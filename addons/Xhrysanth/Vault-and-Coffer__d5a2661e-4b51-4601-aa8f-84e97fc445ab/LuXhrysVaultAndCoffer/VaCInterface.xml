<GuiXml>
	<Controls>


<!-- =================| InfoPanel Custom Quadrants |=================== -->

		<!-- Templates for a Quadrant 3 panel. The default options have arrows, and we just want straight rails. TODO: Scrolling? -->

		<Control name="LuXhrys_VaultAndCoffer_Gamepad_Quadrant_3_Background_Template" inherits="ZO_Gamepad_BackgroundControl_Rails" virtual="true">
			<Controls>
				<Texture name="$(parent)Bg" inherits="ZO_GamepadGrid_BackgroundTexture">
					<TextureCoords left="ZO_GAMEPAD_QUADRANT_3_LEFT_COORD" right="ZO_GAMEPAD_QUADRANT_3_RIGHT_COORD" top="0" bottom="ZO_GAMEPAD_PANEL_BG_BOTTOM_COORD"/>
				</Texture>
			</Controls>
		</Control>

		<TopLevelControl name="LuXhrys_VaultAndCoffer_TopLevel_Gamepad_Quadrant_3_Background" inherits="ZO_GamepadGrid_NavQuadrant_3_Anchors ZO_Gamepad_BackgroundTopLevel_Base_Template">
			<Controls>
				<Control name="$(parent)NestedBg" inherits="LuXhrys_VaultAndCoffer_Gamepad_Quadrant_3_Background_Template"/>
			</Controls>
		</TopLevelControl>

		<!-- Templates for a panel stretching from the right of quadrant 2 to the left of quadrant 4.
		The following are based on controls in esoui/common/gamepad/gamepadquadrants.xml -->

		<Control name="LuXhrys_VaultAndCoffer_Gamepad_Quadrant_3Wide_Anchors" virtual="true">
			<Dimensions x="LUXHRYS.INFO_PANEL_GAMEPAD_CONSTANTS.WIDE.PANEL_WIDTH"/> <!-- Consider also "ZO_GAMEPAD_PANEL_WIDE_WIDTH" for a fixed width! -->
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" offsetX="LUXHRYS.INFO_PANEL_GAMEPAD_CONSTANTS.WIDE.LEFT_OFFSET" offsetY="ZO_GAMEPAD_QUADRANT_TOP_OFFSET"/>
<!--			<Anchor point="BOTTOMLEFT" relativeTo="GuiRoot" offsetX="ZO_GAMEPAD_QUADRANT_2_RIGHT_OFFSET" offsetY="ZO_GAMEPAD_QUADRANT_BOTTOM_OFFSET"/> -->
			<Anchor point="BOTTOMLEFT" relativeTo="GuiRoot" offsetX="LUXHRYS.INFO_PANEL_GAMEPAD_CONSTANTS.WIDE.LEFT_OFFSET" offsetY="ZO_GAMEPAD_QUADRANT_BOTTOM_OFFSET"/>
		</Control>

		<Control name="LuXhrys_VaultAndCoffer_Gamepad_Quadrant_3_Wide_Background_Template" inherits="ZO_Gamepad_BackgroundControl_Rails" virtual="true">
			<Controls>
				<Texture name="$(parent)Bg" inherits="ZO_GamepadGrid_BackgroundTexture">
					<TextureCoords left="ZO_GAMEPAD_QUADRANT_2_RIGHT_COORD" right="ZO_GAMEPAD_QUADRANT_4_LEFT_COORD" top="0" bottom="ZO_GAMEPAD_PANEL_BG_BOTTOM_COORD"/> <!-- Consider also right="ZO_GAMEPAD_QUADRANT_3_RIGHT_COORD" -->
				</Texture>
			</Controls>
		</Control>

		<TopLevelControl name="LuXhrys_VaultAndCoffer_TopLevel_Gamepad_Quadrant_3_Wide_Background" inherits="LuXhrys_VaultAndCoffer_Gamepad_Quadrant_3Wide_Anchors ZO_Gamepad_BackgroundTopLevel_Base_Template">
			<Controls>
				<Control name="$(parent)NestedBg" inherits="LuXhrys_VaultAndCoffer_Gamepad_Quadrant_3_Wide_Background_Template"/>
			</Controls>
		</TopLevelControl>

		<Control name="LuXhrys_VaultAndCoffer_Gamepad_AnchoredToQuadrant_3_Wide_Background" virtual="true">
			<Anchor point="TOPLEFT" relativeTo="LuXhrys_VaultAndCoffer_TopLevel_Gamepad_Quadrant_3_Wide_Background"/>
			<Anchor point="BOTTOMRIGHT" relativeTo="LuXhrys_VaultAndCoffer_TopLevel_Gamepad_Quadrant_3_Wide_Background"/>
		</Control>


<!-- ======================| Entry Templates |========================= -->

<!-- The following are in esoui/common/gamepad/zo_gamepadtemplatescommon.xml: -->

<!--
	x	ZO_GamepadMenuEntryHeaderTemplate
	x	ZO_GamepadMenuEntryWithIconHeaderTemplate (inherits ZO_GamepadMenuEntryHeaderTemplate and adds icon)
		These are used to add a category header above a normal entry. They are not standalone section headers.
-->
		<Label name="LuXhrys_VaultAndCoffer_GamepadMenuEntryHeaderTemplate" inherits="ZO_GamepadMenuEntryHeaderTemplate" virtual="true">
		</Label>
		<Label name="LuXhrys_VaultAndCoffer_GamepadMenuEntryWithIconHeaderTemplate" font="ZoFontGamepadBold42" inherits="ZO_GamepadMenuEntryWithIconHeaderTemplate" virtual="true">
		</Label>

<!--
		ZO_GamepadMenuHeaderTemplate (does not inherit, has its own setup function, and contains a label)
		ZO_GamepadMenuHeaderUppercaseTemplate (similar but is presumably all uppercase)
			This template is intended for usage with the template setup function set to ZO_GamepadMenuHeaderTemplate_Setup.
			When using that setup function, this template includes a few additional features that can be enabled in the item
			data:

				text - Can be either a string or a function to call that returns a string.
				color - Can be a color string, color table, or a function that returns either of the first two.

			Note that by default, this template cannot be selected in the parametric scroll list, however this behavior can be
			overriden by manually setting the canSelect flag in the item's data when adding an item using the template.
-->
		<Control name="LuXhrys_VaultAndCoffer_GamepadMenuHeaderTemplate" inherits="ZO_GamepadMenuHeaderTemplate" virtual="true">
		</Control>
		<Control name="LuXhrys_VaultAndCoffer_GamepadMenuHeaderUppercaseTemplate" inherits="ZO_GamepadMenuHeaderUppercaseTemplate" virtual="true">
		</Control>

<!--
*		ZO_GamepadMenuEntryTemplate (inherits ZO_GamepadMenuEntryDimensionsTemplate and ZO_GamepadMenuEntryLabelSizedTemplate, and adds label, icon, and stackCount)
		ZO_GamepadSubMenuEntryTemplate (inherits ZO_GamepadMenuEntryDimensionsTemplate and ZO_GamepadMenuEntryLabelSizedTemplate, and adds label, icon, stackCount, and SubStatusIcon)
-->
		<Control name="LuXhrys_VaultAndCoffer_GamepadMenuEntryTemplate" inherits="ZO_GamepadMenuEntryTemplate" virtual="true">
		</Control>
		<Control name="LuXhrys_VaultAndCoffer_GamepadSubMenuEntryTemplate" inherits="ZO_GamepadSubMenuEntryTemplate" virtual="true">
		</Control>

<!-- The following are in esoui/ingame/gamepad/gamepadtemplates/gamepadtemplates.xml: -->

<!--
	ZO_GamepadNewMenuEntryTemplate (inherits ZO_GamepadMenuEntryTemplate and adds status indicator)
	ZO_GamepadSubMenuEntryTemplateWithStatus (inherits ZO_GamepadSubMenuEntryTemplate and adds status indicator)
-->

		<Control name="LuXhrys_VaultAndCoffer_GamepadNewMenuEntryTemplate" inherits="ZO_GamepadNewMenuEntryTemplate" virtual="true">
		</Control>
		<Control name="LuXhrys_VaultAndCoffer_GamepadSubMenuEntryTemplateWithStatus" inherits="ZO_GamepadSubMenuEntryTemplateWithStatus" virtual="true">
		</Control>

<!--
	ZO_GamepadItemEntryTemplate (inherits ZO_GamepadMenuEntryTemplate and adds cooldown and status indicator)
	ZO_GamepadItemSubEntryTemplate (inherits ZO_GamepadSubMenuEntryTemplate and adds cooldown and status indicator)
-->

		<Control name="LuXhrys_VaultAndCoffer_GamepadItemEntryTemplate" inherits="ZO_GamepadItemEntryTemplate" virtual="true">
		</Control>
		<Control name="LuXhrys_VaultAndCoffer_GamepadItemSubEntryTemplate" inherits="ZO_GamepadItemSubEntryTemplate" virtual="true">
		</Control>


