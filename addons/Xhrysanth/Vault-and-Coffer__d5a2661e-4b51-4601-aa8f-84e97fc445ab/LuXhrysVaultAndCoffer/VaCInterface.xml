<!-- ==================| InfoPanel Core Templates |==================== -->


		<!--  Main Header/Title Template. Header at the top of the InfoPanel, including the title. This is analogous to ZO_GamepadStatsTopLevelRightPaneHeaderContainer in zo_stats_gamepad.xml and modeled after ZO_GamepadContentHeaderContainer in genericheader.xml. -->

		<!-- analogous to ZO_GamepadContentHeaderTitleTextTemplate -->
		<Label name="LuXhrys_VaultAndCoffer_InfoPanel_MainHeaderTitleText_Template_Gamepad" font="ZoFontGamepadBold54" verticalAlignment="BOTTOM" horizontalAlignment="CENTER" wrapMode="ELLIPSIS" virtual="true" excludeFromResizeToFitExtents="true" maxLineCount="2"/>

		<!-- analagous to RightPaneHeaderContainer and ZO_GamepadContentHeaderContainer-->
		<Control name="LuXhrys_VaultAndCoffer_InfoPanel_MainHeaderContainer_Template_Gamepad" inherits="ZO_GamepadGrid_NavQuadrant_ContainerAnchors" virtual="true"> <!-- Consider resizeToFitDescendents="true" -->
<!--			<Dimensions y="LUXHRYS.INFO_PANEL_GAMEPAD_CONSTANTS.COMMON.MAIN_HEADER_HEIGHT"/> -->
			<Controls>
				<Control name="$(parent)Header" resizeToFitDescendents="true"> <!-- analolgous to ZO_GamepadGenericContentHeader -->
					<Anchor point="TOPLEFT"/> <!-- analagous to ZO_GamepadHeaderAnchors -->
					<Anchor point="TOPRIGHT"/> <!-- analagous to ZO_GamepadHeaderAnchors -->
					<Controls>
						<Control name="$(parent)TitleContainer"> <!-- analagous to ZO_GamepadHeaderTitleAnchors -->
							<Anchor point="TOPLEFT"/> <!-- analagous to ZO_GamepadHeaderTitleAnchors -->
							<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" offsetY="LUXHRYS.INFO_PANEL_GAMEPAD_CONSTANTS.COMMON.MAIN_HEADER_HEIGHT"/> <!-- analagous to ZO_GamepadHeaderTitleAnchors -->
