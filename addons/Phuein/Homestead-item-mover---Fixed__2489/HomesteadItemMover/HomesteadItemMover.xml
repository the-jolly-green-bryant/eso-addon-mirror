<GuiXml>
    <Controls>
        <TopLevelControl name="HomesteadItemMoverUI" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="true">
            <Dimensions x="160" y="200" />
            <Anchor point="RIGHT"/>
			
            <OnUpdate>
                HomesteadItemMoverUpdate()
            </OnUpdate>
 
           <OnInitialized>
                HomesteadItemMover:Initialize()
            </OnInitialized>
 
            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" />
                <Label name="$(parent)ObjectInfo" font="ZoFontGame" color="CFDCBD" wrapMode="ELLIPSIS" verticalAlignment="TOP" text="No selected item">
                    <AnchorFill />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>