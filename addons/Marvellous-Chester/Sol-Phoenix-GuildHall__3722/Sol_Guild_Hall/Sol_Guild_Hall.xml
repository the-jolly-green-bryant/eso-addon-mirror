<GuiXml>
  <Controls>
    <TopLevelControl name="Sol_Guild_Hall">
      <Dimensions x="64" y="64" />
         <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" offsetX="0" offsetY="10"/>
 
      <Controls>
      
        <Label name="$(parent)Label" width="64" height="64 " font="" inheritAlpha="true" color="FFFFFF"
            wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="LEFT">
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOP" />
        </Label>
        <Button name="$(parent)_house" >
                    <!-- <OnClicked>MyAddon.HideUI()</OnClicked> -->
                    <Dimensions x="25" y="25" />
                    <Textures
                        normal     ="Sol_Guild_Hall/imgs/covOver.dds"
                     />
        </Button>
        <Button name="$(parent)_house_Sol" >
                    <!-- <OnClicked>MyAddon.HideUI()</OnClicked> -->
                    <Dimensions x="25" y="25" />
                    <Textures
                        normal     ="Sol_Guild_Hall/imgs/SolPhoenix.dds"
                     />
        </Button>
        <Button name="$(parent)_ReloadUI" >
                    <!-- <OnClicked>MyAddon.HideUI()</OnClicked> -->
                    <Dimensions x="20" y="20" />
                    <Textures
                        normal     ="Sol_Guild_Hall/imgs/reload.dds"
                     />
        </Button>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>