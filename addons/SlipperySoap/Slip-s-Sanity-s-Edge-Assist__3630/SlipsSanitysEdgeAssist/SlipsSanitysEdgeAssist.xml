      <OnMoveStop>SSEA.OnSSEAAlertsMove()</OnMoveStop>
 
      <Controls>
        <Label name="$(parent)Label" width="800" height="200" font="EsoUI/Common/Fonts/univers67.otf|144|soft-shadow-thick" inheritAlpha="true" color="CC33FF"
