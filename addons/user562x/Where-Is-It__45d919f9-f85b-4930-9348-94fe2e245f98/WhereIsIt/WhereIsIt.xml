<GuiXml>
    <Controls>
        <TopLevelControl name="WhereIsIt_Screen" inherits="ZO_Gamepad_ParametricList_Screen" hidden="true">
            <OnInitialized>
                WhereIsIt_Screen_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)HeaderContainer" inherits="ZO_GamepadScreenHeaderContainer">
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                </Control>

                <Label name="$(parent)PageLabel" font="ZoFontGamepad34"
                       color="FFFFFFFF" horizontalAlignment="CENTER" hidden="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)HeaderContainer" relativePoint="BOTTOMLEFT" offsetY="6"/>
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)HeaderContainer" relativePoint="BOTTOMRIGHT" offsetY="6"/>
                </Label>

                <Label name="$(parent)SearchLabel" font="ZoFontGamepad27"
                       color="FFFFFFFF" horizontalAlignment="CENTER">
                    <Anchor point="TOPLEFT"  relativeTo="$(parent)PageLabel" relativePoint="BOTTOMLEFT"  offsetY="8"/>
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)PageLabel" relativePoint="BOTTOMRIGHT" offsetY="8"/>
                </Label>

                <EditBox name="$(parent)SearchBoxText" inherits="ZO_DefaultEdit_Gamepad"
                         font="ZoFontGamepad34" maxInputChars="60">
                    <Anchor point="TOPLEFT"  relativeTo="$(parent)SearchLabel" relativePoint="BOTTOMLEFT"  offsetX="16" offsetY="6"/>
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)SearchLabel" relativePoint="BOTTOMRIGHT" offsetX="-16" offsetY="6"/>
                    <Dimensions y="44"/>
                    <Controls>
                        <Backdrop name="$(parent)BG" inherits="ZO_EditBackdrop_Gamepad">
                            <Anchor point="TOPLEFT"     offsetX="-4" offsetY="-4"/>
                            <Anchor point="BOTTOMRIGHT" offsetX="4"  offsetY="4"/>
                        </Backdrop>
                    </Controls>
                </EditBox>

                <Control name="$(parent)DetailPanel" inherits="ZO_GamepadGrid_NavQuadrant_2_3_4_Anchors" hidden="true">
                    <Controls>
                        <Control name="$(parent)Bg" inherits="ZO_SharedGamepadNavQuadrant_2_3_4_Background_Template"/>

                        <Texture name="$(parent)Icon" hidden="true" tier="HIGH" pixelRoundingEnabled="false">
                            <Dimensions x="192" y="192"/>
                            <Anchor point="CENTER" offsetX="0" offsetY="-180"/>
                        </Texture>

                        <Label name="$(parent)Name" font="ZoFontGamepadBold42"
                               color="FFFFFFFF" horizontalAlignment="CENTER">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Icon" relativePoint="BOTTOMLEFT" offsetX="-150" offsetY="10"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Icon" relativePoint="BOTTOMRIGHT" offsetX="150"/>
                        </Label>

                        <Label name="$(parent)Quality" font="ZoFontGamepad42"
                               color="FFFFFFFF" horizontalAlignment="CENTER" hidden="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Name" relativePoint="BOTTOMLEFT" offsetY="6"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Name" relativePoint="BOTTOMRIGHT"/>
                        </Label>

                        <Texture name="$(parent)Divider"
                                 textureFile="EsoUI/Art/Miscellaneous/Gamepad/gp_navBar_separator.dds">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Quality" relativePoint="BOTTOMLEFT" offsetX="-20" offsetY="10"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Quality" relativePoint="BOTTOMRIGHT" offsetX="20"/>
                            <Dimensions y="2"/>
                        </Texture>

                        <Label name="$(parent)Type" font="ZoFontGamepad42"
                               color="FFFFFFFF" horizontalAlignment="CENTER" hidden="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Divider" relativePoint="BOTTOMLEFT" offsetY="10"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Divider" relativePoint="BOTTOMRIGHT"/>
                        </Label>

                        <Label name="$(parent)ArmorType" font="ZoFontGamepad42"
                               color="FFFFFFFF" horizontalAlignment="CENTER" hidden="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Type" relativePoint="BOTTOMLEFT" offsetY="8"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Type" relativePoint="BOTTOMRIGHT"/>
                        </Label>

                        <Label name="$(parent)Trait" font="ZoFontGamepad42"
                               color="FFFFFFFF" horizontalAlignment="CENTER" hidden="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)ArmorType" relativePoint="BOTTOMLEFT" offsetY="8"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)ArmorType" relativePoint="BOTTOMRIGHT"/>
                        </Label>

                        <Label name="$(parent)Set" font="ZoFontGamepad42"
                               color="FFe4c027" wrapMode="TRUNCATE" horizontalAlignment="CENTER" hidden="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Trait" relativePoint="BOTTOMLEFT" offsetY="8"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Trait" relativePoint="BOTTOMRIGHT"/>
                        </Label>

                        <Label name="$(parent)Char" font="ZoFontGamepad42"
                               color="FFFFFFFF" horizontalAlignment="CENTER" hidden="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Set" relativePoint="BOTTOMLEFT" offsetY="8"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Set" relativePoint="BOTTOMRIGHT"/>
                        </Label>

                        <Label name="$(parent)Location" font="ZoFontGamepad42"
                               color="FFFFFFFF" horizontalAlignment="CENTER" hidden="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Char" relativePoint="BOTTOMLEFT" offsetY="8"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Char" relativePoint="BOTTOMRIGHT"/>
                        </Label>

                        <Label name="$(parent)Count" font="ZoFontGamepad42"
                               color="FFFFFFFF" horizontalAlignment="CENTER" hidden="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Location" relativePoint="BOTTOMLEFT" offsetY="8"/>
                            <Anchor point="TOPRIGHT" relativeTo="$(parent)Location" relativePoint="BOTTOMRIGHT"/>
                        </Label>
                    </Controls>
                </Control>

            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
