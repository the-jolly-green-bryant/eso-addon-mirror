<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="Mechanic Mentor">
            <Action name="DUNGEONMECHANICS_SELECT">
                <Down>MechanicMentor_Select()</Down>
                <GamepadButton>GAMEPAD_BUTTON_1</GamepadButton>
