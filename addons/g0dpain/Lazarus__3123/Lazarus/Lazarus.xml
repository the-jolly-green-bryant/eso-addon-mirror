<GuiXml>
  <Controls>
    <TopLevelControl name="LazarusTLC" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="true">
      <Dimensions x="400" y="50" />
      <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0"/>
      <OnMoveStop>
        Lazarus.SaveUiPosition()
      </OnMoveStop>
      <Controls>
        <Label name="$(parent)Label" width="420" height="50" font="ZoFontWinH1" inheritAlpha="true" color="FF0000" wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="LEFT" text="Lazarus">
          <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
        </Label>
        <Control name="$(parent)Container" inherits="ZO_ScrollContainer">
          <OnInitialized>
                ZO_Scroll_Initialize(self)
          </OnInitialized>
          <Dimensions x="400" y="125"/>
          <Anchor point="TOPLEFT" relativeTo="$(parent)Bg" relativePoint="TOPLEFT" offsetY="40" offsetX="0"/>
        </Control>
        <Label name="$(parent)Data" width="80" height="50" font="ZoFontWinH3" inheritAlpha="true" color="D3D3D3" wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="LEFT" text="YOU">
          <Anchor point="TOPLEFT" relativeTo="$(parent)Bg" relativePoint="TOPLEFT" offsetY="40" offsetX="25"/>
          <OnInitialized>
                self:SetParent(GetControl("LazarusTLCContainerScrollChild"))
                self:SetAnchor(TOPLEFT, LazarusTLCContainerScrollChild, TOPLEFT, 4, 4)
          </OnInitialized>
        </Label>
        <Label name="$(parent)Data2" width="80" height="50" font="ZoFontWinH3" inheritAlpha="true" color="D3D3D3" wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="LEFT" text="Others">
          <Anchor point="TOPRIGHT" relativeTo="$(parent)Bg" relativePoint="TOPRIGHT" offsetY="40" offsetX="-35"/>
          <OnInitialized>
                self:SetParent(GetControl("LazarusTLCContainerScrollChild"))
                self:SetAnchor(TOPLEFT, LazarusTLCContainerScrollChild, TOP, 4, 4)
          </OnInitialized>
        </Label>
        <Texture name="$(parent)Bg" excludeFromResizeToFitExtents="true" color="000000" alpha="0.3">
          <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" offsetY="-8" />
          <Dimensions x="400" y="50"/>
        </Texture>
        <Button name="$(parent)ButtonCloseTally" inherits="ZO_ButtonBehaviorClickSound">
          <Dimensions x="35" y="35" />
          <Anchor point="TOPLEFT" relativeTo="$(parent)Bg" relativePoint="TOPLEFT" offsetX="5" offsetY="5" />
          <Textures normal="EsoUI/Art/Buttons/closebutton_up.dds" pressed="EsoUI/Art/Buttons/closebutton_down.dds" mouseOver="EsoUI/Art/Buttons/closebutton_mouseover.dds" disabled="EsoUI/Art/Buttons/closebutton_disabled.dds"/>
          <OnClicked>
						Lazarus.ToggleWindow()
          </OnClicked>
        </Button>       
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
