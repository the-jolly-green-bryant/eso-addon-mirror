<!--                v 1.3.2               -->
<GuiXml>
	<Controls>
		<TopLevelControl name="KHIDUITitle" mouseEnabled="true" movable="true" drawLayer="DL_BACKGROUND" hidden="true">
			<Dimensions x="220" y="25"/>
			<Anchor point="TOP" relativePoint="TOP" relativeTo="GuiRoot" offsetX="0" offsetY="75" />
			<OnMouseUp>
				KHID_SaveAnchor()
			</OnMouseUp>
			<Controls>
				<Button name="$(parent)Button" font="ZoFontGame" text="" hidden="false" >
					<Dimensions x="25" y="25"/>
					<Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="0" offsetY="0" />
					<OnMouseDown>
						KHID_ToggleUI()
					</OnMouseDown>
				</Button>
				<Texture name="$(parent)Icon" textureFile="/esoui/art/icons/placeholder/icon_spell_rest_convalescence01.dds" color="FF6A00" alpha="0.4" drawLayer="DL_BACKGROUND" hidden="false">
					<Dimensions x="24" y="24" />
					<Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="0" offsetY="0" />
				</Texture>
				<Label name="$(parent)Label" font="ZoFontBookTabletTitle" scale="0.4" alpha="0.4" styleColor="FF6A00" text="Hero In Disguise" drawLayer="DL_BACKGROUND" hidden="false" >
					<Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="5" offsetY="0" />
				</Label>				
			</Controls>
		</TopLevelControl>
		<TopLevelControl name="KHIDUI" mouseEnabled="true" movable="false" clampedToScreen="true" drawLayer="DL_BACKGROUND" hidden="true">
			<Dimensions x="900" y="110"/>
			<Anchor point="TOP" relativeTo="KHIDUITitle" relativePoint="BOTTOM" offsetX="0" offsetY="3" />
			<Controls>
				<Backdrop name="$(parent)BG" alpha="0.5" inherits="ZO_ThinBackdrop" hidden="false" />				
				<Label name="$(parent)Label" font="ZoFontBookTabletTitle" scale="0.5" alpha="0.4" styleColor="FF6A00" text="Hero In Disguise" drawLayer="DL_BACKGROUND" hidden="false" >
                    <Anchor point="CENTER" relativePoint="CENTER" offsetX="40" offsetY="0" />
                </Label>				
				<Texture name="$(parent)Icon" textureFile="/esoui/art/icons/placeholder/icon_spell_rest_convalescence01.dds" color="FF6A00" alpha="0.4" drawLayer="DL_BACKGROUND" hidden="false">
					<Dimensions x="48" y="48" />
					<Anchor point="RIGHT" relativeTo="$(parent)Label" relativePoint="LEFT" offsetX="-10" offsetY="0" />
				</Texture>
				<Control name="$(parent)CatPanel" drawLayer="DL_BACKGROUND" hidden="false">
					<Dimensions x="30" y="130" />
					<Anchor relativeTo="$(parent)" point="TOPRIGHT" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
					<Controls>
						<Backdrop name="$(parent)BG" alpha="0.5" inherits="ZO_ThinBackdrop" hidden="false" />				
					</Controls>
				</Control>
			</Controls>
		</TopLevelControl>
		
		<Control name="KHID_Panel" virtual="true" mouseEnabled="true" drawLayer="DL_BACKGROUND" hidden="false">
			<Dimensions x="140" y="90"/>
			<Controls>
				<Backdrop name="$(parent)BG" alpha="0.5" inherits="ZO_DefaultBackdrop" />				
				<Texture name="$(parent)Icon" alpha="1" hidden="false">
					<Dimensions x="48" y="48" />
					<Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" offsetX="0" offsetY="0" />
				</Texture>
				<Texture name="$(parent)Bank" alpha="0.3" hidden="true">
					<Dimensions x="32" y="32" />
					<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="0" offsetY="0" />
				</Texture>
				<Label name="$(parent)Label" wrapMode="TEXT_WRAP_MODE_ELLIPSIS" horizontalAlignment="CENTER" font="ZoFontHeader" alpha="0.7" text="Disguise Name" >
					<Dimensions x="140" y="50"/>
					<Anchor point="TOP" relativeTo="$(parent)Icon" relativePoint="BOTTOM" offsetX="0" offsetY="0"/>
				</Label>
                <Cooldown name="$(parent)Cooldown" inherits="ZO_DefaultCooldown" />				
			</Controls>
		</Control>
		
	</Controls>
</GuiXml>