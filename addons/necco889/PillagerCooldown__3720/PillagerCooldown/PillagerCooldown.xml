<GuiXml>
    <Controls>
            <TopLevelControl name="PillagerCooldownFrame" mouseEnabled="false" movable="false" resizeToFitDescendents="true" clampedToScreen="true" hidden="false">
            <Anchor point="LEFT" relativeTo="GuiRoot" relativePoint="LEFT" offsetX="500" offsetY="0" />
            <OnMoveStop>PillagerCooldown.OnMoveStop()</OnMoveStop>
            <Controls>
                <Texture name="$(parent)_Icon" textureFile="esoui/art/icons/ability_healer_030.dds">
                    <Dimensions x="28" y="28"/>
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT" relativeTo="$(parent)" offsetX="4" offsetY="-8" />
                </Texture>
                <Label name="$(parent)_Duration" horizontalAlignment="left" font="$(MEDIUM_FONT)|$(KB_22)|soft-shadow-thick" text="  0.0" wrapMode="TRUNCATE">
                    <Dimensions x="50" y="24"/>
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)_Icon" offsetX="0" offsetY="0" />
                </Label>
                <Label name="$(parent)_NumOfPlayers" horizontalAlignment="left" font="$(MEDIUM_FONT)|$(KB_22)|soft-shadow-thick" text="   0" wrapMode="TRUNCATE">
                    <Dimensions x="50" y="24"/>
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)_Duration" offsetX="0" offsetY="0" />
                </Label>
                <Label name="$(parent)_UltiGain" horizontalAlignment="left" font="$(MEDIUM_FONT)|$(KB_22)|soft-shadow-thick" text="   0" wrapMode="TRUNCATE">
                    <Dimensions x="50" y="24"/>
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)_NumOfPlayers" offsetX="0" offsetY="0" />
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
