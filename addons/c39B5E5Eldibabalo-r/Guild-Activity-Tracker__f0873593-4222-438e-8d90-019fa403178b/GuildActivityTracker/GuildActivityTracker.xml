<GuiXml>
    <Controls>

        <!-- ================================================================
             Guild Activity Tracker v1.0.0
             1200x800 window. Custom pixel-size fonts for TV readability.
             Uses RegisterTopLevel for native ESO virtual cursor on console.
             ================================================================ -->
        <TopLevelControl name="GAT_Window" hidden="true"
                         clampedToScreen="true" mouseEnabled="true"
                         movable="true"
                         layer="OVERLAY" level="10">
            <Dimensions x="1200" y="800" />
            <Anchor point="CENTER" />

            <Controls>

                <!-- Solid dark background -->
                <Texture name="$(parent)BGSolid" mouseEnabled="false"
                         color="0D0D0D" alpha="0.97">
                    <AnchorFill />
                </Texture>

                <!-- Thin gold border -->
                <Backdrop name="$(parent)Border" mouseEnabled="false"
                          centerColor="00000000" edgeColor="E8C05C">
                    <AnchorFill />
                    <Edge edgeSize="2" />
                </Backdrop>

                <!-- Title (large) -->
                <Label name="$(parent)Title" mouseEnabled="false"
                       font="$(BOLD_FONT)|32|soft-shadow-thick" color="E8C05C"
                       horizontalAlignment="CENTER" verticalAlignment="CENTER"
                       text="Guild Activity Tracker">
                    <Anchor point="TOP" offsetY="14" />
                    <Dimensions x="800" y="36" />
                </Label>

                <!-- Close Button (X) — tappable with virtual cursor -->
                <Button name="$(parent)CloseBtn" mouseEnabled="true"
                        inherits="ZO_ButtonBehaviorClickSound">
                    <Dimensions x="36" y="36" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT"
                            offsetX="-6" offsetY="6" />
                    <Textures normal="EsoUI/Art/Buttons/closebutton_up.dds"
                              pressed="EsoUI/Art/Buttons/closebutton_down.dds"
                              mouseOver="EsoUI/Art/Buttons/closebutton_mouseover.dds"
                              disabled="EsoUI/Art/Buttons/closebutton_disabled.dds" />
                    <OnClicked>
                        GAT_UI:Hide()
                    </OnClicked>
                </Button>

                <!-- ===== TAB BUTTONS (Roster / History) ===== -->
                <Button name="$(parent)TabBtn1" mouseEnabled="true"
                        inherits="ZO_ButtonBehaviorClickSound">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="54" />
                    <Dimensions x="280" y="32" />
                </Button>
                <Button name="$(parent)TabBtn2" mouseEnabled="true"
                        inherits="ZO_ButtonBehaviorClickSound">
                    <Anchor point="TOPLEFT" offsetX="310" offsetY="54" />
                    <Dimensions x="280" y="32" />
                </Button>

                <!-- Guild selector (tappable label, right side of tab row) -->
                <Button name="$(parent)GuildBtn" mouseEnabled="true"
                        inherits="ZO_ButtonBehaviorClickSound">
                    <Anchor point="TOPRIGHT" offsetX="-20" offsetY="54" />
                    <Dimensions x="500" y="32" />
                </Button>

                <!-- Separator under tabs -->
                <Texture name="$(parent)Sep1" mouseEnabled="false" color="E8C05C" alpha="0.4">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="90" />
                    <Dimensions x="1160" y="1" />
                </Texture>

                <!-- ===== FILTER / SORT / SEARCH ROW ===== -->
                <Button name="$(parent)FilterBtn" mouseEnabled="true"
                        inherits="ZO_ButtonBehaviorClickSound">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="96" />
                    <Dimensions x="350" y="26" />
                </Button>
                <Button name="$(parent)SortBtn" mouseEnabled="true"
                        inherits="ZO_ButtonBehaviorClickSound">
                    <Anchor point="TOPLEFT" offsetX="380" offsetY="96" />
                    <Dimensions x="300" y="26" />
                </Button>

                <!-- Search Box (tappable — opens virtual keyboard on console) -->
                <Control name="$(parent)SearchBox" mouseEnabled="false">
                    <Anchor point="TOPLEFT" offsetX="700" offsetY="94" />
                    <Dimensions x="340" y="28" />
                    <Controls>
                        <Backdrop name="$(parent)BG" inherits="ZO_EditBackdrop">
                            <AnchorFill />
                        </Backdrop>
                        <EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop"
                                 font="$(MEDIUM_FONT)|20|soft-shadow-thin">
                            <Anchor point="TOPLEFT" offsetX="6" offsetY="2" />
                            <Anchor point="BOTTOMRIGHT" offsetX="-6" offsetY="-2" />
                        </EditBox>
                    </Controls>
                </Control>

                <!-- Member count (hidden — info is in footer stats) -->
                <Label name="$(parent)MemberCount" mouseEnabled="false" hidden="true"
                       font="$(MEDIUM_FONT)|22|soft-shadow-thin" color="888888"
                       horizontalAlignment="RIGHT" verticalAlignment="CENTER">
                    <Anchor point="TOPRIGHT" offsetX="-20" offsetY="54" />
                    <Dimensions x="200" y="32" />
                </Label>

                <!-- Detail Header (hidden by default — shown in member detail view) -->
                <Label name="$(parent)DetailHeader" mouseEnabled="false" hidden="true"
                       font="$(BOLD_FONT)|24|soft-shadow-thick" color="E8C05C"
                       horizontalAlignment="LEFT" verticalAlignment="CENTER">
                    <Anchor point="TOPLEFT" offsetX="24" offsetY="96" />
                    <Dimensions x="1100" y="26" />
                </Label>

                <!-- Separator under filter row -->
                <Texture name="$(parent)Sep2" mouseEnabled="false" color="444444">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="126" />
                    <Dimensions x="1160" y="1" />
                </Texture>

                <!-- ===== COLUMN HEADERS (Roster — shown by default) ===== -->
                <Label name="$(parent)ColName" mouseEnabled="false"
                       font="$(BOLD_FONT)|22|soft-shadow-thin" color="AAAAAA"
                       horizontalAlignment="LEFT" text="NAME">
                    <Anchor point="TOPLEFT" offsetX="30" offsetY="130" />
                    <Dimensions x="300" y="24" />
                </Label>
                <Label name="$(parent)ColRank" mouseEnabled="false"
                       font="$(BOLD_FONT)|22|soft-shadow-thin" color="AAAAAA"
                       horizontalAlignment="LEFT" text="RANK">
                    <Anchor point="TOPLEFT" offsetX="340" offsetY="130" />
                    <Dimensions x="170" y="24" />
                </Label>
                <Label name="$(parent)ColStatus" mouseEnabled="false"
                       font="$(BOLD_FONT)|22|soft-shadow-thin" color="AAAAAA"
                       horizontalAlignment="CENTER" text="STATUS">
                    <Anchor point="TOPLEFT" offsetX="520" offsetY="130" />
                    <Dimensions x="110" y="24" />
                </Label>
                <Label name="$(parent)ColLastOnline" mouseEnabled="false"
                       font="$(BOLD_FONT)|22|soft-shadow-thin" color="AAAAAA"
                       horizontalAlignment="LEFT" text="LAST ONLINE">
                    <Anchor point="TOPLEFT" offsetX="640" offsetY="130" />
                    <Dimensions x="240" y="24" />
                </Label>
                <Label name="$(parent)ColZone" mouseEnabled="false"
                       font="$(BOLD_FONT)|22|soft-shadow-thin" color="AAAAAA"
                       horizontalAlignment="LEFT" text="ZONE">
                    <Anchor point="TOPLEFT" offsetX="890" offsetY="130" />
                    <Dimensions x="260" y="24" />
                </Label>

                <!-- Separator under headers -->
                <Texture name="$(parent)Sep3" mouseEnabled="false" color="444444">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="158" />
                    <Dimensions x="1160" y="1" />
                </Texture>

                <!-- ===== LIST AREA (rows created in Lua) ===== -->
                <Control name="$(parent)ListArea" mouseEnabled="true">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="162" />
                    <Dimensions x="1160" y="560" />
                </Control>

                <!-- Scroll Buttons (tappable with virtual cursor) -->
                <Button name="$(parent)ScrollUpBtn" mouseEnabled="true"
                        inherits="ZO_ButtonBehaviorClickSound">
                    <Anchor point="TOPRIGHT" offsetX="-4" offsetY="162" />
                    <Dimensions x="36" y="36" />
                </Button>
                <Button name="$(parent)ScrollDownBtn" mouseEnabled="true"
                        inherits="ZO_ButtonBehaviorClickSound">
                    <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-86" />
                    <Dimensions x="36" y="36" />
                </Button>

                <!-- Separator above footer -->
                <Texture name="$(parent)Sep4" mouseEnabled="false" color="444444">
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="726" />
                    <Dimensions x="1160" y="1" />
                </Texture>

                <!-- Footer stats -->
                <Label name="$(parent)FooterStats" mouseEnabled="false"
                       font="$(MEDIUM_FONT)|22|soft-shadow-thin" color="BBBBBB"
                       horizontalAlignment="LEFT" verticalAlignment="CENTER">
                    <Anchor point="BOTTOMLEFT" offsetX="24" offsetY="-28" />
                    <Dimensions x="800" y="26" />
                </Label>

                <!-- Player name watermark (right-aligned) -->
                <Label name="$(parent)FooterPlayer" mouseEnabled="false"
                       font="$(MEDIUM_FONT)|22|soft-shadow-thin" color="888888"
                       horizontalAlignment="RIGHT" verticalAlignment="CENTER"
                       text="">
                    <Anchor point="BOTTOMRIGHT" offsetX="-24" offsetY="-28" />
                    <Dimensions x="350" y="26" />
                </Label>

            </Controls>
        </TopLevelControl>

    </Controls>
</GuiXml>
