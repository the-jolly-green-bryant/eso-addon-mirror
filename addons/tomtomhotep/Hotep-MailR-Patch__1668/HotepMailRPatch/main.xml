            </Label>
            
            <Label name="HOTEPMRP_Attach3" font="ZoFontWinH4" linkEnabled="true" mouseEnabled="true" hidden="true">
              <Dimensions x="1260" y="80" />
              <OnInitialized>
                self:SetParent(GetControl("HOTEPMRP_BodyContainerScrollChild"))
                self:SetAnchor(TOPLEFT, HOTEPMRP_Attach2, BOTTOMLEFT, 0, 2)
              </OnInitialized>
              
              <OnMouseEnter>
                  InitializeTooltip(ItemTooltip, self, BOTTOMLEFT, 0, 0)
                  ItemTooltip:SetLink(self.ITEMLINK)
              </OnMouseEnter>
              
              <OnMouseExit>
                  ClearTooltip(ItemTooltip)
              </OnMouseExit>
              
              <OnMouseUp>
                  if upInside then
                      ZO_LinkHandler_OnLinkClicked(self.ITEMLINK, button, self)
                  end
              </OnMouseUp>
            </Label>
            
            <Label name="HOTEPMRP_Attach4" font="ZoFontWinH4" linkEnabled="true" mouseEnabled="true" hidden="true">
              <Dimensions x="1260" y="80" />
              <OnInitialized>
                self:SetParent(GetControl("HOTEPMRP_BodyContainerScrollChild"))
                self:SetAnchor(TOPLEFT, HOTEPMRP_Attach3, BOTTOMLEFT, 0, 2)
              </OnInitialized>
              
              <OnMouseEnter>
                  InitializeTooltip(ItemTooltip, self, BOTTOMLEFT, 0, 0)
                  ItemTooltip:SetLink(self.ITEMLINK)
              </OnMouseEnter>
              
              <OnMouseExit>
                  ClearTooltip(ItemTooltip)
              </OnMouseExit>
              
              <OnMouseUp>
                  if upInside then
                      ZO_LinkHandler_OnLinkClicked(self.ITEMLINK, button, self)
                  end
              </OnMouseUp>
            </Label>
            
            <Label name="HOTEPMRP_Attach5" font="ZoFontWinH4" linkEnabled="true" mouseEnabled="true" hidden="true">
              <Dimensions x="1260" y="80" />
              <OnInitialized>
                self:SetParent(GetControl("HOTEPMRP_BodyContainerScrollChild"))
                self:SetAnchor(TOPLEFT, HOTEPMRP_Attach4, BOTTOMLEFT, 0, 2)
              </OnInitialized>
              
              <OnMouseEnter>
                  InitializeTooltip(ItemTooltip, self, BOTTOMLEFT, 0, 0)
                  ItemTooltip:SetLink(self.ITEMLINK)
              </OnMouseEnter>
              
              <OnMouseExit>
                  ClearTooltip(ItemTooltip)
              </OnMouseExit>
              
              <OnMouseUp>
                  if upInside then
                      ZO_LinkHandler_OnLinkClicked(self.ITEMLINK, button, self)
                  end
              </OnMouseUp>
            </Label>
            
            <Label name="HOTEPMRP_Attach6" font="ZoFontWinH4" linkEnabled="true" mouseEnabled="true" hidden="true">
              <Dimensions x="1260" y="80" />
              <OnInitialized>
                self:SetParent(GetControl("HOTEPMRP_BodyContainerScrollChild"))
                self:SetAnchor(TOPLEFT, HOTEPMRP_Attach5, BOTTOMLEFT, 0, 2)
              </OnInitialized>
              
              <OnMouseEnter>
                  InitializeTooltip(ItemTooltip, self, BOTTOMLEFT, 0, 0)
                  ItemTooltip:SetLink(self.ITEMLINK)
              </OnMouseEnter>
              
              <OnMouseExit>
                  ClearTooltip(ItemTooltip)
              </OnMouseExit>
              
              <OnMouseUp>
                  if upInside then
                      ZO_LinkHandler_OnLinkClicked(self.ITEMLINK, button, self)
                  end
              </OnMouseUp>
            </Label>
            
          </Controls>
        </Control>
        
        <Label name="$(parent)_Trademark" font="ZoFontGameLarge" horizontalAlignment="center"
                text="Hotep|t24:24:\HotepMailRPatch\R.dds|t is a Registered Trademark of Simple Designs Software LLC. All Rights Reserved.">
          <Anchor point="BOTTOM" relativeTo="$(parent)" relativePoint="BOTTOM" offsetY="8" />
          <Dimensions x="1250" y="28" />
        </Label>
        
      </Controls>
    </TopLevelControl>
    
    <Control name="HOTEPMRP_UI_main_List_Row" virtual="true" mouseEnabled="true">
      <Dimensions x="620" y="32" />
      <OnMouseEnter>
          HotepMRP.OnMouseEnter(self)
      </OnMouseEnter>
      <OnMouseExit>
          HotepMRP.OnMouseExit(self)
      </OnMouseExit>
      <OnMouseUp>
          HotepMRP.MailClicked(self, button, upInside)
      </OnMouseUp>
      <Controls>
        <Texture name="$(parent)BG" inherits="ZO_ThinListBgStrip" />
        
        <Texture name="$(parent)hotep" textureFile="\HotepMailRPatch\blue.dds" hidden="true">
          <Anchor point="TOPLEFT" relativeTo="$(parent)" />
          <Dimensions x="620" y="32" />
          <AnchorFill />
        </Texture>
        
        <Label name="$(parent)recipient" font="ZoFontWinH4" wrapMode="ELLIPSIS">
          <Anchor point="TOPLEFT" relativeTo="$(parent)" />
          <Dimensions x="160" y="32" />
        </Label>
        <Label name="$(parent)sent" font="ZoFontWinH4" wrapMode="ELLIPSIS">
          <Anchor point="TOPLEFT" relativeTo="$(parent)recipient" relativePoint="TOPRIGHT" />
          <Dimensions x="120" y="32" />
        </Label>
        <Label name="$(parent)subject" font="ZoFontWinH4" wrapMode="ELLIPSIS">
          <Anchor point="TOPLEFT" relativeTo="$(parent)sent"  relativePoint="TOPRIGHT" />
          <Dimensions x="340" y="32" />
        </Label>
      </Controls>
    </Control>
    
  </Controls>
