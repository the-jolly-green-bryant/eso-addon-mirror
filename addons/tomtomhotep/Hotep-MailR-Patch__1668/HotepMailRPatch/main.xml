<GuiXml>
  <Controls>
    <TopLevelControl name="HOTEPMRP_UI_main" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="true">
      <Dimensions x="1300" y="810" />
      <Anchor point="CENTER" />
      <Controls>
        
        <Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop" />
        
        <Label name="$(parent)_WindowTitle" font="ZoFontWindowTitle" text="|c3366ffHotep|r|t32:32:\HotepMailRPatch\R.dds|t |cff6633MailR Patch|r">
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" />
        </Label>
        
        <Texture name="$(parent)_TopDivider" textureFile="/esoui/art/miscellaneous/horizontaldivider.dds" tier="HIGH">
          <Dimensions x="1600" y="4"/>
          <Anchor point="TOP" relativeTo="$(parent)" offsetY="38" />
        </Texture>
        
        
        <Button name="$(parent)_Button_Close" inherits="ZO_ButtonBehaviorClickSound">
          <Dimensions x="40" y="40" />
          <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="15" />
          <Textures normal="EsoUI/Art/Buttons/closebutton_up.dds"
            pressed="EsoUI/Art/Buttons/closebutton_down.dds"
            mouseOver="EsoUI/Art/Buttons/closebutton_mouseover.dds"
            disabled="EsoUI/Art/Buttons/closebutton_disabled.dds"/>
          <OnClicked>
            HotepMRP.ToggleUIMain()
          </OnClicked>
        </Button>
        
        <Control name="$(parent)_Saved">
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="5" offsetY="50" />
          <Dimensions x="630" y="350" />
          
          <Controls>
            
            <Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop" />
            
            <Label name="$(parent)_Heading" font="ZoFontHeader2" text="Saved Mails" horizontalAlignment="center">
              <Anchor point="TOPLEFT" relativeTo="$(parent)" />
              <Dimensions x="630" y="32" />
            </Label>
            
            <Control name="$(parent)Headers">
              <Anchor point="TOP" relativeTo="$(parent)_Heading" relativePoint="BOTTOM" offsetX="0" offsetY="4"/>
              <Dimensions x="620" y="32" />
              <Controls>
                <Control name="$(parent)recipient" inherits="ZO_SortHeader">
                  <OnInitialized>
                    ZO_SortHeader_Initialize(self, "Sender", "recipient", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                  </OnInitialized>
                  <Anchor point="TOPLEFT" />
                  <Dimensions x="160" y="32" />
                </Control>
                <Control name="$(parent)sent" inherits="ZO_SortHeader">
                  <OnInitialized>
                    ZO_SortHeader_Initialize(self, "Time Sent", "timesent", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                  </OnInitialized>
                  <Anchor point="TOPLEFT" relativeTo="$(parent)recipient" relativePoint="TOPRIGHT"/>
                  <Dimensions x="120" y="32" />
                </Control>
                <Control name="$(parent)subject" inherits="ZO_SortHeader">
                  <OnInitialized>
                    ZO_SortHeader_Initialize(self, "Subject", "subject", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                  </OnInitialized>
                  <Anchor point="TOPLEFT" relativeTo="$(parent)sent" relativePoint="TOPRIGHT" />
                  <Dimensions x="340" y="32" />
                </Control>
              </Controls>
            </Control>
            
            <Control name="$(parent)List" inherits="ZO_ScrollList">
              <Anchor point="TOPLEFT" relativeTo="$(parent)Headers" relativePoint="BOTTOMLEFT" />
              <Dimensions x="620" y="280" />
            </Control>
            
          </Controls>
        </Control>
        
        
        <Control name="$(parent)_Sent">
          <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-5" offsetY="50" />
          <Dimensions x="630" y="350" />
          
          <Controls>
            
            <Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop" />
            
            <Label name="$(parent)_Heading" font="ZoFontHeader2" text="Sent Mails" horizontalAlignment="center">
              <Anchor point="TOPLEFT" relativeTo="$(parent)" />
              <Dimensions x="630" y="32" />
            </Label>
            
            <Control name="$(parent)Headers">
              <Anchor point="TOP" relativeTo="$(parent)_Heading" relativePoint="BOTTOM" offsetX="0" offsetY="4"/>
              <Dimensions x="620" y="32" />
              <Controls>
                <Control name="$(parent)recipient" inherits="ZO_SortHeader">
                  <OnInitialized>
                    ZO_SortHeader_Initialize(self, "Recipient", "recipient", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                  </OnInitialized>
                  <Anchor point="TOPLEFT" />
                  <Dimensions x="160" y="32" />
                </Control>
                <Control name="$(parent)sent" inherits="ZO_SortHeader">
                  <OnInitialized>
                    ZO_SortHeader_Initialize(self, "Time Sent", "timesent", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                  </OnInitialized>
                  <Anchor point="TOPLEFT" relativeTo="$(parent)recipient" relativePoint="TOPRIGHT"/>
                  <Dimensions x="120" y="32" />
                </Control>
                <Control name="$(parent)subject" inherits="ZO_SortHeader">
                  <OnInitialized>
                    ZO_SortHeader_Initialize(self, "Subject", "subject", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                  </OnInitialized>
                  <Anchor point="TOPLEFT" relativeTo="$(parent)sent" relativePoint="TOPRIGHT" />
                  <Dimensions x="340" y="32" />
                </Control>
              </Controls>
            </Control>
            
            <Control name="$(parent)List" inherits="ZO_ScrollList">
              <Anchor point="TOPLEFT" relativeTo="$(parent)Headers" relativePoint="BOTTOMLEFT" />
              <Dimensions x="620" y="280" />
            </Control>
            
          </Controls>
        </Control>
        
        <Control name="$(parent)_Mail" hidden="true">
          <Anchor point="TOPLEFT" relativeTo="$(parent)_Saved" relativePoint="BOTTOMLEFT" offsetY="20" />
          <Anchor point="TOPRIGHT" relativeTo="$(parent)_Sent" relativePoint="BOTTOMRIGHT" offsetY="20" />
          <Dimensions y="360" />
          
          <Controls>
            
            <Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop" />
            
            <!-- 
            <Control name="$(parent)_BodyContainer">
              <Dimensions x="1230" y="350" />
              <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" offsetY="5" />
              <Controls>
                <Backdrop name="$(parent)_BG" inherits="ZO_MultiLineEditBackdrop_Keyboard">
                  <AnchorFill />
                </Backdrop>
                <EditBox name="HOTEPMRP_Body" font="ZoFontWinH4" editEnabled="false" newLineEnabled="true" multiLine="true" maxInputCharacters="9999" inherits="ZO_DefaultEditMultiLineForBackdrop">
                  <Dimensions x="1225" y="345" />
                  <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" offsetX="2" offsetY="2" />
                </EditBox>
              </Controls>
            </Control>
            -->
            
            <Control name="HOTEPMRP_BodyContainer" inherits="ZO_ScrollContainer">
              <OnInitialized>
                ZO_Scroll_Initialize(self)
              </OnInitialized>
              <Dimensions x="1280" y="350" />
              <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="5" offsetY="5" />
            </Control>
            
            <Label name="HOTEPMRP_Body" font="ZoFontWinH4" linkEnabled="true">
              <Dimensions x="1260" y="1000" />
              <OnInitialized>
                self:SetParent(GetControl("HOTEPMRP_BodyContainerScrollChild"))
                self:SetAnchor(TOPLEFT, HOTEPMRP_BodyContainerScrollChild, TOPLEFT, 4, 4)
              </OnInitialized>
            </Label>
            
            <Label name="HOTEPMRP_Attach1" font="ZoFontWinH4" linkEnabled="true" mouseEnabled="true" hidden="true">
              <Dimensions x="1260" y="80" />
              <OnInitialized>
                self:SetParent(GetControl("HOTEPMRP_BodyContainerScrollChild"))
                self:SetAnchor(TOPLEFT, HOTEPMRP_Body, BOTTOMLEFT, 0, 2)
              </OnInitialized>
              
              <OnMouseEnter>
                  InitializeTooltip(ItemTooltip, self, BOTTOMLEFT, 0, 0)
                  ItemTooltip:SetLink(self.ITEMLINK)
              </OnMouseEnter>
              
              <OnMouseExit>
                  ClearTooltip(ItemTooltip)
              </OnMouseExit>
              
              <OnMouseUp>
                  if upInside then
                    ZO_LinkHandler_OnLinkClicked(self.ITEMLINK, button, self)
                  end
              </OnMouseUp>
            </Label>
            
            <Label name="HOTEPMRP_Attach2" font="ZoFontWinH4" linkEnabled="true" mouseEnabled="true" hidden="true">
              <Dimensions x="1260" y="80" />
              <OnInitialized>
                self:SetParent(GetControl("HOTEPMRP_BodyContainerScrollChild"))
