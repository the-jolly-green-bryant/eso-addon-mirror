<GuiXml>
	<Controls>
		<TopLevelControl name="STG_EventBoxTimerFrame" resizeToFitDescendents="true" mouseEnabled="true" movable="true" clampedToScreen="true">
			<OnMoveStop>
				STG_EventBoxTimer.OnMoveStop()
			</OnMoveStop>
			<OnMouseDoubleClick>
				STG_EventBoxTimer.StopAndHideTimer()
			</OnMouseDoubleClick>
			<OnMouseUp>
				if (button == MOUSE_BUTTON_INDEX_RIGHT and upInside) then
					STG_EventBoxTimer.PostMessage()
				end
			</OnMouseUp>
			<Controls>
				<Texture name="$(parent)Icon">
					<Anchor point="TOPLEFT" />
					<Dimensions x="28" y="28" />
				</Texture>
				<Label name="$(parent)Label" font="ZoFontWinH3" horizontalAlignment="LEFT" verticalAlignment="CENTER">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Icon" offsetX="4" />
					<Dimensions y="32" />
				</Label>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>
