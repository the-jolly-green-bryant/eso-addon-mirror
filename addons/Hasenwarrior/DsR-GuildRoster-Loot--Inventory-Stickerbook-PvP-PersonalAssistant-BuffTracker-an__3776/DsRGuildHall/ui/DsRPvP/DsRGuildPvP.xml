<GuiXml>
<!-- PvP Kill Animation -->
    <Animations>
        <AnimationTimeline name="DSR_KillingBlowScreenFrameAnimation">
            <Animations>
                <AlphaAnimation startAlpha="0.0" endAlpha="0.5" delay="200" duration="200">
                    <EasingFunction>
                        return ZO_EaseInQuadratic(progress)
                    </EasingFunction>
                </AlphaAnimation>
                <AlphaAnimation startAlpha="0.5" endAlpha="0.0" delay="400" duration="800">
                    <EasingFunction>
                        return ZO_EaseOutQuadratic(progress)
                    </EasingFunction>
                </AlphaAnimation>
            </Animations>
        </AnimationTimeline>
    </Animations>
    <Controls>
        <TopLevelControl name="DSR_KillingBlowScreenFrame" alpha="0" tier="HIGH">
            <AnchorFill/>
            <Controls>
                <Backdrop name="$(parent)Overlay" edgeColor="39EE31">
                    <AnchorFill/>
                    <Center file="EsoUI/Art/HUD/UITelvarOverlayCenter.dds" />
                    <Edge file="EsoUI/Art/HUD/UITelvarOverlayEdge.dds" edgeColor="000000" edgeFileWidth="2048" edgeFileHeight="256" />
                    <Insets left="256" top="256" right="-256" bottom="-256" />
                </Backdrop>
            </Controls>
        </TopLevelControl>
    </Controls>

<!-- PvP-ScoreWindows -->
    <Controls>
        <TopLevelControl name="DsRScoreWindow" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="true">
            <Anchor point="TOPRIGHT" relativeTo="GuiRoot" relativePoint="TOPRIGHT" offsetX="0" offsetY="0" />
            <Dimensions x="400" y="200" />
            <OnInitialized> DsRGuildPvPscore.ScoreWindow_OnInitialized() </OnInitialized>
            <OnMoveStop> DsRGuildPvPscore.ScoreWindow_OnMoveStop() </OnMoveStop>
            <ClampedToScreenInsets left="9" top="9" right="-18" bottom="-12" />
            <Controls>
                <Label name="$(parent)Background" width="400" font="ZoFontWinT1" inheritAlpha="true" color="FFFFFF"
                    wrapMode="TRUNCATE" verticalAlignment="LEFT" horizontalAlignment="LEFT" text="">
                    <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="0" offsetY="0" />
                </Label>
                <Label name="$(parent)BackgroundPercent" width="400" font="ZoFontWinT1" inheritAlpha="true" color="FFFFFF"
                    wrapMode="TRUNCATE" verticalAlignment="LEFT" horizontalAlignment="LEFT" text="">
