<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sir.insidi.at/or/schema/esoui.xsd">
  <Controls>
    <TopLevelControl name="DsRGuildRaidFrame" hidden="true">
      <Dimensions x="700" y="100" />
      <Anchor point="TOPRIGHT" relativeTo="ZO_GuildHome" relativePoint="TOPLEFT" offsetX="-20" offsetY="30" />
      <OnInitialized>
            DsRGuildRaid.Check()
      </OnInitialized>
      <Controls>
        <Control name="DsRGuildRaidInformations"> 
            <Controls>
                <Texture name="DsRGuildRaidBg" textureFile="/DsRGuildHall/misc/DsRInfoBG.dds" override="true">
                    <Anchor point="TOPRIGHT" relativeTo="ZO_GuildHome" relativePoint="TOPLEFT" offsetX="-20" offsetY="60" />
                    <Dimensions x="700" y="1100" />
                </Texture>
                <Texture name="DsRGuildRaidDivider" textureFile="/esoui/art/miscellaneous/horizontaldivider_mythic.dds"
                         verticalAlignment="LEFT" horizontalAlignment="LEFT" >
                    <Dimensions x="900" y="10" />
                    <Anchor point="TOPLEFT" relativeTo="DsRGuildRaidFrame" relativePoint="TOPLEFT" offsetX="-90" offsetY="250"/>
                </Texture>
                <Label name="DsRGuildRaidHeaderTXT" width="700" height="25" font="ZoFontWinH2" inheritAlpha="true"  color="9fb6cd"
                        wrapMode="TRUNCATE" verticalAlignment="LEFT" horizontalAlignment="CENTER"  text="Raid‘s & PvP" modifyTextType="UPPERCASE">
                        <Anchor point="BOTTOMLEFT" relativeTo="DsRGuildRaidDivider" relativePoint="LEFT" offsetX="230" offsetY="35"/>
                </Label>
                <Button name="DsRGuildRaidINVon" inherits="ZO_DefaultButton" font="ZoFontWinH4" inheritAlpha="true"
                        wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="CENTER"
                        text="Start Auto-INV">
                        <OnClicked>
                            DsRGuildRaid.OnClickedINVon(...)
                        </OnClicked>
                      <Anchor point="TOP" relativeTo="DsRGuildRaidHeaderTXT" relativePoint="TOP" offsetX="160" offsetY="5"/>
                      <Dimensions x="170" />
                  </Button>
                <Button name="DsRGuildRaidINVoff" inherits="ZO_DefaultButton" font="ZoFontWinH4" inheritAlpha="true"
                        wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="CENTER"
                        text="Stop Auto-INV">
                        <OnClicked>
                            DsRGuildRaid.OnClickedINVoff(...)
                        </OnClicked>
                      <Anchor point="TOP" relativeTo="DsRGuildRaidINVon" relativePoint="TOP" offsetX="170" offsetY="0"/>
                      <Dimensions x="170" />
                  </Button>
