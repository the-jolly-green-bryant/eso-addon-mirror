<GuiXml>
    <Controls>
        <Label name="DsRAI_SmallGroupListLabel" font="ZoFontGame" wrapMode="ELLIPSIS" virtual="true"/>
        <Control name="DsRAI_SmallGroupListRow" mouseEnabled="true" virtual="true">
            <Dimensions x="300" y="30"/>
            <OnMouseEnter>
                DsRAI_SmallGroupListing_OnMouseEnter(self)
            </OnMouseEnter>
            <OnMouseExit>
                DsRAI_SmallGroupListing_OnMouseExit(self)
            </OnMouseExit>
            <Controls>
                <Texture name="$(parent)BG" inherits="ZO_ThinListBgStrip" hidden="true">
                    <Dimensions x="260"/>
                </Texture>

                <Label name="$(parent)Status" inherits="DsRAI_SmallGroupListLabel">
                    <Anchor point="LEFT" offsetX="5"/>
                    <Dimensions x="60"/>
                </Label>
                <Label name="$(parent)DisplayName" inherits="DsRAI_SmallGroupListLabel">
                    <Anchor point="LEFT" relativeTo="$(parent)Status" relativePoint="RIGHT" offsetX="10"/>
                    <Dimensions x="200"/>
                </Label>
            </Controls>
        </Control>

        <TopLevelControl name="DsRAI_SmallGroupList" inherits="ZO_RightPanelFootPrint" hidden="true">
            <OnInitialized>
                DsRAI_SmallGroupListing_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Headers"> 
                    <Anchor point="TOPLEFT" relativeTo="ZO_GroupList" offsetX="0" offsetY="110"/>
                    <Anchor point="TOPRIGHT" relativeTo="ZO_GroupList" offsetY="110" offsetX="0"/>
                    <Dimensions y="32"/>
                    <Controls>
                        <Control name="$(parent)DisplayName" inherits="ZO_SortHeader">
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_GROUP_LIST_PANEL_NAME_HEADER),
                                "displayName", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                            </OnInitialized>
                            <Anchor point="TOP" offsetX="-110" offsetY="0"/>
                            <!-- <Anchor point="TOPLEFT" offsetX="59"/> -->
                            <Dimensions x="200" y="32"/>
                        </Control>
                    </Controls>
                </Control>

                <Control name="$(parent)List" inherits="ZO_ScrollList">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Headers" relativePoint="BOTTOMLEFT" offsetY="3"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMLEFT" offsetX="600" offsetY="-32"/>
                </Control>
            </Controls>
        </TopLevelControl>


    <TopLevelControl name="DsRAI_Encounter" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="false">
      <Dimensions x="250" y="50" />
      <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0"/>
      <OnMoveStop>
        DsRAutoINV.SaveLoc()
      </OnMoveStop>
      <Controls>
        <Label name="$(parent)Label" width="250" height="50" font="ZoFontWinH2" inheritAlpha="true" color="" wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="LEFT" text="">
          <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
        </Label>
      </Controls>
    </TopLevelControl>









    </Controls>
</GuiXml>
