<GuiXml>
	<Controls>
		<TopLevelControl name="CarrionBlockerDisplay" clampedToScreen="true" mouseEnabled="true" movable="true">
			<Dimensions x="500" y="50" />
				<Anchor offsetY="0" relativePoint="CENTER" relativeTo="GuiRoot" point="CENTER"/>
					<OnMoveStop>
						CarrionBlocker.savePosition()
					</OnMoveStop>
		<Controls>
			<Backdrop name="$(parent)Backdrop" inherits="ZO_DefaultBackdrop" />
				<Label name="$(parent)Label" fontName="ZoFontWinH1" font="$(BOLD_FONT)|$(KB_30)|soft-shadow-thick" inheritAlpha="true" verticalAlignment="CENTER" horizontalAlignment="CENTER">
					<AnchorFill/>
				</Label>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>