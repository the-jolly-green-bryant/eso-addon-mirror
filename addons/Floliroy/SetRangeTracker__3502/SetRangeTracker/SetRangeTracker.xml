<GuiXml>
	<Controls>

		<TopLevelControl name="SetRangeTrackerUI" mouseEnabled="true" movable="true">
            <Dimensions x="64" y="64" />
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0" />

            <OnMoveStop>
				SetRangeTracker.SaveLoc()
			</OnMoveStop>

            <Controls>
				<Texture name="$(parent)_Border" color="00FF00" alpha="1">
					<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" />
					<Dimensions x="64" y="64" />
				</Texture>
				<Texture name="$(parent)_Icon">
					<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER"/>
					<Dimensions x="54" y="54"/>
				</Texture>
				<Label name="$(parent)_Number" font="$(BOLD_FONT)|$(KB_32)|soft-shadow-thick" color="FFFFFF" wrapMode="ELLIPSIS" text="11">
					<Anchor relativeTo="$(parent)"  point="CENTER"  offsetY="10"/>
				</Label>
            </Controls>
        </TopLevelControl>

	</Controls>
</GuiXml>