<GuiXml>
	<Controls>
		<Control name="sidWarToolsObjectivesRow" virtual="true">
			<Dimensions x="200" y="23" />
			<Controls>
				<Label name="$(parent)Objective" inherits="ZO_SelectableLabel" font="ZoFontHeader">
					<Anchor point="TOPLEFT" />
					<OnMouseDown>
						sidWarToolsObjectives_OnMouseDown(self, button)
					</OnMouseDown>
					<OnMouseUp>
						sidWarToolsObjectives_OnMouseUp(self, button, upInside)
					</OnMouseUp>
				</Label>
			</Controls>
		</Control>
		<Control name="sidWarToolsObjectivesLabelRow" virtual="true">
			<Dimensions x="200" y="23" />
			<Controls>
				<Label name="$(parent)Text" font="ZoFontHeader2" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" modifyTextType="UPPERCASE" >
					<Anchor point="TOPLEFT" />
				</Label>
			</Controls>
		</Control>

		<TopLevelControl name="sidWarToolsObjectives" inherits="ZO_WorldMapInfoContent">
			<OnInitialized>
				sidWarToolsObjectives_OnInitialized(self)
			</OnInitialized>
			<Controls>
				<Control name="$(parent)List" inherits="ZO_ScrollList">
					<Anchor point="TOPLEFT" offsetX="20" />
					<Anchor point="BOTTOMRIGHT" />
				</Control>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>