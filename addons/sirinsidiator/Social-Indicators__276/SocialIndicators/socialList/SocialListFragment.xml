<GuiXml>
	<Controls>
		<Label name="SocialIndicatorsSocialListRowLabel" font="ZoFontGame" wrapMode="ELLIPSIS" virtual="true" />
		<Control name="SocialIndicatorsSocialListRow" mouseEnabled="true" virtual="true">
			<Dimensions y="30" />
			<OnMouseEnter>
				SocialIndicators.SocialListRow_OnMouseEnter(self)
			</OnMouseEnter>
			<OnMouseExit>
				SocialIndicators.SocialListRow_OnMouseExit(self)
			</OnMouseExit>
			<OnMouseUp>
				SocialIndicators.SocialListRow_OnMouseUp(self, button, upInside)
			</OnMouseUp>
			<Controls>
				<Texture name="$(parent)BG" inherits="ZO_ThinListBgStrip" />
				<Texture name="$(parent)Status" layer="OVERLAY" mouseEnabled="true">
					<Anchor point="LEFT" />
					<Dimensions x="32" y="32" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Texture>
				<Texture name="$(parent)Alliance" mouseEnabled="true" layer="OVERLAY">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Status" />
					<Dimensions x="32" y="32" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Texture>
				<Texture name="$(parent)Friend" mouseEnabled="true" layer="OVERLAY" textureFile="/EsoUI/Art/Notifications/notificationIcon_friend.dds">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Alliance" offsetX="1" />
					<Dimensions x="32" y="32" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Texture>
				<Texture name="$(parent)Guild" mouseEnabled="true" layer="OVERLAY" textureFile="/EsoUI/Art/Notifications/notificationIcon_guild.dds">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Friend" offsetX="1" />
					<Dimensions x="32" y="32" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Texture>
				<Texture name="$(parent)Group" mouseEnabled="true" layer="OVERLAY" textureFile="/EsoUI/Art/Notifications/notificationIcon_group.dds">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Guild" offsetX="1" />
					<Dimensions x="32" y="32" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Texture>
				<Label name="$(parent)DisplayName" inherits="ZO_FriendsListRowLabel" verticalAlignment="CENTER" mouseEnabled="true">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Group" offsetX="25" />
					<Dimensions x="225" y="30" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Label>
				<Label name="$(parent)CharacterName" inherits="ZO_FriendsListRowLabel" verticalAlignment="CENTER" mouseEnabled="true">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)DisplayName" offsetX="18" />
					<Dimensions x="225" y="30" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Label>
				<Texture name="$(parent)Class" mouseEnabled="true" layer="OVERLAY">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)CharacterName" offsetX="18" />
					<Dimensions x="32" y="32" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Texture>
				<Texture name="$(parent)Champion" mouseEnabled="true" layer="OVERLAY">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Class" offsetX="14" />
					<Dimensions x="32" y="32" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Texture>
				<Label name="$(parent)Level" inherits="ZO_FriendsListRowLabel" horizontalAlignment="CENTER">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Class" offsetX="14" />
					<Dimensions x="75" y="20" />
					<OnMouseEnter>
						SocialIndicators.SocialListRow_OnMouseEnter(self:GetParent())
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRow_OnMouseExit(self:GetParent())
					</OnMouseExit>
				</Label>
				<Button name="$(parent)Note">
					<Textures normal="EsoUI/Art/Contacts/social_note_up.dds" pressed="EsoUI/Art/Contacts/social_note_down.dds" mouseOver="EsoUI/Art/Contacts/social_note_over.dds" />
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Level" offsetX="18" />
					<Dimensions x="32" y="32" />
					<OnMouseEnter>
						SocialIndicators.SocialListRowNote_OnMouseEnter(self)
					</OnMouseEnter>
					<OnMouseExit>
						SocialIndicators.SocialListRowNote_OnMouseExit(self)
					</OnMouseExit>
					<OnClicked>
						SocialIndicators.SocialListRowNote_OnClicked(self)
					</OnClicked>
				</Button>
			</Controls>
		</Control>

		<TopLevelControl name="SocialIndicatorsSocialList" inherits="ZO_RightPanelFootPrint" hidden="true">
			<Controls>
				<Backdrop name="$(parent)Search" tier="HIGH" inherits="ZO_EditBackdrop">
					<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" offsetX="-38" offsetY="28" />
					<Dimensions x="270" />
					<Controls>
						<EditBox name="$(parent)Box" inherits="ZO_DefaultEditForBackdrop ZO_EditDefaultText">
							<OnInitialized>
								ZO_EditDefaultText_Initialize(self, GetString(SI_REQUEST_NAME_INSTRUCTIONS))
							</OnInitialized>
						</EditBox>
					</Controls>
				</Backdrop>

				<Label name="$(parent)SearchLabel" text="SI_FRIENDS_LIST_PANEL_SEARCH" font="ZoFontGameLargeBold" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
					<Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" relativeTo="$(parent)Search" offsetY="-2" />
				</Label>

				<Control name="$(parent)Headers">
					<Anchor point="TOPLEFT" offsetX="30" offsetY="67" />
					<Anchor point="TOPRIGHT" offsetY="67" />
					<Dimensions y="32" />
					<Controls>
						<Control name="$(parent)Status" inherits="ZO_SortHeaderIcon">
							<OnInitialized>
								ZO_SortHeader_InitializeArrowHeader(self, "status", ZO_SORT_ORDER_UP)
								ZO_SortHeader_SetTooltip(self, GetString(SI_FRIENDS_LIST_PANEL_TOOLTIP_STATUS))
							</OnInitialized>
							<Anchor point="TOPLEFT" offsetX="8" />
							<Dimensions x="16" y="32" />
						</Control>
						<Control name="$(parent)Alliance" inherits="ZO_SortHeaderIcon">
							<OnInitialized>
								ZO_SortHeader_InitializeArrowHeader(self, "alliance", ZO_SORT_ORDER_UP)
								ZO_SortHeader_SetTooltip(self, GetString(SI_FRIENDS_LIST_PANEL_TOOLTIP_ALLIANCE))
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Status" offsetX="17" />
							<Dimensions x="16" y="32" />
						</Control>
						<Control name="$(parent)Friend" inherits="ZO_SortHeaderIcon">
							<OnInitialized>
								ZO_SortHeader_InitializeArrowHeader(self, "friend", ZO_SORT_ORDER_UP)
								ZO_SortHeader_SetTooltip(self, GetString(SI_SOCIAL_MENU_CONTACTS))
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Alliance" offsetX="17" />
							<Dimensions x="16" y="32" />
						</Control>
						<Control name="$(parent)Guild" inherits="ZO_SortHeaderIcon">
							<OnInitialized>
								ZO_SortHeader_InitializeArrowHeader(self, "guild", ZO_SORT_ORDER_UP)
								ZO_SortHeader_SetTooltip(self, GetString(SI_SOCIAL_MENU_GUILDS))
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Friend" offsetX="17" />
							<Dimensions x="16" y="32" />
						</Control>
						<Control name="$(parent)Group" inherits="ZO_SortHeaderIcon">
							<OnInitialized>
								ZO_SortHeader_InitializeArrowHeader(self, "group", ZO_SORT_ORDER_UP)
								ZO_SortHeader_SetTooltip(self, GetString(SI_SOCIAL_MENU_GROUP))
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Guild" offsetX="17" />
							<Dimensions x="16" y="32" />
						</Control>
						<Control name="$(parent)DisplayName" inherits="ZO_SortHeader">
							<OnInitialized>
								ZO_SortHeader_Initialize(self, GetString(SI_SOCIAL_LIST_PANEL_HEADER_DISPLAY_NAME), "displayName", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Group" offsetX="32" />
							<Dimensions x="225" y="32" />
						</Control>
						<Control name="$(parent)CharacterName" inherits="ZO_SortHeader">
							<OnInitialized>
								ZO_SortHeader_Initialize(self, GetString(SI_GROUP_LIST_PANEL_NAME_HEADER), "characterName", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)DisplayName" offsetX="18" />
							<Dimensions x="225" y="32" />
						</Control>
						<Control name="$(parent)Class" inherits="ZO_SortHeaderIcon">
							<OnInitialized>
								ZO_SortHeader_InitializeArrowHeader(self, "class", ZO_SORT_ORDER_UP)
								ZO_SortHeader_SetTooltip(self, GetString(SI_FRIENDS_LIST_PANEL_TOOLTIP_CLASS))
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)CharacterName" offsetX="25" />
							<Dimensions x="16" y="32" />
						</Control>
						<Control name="$(parent)Level" inherits="ZO_SortHeaderIcon">
							<OnInitialized>
								ZO_SortHeader_InitializeArrowHeader(self, "level", ZO_SORT_ORDER_UP)
								ZO_SortHeader_SetTooltip(self, GetString(SI_FRIENDS_LIST_PANEL_TOOLTIP_LEVEL))
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Class" offsetX="50" />
							<Dimensions x="16" y="32" />
						</Control>
					</Controls>
				</Control>

				<Control name="$(parent)List" inherits="ZO_ScrollList">
					<Anchor point="TOPLEFT" relativeTo="$(parent)Headers" relativePoint="BOTTOMLEFT" offsetY="3" />
					<Anchor point="BOTTOMRIGHT" offsetX="-35" offsetY="-32" />
				</Control>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>