lang/en.lua
lang/$(language).lua
lang/setup.lua

TheLibrarium.lua
BookList.lua

library/keyboard/Library_keyboard.xml

library/gamepad/Library_Common_gamepad.lua
library/gamepad/Bookset_gamepad.lua
library/gamepad/Bookset_gamepad.xml
library/gamepad/Library_gamepad.lua
library/gamepad/Library_gamepad.xml

editor/LibDeflate.lua
editor/LibrariumEditor.lua
editor/LibrariumEditor.xml

