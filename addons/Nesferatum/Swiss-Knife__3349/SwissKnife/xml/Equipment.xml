<GuiXml>
    <Controls>
        <TopLevelControl name="SKInfoText" hidden="true" alpha="0.0">
            <Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="-60" />
                <Controls>
                    <Label name="$(parent)Label" font="ZoFontWinH2" color="FFFFFF"
                    wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="CENTER"
                    text="">
                        <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
                    </Label>
                </Controls>
        </TopLevelControl>
        <Button name="SK_Repair" clickSound="Click" hidden="true">
            <Anchor point="3" relativePoint="9" relativeTo="ActionButton8" offsetX="19" />
            <Dimensions x="50" y="50" />
            <OnInitialized>self:SetParent(ZO_ActionBar1)</OnInitialized>
            <Controls>
                <Backdrop name="$(parent)Bg" edgeColor="00000000">
                    <Center file="/EsoUI/Art/ActionBar/abilityInset.dds" />
                    <AnchorFill />
                    <Edge edgeSize="1" />
                </Backdrop>
                <Label name="$(parent)Cost" font="ZoFontGameSmall" color="FFFFFF"
                       horizontalAlignment="1" verticalAlignment="1"
                >
                    <Anchor point="4" relativePoint="1" relativeTo="$(parent)" offsetY="-5" />
                    <Dimensions x="50" y="12" />
                </Label>
                <Texture name="$(parent)Icon">
                    <Anchor point="128" />
                    <Dimensions x="46" y="46" />
                </Texture>
            </Controls>
        </Button>
        <Label name="SK_RepairValue" font="ZoFontGameSmall" color="FFFFFF" horizontalAlignment="1" verticalAlignment="1">
            <OnInitialized>self:SetParent(ZO_ActionBar1)</OnInitialized>
            <Anchor point="1" relativePoint="4" relativeTo="SK_Repair" offsetY="-1" />
            <Dimensions x="50" y="12" />
        </Label>
        <Button name="SK_ChargeLeftHand" clickSound="Click" hidden="true">
            <Anchor point="3" relativePoint="9" relativeTo="SK_Repair" offsetX="20" />
            <Dimensions x="50" y="50" />
            <OnInitialized>self:SetParent(ZO_ActionBar1)</OnInitialized>
            <Controls>
                <Backdrop name="$(parent)Bg" edgeColor="00000000">
                    <Center file="/EsoUI/Art/ActionBar/abilityInset.dds" />
                    <AnchorFill />
                    <Edge edgeSize="1" />
                </Backdrop>
                <Label name="$(parent)Cost" font="ZoFontGameSmall" color="FFFFFF" horizontalAlignment="1" verticalAlignment="1">
                    <Anchor point="4" relativePoint="1" relativeTo="$(parent)" offsetY="-5" />
                    <Dimensions x="50" y="12" />
                </Label>
                <Label name="$(parent)Value" font="ZoFontGameSmall" color="FFFFFF" horizontalAlignment="1" verticalAlignment="1">
                    <Anchor point="1" relativePoint="4" relativeTo="$(parent)" offsetY="-1" />
                    <Dimensions x="50" y="12" />
                </Label>
                <Texture name="$(parent)Icon" color="FFFFFF">
                    <Anchor point="128" />
                    <Dimensions x="40" y="40" />
                </Texture>
            </Controls>
        </Button>
        <Button name="SK_ChargeRightHand" clickSound="Click" hidden="true">
            <Anchor point="3" relativePoint="9" relativeTo="SK_ChargeLeftHand" offsetX="20" />
            <Dimensions x="50" y="50" />
            <OnInitialized>self:SetParent(ZO_ActionBar1)</OnInitialized>
            <Controls>
                <Backdrop name="$(parent)Bg" edgeColor="00000000">
                    <Center file="/EsoUI/Art/ActionBar/abilityInset.dds" />
                    <AnchorFill />
                    <Edge edgeSize="1" />
                </Backdrop>
                <Label name="$(parent)Cost" font="ZoFontGameSmall" color="FFFFFF" horizontalAlignment="1" verticalAlignment="1">
                    <Anchor point="4" relativePoint="1" relativeTo="$(parent)" offsetY="-5" />
                    <Dimensions x="50" y="12" />
                </Label>
                <Label name="$(parent)Value" font="ZoFontGameSmall" color="FFFFFF" horizontalAlignment="1" verticalAlignment="1">
                    <Anchor point="1" relativePoint="4" relativeTo="$(parent)" offsetY="-1" />
                    <Dimensions x="50" y="12" />
                </Label>
                <Texture name="$(parent)Icon" color="FFFFFF">
                    <Anchor point="128" />
                    <Dimensions x="40" y="40" />
                </Texture>
            </Controls>
        </Button>
    </Controls>
</GuiXml>