<GuiXml>
  <Controls>
    <Label name="ShissuChatFilterRowLabel" font="ZoFontGame" wrapMode="ELLIPSIS" virtual="true"/>

    <Control name="ShissuChatFilterRow" mouseEnabled="true" virtual="true">
      <Dimensions x="400" y="30"/>
      <Controls>
        <Label name="$(parent)Name" inherits="ShissuChatFilterRowLabel" hidden="false" wrapMode ="ELLIPSIS" horizontalAlignment="LEFT" verticalAlignment="CENTER" font="$(MEDIUM_FONT)|$(KB_14)|soft-shadow-thin" mouseEnabled="true">
          <Anchor point="LEFT" relativeTo="$(parent)"/>    
          <Dimensions x="100" y="30"/>
          <OnMouseUp>
            ShissuChatFilterRowName_OnMouseUp(self, button, upInside)
          </OnMouseUp>         
          
          <OnMouseEnter>
           ShissuChatFilterRowEnter(self)
          </OnMouseEnter>       
          <OnMouseExit>
            ShissuChatFilterRowExit(self)
          </OnMouseExit> 
        </Label> 

        <Label name="$(parent)Text" inherits="ShissuChatFilterRowLabel" hidden="false" wrapMode ="ELLIPSIS" horizontalAlignment="LEFT" verticalAlignment="CENTER" font="$(MEDIUM_FONT)|$(KB_14)|soft-shadow-thin" mouseEnabled="true">
          <Anchor point="LEFT" relativeTo="$(parent)Name"  offsetX="110"/>   
          <Dimensions x="350" y="30"/>
          <OnMouseUp>
            ShissuChatFilterRowName_OnMouseUp(self, button, upInside)
          </OnMouseUp>         
          <OnMouseEnter>
           ShissuChatFilterRowEnter(self)
          </OnMouseEnter>       
          <OnMouseExit>
            ShissuChatFilterRowExit(self)
          </OnMouseExit> 
        </Label> 
      </Controls>
    </Control>    
          
    <TopLevelControl name="ShissuChatFilter" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="true">
      <Dimensions x="500" y="300" />
      <Anchor point="CENTER" offsetX="100" offsetY="100" />      

      <Controls>
  		  <Label name="$(parent)_Version" font="$(ANTIQUE_FONT)|12" wrapMode="ELLIPSIS" verticalAlignment="RIGHT" text="Shissu's Guild Tools">
  			  <Anchor point="BOTTOM" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="-104" offsetY="-0" />
  		  </Label>

        <Backdrop name="$(parent)_Filter" inherits="ZO_EditBackdrop">
          <Anchor point="BOTTOM" relativeTo="$(parent)" relativePoint="BOTTOMLEFT" offsetX="120" offsetY="-5" /> 
          <Dimensions x="250" y="30" />
  			  <Controls>
            <EditBox name="$(parent)Text" inherits="ZO_DefaultEditForBackdrop"></EditBox>
  			  </Controls>
  		  </Backdrop>  

        <Control name="$(parent)Headers" hidden="true">
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="30"/>
          <Anchor point="TOPRIGHT" offsetY="10"/>      
          <Dimensions y="32"/>
          
          <Controls>
            <Control name="$(parent)Name" inherits="ZO_SortHeader">
              <Anchor point="TOPLEFT" offsetX="8"/>
              <Dimensions x="100" y="30" /> 
              <OnInitialized>
                ZO_SortHeader_Initialize(self, "Name", "name", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
              </OnInitialized>              
            </Control>         

            <Control name="$(parent)Text" inherits="ZO_SortHeader">
              <Anchor point="TOPLEFT" relativeTo="$(parent)Name" relativePoint="TOPLEFT" offsetX="110"/>
              <Dimensions x="100" y="30" /> 
              <OnInitialized>
                ZO_SortHeader_Initialize(self, "Text", "text", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
              </OnInitialized>              
            </Control>     
          </Controls> 
        </Control>
                            
        <Control name="$(parent)List" inherits="ZO_ScrollList"> 
          <Anchor point="TOPLEFT" relativeTo="$(parent)Headers" relativePoint="BOTTOMLEFT" offsetX="10"/>
          <Anchor point="BOTTOMRIGHT" offsetX="-20" offsetY="-40"/>
        </Control>                                             
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>