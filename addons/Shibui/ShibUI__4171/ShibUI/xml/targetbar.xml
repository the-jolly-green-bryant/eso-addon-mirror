                <Control name="$(parent)BgContainer" inherits="ZO_PlayerAttributeBgContainer">
                    <Dimensions x="281"/>
                    <Anchor point="CENTER" />
                    <Controls>
                        <Texture name="$(parent)BgLeft" hidden="true"/>
