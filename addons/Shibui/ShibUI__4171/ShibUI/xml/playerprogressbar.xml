<GuiXml>
    <Controls>
        <StatusBar name="SUI_PlayerProgressBarTemplate" inherits="ZO_ArrowStatusBar" mouseEnabled="true" virtual="true">
            <OnMouseEnter>
                ZO_PlayerProgressBar_OnMouseEnter(self)
            </OnMouseEnter>
            <OnMouseExit>
                ZO_PlayerProgressBar_OnMouseExit(self)
            </OnMouseExit>
            <Controls>
                <StatusBar name="$(parent)Gloss" level="550" override="true" />
                    
                <Control name="$(parent)GlowContainer" inherits="ZO_PlayerAttributeWarner">
                    <Controls>
                        <Texture name="$(parent)Left" inherits="ZO_PlayerAttributeWarnerLeft" textureFile="EsoUI/Art/Progression/progressBar_genericGlow.dds"/>
                        <Texture name="$(parent)Right" inherits="ZO_PlayerAttributeWarnerRightArrow" textureFile="EsoUI/Art/Progression/progressBar_genericGlow.dds"/>
                        <Texture name="$(parent)Center" inherits="ZO_PlayerAttributeWarnerCenter" textureFile="EsoUI/Art/Progression/progressBar_genericGlow.dds"/>
                    </Controls>
                </Control>
                
                <!-- Override BG with hidden textures -->
                <Control name="$(parent)BG" inherits="ZO_ArrowStatusBarBG" tier="LOW">
                    <Controls>
                        <Texture name="$(parent)Left" override="true" hidden="true" />
                        <Texture name="$(parent)Right" override="true" hidden="true" />
                        <Texture name="$(parent)Middle" override="true" hidden="true" />
                    </Controls>
                </Control>
                
                <!-- Override Overlay with hidden textures -->
                <Control name="$(parent)Overlay" inherits="ZO_ArrowStatusBarOverlay">
                    <Controls>
                        <Texture name="$(parent)Left" override="true" hidden="true" />
                        <Texture name="$(parent)Right" override="true" hidden="true" />
                        <Texture name="$(parent)Middle" override="true" hidden="true" />
                    </Controls>
                </Control>

                <!-- Enlightened Bar -->
                <StatusBar name="$(parent)EnlightenedBar" alpha="0.3" textureFile="/esoui/art/unitattributevisualizer/attributebar_dynamic_fill.dds" level="1">
                <Dimensions x="512" y="16" />
                    <TextureCoords left="0" right="1" top="0" bottom="0.625" />
                    <LeadingEdgeTextureCoords left="0" right="1" top="0" bottom="0.625" />
                    <LeadingEdge textureFile="/esoui/art/unitattributevisualizer/attributebar_dynamic_leadingedge.dds" width="8" height="16" />
                    <Anchor point="TOPLEFT" />
                    <Anchor point="BOTTOMRIGHT" offsetY="2"/>
                </StatusBar>

            </Controls>
        </StatusBar>
    </Controls>
</GuiXml>
