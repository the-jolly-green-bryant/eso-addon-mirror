<GuiXml>
    <Controls>
        <TopLevelControl name="YudosPowerStatsControl" mouseEnabled="true" movable="true" clampedToScreen="true">
            <Dimensions x="88" y="80" />
            <Anchor point="CENTER" />
            <Controls>
                <Backdrop name="$(parent)BG" edgeColor="000000" centerColor="000000" alpha="0.5">
                    <AnchorFill />
                    <Edge edgeSize="2" />
                </Backdrop>
                <Label name="$(parent)Tags" font="ZoFontGameLargeBold" color="C5C29E" text="" horizontalAlignment="LEFT" verticalAlignment="TOP">
                    <Dimensions x="28" />
                    <Anchor point="TOPLEFT" offsetX="8" offsetY="5" /> 
                </Label>
                <Label name="$(parent)Values" font="ZoFontGameLargeBold" color="FFFFFF" text="" horizontalAlignment="LEFT" verticalAlignment="TOP">
                    <Dimensions x="50" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Tags" relativePoint="TOPRIGHT" offsetX="2" />
                </Label>
                <Control name="$(parent)ResizeHandle" mouseEnabled="true" hidden="false">
                    <Dimensions x="20" y="20" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" />
                </Control>
            </Controls>
        </TopLevelControl>

        <TopLevelControl name="YudosDefenseStatsControl" mouseEnabled="true" movable="true" clampedToScreen="true">
            <Dimensions x="88" y="80" />
            <Anchor point="CENTER" offsetX="100" />
            <Controls>
                <Backdrop name="$(parent)BG" edgeColor="000000" centerColor="000000" alpha="0.5">
                    <AnchorFill />
                    <Edge edgeSize="2" />
                </Backdrop>
                <Label name="$(parent)Tags" font="ZoFontGameLargeBold" color="C5C29E" text="" horizontalAlignment="LEFT" verticalAlignment="TOP">
                    <Dimensions x="28" />
                    <Anchor point="TOPLEFT" offsetX="8" offsetY="5" /> 
                </Label>
                <Label name="$(parent)Values" font="ZoFontGameLargeBold" color="FFFFFF" text="" horizontalAlignment="LEFT" verticalAlignment="TOP">
                    <Dimensions x="50" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Tags" relativePoint="TOPRIGHT" offsetX="2" />
                </Label>
                <Control name="$(parent)ResizeHandle" mouseEnabled="true" hidden="false">
                    <Dimensions x="20" y="20" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" />
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>