<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="Death Report">
            <Action name="DEATH_REPORT_PRINT_TOTAL" >
                <Down>DeathReport.PrintRace()</Down>
            </Action>
			<Action name="DEATH_REPORT_PRINT_INTERIM" >
                <Down>DeathReport.PrintLap()</Down>
            </Action>
            <Action name="DEATH_REPORT_PRINT_TOTAL_HISTORY" >
                <Down>DeathReport.PrintRace("list")</Down>
            </Action>
			<Action name="DEATH_REPORT_PRINT_INTERIM_HISTORY" >
                <Down>DeathReport.PrintLap("list")</Down>
            </Action>
			<Action name="DEATH_REPORT_RESET_TOTAL" >
                <Down>DeathReport.ResetRace()</Down>
            </Action>
			<Action name="DEATH_REPORT_RESET_INTERIM" >
                <Down>DeathReport.ResetLap()</Down>
            </Action>
        </Category>
    </Layer>
</Bindings>
