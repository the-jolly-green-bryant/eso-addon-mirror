<GuiXml>
	<Controls>
		<Label name="AllianceTierViewRowLabel" font="ZoFontWinH4" wrapMode="ELLIPSIS" virtual="true"/>
		<Label name="AllianceTierViewHeaderLabel" font="ZoFontWinH4" modifyTextType="UPPERCASE" wrapMode="ELLIPSIS" virtual="true"/>		
		<Control name="AllianceTierViewRow" virtual="true">
			<Dimensions x="610" y="30"/>
			<Controls>						
				<Backdrop name="$(parent)SelectBox" centerColor="001100" edgeColor="009300" alpha="0.6">
					<AnchorFill/>
					<Edge edgeSize="2"/>
				</Backdrop>
				<Label name="$(parent)CharName" inherits="AllianceTierViewRowLabel" font="ZoFontWinT1" mouseEnabled="true">
					<Anchor point="LEFT"/>
					<Dimensions x="220"/>
				</Label>
				<Label name="$(parent)TierInfo" inherits="AllianceTierViewRowLabel" horizontalAlignment="CENTER">
					<Anchor point="LEFT" relativeTo="$(parent)CharName" relativePoint="RIGHT"/>
					<Dimensions x="130"/>
				</Label>
				<Label name="$(parent)CampaignName" inherits="AllianceTierViewRowLabel" horizontalAlignment="CENTER">
					<Anchor point="LEFT" relativeTo="$(parent)TierInfo" relativePoint="RIGHT"/>
					<Dimensions x="120"/>
				</Label>
				<Label name="$(parent)TimeRemaining" inherits="AllianceTierViewRowLabel" horizontalAlignment="CENTER">
					<Anchor point="LEFT" relativeTo="$(parent)CampaignName" relativePoint="RIGHT"/>
					<Dimensions x="140"/>
				</Label>
			</Controls>
		</Control>
		<TopLevelControl name="CampaignTierView" inherits="ZO_CampaignOverviewSubwindow" hidden="true">
			<OnInitialized>
				AllianceTierView_Keyboard_OnInitialize(self)
			</OnInitialized>
			<Controls>
				<Control name="$(parent)Headers">
					<Anchor point="TOPLEFT" offsetY="0"/>
					<Dimensions y="32"/>
					<Controls>
						<Label name="$(parent)CharName" inherits="AllianceTierViewHeaderLabel" text="Character">
							<Anchor point="LEFT"/>
							<Dimensions x="220"/>
						</Label>
						<Label name="$(parent)TierInfo" inherits="AllianceTierViewHeaderLabel" horizontalAlignment="CENTER" text="Alliance Tier">
							<Anchor point="LEFT" relativeTo="$(parent)CharName" relativePoint="RIGHT"/>
							<Dimensions x="120"/>
						</Label>
						<Label name="$(parent)CampaignName" inherits="AllianceTierViewHeaderLabel" horizontalAlignment="CENTER" text="Campaign">
							<Anchor point="LEFT" relativeTo="$(parent)TierInfo" relativePoint="RIGHT"/>
							<Dimensions x="115"/>
						</Label>
						<Label name="$(parent)TimeRemaining" inherits="AllianceTierViewHeaderLabel" horizontalAlignment="CENTER" text="Time Remaining">
							<Anchor point="LEFT" relativeTo="$(parent)CampaignName" relativePoint="RIGHT"/>
							<Dimensions x="140"/>
						</Label>
					</Controls>
				</Control>
				<Backdrop name="$(parent)Panel" tier="1" centerColor="00000000" edgeColor="00000000" inherits="ZO_ScrollContainerBase">
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$(parent)Headers" offsetX="0" offsetY="0"/>
					<Anchor point="BOTTOMRIGHT" offsetX="-9"/>
					<Edge edgeSize="0"/>
					<OnInitialized>ZO_Scroll_Initialize(self)</OnInitialized>
					<Controls>
						<Control name="$(parent)ScrollChild" resizeToFitDescendents="true">
							<OnInitialized>self:SetParent(self:GetParent():GetNamedChild("Scroll"));self:SetAnchor(3,nil,3,0,0)</OnInitialized>
							<Controls>
								<Control name="$(parent)Rankings" hidden="false">
									<Anchor point="3" relativePoint="3" relativeTo="$(parent)"/>
								</Control>
							</Controls>
						</Control>
					</Controls>						
				</Backdrop>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>