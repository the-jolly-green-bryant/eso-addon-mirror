<GuiXml>
    <Controls>		
		<TopLevelControl name="BSCASUIAlert" resizeToFitDescendents="true" clampedToScreen="true" movable="true" mouseEnabled="true" hidden="true">	
			<OnMoveStop> BSCASynergy:AlertOnMoveStop()	</OnMoveStop>		
			<Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="-165" />		
			<Controls>
				<Backdrop name="$(parent)Frame" centerColor="66000000" edgeColor="66000000">
					<Anchor point="TOPLEFT" />
					<Dimensions x="420" y="36" />
					<Edge edgeSize="1" />
				</Backdrop>
				<Label name="$(parent)LAlert" font="$(BOLD_FONT)|$(KB_28)|soft-shadow-thick" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Drop Blop Behind!">
					<Anchor point="LEFT" relativePoint="LEFT" relativeTo="$(parent)Frame" />
					<Dimensions x="420" y="36" />
				</Label>
			</Controls>
		</TopLevelControl>		
        <TopLevelControl name="BSCAS_ConfirmationDialog" inherits="ZO_CustomDialogBase" >
            <Controls>
                <Label name="$(parent)Text" inherits="ZO_DialogContentAnchors" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" font="ZoFontGame"/>				
                <Texture name="$(parent)Skill" textureFile="esoui/art/icons/ability_sorcerer_065.dds">
                    <Dimensions x="56" y="56"/>
                    <Anchor point="TOP" relativeTo="$(parent)Text" relativePoint="BOTTOM" offsetY="16" />
				</Texture>			
				<Label name="$(parent)Text2" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" font="ZoFontGame">
					<Anchor point="TOP" relativeTo="$(parent)Skill" relativePoint="BOTTOM" offsetY="16" />
				</Label>
				<Control name="$(parent)Cancel" inherits="ZO_CustomDialogButton"/>
                <Control name="$(parent)Confirm" inherits="ZO_CustomDialogButton"/>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>