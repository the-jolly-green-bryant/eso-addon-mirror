<GuiXml>
	<Controls>
		<TopLevelControl name="BSCGUardHelperUI" resizeToFitDescendents="true" clampedToScreen="true" movable="true" mouseEnabled="true" hidden="true">			
			<Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="-250" />
			<OnMoveStop> BSCGUardHelper:OnMoveStop() </OnMoveStop>
            <OnUpdate> BSCGUardHelper:onRootFrameUpdate() </OnUpdate>
			<Controls>
				<Backdrop name="$(parent)FrameBack" centerColor="44000000" edgeColor="FF000000">
					<Anchor point="CENTER" />
					<Dimensions x="60" y="60" />
					<Edge edgeSize="3" />
				</Backdrop>
				<Backdrop name="$(parent)FrameBackIcon" centerColor="66000000" edgeColor="FF000000">
					<Anchor relativePoint="CENTER" relativeTo="$(parent)FrameBack" point="CENTER"/>
					<Dimensions x="45" y="45" />
					<Edge edgeSize="3" />
				</Backdrop>
				<Texture name="$(parent)Icon" textureFile="esoui/art/icons/ability_ava_guard.dds">
					<Anchor relativePoint="CENTER" relativeTo="$(parent)FrameBackIcon" point="CENTER"/>
					<Dimensions y="40" x="40"/>
				</Texture>
				<Label name="$(parent)Guarding" font="$(BOLD_FONT)|$(KB_24)|soft-shadow-thick" horizontalAlignment="LEFT" verticalAlignment="CENTER">
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)FrameBack" offsetX="4" />
					<Dimensions x="250" y="30" />
				</Label>	
				<Label name="$(parent)Range" font="$(BOLD_FONT)|$(KB_24)|soft-shadow-thick" horizontalAlignment="LEFT" verticalAlignment="CENTER">
					<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" relativeTo="$(parent)FrameBack" offsetX="4" />
					<Dimensions x="150" y="30" />
				</Label>			
			</Controls>
		</TopLevelControl>	
	</Controls>
</GuiXml>