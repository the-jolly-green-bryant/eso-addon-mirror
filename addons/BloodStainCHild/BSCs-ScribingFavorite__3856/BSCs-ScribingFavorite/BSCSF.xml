<GuiXml>
    <Controls>
        <TopLevelControl name="BSC_InitialScribeAddFavoriteConfirmationDialog" inherits="ZO_CustomDialogBase" >
            <Controls>
                <Label name="$(parent)Text" inherits="ZO_DialogContentAnchors" font="ZoFontWinH1" verticalAlignment="CENTER" horizontalAlignment="CENTER" />

                <Texture name="$(parent)ScribedSkill" >
                    <Dimensions x="56" y="56"/>
                    <Anchor point="TOP" relativeTo="$(parent)Text" relativePoint="BOTTOM" offsetY="16" />
                </Texture>				
				
				<Label name="$(parent)SkillDesc" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" font="ZoFontGame" >
					<Dimensions x="500" />
					<Anchor point="TOP" relativeTo="$(parent)ScribedSkill" relativePoint="BOTTOM" offsetY="5" />
				</Label>
								
				<Label name="$(parent)NameLabel" font="ZoFontGame" text="Custom Info:" color="FFFFFF">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)SkillDesc" relativePoint="BOTTOMLEFT" offsetY="16"/>
                </Label>
                <EditBox name="$(parent)NameInput" font="ZoFontGame" inherits="ZO_DefaultEdit" maxInputCharacters="55" >
                    <Anchor point="TOPLEFT" relativeTo="$(parent)NameLabel" relativePoint="TOPRIGHT" offsetX="10"/>
                    <Dimensions x="395" y="20"/>
					<Controls>
						<Backdrop name="$(parent)BG" inherits="ZO_EditBackdrop">
							<Dimensions x="395" y="20"/>
							<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
						</Backdrop>
					</Controls>
                </EditBox>
				
                <Control name="$(parent)Cancel" inherits="ZO_CustomDialogButton"/>
                <Control name="$(parent)Confirm" inherits="ZO_CustomDialogButton"/>
            </Controls>
        </TopLevelControl>
		
        <TopLevelControl name="BSC_InitialScribeRemoveFavoriteConfirmationDialog" inherits="ZO_CustomDialogBase" >
            <Controls>
                <Label name="$(parent)Text" inherits="ZO_DialogContentAnchors" font="ZoFontWinH1" verticalAlignment="CENTER" horizontalAlignment="CENTER" />

                <Texture name="$(parent)ScribedSkill" >
                    <Dimensions x="56" y="56"/>
                    <Anchor point="TOP" relativeTo="$(parent)Text" relativePoint="BOTTOM" offsetY="16" />
                </Texture>				
				
				<Label name="$(parent)SkillDesc" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" font="ZoFontGame" >
					<Dimensions x="500" />
					<Anchor point="TOP" relativeTo="$(parent)ScribedSkill" relativePoint="BOTTOM" offsetY="5" />
				</Label>		
				

                <Control name="$(parent)Cancel" inherits="ZO_CustomDialogButton"/>
                <Control name="$(parent)Confirm" inherits="ZO_CustomDialogButton"/>
            </Controls>
        </TopLevelControl>
		
        <Control name="BSC_Scribing_RecentCraftedAbilityRow_Keyboard" inherits="ZO_ListEntry_BackdropAndHighlight_Template" mouseEnabled="true" virtual="true">
            <Dimensions x="509" y="ZO_SCRIBING_RECENT_CRAFTED_ABILITY_ENTRY_HEIGHT_KEYBOARD" />

            <OnMouseEnter>
                ZO_Scribing_Keyboard.OnMouseEnterRecentCraftedAbility(...)
            </OnMouseEnter>

            <OnMouseExit>
                ZO_Scribing_Keyboard.OnMouseExitRecentCraftedAbility(...)
            </OnMouseExit>

            <OnMouseUp>
                BSCScribingFavorite.OnMouseClickRecentCraftedAbility(...)
            </OnMouseUp>

            <Controls>
                <Texture name="$(parent)Icon">
                    <Dimensions x="40" y="40" />
                    <Anchor point="CENTER" relativePoint="TOPLEFT" offsetX="70" offsetY="26" />
                </Texture>

                <Label name="$(parent)Name" font="ZoFontGameShadow" maxLineCount="2" wrapMode="ELLIPSIS">
                    <Dimensions x="270" />
                    <Anchor point="LEFT" offsetX="110" />
                </Label>
            </Controls>
        </Control>
		
		<TopLevelControl name="BSCScribingFavoriteUI"  hidden="true">
            <Controls>
				<Control name="$(parent)Favorite" hidden="true">
					<Dimensions x="565" />
					<Anchor point="TOPLEFT" relativeTo="ZO_SharedRightPanelBackground" offsetY="45" />
					<Anchor point="BOTTOMLEFT" relativeTo="ZO_SharedRightPanelBackground" offsetY="-30" />

					<Controls>
						<Control name="$(parent)FilterDivider" inherits="ZO_DynamicHorizontalDivider" hidden="true">
							<Dimensions x="0" y="0"/>
							<Anchor point="TOP" relativeTo="ZO_SharedRightPanelBackground" offsetX="-22" offsetY="DEFAULT_INVENTORY_FILTER_DIVIDER_TOP_OFFSET_Y" />
						</Control>
						
						<Control name="$(parent)ScribedAbilities" inherits="ZO_ScrollList">
							<Dimensions x="100%" />
							<Anchor point="TOPRIGHT" relativeTo="$(parent)FilterDivider" relativePoint="BOTTOMRIGHT" offsetY="2" />
							<Anchor point="BOTTOMRIGHT" />
						</Control>
					</Controls>
				</Control>
			</Controls>
        </TopLevelControl>
	</Controls>
</GuiXml>