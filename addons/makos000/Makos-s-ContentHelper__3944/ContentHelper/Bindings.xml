<Bindings>
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="|c8080FFMakos's ContentHelper|r">
			<Action name="MH_PLACE_MARKER">
				<Down>ContentHelper.SendMarker()</Down>
			</Action>
			<Action name="MH_PLACE_MARKER_SELF">
				<Down>ContentHelper.SendMarkerSelf()</Down>
			</Action>
			<Action name="MH_PLACE_MARKER_CLEAR_ALL">
				<Down>ContentHelper.SendClearAll()</Down>
			</Action>
			<Action name="MH_PLACE_MARKER_CLEAR_LAST">
				<Down>ContentHelper.SendClearLast()</Down>
			</Action>
			<Action name="MH_RW_ONE">
				<Down>ContentHelper.SendRW(ContentHelper.savedVariables.RW1 or "")</Down>
			</Action>
			<Action name="MH_RW_TWO">
				<Down>ContentHelper.SendRW(ContentHelper.savedVariables.RW2 or "")</Down>
			</Action>
			<Action name="MH_RW_THREE">
				<Down>ContentHelper.SendRW(ContentHelper.savedVariables.RW3 or "")</Down>
			</Action>
			<Action name="MH_CD_THREE">
				<Down>ContentHelper.SendCD(3)</Down>
			</Action>
			<Action name="MH_CD_FIVE">
				<Down>ContentHelper.SendCD(5)</Down>
			</Action>
			<Action name="MH_CD_TEN">
				<Down>ContentHelper.SendCD(10)</Down>
			</Action>
			<Action name="MH_CD_ONEFIVE">
				<Down>ContentHelper.SendCD(15)</Down>
			</Action>
		</Category>
	</Layer>
</Bindings>