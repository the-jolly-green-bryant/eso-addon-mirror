<GuiXml>
    <Controls>
        <TopLevelControl name="EASAlternateMorphTooltipTopLevel" inherits="TooltipTopLevel" hidden="true">
            <Controls>
                <Tooltip name="EASAlternateMorphTooltip" inherits="ZO_BaseTooltip">
                    <ResizeToFitPadding width="32" height="40"/>
                    <DimensionConstraints minX="384" maxX="384"/>
                    <OnInitialized>
                        ZO_SkillTooltip_Initialize(self)
                    </OnInitialized>
                    <OnCleared>
                        ZO_SkillTooltip_Cleared(self)
                    </OnCleared>
                    <OnAddGameData>
                        ZO_SkillTooltip_OnAddGameData(...)
                    </OnAddGameData>
                    <Controls>
                        <StatusBar name="$(parent)Progression" inherits="SkillTooltipProgressionBar" hidden="true"/>
                    </Controls>
                </Tooltip>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
