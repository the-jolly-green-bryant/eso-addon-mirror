<Bindings>
 <Layer name="PBsTetrisInput" allowFallthrough="false">
  <Category name="PBsTetris">
   <Action name="PBSTETRIS_LEFT" inheritsBindFrom="UI_SHORTCUT_INPUT_LEFT" hideAction="true" rebindable="false"><Down>PBT.App:Input("left",true)</Down><Up>PBT.App:Input("left",false)</Up></Action>
   <Action name="PBSTETRIS_RIGHT" inheritsBindFrom="UI_SHORTCUT_INPUT_RIGHT" hideAction="true" rebindable="false"><Down>PBT.App:Input("right",true)</Down><Up>PBT.App:Input("right",false)</Up></Action>
   <Action name="PBSTETRIS_DOWN" inheritsBindFrom="UI_SHORTCUT_INPUT_DOWN" hideAction="true" rebindable="false"><Down>PBT.App:Input("down",true)</Down><Up>PBT.App:Input("down",false)</Up></Action>
   <Action name="PBSTETRIS_UP" inheritsBindFrom="UI_SHORTCUT_INPUT_UP" hideAction="true" rebindable="false"><Down>PBT.App:Input("up",true)</Down><Up>PBT.App:Input("up",false)</Up></Action>
  <AllowAction name="UI_SHORTCUT_PRIMARY" />
  <AllowAction name="UI_SHORTCUT_SECONDARY" />
  <AllowAction name="UI_SHORTCUT_TERTIARY" />
  <AllowAction name="UI_SHORTCUT_NEGATIVE" />
  <AllowAction name="UI_SHORTCUT_LEFT_SHOULDER" />
  <AllowAction name="UI_SHORTCUT_RIGHT_SHOULDER" />
  </Category>
 </Layer>
</Bindings>
