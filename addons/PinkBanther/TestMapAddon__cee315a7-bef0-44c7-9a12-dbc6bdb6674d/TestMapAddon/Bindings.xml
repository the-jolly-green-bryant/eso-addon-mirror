<Bindings>
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="SI_KEYBINDINGS_CATEGORY_TESTMAPADDON">
			<Action name="TESTMAPADDON_TOGGLE_MAP_SHOW">
				<Down>TESTMAPADDON:ToggleShowMap()</Down>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_SHOW_HUD">
				<Down>TESTMAPADDON:ToggleShowHUD()</Down>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_SHOW_COMBAT">
				<Down>TESTMAPADDON:ToggleShowCombat()</Down>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_ZOOM_OUT">
				<Down>TESTMAPADDON:ToogleZoom(true, TESTMAPADDON.account.zoomOut)</Down>
				<Up>TESTMAPADDON:ToogleZoom(false)</Up>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_ZOOM_IN">
				<Down>TESTMAPADDON:ToogleZoom(true, TESTMAPADDON.account.zoomIn)</Down>
				<Up>TESTMAPADDON:ToogleZoom(false)</Up>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_ZOOM_PLUS">
				<Down>TESTMAPADDON:StepZoom(true)</Down>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_ZOOM_MINUS">
				<Down>TESTMAPADDON:StepZoom(false)</Down>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_OFFSET_FIX">
				<Down>TESTMAPADDON:ToggleFixedOffset()</Down>
			</Action>
		</Category>
	</Layer>
	<Layer name="SI_KEYBINDINGS_LAYER_SIEGE" allowFallthrough="false">
		<Category name="SI_KEYBINDINGS_CATEGORY_TESTMAPADDON">
			<Action name="TESTMAPADDON_TOGGLE_MAP_SHOW_SIEGE_HUD">
				<Down>TESTMAPADDON:ToggleShowSiege()</Down>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_ZOOM_OUT_SIEGE" hideAction="true" inheritsBindFrom="TESTMAPADDON_TOGGLE_MAP_ZOOM_OUT">
				<Down>TESTMAPADDON:ToogleZoom(true, TESTMAPADDON.account.zoomOut)</Down>
				<Up>TESTMAPADDON:ToogleZoom(false)</Up>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_ZOOM_IN_SIEGE" hideAction="true" inheritsBindFrom="TESTMAPADDON_TOGGLE_MAP_ZOOM_IN">
				<Down>TESTMAPADDON:ToogleZoom(true, TESTMAPADDON.account.zoomIn)</Down>
				<Up>TESTMAPADDON:ToogleZoom(false)</Up>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_ZOOM_PLUS_SIEGE" hideAction="true" inheritsBindFrom="TESTMAPADDON_TOGGLE_MAP_ZOOM_PLUS">
				<Down>TESTMAPADDON:StepZoom(true)</Down>
			</Action>
			<Action name="TESTMAPADDON_TOGGLE_MAP_ZOOM_MINUS_SIEGE" hideAction="true" inheritsBindFrom="TESTMAPADDON_TOGGLE_MAP_ZOOM_MINUS">
				<Down>TESTMAPADDON:StepZoom(false)</Down>
			</Action>
		</Category>
	</Layer>
</Bindings>