<?xml version="1.2" encoding="UTF-8"?>
<Bindings>
  <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
    <Category name="SI_KEYBINDINGS_CATEGORY_PERFECTEDWEAVE">
      <!-- Toggle Mode (1-2-3 cycle) -->
      <Action name="PERFECTEDWEAVE_TOGGLE_MODE">
        <Down>PerfectedWeave.ToggleMode()</Down>
      </Action>
      
      <!-- Toggle Custom Block List -->
      <Action name="PERFECTEDWEAVE_TOGGLE_CUSTOM_BLOCK_LIST">
        <Down>PerfectedWeave.ToggleCustomBlockList()</Down>
      </Action>
      
      <!-- Toggle Custom Recast Block List -->
      <Action name="PERFECTEDWEAVE_TOGGLE_CUSTOM_RECAST_BLOCK_LIST">
        <Down>PerfectedWeave.ToggleCustomRecastBlockList()</Down>
      </Action>
      
      <!-- Toggle Backbar Features -->
      <Action name="PERFECTEDWEAVE_TOGGLE_BACKBAR_FEATURES">
        <Down>PerfectedWeave.ToggleBackbarFeatures()</Down>
      </Action>
      
      <!-- Toggle Backbar Weave Assist -->
      <Action name="PERFECTEDWEAVE_TOGGLE_BACKBAR_WEAVE_ASSIST">
        <Down>PerfectedWeave.ToggleBackbarWeaveAssist()</Down>
      </Action>
      
      <!-- Toggle Execute Check -->
      <Action name="PERFECTEDWEAVE_TOGGLE_EXECUTE_CHECK">
        <Down>PerfectedWeave.ToggleExecuteCheck()</Down>
      </Action>
    </Category>
  </Layer>
</Bindings>