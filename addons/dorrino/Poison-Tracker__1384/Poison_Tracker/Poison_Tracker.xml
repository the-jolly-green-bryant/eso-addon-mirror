<!-- Poison Tracker -->

<GuiXml>
	<Controls>
      <TopLevelControl name="PT_Frame" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="false">
            <Dimensions x="64" y="64" />
			<Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" />
			<OnMoveStop>
				PT_SavePosition()
			</OnMoveStop>
	      <Controls>
					<Texture name="$(parent)_IconBG" layer="0" level="0">
						<Dimensions x="64" y="64" />
						<Anchor point="CENTER" relativeTo="$(parent)_Icon" relativePoint="CENTER" offsetX="0" offsetY="0"/>
					</Texture>
					<Texture name="$(parent)_Icon" layer="0" level="1">
						<Dimensions x="50" y="50" />
						<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" offsetX="0" />
					</Texture>
					<Cooldown name="$(parent)_CooldownMain" inherits="ZO_DefaultCooldown" layer="0" level="3" hidden="false">
						<Dimensions x="64" y="64" />
						<Anchor point="CENTER" relativeTo="$(parent)_Icon" relativePoint="CENTER" />
					</Cooldown>
					<Label name="$(parent)_Unlocked" horizontalAlignment="CENTER" font="$(BOLD_FONT)|22|soft-shadow-thick" color="FFFFFF" text="Unlocked">
						<Anchor point="BOTTOM" relativeTo="$(parent)" relativePoint="TOP" offsetX="0" offsetY="-2" />
					</Label>
					<Texture name="$(parent)_IconBGFrame" textureFile="/esoui/art/progression/abilityframe_filled.dds" layer="0" level="1" hidden="false">
						<Dimensions x="103" y="103" />
						<Anchor point="CENTER" relativeTo="$(parent)_Icon" relativePoint="CENTER" />
					</Texture>
					<Texture name="$(parent)_IconBGCorners" textureFile="/esoui/art/actionbar/ability_ultimate_framedecobg.dds" layer="0" level="2" hidden="false" >
						<Dimensions x="128" y="128" />
						<Anchor point="CENTER" relativeTo="$(parent)_Icon" relativePoint="CENTER" />
					</Texture>
					<Label name="$(parent)_Stacks" horizontalAlignment="CENTER" font="$(BOLD_FONT)|18|thin-outline" color="FFFFFF">
						<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="-4" offsetY="1" />
	        </Label>


					<Texture name="$(parent)_Star" layer="0" level="4" textureFile="EsoUI/Art/ActionBar/coolDown_completeEFX.dds" blendMode="ADD" hidden="true">
						<Dimensions x="72" y="72" />
						<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" offsetX="0" />
					</Texture>
				</Controls>
      </TopLevelControl>

	</Controls>
</GuiXml>
