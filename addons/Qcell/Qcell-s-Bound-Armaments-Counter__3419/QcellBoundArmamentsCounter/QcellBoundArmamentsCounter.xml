<GuiXml>
  <Controls>
    <TopLevelControl name="QBACUI" mouseEnabled="true" movable="true" clampedToScreen="true">
      <Dimensions x="80" y="80" />
      <Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="200" offsetX="0" />
      <OnMoveStop>QBAC.OnUIMove()</OnMoveStop>
      <Controls>
        <Backdrop name="$(parent)TextureBorder" centerColor="000000" edgeColor="000000">
          <Anchor point="CENTER"/>
          <Dimensions x="90" y="90"/>
          <Edge edgeSize="3"/>
        </Backdrop>
        <Texture name="$(parent)Texture" textureFile="/esoui/art/icons/ability_sorcerer_bound_armaments_proc.dds">
            <Dimensions x="80" y="80"/>
            <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER"/>
        </Texture>
        
        <Label name="$(parent)Stacks" font="EsoUI/Common/Fonts/univers67.otf|144|soft-shadow-thick" color="FFFFFF" text="0" verticalAlignment="TOP" horizontalAlignment="LEFT"  alpha="1">
            <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER"/>
        </Label>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
