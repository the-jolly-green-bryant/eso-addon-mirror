<GuiXml>
	<Controls>
		<TopLevelControl name="DwFuryFrame" mouseEnabled="true" movable="true" hidden="true" clampedToScreen="true">
			<Dimensions x="50" y="50" />
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" />

			<OnMoveStop>
				DwFury.savePosition()
			</OnMoveStop>

			<Controls>
				<Texture name="$(parent)Texture" textureFile="/esoui/art/icons/ability_warrior_025.dds">
					<AnchorFill />
				</Texture>
				<Texture name="$(parent)Frame" textureFile="/esoui/art/actionbar/gamepad/gp_abilityframe64.dds">
					<AnchorFill />
				</Texture>
				<Label name="$(parent)Stacks" text="" color="00FF00" inheritAlpha="true" font="$(CHAT_FONT)|$(KB_48)|soft-shadow-thick" verticalAlignment="TOP" horizontalAlignment="CENTER">
					<AnchorFill />
				</Label>
				<Label name="$(parent)Time" text="" color="00FF00" inheritAlpha="true" font="$(CHAT_FONT)|$(KB_48)|soft-shadow-thick" verticalAlignment="BOTTOM" horizontalAlignment="CENTER">
					<AnchorFill />
				</Label>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>
