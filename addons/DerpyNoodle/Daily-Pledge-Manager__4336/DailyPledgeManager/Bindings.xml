<Bindings>
    <Layer name="SI_KEYBINDINGS_CATEGORY_GENERAL">
        <Category name="Daily Pledge Manager">
            <Action name="DAILY_PLEDGE_MANAGER_TOGGLE">
                <Down>DailyPledgeManager.ToggleKeybind()</Down>
                <Default>KEY_MINUS</Default>
            </Action>
            <Action name="DAILY_PLEDGE_MANAGER_QUEUE_ALL">
                <Down>DailyPledgeManager.QueueAllKeybind()</Down>
                <Default>KEY_9</Default>
            </Action>
            <Action name="DAILY_PLEDGE_MANAGER_ABANDON_ALL">
                <Down>DailyPledgeManager.AbandonAllKeybind()</Down>
                <Default>KEY_0</Default>
            </Action>
        </Category>
    </Layer>
</Bindings>
