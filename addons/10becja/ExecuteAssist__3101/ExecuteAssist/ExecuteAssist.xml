<GuiXml>
	<Controls>
		<TopLevelControl name="ExAsAlert" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="true">
			<Dimensions x="200" y="40" />
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" offsetX="800" offsetY="300"/>

			<OnMoveStop>
				ExAs.OnIndicatorMoveStop()
			</OnMoveStop>

			<Controls>
				<Label name="$(parent)_Label" width="200" height="40" font="$(BOLD_FONT)|$(KB_40)|soft-shadow-thick" inheritAlpha="true" color="FF0000"
					wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="CENTER" text="Execute!">
					<Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
				</Label>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>