<GuiXml>
    <Controls>
        <!-- Moveable HUD Icon Widget (Hover-Only Tooltip & Tri-Color Badges: Red Messages, Green Friends, Blue Mail) -->
        <TopLevelControl name="AetherChat_MinBar" movable="true" mouseEnabled="true" clampedToScreen="true" hidden="false">
            <Dimensions x="38" y="38" />
            <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" offsetX="60" offsetY="60" />
            <Controls>
                <!-- Sleek Dark Slate Tile with Nordic Gold Edge matching Channel Buttons -->
                <Backdrop name="$(parent)_BG" edgeColor="E5B558" centerColor="121212" alpha="0.92">
                    <AnchorFill />
                    <Edge edgeSize="1" />
                </Backdrop>
                <Texture name="$(parent)_Texture" textureFile="/esoui/art/journal/journal_tabicon_lorelibrary_up.dds">
                    <Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" offsetX="0" offsetY="0" />
                    <Dimensions x="24" y="24" />
                </Texture>
                <!-- 1. Crimson Notification Badge (Unread Chat Messages) with Gold Edge (Top-Right) -->
                <Backdrop name="$(parent)_Badge" edgeColor="E5B558" centerColor="B81414" hidden="true" tier="HIGH">
                    <Dimensions x="17" y="17" />
                    <Anchor point="TOPRIGHT" offsetX="4" offsetY="-4" />
                    <Edge edgeSize="1" />
                    <Controls>
                        <Label name="$(parent)Count" font="ZoFontGameSmall" text="0" color="FFFFFF" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                            <AnchorFill />
                        </Label>
                    </Controls>
                </Backdrop>
                <!-- 2. Emerald Forest Badge (Friends Online) with Gold Edge (Top-Left) -->
                <Backdrop name="$(parent)_FriendsBadge" edgeColor="E5B558" centerColor="1B5E20" hidden="true" tier="HIGH">
                    <Dimensions x="17" y="17" />
                    <Anchor point="TOPLEFT" offsetX="-4" offsetY="-4" />
                    <Edge edgeSize="1" />
                    <Controls>
                        <Label name="$(parent)Count" font="ZoFontGameSmall" text="0" color="FFFFFF" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                            <AnchorFill />
                        </Label>
                    </Controls>
                </Backdrop>
                <!-- 3. Celestial Blue Badge (Unread Mails) with Gold Edge (Bottom-Right) -->
                <Backdrop name="$(parent)_MailBadge" edgeColor="E5B558" centerColor="0369A1" hidden="true" tier="HIGH">
                    <Dimensions x="17" y="17" />
                    <Anchor point="BOTTOMRIGHT" offsetX="4" offsetY="4" />
                    <Edge edgeSize="1" />
                    <Controls>
                        <Label name="$(parent)Count" font="ZoFontGameSmall" text="0" color="FFFFFF" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                            <AnchorFill />
                        </Label>
                    </Controls>
                </Backdrop>
            </Controls>
        </TopLevelControl>

        <!-- Virtual Template for Channel / Contact Items on Left Sidebar -->
        <Button name="AetherChat_ChannelBtnTemplate" virtual="true" mouseEnabled="true">
            <Dimensions x="198" y="34" />
            <Controls>
                <Backdrop name="$(parent)BG" alpha="0.25" centerColor="121212" edgeColor="3A3A3A">
                    <AnchorFill />
                    <Edge edgeSize="1" />
                </Backdrop>
                <Backdrop name="$(parent)SelectedBG" alpha="0.45" centerColor="E5B558" edgeColor="FFD700" hidden="true">
                    <AnchorFill />
                    <Edge edgeSize="1" />
                </Backdrop>
                <!-- Distinct Luminous Nordic Gold Drag & Drop Glow Border -->
                <Backdrop name="$(parent)DragGlow" alpha="0.6" centerColor="E5B558" edgeColor="FFD700" hidden="true" tier="HIGH">
                    <AnchorFill offsetX="-2" offsetY="-2" />
                    <Edge edgeSize="2" />
                </Backdrop>
                <!-- Official ESO Texture Icon (Guild Shield, Group, Whisper, Loot, etc.) -->
                <Texture name="$(parent)Icon" textureFile="/esoui/art/inventory/inventory_tabicon_misc_up.dds">
                    <Dimensions x="22" y="22" />
                    <Anchor point="LEFT" offsetX="8" />
                </Texture>
                <!-- Clean Skyrim Styled Channel Name (Strict single line with ellipsis, never wraps) -->
                <Label name="$(parent)Name" font="ZoFontGame" color="E0E0E0" wrapMode="ELLIPSIS" maxLineCount="1" verticalAlignment="CENTER" horizontalAlignment="LEFT">
                    <Dimensions y="24" />
                    <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="6" />
                    <Anchor point="RIGHT" offsetX="-28" />
                </Label>
                <!-- Small Discreet Close 'X' Button (Private Messages Only) -->
                <Button name="$(parent)CloseBtn" mouseEnabled="true" tier="HIGH" layer="CONTROLS" hidden="true">
                    <Dimensions x="18" y="18" />
                    <Anchor point="RIGHT" offsetX="-6" />
                    <Textures normal="/esoui/art/buttons/edit_cancel_up.dds"
                              pressed="/esoui/art/buttons/edit_cancel_down.dds"
                              mouseOver="/esoui/art/buttons/edit_cancel_over.dds" />
                </Button>
                <!-- Crimson Notification Badge with Gold Edge -->
                <Backdrop name="$(parent)Badge" edgeColor="E5B558" centerColor="B81414" hidden="true" tier="HIGH">
                    <Dimensions x="18" y="18" />
                    <Anchor point="RIGHT" offsetX="-4" />
                    <Edge edgeSize="1" />
                    <Controls>
                        <Label name="$(parent)Count" font="ZoFontGameSmall" text="1" color="FFFFFF" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                            <AnchorFill />
                        </Label>
                    </Controls>
                </Backdrop>
            </Controls>
        </Button>

        <!-- Main Messenger Window (Skyrim / Tamriel Authentic Frame & Edge Resizable) -->
        <TopLevelControl name="AetherChat_MessengerWindow" movable="true" mouseEnabled="true" clampedToScreen="true" hidden="true">
            <Dimensions x="940" y="520" />
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" />
            <Controls>
                <!-- Authentic ESO Slate Stone Backdrop -->
                <Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop">
                    <AnchorFill />
                </Backdrop>

                <!-- Sidebar Collapse / Expand Toggle Button -->
                <Button name="$(parent)CollapseSidebarBtn" mouseEnabled="true">
                    <Dimensions x="22" y="22" />
                    <Anchor point="TOPLEFT" offsetX="8" offsetY="12" />
                    <Textures normal="/esoui/art/buttons/tree_open_up.dds"
                              pressed="/esoui/art/buttons/tree_open_down.dds"
                              mouseOver="/esoui/art/buttons/tree_open_over.dds" />
                </Button>

                <!-- Skyrim Header Area -->
                <Texture name="$(parent)HeaderIcon" textureFile="/esoui/art/journal/journal_tabicon_lorelibrary_up.dds">
                    <Dimensions x="26" y="26" />
                    <Anchor point="LEFT" relativeTo="$(parent)CollapseSidebarBtn" relativePoint="RIGHT" offsetX="6" />
                </Texture>
                <Label name="$(parent)Title" font="ZoFontWinH2" color="E5B558" wrapMode="ELLIPSIS" verticalAlignment="CENTER" text="|cE5B558AETHER|r|cFFFFFFCHAT|r">
                    <Anchor point="LEFT" relativeTo="$(parent)HeaderIcon" relativePoint="RIGHT" offsetX="8" />
                </Label>

                <!-- Header Action Buttons (Settings, Friends, Mail, Donate) -->
                <Button name="$(parent)SettingsBtn" mouseEnabled="true">
                    <Dimensions x="24" y="24" />
                    <Anchor point="TOPRIGHT" offsetX="-10" offsetY="10" />
                    <Textures normal="/esoui/art/chatwindow/chat_options_up.dds"
                              pressed="/esoui/art/chatwindow/chat_options_down.dds"
                              mouseOver="/esoui/art/chatwindow/chat_options_over.dds" />
                </Button>
                <Button name="$(parent)FriendsBtn" mouseEnabled="true">
                    <Dimensions x="24" y="24" />
                    <Anchor point="TOPRIGHT" offsetX="-40" offsetY="10" />
                    <Textures normal="/esoui/art/contacts/tabicon_friends_up.dds"
                              pressed="/esoui/art/contacts/tabicon_friends_down.dds"
                              mouseOver="/esoui/art/contacts/tabicon_friends_over.dds" />
                    <Controls>
                        <Backdrop name="$(parent)Badge" edgeColor="E5B558" centerColor="1B5E20" hidden="true" tier="HIGH">
                            <Dimensions x="16" y="16" />
                            <Anchor point="TOPRIGHT" offsetX="4" offsetY="-4" />
                            <Edge edgeSize="1" />
                            <Controls>
                                <Label name="$(parent)Count" font="ZoFontGameSmall" text="0" color="FFFFFF" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                                    <AnchorFill />
                                </Label>
                            </Controls>
                        </Backdrop>
                    </Controls>
                </Button>
                <Button name="$(parent)MailBtn" mouseEnabled="true">
                    <Dimensions x="24" y="24" />
                    <Anchor point="TOPRIGHT" offsetX="-70" offsetY="10" />
                    <Textures normal="/esoui/art/mainmenu/menubar_mail_up.dds"
                              pressed="/esoui/art/mainmenu/menubar_mail_down.dds"
                              mouseOver="/esoui/art/mainmenu/menubar_mail_over.dds" />
                    <Controls>
                        <!-- Celestial Blue Badge for Unread Mails -->
                        <Backdrop name="$(parent)Badge" edgeColor="E5B558" centerColor="0369A1" hidden="true" tier="HIGH">
                            <Dimensions x="16" y="16" />
                            <Anchor point="TOPRIGHT" offsetX="4" offsetY="-4" />
                            <Edge edgeSize="1" />
                            <Controls>
                                <Label name="$(parent)Count" font="ZoFontGameSmall" text="0" color="FFFFFF" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                                    <AnchorFill />
                                </Label>
                            </Controls>
                        </Backdrop>
                    </Controls>
                </Button>
                <!-- Dedicated Donation Button with Gold Coin -->
                <Button name="$(parent)DonateBtn" mouseEnabled="true">
                    <Dimensions x="24" y="24" />
                    <Anchor point="TOPRIGHT" offsetX="-100" offsetY="10" />
                    <Controls>
                        <Texture name="$(parent)Icon" textureFile="/esoui/art/currency/currency_gold.dds">
                            <AnchorFill />
                        </Texture>
                    </Controls>
                </Button>

                <!-- Live Chat Search Box -->
                <Backdrop name="$(parent)SearchBox" edgeColor="3A3A3A" centerColor="0D1117" alpha="0.9" mouseEnabled="true" tier="HIGH">
                    <Dimensions x="175" y="24" />
                    <Anchor point="TOPRIGHT" offsetX="-132" offsetY="10" />
                    <Edge edgeSize="1" />
                    <Controls>
                        <Texture name="$(parent)Icon" textureFile="/esoui/art/tradinghouse/tradinghouse_browse_tabicon_up.dds" mouseEnabled="true">
                            <Dimensions x="16" y="16" />
                            <Anchor point="LEFT" offsetX="6" offsetY="0" />
                        </Texture>
                        <EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop" font="ZoFontGameSmall" maxInputCharacters="60" mouseEnabled="true">
                            <Anchor point="TOPLEFT" relativeTo="$(parent)Icon" relativePoint="TOPRIGHT" offsetX="6" offsetY="-2" />
                            <Anchor point="BOTTOMRIGHT" offsetX="-22" offsetY="2" />
                        </EditBox>
                        <Button name="$(parent)ClearBtn" mouseEnabled="true" hidden="true">
                            <Dimensions x="14" y="14" />
                            <Anchor point="RIGHT" offsetX="-4" offsetY="0" />
                            <Textures normal="/esoui/art/buttons/edit_cancel_up.dds"
                                      pressed="/esoui/art/buttons/edit_cancel_down.dds"
                                      mouseOver="/esoui/art/buttons/edit_cancel_over.dds" />
                        </Button>
                    </Controls>
                </Backdrop>

                <!-- Top Horizontal Divider (Flush across whole window) -->
                <Texture name="$(parent)TopDivider" textureFile="/esoui/art/miscellaneous/centerscreen_topdivider.dds">
                    <Dimensions y="2" />
                    <Anchor point="TOPLEFT" offsetX="4" offsetY="42" />
                    <Anchor point="TOPRIGHT" offsetX="-4" offsetY="42" />
                </Texture>

                <!-- Left Column Sidebar Background Panel (Gives Skyrim/Nordic framed structure to the sidebar) -->
                <Backdrop name="$(parent)SidebarBG" alpha="0.3" centerColor="050505" edgeColor="282828">
                    <Dimensions x="216" />
                    <Anchor point="TOPLEFT" offsetX="6" offsetY="46" />
                    <Anchor point="BOTTOMLEFT" offsetX="6" offsetY="-8" />
                    <Edge edgeSize="1" />
                </Backdrop>

                <!-- Left Column: Channels Scrollable Container (ZO_ScrollContainer with strict clipping) -->
                <Control name="$(parent)ChannelsScroll" inherits="ZO_ScrollContainer" mouseEnabled="true">
                    <Dimensions x="216" />
                    <Anchor point="TOPLEFT" offsetX="6" offsetY="46" />
                    <Anchor point="BOTTOMLEFT" offsetX="6" offsetY="-8" />
                </Control>

                <!-- Vertical Nordic Divider between Channels and Conversation -->
                <Texture name="$(parent)VerticalDivider" textureFile="/esoui/art/interaction/conversation_verticalborder.dds">
                    <Dimensions x="2" />
                    <Anchor point="TOPLEFT" offsetX="226" offsetY="44" />
                    <Anchor point="BOTTOMLEFT" offsetX="226" offsetY="-6" />
                </Texture>

                <!-- Right Column: Active Conversation Header & Actions -->
                <Label name="$(parent)ActiveChannelLabel" font="ZoFontWinH3" color="E5B558" wrapMode="ELLIPSIS" verticalAlignment="CENTER" text="Canal Zone">
                    <Anchor point="TOPLEFT" offsetX="236" offsetY="48" />
                </Label>
                <!-- Zone Multi-Language Selector Pills -->
                <Control name="$(parent)ZoneLangBar" hidden="true">
                    <Dimensions x="280" y="24" />
                    <Anchor point="TOPRIGHT" offsetX="-38" offsetY="48" />
                    <Controls>
                        <Button name="$(parent)All" mouseEnabled="true">
                            <Dimensions x="50" y="22" />
                            <Anchor point="LEFT" offsetX="0" offsetY="0" />
                            <Controls>
                                <Backdrop name="$(parent)BG" edgeColor="E5B558" centerColor="111827" alpha="0.9">
                                    <AnchorFill />
                                    <Edge edgeSize="1" />
                                </Backdrop>
                                <Label name="$(parent)Label" font="ZoFontGameSmall" color="E5B558" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Toutes">
                                    <AnchorFill />
                                </Label>
                            </Controls>
                        </Button>
                        <Button name="$(parent)FR" mouseEnabled="true">
                            <Dimensions x="36" y="22" />
                            <Anchor point="LEFT" relativeTo="$(parent)All" relativePoint="RIGHT" offsetX="3" />
                            <Controls>
                                <Backdrop name="$(parent)BG" edgeColor="444444" centerColor="111827" alpha="0.9">
                                    <AnchorFill />
                                    <Edge edgeSize="1" />
                                </Backdrop>
                                <Label name="$(parent)Label" font="ZoFontGameSmall" color="888888" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="FR">
                                    <AnchorFill />
                                </Label>
                            </Controls>
                        </Button>
                        <Button name="$(parent)EN" mouseEnabled="true">
                            <Dimensions x="36" y="22" />
                            <Anchor point="LEFT" relativeTo="$(parent)FR" relativePoint="RIGHT" offsetX="3" />
                            <Controls>
                                <Backdrop name="$(parent)BG" edgeColor="444444" centerColor="111827" alpha="0.9">
                                    <AnchorFill />
                                    <Edge edgeSize="1" />
                                </Backdrop>
                                <Label name="$(parent)Label" font="ZoFontGameSmall" color="888888" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="EN">
                                    <AnchorFill />
                                </Label>
                            </Controls>
                        </Button>
                        <Button name="$(parent)DE" mouseEnabled="true">
                            <Dimensions x="36" y="22" />
                            <Anchor point="LEFT" relativeTo="$(parent)EN" relativePoint="RIGHT" offsetX="3" />
                            <Controls>
                                <Backdrop name="$(parent)BG" edgeColor="444444" centerColor="111827" alpha="0.9">
                                    <AnchorFill />
                                    <Edge edgeSize="1" />
                                </Backdrop>
                                <Label name="$(parent)Label" font="ZoFontGameSmall" color="888888" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="DE">
                                    <AnchorFill />
                                </Label>
                            </Controls>
                        </Button>
                        <Button name="$(parent)ES" mouseEnabled="true">
                            <Dimensions x="36" y="22" />
                            <Anchor point="LEFT" relativeTo="$(parent)DE" relativePoint="RIGHT" offsetX="3" />
                            <Controls>
                                <Backdrop name="$(parent)BG" edgeColor="444444" centerColor="111827" alpha="0.9">
                                    <AnchorFill />
                                    <Edge edgeSize="1" />
                                </Backdrop>
                                <Label name="$(parent)Label" font="ZoFontGameSmall" color="888888" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="ES">
                                    <AnchorFill />
                                </Label>
                            </Controls>
                        </Button>
                        <Button name="$(parent)Global" mouseEnabled="true">
                            <Dimensions x="50" y="22" />
                            <Anchor point="LEFT" relativeTo="$(parent)ES" relativePoint="RIGHT" offsetX="3" />
                            <Controls>
                                <Backdrop name="$(parent)BG" edgeColor="444444" centerColor="111827" alpha="0.9">
                                    <AnchorFill />
                                    <Edge edgeSize="1" />
                                </Backdrop>
                                <Label name="$(parent)Label" font="ZoFontGameSmall" color="888888" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Global">
                                    <AnchorFill />
                                </Label>
                            </Controls>
                        </Button>
                    </Controls>
                </Control>
                <Button name="$(parent)SetFilterBtn" mouseEnabled="true" hidden="true">
                    <Dimensions x="170" y="24" />
                    <Anchor point="TOPRIGHT" offsetX="-38" offsetY="48" />
                    <Controls>
                        <Backdrop name="$(parent)BG" edgeColor="E5B558" centerColor="111827" alpha="0.9">
                            <AnchorFill />
                            <Edge edgeSize="1" />
                        </Backdrop>
                        <Texture name="$(parent)Icon" textureFile="/esoui/art/inventory/inventory_tabicon_armor_up.dds">
                            <Dimensions x="18" y="18" />
                            <Anchor point="LEFT" offsetX="6" />
                        </Texture>
                        <Label name="$(parent)Label" font="ZoFontGameSmall" color="E5B558" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="[✓] Sets Uniquement">
                            <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="4" />
                            <Anchor point="RIGHT" offsetX="-4" />
                        </Label>
                    </Controls>
                </Button>
                <Button name="$(parent)ClearBtn" mouseEnabled="true">
                    <Dimensions x="24" y="24" />
                    <Anchor point="TOPRIGHT" offsetX="-10" offsetY="48" />
                    <Textures normal="/esoui/art/buttons/edit_cancel_up.dds"
                              pressed="/esoui/art/buttons/edit_cancel_down.dds"
                              mouseOver="/esoui/art/buttons/edit_cancel_over.dds" />
                </Button>

                <!-- Middle Divider below Channel Title -->
                <Texture name="$(parent)MidDivider" textureFile="/esoui/art/miscellaneous/centerscreen_topdivider.dds">
                    <Dimensions y="2" />
                    <Anchor point="TOPLEFT" offsetX="230" offsetY="76" />
                    <Anchor point="TOPRIGHT" offsetX="-8" offsetY="76" />
                </Texture>

                <!-- Message TextBuffer (Native ESO Chat Buffer with Skyrim Styling) -->
                <TextBuffer name="$(parent)Messages" font="ZoFontChat" linkEnabled="true" mouseEnabled="true" maxHistoryLines="400">
                    <Anchor point="TOPLEFT" offsetX="234" offsetY="82" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-10" offsetY="-48" />
                </TextBuffer>

                <!-- Bottom Horizontal Divider -->
                <Texture name="$(parent)BottomDivider" textureFile="/esoui/art/miscellaneous/centerscreen_topdivider.dds">
                    <Dimensions y="2" />
                    <Anchor point="BOTTOMLEFT" offsetX="230" offsetY="-44" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-8" offsetY="-44" />
                </Texture>

                <!-- ============================================================== -->
                <!-- Edge Interactive Resize Handles with Luminous Glow             -->
                <!-- ============================================================== -->

                <!-- 1. Right Edge Resize Strip -->
                <Control name="$(parent)ResizeRight" mouseEnabled="true" tier="HIGH">
                    <Dimensions x="10" />
                    <Anchor point="TOPRIGHT" offsetX="0" offsetY="10" />
                    <Anchor point="BOTTOMRIGHT" offsetX="0" offsetY="0" />
                    <Controls>
                        <Backdrop name="$(parent)Glow" alpha="0.8" centerColor="00000000" edgeColor="E5B558" hidden="true">
                            <AnchorFill />
                            <Edge edgeSize="2" />
                        </Backdrop>
                    </Controls>
                </Control>

                <!-- 2. Top Edge Resize Strip -->
                <Control name="$(parent)ResizeTop" mouseEnabled="true" tier="HIGH">
                    <Dimensions y="10" />
                    <Anchor point="TOPLEFT" offsetX="10" offsetY="0" />
                    <Anchor point="TOPRIGHT" offsetX="-140" offsetY="0" />
                    <Controls>
                        <Backdrop name="$(parent)Glow" alpha="0.8" centerColor="00000000" edgeColor="E5B558" hidden="true">
                            <AnchorFill />
                            <Edge edgeSize="2" />
                        </Backdrop>
                    </Controls>
                </Control>

                <!-- 3. Bottom Edge Resize Strip -->
                <Control name="$(parent)ResizeBottom" mouseEnabled="true" tier="HIGH">
                    <Dimensions y="10" />
                    <Anchor point="BOTTOMLEFT" offsetX="10" offsetY="0" />
                    <Anchor point="BOTTOMRIGHT" offsetX="0" offsetY="0" />
                    <Controls>
                        <Backdrop name="$(parent)Glow" alpha="0.8" centerColor="00000000" edgeColor="E5B558" hidden="true">
                            <AnchorFill />
                            <Edge edgeSize="2" />
                        </Backdrop>
                    </Controls>
                </Control>

            </Controls>
        </TopLevelControl>

        <!-- ============================================================== -->
        <!-- Dedicated Donation Modal Window (AetherTrade-like Skyrim UI)  -->
        <!-- ============================================================== -->
        <TopLevelControl name="AetherChat_DonationWindow" movable="true" mouseEnabled="true" clampedToScreen="true" hidden="true" tier="HIGH">
            <Dimensions x="580" y="380" />
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" />
            <Controls>
                <Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop">
                    <AnchorFill />
                </Backdrop>

                <!-- Header -->
                <Texture name="$(parent)HeaderIcon" textureFile="/esoui/art/currency/currency_gold.dds">
                    <Dimensions x="24" y="24" />
                    <Anchor point="TOPLEFT" offsetX="14" offsetY="12" />
                </Texture>
                <Label name="$(parent)Title" font="ZoFontWinH2" color="E5B558" text="|cE5B558AetherChat|r — Dons &amp; Soutien au Créateur">
                    <Anchor point="LEFT" relativeTo="$(parent)HeaderIcon" relativePoint="RIGHT" offsetX="8" />
                </Label>
                <Button name="$(parent)CloseBtn" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetX="-8" offsetY="8" />
                </Button>

                <Label name="$(parent)Desc" font="ZoFontGameSmall" color="C5C29E" wrapMode="ELLIPSIS" text="Vous pouvez soutenir le développement continu d'AetherChat (@AlexQuiet) via l'une des options ci-dessous :">
                    <Anchor point="TOPLEFT" offsetX="14" offsetY="44" />
                    <Anchor point="TOPRIGHT" offsetX="-14" offsetY="44" />
                </Label>

                <!-- Divider -->
                <Texture name="$(parent)Div1" textureFile="/esoui/art/miscellaneous/centerscreen_topdivider.dds">
                    <Dimensions y="2" />
                    <Anchor point="TOPLEFT" offsetX="8" offsetY="68" />
                    <Anchor point="TOPRIGHT" offsetX="-8" offsetY="68" />
                </Texture>

                <!-- Section 1: In-Game Gold -->
                <Backdrop name="$(parent)SectionGold" edgeColor="505050" centerColor="111111" alpha="0.6">
                    <Dimensions y="68" />
                    <Anchor point="TOPLEFT" offsetX="14" offsetY="76" />
                    <Anchor point="TOPRIGHT" offsetX="-14" offsetY="76" />
                    <Edge edgeSize="1" />
                    <Controls>
                        <Label name="$(parent)Label" font="ZoFontGameBold" color="FFD700" text="[#] Don de pièces d'or en jeu (Serveur EU)">
                            <Anchor point="TOPLEFT" offsetX="10" offsetY="10" />
                        </Label>
                        <Label name="$(parent)Sub" font="ZoFontGameSmall" color="888888" text="Destinataire @AlexQuiet et objet Don AetherChat pré-remplis (montant et mot libres)">
                            <Anchor point="TOPLEFT" offsetX="10" offsetY="34" />
                        </Label>
                        <Button name="$(parent)Btn" inherits="ZO_DefaultButton" text="Envoyer Courrier">
                            <Dimensions x="140" y="28" />
                            <Anchor point="RIGHT" offsetX="-10" />
                        </Button>
                    </Controls>
                </Backdrop>

                <!-- Section 2: PayPal -->
                <Backdrop name="$(parent)SectionPayPal" edgeColor="505050" centerColor="111111" alpha="0.6">
                    <Dimensions y="68" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)SectionGold" relativePoint="BOTTOMLEFT" offsetY="8" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)SectionGold" relativePoint="BOTTOMRIGHT" offsetY="8" />
                    <Edge edgeSize="1" />
                    <Controls>
                        <Label name="$(parent)Label" font="ZoFontGameBold" color="38BDF8" text="[#] Don PayPal">
                            <Anchor point="TOPLEFT" offsetX="10" offsetY="8" />
                        </Label>
                        <EditBox name="$(parent)Edit" font="ZoFontGame" color="FFFFFF" maxInputCharacters="100" mouseEnabled="true" text="alexjonsnow25@gmail.com">
                            <Dimensions x="390" y="24" />
                            <Anchor point="TOPLEFT" offsetX="10" offsetY="32" />
                        </EditBox>
                        <Button name="$(parent)Btn" inherits="ZO_DefaultButton" text="Copier">
                            <Dimensions x="140" y="28" />
                            <Anchor point="RIGHT" offsetX="-10" />
                        </Button>
                    </Controls>
                </Backdrop>

                <!-- Section 3: USDT ERC20 -->
                <Backdrop name="$(parent)SectionUSDT" edgeColor="505050" centerColor="111111" alpha="0.6">
                    <Dimensions y="68" />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)SectionPayPal" relativePoint="BOTTOMLEFT" offsetY="8" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)SectionPayPal" relativePoint="BOTTOMRIGHT" offsetY="8" />
                    <Edge edgeSize="1" />
                    <Controls>
                        <Label name="$(parent)Label" font="ZoFontGameBold" color="57F287" text="[#] Don Crypto USDT (Réseau ERC20)">
                            <Anchor point="TOPLEFT" offsetX="10" offsetY="8" />
                        </Label>
                        <EditBox name="$(parent)Edit" font="ZoFontGameSmall" color="FFFFFF" maxInputCharacters="100" mouseEnabled="true" text="0xad6d30189f61ace3b9c806d486a8547bb751e0bd">
                            <Dimensions x="390" y="24" />
                            <Anchor point="TOPLEFT" offsetX="10" offsetY="32" />
                        </EditBox>
                        <Button name="$(parent)Btn" inherits="ZO_DefaultButton" text="Copier USDT">
                            <Dimensions x="140" y="28" />
                            <Anchor point="RIGHT" offsetX="-10" />
                        </Button>
                    </Controls>
                </Backdrop>

                <!-- Close Button at bottom -->
                <Button name="$(parent)BottomCloseBtn" inherits="ZO_DefaultButton" text="Fermer">
                    <Dimensions x="120" y="28" />
                    <Anchor point="BOTTOM" offsetY="-12" />
                </Button>
            </Controls>
        </TopLevelControl>

        <!-- On-Screen Player Status Toast Notification (Friends & Guilds) -->
        <TopLevelControl name="AetherChat_FriendNotification" tier="MEDIUM" clampedToScreen="true" mouseEnabled="false" hidden="true">
            <Dimensions x="560" y="44" />
            <Anchor point="TOP" relativeTo="GuiRoot" relativePoint="TOP" offsetX="0" offsetY="220" />
            <Controls>
                <Backdrop name="$(parent)BG" edgeColor="E5B558" centerColor="0D131C" alpha="0.94">
                    <AnchorFill />
                    <Edge edgeSize="1" />
                </Backdrop>
                <Texture name="$(parent)Icon" textureFile="/esoui/art/contacts/tabicon_friends_up.dds">
                    <Dimensions x="24" y="24" />
                    <Anchor point="LEFT" offsetX="14" offsetY="0" />
                </Texture>
                <Label name="$(parent)Text" font="ZoFontHeader" color="FFFFFF" verticalAlignment="CENTER" horizontalAlignment="LEFT" wrapMode="ELLIPSIS" maxLineCount="1">
                    <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="12" />
                    <Anchor point="RIGHT" offsetX="-16" />
                </Label>
            </Controls>
        </TopLevelControl>

        <!-- Dedicated Copy Text & URL Modal Window -->
        <TopLevelControl name="AetherChat_CopyModal" movable="true" mouseEnabled="true" clampedToScreen="true" hidden="true" tier="HIGH">
            <Dimensions x="520" y="220" />
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" />
            <Controls>
                <Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop">
                    <AnchorFill />
                </Backdrop>

                <!-- Header -->
                <Texture name="$(parent)HeaderIcon" textureFile="/esoui/art/journal/journal_tabicon_lorelibrary_up.dds">
                    <Dimensions x="22" y="22" />
                    <Anchor point="TOPLEFT" offsetX="14" offsetY="12" />
                </Texture>
                <Label name="$(parent)Title" font="ZoFontWinH2" color="E5B558" text="|cE5B558AetherChat|r — Copier le texte / Lien">
                    <Anchor point="LEFT" relativeTo="$(parent)HeaderIcon" relativePoint="RIGHT" offsetX="8" />
                </Label>
                <Button name="$(parent)CloseBtn" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetX="-8" offsetY="8" />
                </Button>

                <Label name="$(parent)Desc" font="ZoFontGameSmall" color="C5C29E" text="Appuyez sur Ctrl+C pour copier le contenu dans votre presse-papiers :">
                    <Anchor point="TOPLEFT" offsetX="14" offsetY="42" />
                    <Anchor point="TOPRIGHT" offsetX="-14" offsetY="42" />
                </Label>

                <!-- Multi-line EditBox for Copy -->
                <Backdrop name="$(parent)Box" edgeColor="505050" centerColor="111111" alpha="0.8">
                    <Dimensions y="95" />
                    <Anchor point="TOPLEFT" offsetX="14" offsetY="66" />
                    <Anchor point="TOPRIGHT" offsetX="-14" offsetY="66" />
                    <Edge edgeSize="1" />
                    <Controls>
                        <EditBox name="$(parent)Edit" font="ZoFontGame" color="FFFFFF" multiLine="true" maxInputCharacters="2000" mouseEnabled="true">
                            <AnchorFill offsetX="8" offsetY="6" />
                        </EditBox>
                    </Controls>
                </Backdrop>

                <!-- Close Button -->
                <Button name="$(parent)BottomCloseBtn" inherits="ZO_DefaultButton" text="Fermer">
                    <Dimensions x="110" y="26" />
                    <Anchor point="BOTTOM" offsetY="-10" />
                </Button>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>