<GuiXml>
  <Controls>
    <TopLevelControl name="TGT_SimpleDpsListControl" hidden="true" layer="OVERLAY" level="1" allowBringToTop="false" mouseEnabled="true" movable="true" clampedToScreen="true">
      <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT"/>
      <Dimensions x="200" y="510" />
      <OnMoveStop>TGT_SimpleDpsHpsList:OnSimpleListMoveStop()</OnMoveStop>

      <Controls>
        <Control name="$(parent)MovableControl" tier="PARENT" inherits="MovableBackdropControl">
          <Anchor point="TOPLEFT"/>
          <Anchor point="BOTTOMRIGHT" />
        </Control>

        <!-- Header -->
        <Label name="$(parent)SenderNameHeaderLabel" inherits="CenterLeftHeaderLabel" text="Name">
		  <Dimensions x="75" />
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"/>
        </Label>
        <Label name="$(parent)DpsHeaderLabel" inherits="CenterLeftHeaderLabel" text="Damage">
		  <Dimensions x="125" />
          <Anchor point="TOPLEFT" relativeTo="$(parent)SenderNameHeaderLabel" relativePoint="TOPRIGHT"/>
        </Label>

        <Control name="$(parent)Container" layer="0" level="0">
          <Anchor point="TOPLEFT" relativeTo="$(parent)SenderNameHeaderLabel" relativePoint="BOTTOMLEFT" />
          <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" />
        </Control>
      </Controls>
    </TopLevelControl>
	
	<TopLevelControl name="TGT_SimpleHpsListControl" hidden="true" layer="OVERLAY" level="1" allowBringToTop="false" mouseEnabled="true" movable="true" clampedToScreen="true">
      <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT"/>
      <Dimensions x="200" y="510" />
      <OnMoveStop>TGT_SimpleDpsHpsList:OnSimpleListMoveStop()</OnMoveStop>

      <Controls>
        <Control name="$(parent)MovableControl" tier="PARENT" inherits="MovableBackdropControl">
          <Anchor point="TOPLEFT"/>
          <Anchor point="BOTTOMRIGHT" />
        </Control>

        <!-- Header -->
        <Label name="$(parent)SenderNameHeaderLabel" inherits="CenterLeftHeaderLabel" text="Name">
		  <Dimensions x="75" />
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"/>
        </Label>
        <Label name="$(parent)HpsHeaderLabel" inherits="CenterLeftHeaderLabel" text="Heal">
		  <Dimensions x="125" />
          <Anchor point="TOPLEFT" relativeTo="$(parent)SenderNameHeaderLabel" relativePoint="TOPRIGHT"/>
        </Label>

        <Control name="$(parent)Container" layer="0" level="0">
          <Anchor point="TOPLEFT" relativeTo="$(parent)SenderNameHeaderLabel" relativePoint="BOTTOMLEFT" />
          <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" />
        </Control>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>