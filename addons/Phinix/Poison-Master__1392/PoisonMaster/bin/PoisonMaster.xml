			<!--------------------------------------------------------------------------------------------------------------------------------------------->
				<Label name="$(parent)PoisonSlot03_Stack" horizontalAlignment="CENTER" font="$(BOLD_FONT)|18|soft-shadow-thin" color="FFFFFF">
					<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)PoisonSlot03" relativePoint="BOTTOMRIGHT" offsetX="-4" offsetY="1" />
				</Label>
			<!--------------------------------------------------------------------------------------------------------------------------------------------->
