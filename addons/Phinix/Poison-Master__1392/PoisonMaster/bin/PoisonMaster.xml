					<Dimensions x="16" y="16"/>
					<Anchor point="TOPRIGHT" relativeTo="$(parent)PoisonSlot03" relativePoint="TOPRIGHT"/>
				</Texture>
			<!--------------------------------------------------------------------------------------------------------------------------------------------->
				<Texture name="$(parent)PoisonSlot03_EquipOc" textureFile="/PoisonMaster/bin/equipO.dds">
					<Dimensions x="16" y="16"/>
					<Anchor point="TOPRIGHT" relativeTo="$(parent)PoisonSlot03" relativePoint="TOPRIGHT"/>
				</Texture>
			<!--------------------------------------------------------------------------------------------------------------------------------------------->
