					<Dimensions x="48" y="48"/>
					<Anchor point="LEFT" relativeTo="$(parent)PoisonSlot03" relativePoint="RIGHT" offsetX="12" offsetY="0"/>
					<Textures
						normal="/esoui/art/characterwindow/gearslot_poison.dds"
						pressed="/esoui/art/characterwindow/gearslot_poison.dds"
						mouseOver="/esoui/art/characterwindow/gearslot_poison.dds"
						disabled="/esoui/art/characterwindow/gearslot_poison.dds"
					/>
					<OnMouseEnter>
