				</Button>
			<!--------------------------------------------------------------------------------------------------------------------------------------------->
				<Label name="$(parent)PoisonSlot04_Stack" horizontalAlignment="CENTER" font="$(BOLD_FONT)|18|soft-shadow-thin" color="FFFFFF">
					<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)PoisonSlot04" relativePoint="BOTTOMRIGHT" offsetX="-4" offsetY="1" />
				</Label>
			<!--------------------------------------------------------------------------------------------------------------------------------------------->
				<Texture name="$(parent)PoisonSlot04_EquipAb" textureFile="/PoisonMaster/bin/borderA.dds">
					<Dimensions x="64" y="64"/>
					<Anchor point="CENTER" relativeTo="$(parent)PoisonSlot04" relativePoint="CENTER" offsetX="2" offsetY="2" />
				</Texture>
			<!--------------------------------------------------------------------------------------------------------------------------------------------->
				<Texture name="$(parent)PoisonSlot04_EquipOb" textureFile="/PoisonMaster/bin/borderO.dds">
					<Dimensions x="64" y="64"/>
					<Anchor point="CENTER" relativeTo="$(parent)PoisonSlot04" relativePoint="CENTER" offsetX="2" offsetY="2" />
				</Texture>
			<!--------------------------------------------------------------------------------------------------------------------------------------------->
				<Texture name="$(parent)PoisonSlot04_EquipAc" textureFile="/PoisonMaster/bin/equipA.dds">
					<Dimensions x="16" y="16"/>
					<Anchor point="TOPRIGHT" relativeTo="$(parent)PoisonSlot04" relativePoint="TOPRIGHT"/>
				</Texture>
			<!--------------------------------------------------------------------------------------------------------------------------------------------->
				<Texture name="$(parent)PoisonSlot04_EquipOc" textureFile="/PoisonMaster/bin/equipO.dds">
