<GuiXml>
	<Controls>
<!----------------------------------------------------------------------------------------------------------------------------------------------------------
Defines the clickable list functionality.
----------------------------------------------------------------------------------------------------------------------------------------------------------->
		<Control name="TBoxAddon_ListItemTemplate" virtual="true">
			<Dimensions x="940" y="18"/>
			<OnMouseEnter>
				ZO_ScrollList_MouseEnter(TBoxAddon_MainFrameListFrameList, self)
			</OnMouseEnter>
			<OnMouseExit>
				ZO_ScrollList_MouseExit(TBoxAddon_MainFrameListFrameList, self)
			</OnMouseExit>
			<OnMouseUp>
				if(upInside) then
					ZO_ScrollList_MouseClick(TBoxAddon_MainFrameListFrameList, self)
				end
			</OnMouseUp>
			<Controls>
				<Label name="$(parent)Name" font="ZoFontGame" mouseEnabled="true">
					<Dimensions x="840" y="16"/>
					<Anchor point="TOPLEFT"/>
					<OnMouseEnter>
						TBoxAddon.XMLNavigation(001, self, self:GetText(), 1, nil)
					</OnMouseEnter>
					<OnMouseExit>
						TBoxAddon.XMLNavigation(001, self, self:GetText(), 2, nil)
					</OnMouseExit>
					<OnMouseDown>
						TBoxAddon.XMLNavigation(002, nil, self:GetText(), button)
					</OnMouseDown>
				</Label>
			</Controls>
		</Control>
<!----------------------------------------------------------------------------------------------------------------------------------------------------------
Top-level control frame, backdrop, header, close and info buttons.
----------------------------------------------------------------------------------------------------------------------------------------------------------->
