					<Anchor point="TOPLEFT"  relativeTo="ODT_BAG" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
				</Backdrop>

				<!-- 	
				---------------------------------------
				BAG
				---------------------------------------
				 -->
				<Button name="ODT_BAG_INVENTORY_IMG" mouseEnabled="true" color="A5F81E" text="Close" hidden="false" >
                    <Dimensions x="24" y="24" />
					<Anchor relativeTo="ODT_BAG" point="TOPRIGHT" relativePoint="TOPRIGHT" offsetX="-160" offsetY="6" />
					<Textures normal="esoui/art/icons/item_generic_coinbag.dds" pressed="esoui/art/icons/item_generic_coinbag.dds" mouseOver="esoui/art/icons/item_generic_coinbag.dds" disabled="esoui/art/icons/item_generic_coinbag.dds"></Textures>
					<OnMouseEnter>XML_ODT_Navigation(self, 81)</OnMouseEnter>
					<OnMouseExit>XML_ODT_Navigation(self, 82)</OnMouseExit>
  				</Button>
				 
				<Label name="ODT_BAG_INVENTORY_PCENT" font="$(MEDIUM_FONT)|12" color="A5F81E" wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="RIGHT" text="" hidden="false" >
				<Anchor point="TOPRIGHT"  relativeTo="ODT_BAG" relativePoint="TOPRIGHT" offsetX="-135" offsetY="10"/>
