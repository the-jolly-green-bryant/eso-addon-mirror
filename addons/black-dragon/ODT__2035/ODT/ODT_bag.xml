<GuiXml>
    <Controls>
        <TopLevelControl name="ODT_BAG" mouseEnabled="true" movable="true" hidden="false">
			<Dimensions x="196" y="65" />
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="-400" offsetY="-400"/>
			<OnMoveStop>
				ODT_BAG.MoveStop()
			</OnMoveStop>

			<Controls>
 
