				<Label name="ODT_BAG_INVENTORY_NUMBERS" font="$(MEDIUM_FONT)|12" color="FFFFFF" wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="RIGHT" text=".../..." hidden="true" >
