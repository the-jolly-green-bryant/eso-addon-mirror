<GuiXml>
    <Font name="LedgerRowFont" font="$(MEDIUM_FONT)|16|shadow"/>

    <Controls>
        <!-- P5YCH3 - A new button within the inventory screen to bring up the ledger (optional). This can been controlled with the addon settings menu. -->
        <TopLevelControl name="GoldLedgerInventoryButton" mouseEnabled="true" movable="true" clampedToScreen="true">
            <Dimensions x="60" y="60" /><Anchor point="CENTER" />
            <Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="-20" />
            <Controls>
                <Button name="$(parent)Control" movable="true" font="ZoFontChat" horizontalAlignment="CENTER" verticalAlignment="CENTER" inheritAlpha="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetY="0" />
                    <Dimensions x="60" y="60" />
                    <Textures normal="/esoui/art/icons/poi/poi_areaofinterest_complete.dds" />
                    <FontColors normalColor="FFFFFF" />
                </Button>
            </Controls>
        </TopLevelControl>

        <Label name="LedgerRowLabel" font="LedgerRowFont" verticalAlignment="CENTER" wrapMode="ELLIPSIS" virtual="true">
            <Dimensions y="GOLD_LEDGER_ROW_HEIGHT"/>
        </Label>

        <Control name="LedgerRow" mouseEnabled="true" virtual="true">
            <Dimensions y="GOLD_LEDGER_ROW_HEIGHT"/>

            <OnMouseEnter>
                GOLD_LEDGER:EnterRow(self)
            </OnMouseEnter>

            <OnMouseExit>
                GOLD_LEDGER:ExitRow(self)
            </OnMouseExit>

            <Controls>
                <Texture name="$(parent)BG" inherits="ZO_ThinListBgStrip"/>

                <Label name="$(parent)Timestamp" inherits="LedgerRowLabel">
                    <Dimensions x="160"/>
                    <Anchor point="LEFT"/>
                </Label>

                <Label name="$(parent)Character" inherits="LedgerRowLabel">
                    <Dimensions x="180"/>
                    <Anchor point="LEFT" relativeTo="$(parent)Timestamp" relativePoint="RIGHT"/>
                </Label>

                <Label name="$(parent)Balance" inherits="LedgerRowLabel">
                    <Dimensions x="120"/>
                    <Anchor point="RIGHT"/>
                </Label>

                <Label name="$(parent)Variation" inherits="LedgerRowLabel">
                    <Dimensions x="120"/>
                    <Anchor point="RIGHT" relativeTo="$(parent)Balance" relativePoint="LEFT"/>
                </Label>

                <Label name="$(parent)Reason" inherits="LedgerRowLabel">
                    <Dimensions/>
                    <Anchor point="LEFT" relativeTo="$(parent)Character" relativePoint="RIGHT"/>
                    <Anchor point="RIGHT" relativeTo="$(parent)Variation" relativePoint="LEFT"/>
                </Label>
            </Controls>
        </Control>

        <!-- / -->

        <TopLevelControl name="Ledger" movable="true" mouseEnabled="true" resizeHandleSize="10" hidden="true">
            <Dimensions x="980" y="320"/>
            <DimensionConstraints minX="980" minY="320"/>
            <Anchor point="CENTER"/>

            <OnInitialized>
                GoldLedger_OnInitialized(self)
            </OnInitialized>

            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop">
                    <AnchorFill/>
                </Backdrop>

                <!-- P5YCH3 - New button to open the inventory menu. -->
                <Button name="$(parent)OpenInventoryButton" inherits="ZO_DefaultButton">
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT" offsetX="10" offsetY="10"/>
                    <OnClicked>
                        SCENE_MANAGER:Show('inventory')
                    </OnClicked>
                </Button>

                <!-- P5YCH3 - New button to open the addon settings menu. -->
                <Button name="$(parent)OpenSettingsButton" inherits="ZO_DefaultButton">
                    <Anchor point="TOPLEFT" relativePoint="TOPLEFT" relativeTo="$(parent)OpenInventoryButton" offsetX="90" offsetY="0"/>
                    <OnClicked>
                        GOLD_LEDGER:ShowAddonSettingsMenu()
                    </OnClicked>
                </Button>

                <!-- P5YCH3 - New button to show current bag gold, also opens the inventory when clicked. -->
                <Button name="$(parent)CurrentBagBalanceButton" inherits="ZO_DefaultButton">
                    <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" offsetX="-40" offsetY="10"/>
                    <!-- Only activate the interface if left mouse button is used.-->
                    <!-- <OnMouseUp>if button == MOUSE_BUTTON_INDEX_LEFT then tomUI.AlerterClick() end</OnMouseUp> -->
                    <OnMouseUp>
                        if button == MOUSE_BUTTON_INDEX_LEFT then
                            SCENE_MANAGER:Show('inventory')
                        elseif button == MOUSE_BUTTON_INDEX_RIGHT then
                            GOLD_LEDGER:SpawnMerchant()
                        elseif button == MOUSE_BUTTON_INDEX_MIDDLE then
                            GOLD_LEDGER:SpawnFence()
                        end
                    </OnMouseUp>
                </Button>

                <!-- P5YCH3 - New button to show current banked gold, also spawns the personal banker when clicked. -->
                <Button name="$(parent)CurrentBankBalanceButton" inherits="ZO_DefaultButton">
                    <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" offsetX="-140" offsetY="10"/>
                    <OnClicked>
                        GOLD_LEDGER:SpawnBanker()
                    </OnClicked>
                </Button>

                <!-- / -->

                <Button name="$(parent)CloseButton" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" offsetX="-10" offsetY="10"/>
                    <OnClicked>
                        GOLD_LEDGER:Toggle()
                    </OnClicked>
                </Button>

                <!-- / -->

                <Control name="$(parent)Title">
                    <Dimensions y="47"/>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                    <Controls>
                        <Texture name="$(parent)FadeLeft" textureFile="esoui/art/itemtooltip/iconstrip.dds" excludeFromResizeToFitExtents="true">
                            <Dimensions x="100" y="4"/>
                            <TextureCoords left="1" right="0"/>
                            <Anchor point="TOPRIGHT" relativePoint="TOP"/>
                        </Texture>
                        <Texture name="$(parent)FadeRight" textureFile="esoui/art/itemtooltip/iconstrip.dds" excludeFromResizeToFitExtents="true">
                            <Dimensions x="100" y="4"/>
                            <Anchor point="TOPLEFT" relativePoint="TOP"/>
                        </Texture>

                        <Texture name="$(parent)Icon" textureFile="esoui/art/icons/justice_stolen_coin_001.dds" excludeFromResizeToFitExtents="true" layer="OVERLAY" mouseEnabled="true">
                            <Dimensions x="64" y="64"/>
                            <Anchor point="CENTER" relativePoint="TOP"/>
                            <OnMouseDown>
                                GOLD_LEDGER.control:StartMoving()
                            </OnMouseDown>
                            <OnMouseUp>
                                GOLD_LEDGER.control:StopMovingOrResizing()
                            </OnMouseUp>
                        </Texture>
                    </Controls>
                </Control>

                <!-- / -->

                <Control name="$(parent)Options">
                    <Dimensions y="32"/>

                    <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetX="20"/>
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Title" relativePoint="BOTTOMRIGHT" offsetX="-20"/>

                    <Controls>
                        <Control name="$(parent)PeriodComboBox" inherits="ZO_ComboBox">
                            <Dimensions x="170"/>
                            <Anchor point="LEFT" relativePoint="LEFT"/>
                        </Control>
                        <Control name="$(parent)CharacterComboBox" inherits="ZO_ComboBox">
                            <Dimensions x="270"/>
                             <Anchor point="LEFT" relativeTo="$(parent)PeriodComboBox" relativePoint="RIGHT" offsetX="10"/>
                        </Control>
                        <Backdrop name="$(parent)Search" inherits="ZO_InsetBackground" centerColor="00000000" edgeColor="00000000">
                            <Dimensions x="200" y="31"/>
                            <Anchor point="LEFT" relativeTo="$(parent)CharacterComboBox" relativePoint="RIGHT" offsetX="10"/>
                            <Controls>
                                <EditBox name="$(parent)Box" inherits="ZO_DefaultEdit">
                                    <Anchor point="LEFT" offsetX="8"/>
                                    <Anchor point="RIGHT" offsetX="-8"/>
                                    <OnInitialized>
                                        ZO_EditDefaultText_Initialize(self, GetString(SI_GOLD_LEDGER_SEARCH_LABEL))
                                    </OnInitialized>
                                    <OnIMEBeginComposition>
                                        ZO_EditDefaultText_OnIMECompositionChanged(self)
                                    </OnIMEBeginComposition>
                                    <OnIMEEndComposition>
                                        ZO_EditDefaultText_OnIMECompositionChanged(self)
                                    </OnIMEEndComposition>
                                    <OnEscape>
                                        self:SetText("")
                                    </OnEscape>
                                    <Controls>
                                        <Label name="$(parent)Text" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_DEFAULT_TEXT" font="ZoFontEdit">
                                            <Anchor point="TOPLEFT"/>
                                            <Anchor point="BOTTOMRIGHT"/>
                                        </Label>
                                    </Controls>
                                </EditBox>
                            </Controls>
                        </Backdrop>
                        <Button name="$(parent)MergeCheckBox" inherits="ZO_CheckButton">
                            <Anchor point="LEFT" relativeTo="$(parent)Search" relativePoint="RIGHT" offsetX="15" offsetY="-1"/>
                        </Button>
                     </Controls>
                </Control>

                <!-- / -->

                <Control name="$(parent)Headers">
                    <Dimensions y="32"/>

                    <Anchor point="TOPLEFT" relativeTo="$(parent)Options" relativePoint="BOTTOMLEFT" offsetY="10"/>
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)Options" relativePoint="BOTTOMRIGHT" offsetY="10" offsetX="-10"/>

                    <Controls>
                        <Control name="$(parent)Timestamp" inherits="ZO_SortHeader">
                            <Dimensions x="160" y="32"/>
                            <Anchor point="LEFT"/>
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_GOLD_LEDGER_HEADER_TIMESTAMP), "timestamp", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Character" inherits="ZO_SortHeader">
                            <Dimensions x="180" y="32"/>
                            <Anchor point="LEFT" relativeTo="$(parent)Timestamp" relativePoint="RIGHT"/>
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_GOLD_LEDGER_HEADER_CHARACTER), "character", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Balance" inherits="ZO_SortHeader">
                            <Dimensions x="120" y="32"/>
                            <Anchor point="RIGHT"/>
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_GOLD_LEDGER_HEADER_BALANCE), "balance", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Variation" inherits="ZO_SortHeader">
                            <Dimensions x="120" y="32"/>
                            <Anchor point="RIGHT" relativeTo="$(parent)Balance" relativePoint="LEFT"/>
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_GOLD_LEDGER_HEADER_VARIATION), "variation", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Reason" inherits="ZO_SortHeader">
                            <Dimensions y="32"/>
                            <Anchor point="LEFT" relativeTo="$(parent)Character" relativePoint="RIGHT"/>
                            <Anchor point="RIGHT" relativeTo="$(parent)Variation" relativePoint="LEFT"/>
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_GOLD_LEDGER_HEADER_REASON), "reason", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
                            </OnInitialized>
                        </Control>
                    </Controls>
                </Control>

                <!-- / -->

                <Label name="$(parent)Summary" font="LedgerRowFont" verticalAlignment="CENTER" wrapMode="ELLIPSIS" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                    <Dimensions y="24"/>
                    <Anchor point="BOTTOMLEFT" offsetX="20" offsetY="-20"/>
                    <Anchor point="BOTTOMRIGHT" offsetX="-20" offsetY="-20"/>
                </Label>

                <!-- / -->

                <Control name="$(parent)List" inherits="ZO_ScrollList" >
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Headers" relativePoint="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Summary" relativePoint="TOPRIGHT" offsetX="6" offsetY="-10"/>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
