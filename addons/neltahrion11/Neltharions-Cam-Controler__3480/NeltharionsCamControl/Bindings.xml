<Bindings>
   <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
      <Category name="Neltharions Camera Control">
         <Action name="CAMERA_HORIZONTAL_INC">
            <Down>NeltharionsCamControl.StartHorizontalInc() return true</Down>
            <Up>NeltharionsCamControl.StopHorizontalInc() return true</Up>
         </Action>
         <Action name="CAMERA_HORIZONTAL_DEC">
            <Down>NeltharionsCamControl.StartHorizontalDec() return true</Down>
            <Up>NeltharionsCamControl.StopHorizontalDec() return true</Up>
         </Action>
         <Action name="CAMERA_HORIZONTALOFFSET_INC">
