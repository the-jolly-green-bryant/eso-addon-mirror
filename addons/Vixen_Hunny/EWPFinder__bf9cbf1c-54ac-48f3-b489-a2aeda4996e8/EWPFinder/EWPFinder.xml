                    <Anchor point="TOPLEFT" relativeTo="$(parent)SorceryBarFrame" offsetX="2" offsetY="2" />
                    <Dimensions x="306" y="14" />
                </StatusBar>

                <Label name="$(parent)SorceryBarName" font="/esoui/common/fonts/univers67.otf|14|soft-shadow-thin" color="D2944A" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="MAJOR SORCERY">
                    <Anchor point="LEFT" relativeTo="$(parent)SorceryBarFrame" relativePoint="LEFT" offsetX="6" offsetY="0"/>
