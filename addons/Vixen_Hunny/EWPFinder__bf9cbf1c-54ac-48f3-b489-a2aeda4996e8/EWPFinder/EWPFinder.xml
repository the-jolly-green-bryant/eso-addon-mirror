                    <Dimensions x="310" y="18" />
                    <Insets left="3" right="3" top="3" bottom="3" />
                </Backdrop>

                <StatusBar name="$(parent)BrutalityBar" min="0" max="100" value="0" mouseEnabled="false">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)BrutalityBarFrame" offsetX="2" offsetY="2" />
                    <Dimensions x="306" y="14" />
                </StatusBar>

                <Label name="$(parent)BrutalityBarName" font="/esoui/common/fonts/univers67.otf|14|soft-shadow-thin" color="D2944A" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="MAJOR BRUTALITY">
                    <Anchor point="LEFT" relativeTo="$(parent)BrutalityBarFrame" relativePoint="LEFT" offsetX="6" offsetY="0"/>
                </Label>

                <Label name="$(parent)BrutalityBarValue" font="/esoui/common/fonts/univers67.otf|14|soft-shadow-thin" color="FFFFFF" verticalAlignment="CENTER" horizontalAlignment="RIGHT" text="0%">
                    <Anchor point="RIGHT" relativeTo="$(parent)BrutalityBarFrame" relativePoint="RIGHT" offsetX="-6" offsetY="0"/>
                </Label>

                <Backdrop name="$(parent)SorceryBarFrame" mouseEnabled="false" edgeTexture="EsoUI/Art/ChatWindow/chatOptions_bgEdge.dds" centerTexture="EsoUI/Art/ChatWindow/chat_BG_center.dds">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" offsetX="30" offsetY="130" />
                    <Dimensions x="310" y="18" />
                    <Insets left="3" right="3" top="3" bottom="3" />
