<GuiXml>
    <Controls>
        <TopLevelControl name="EWPFinderContainer" clampedToScreen="true" hidden="false" layer="0" level="2">
            <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" offsetX="500" offsetY="520" />
            <Dimensions x="430" y="188" />
            <Controls>
                <Backdrop name="$(parent)Card" mouseEnabled="false" edgeTexture="EsoUI/Art/ChatWindow/chatOptions_bgEdge.dds" centerTexture="EsoUI/Art/ChatWindow/chat_BG_center.dds" hidden="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="-16" offsetY="-16" />
                    <Dimensions x="430" y="188" />
                    <Insets left="6" right="6" top="6" bottom="6" />
                </Backdrop>

                <Texture name="$(parent)GlowTop" textureFile="EsoUI/Art/Miscellaneous/horizontalDivider.dds" mouseEnabled="false" hidden="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Card" relativePoint="TOPLEFT" offsetX="10" offsetY="8" />
                    <Dimensions x="400" y="10" />
                </Texture>

                <Texture name="$(parent)GlowBottom" textureFile="EsoUI/Art/Miscellaneous/horizontalDivider.dds" mouseEnabled="false" hidden="true">
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)Card" relativePoint="BOTTOMLEFT" offsetX="10" offsetY="-8" />
                    <Dimensions x="400" y="10" />
                </Texture>

                <Label name="$(parent)HeaderLabel" font="/esoui/common/fonts/univers67.otf|18|soft-shadow-thick" color="E6A45C" verticalAlignment="TOP" horizontalAlignment="LEFT" text="EWPFINDER" hidden="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" offsetX="8" offsetY="-28"/>
                </Label>

                <Label name="$(parent)Label" font="/esoui/common/fonts/univers67.otf|21|soft-shadow-thick" color="FFFFFF" verticalAlignment="TOP" horizontalAlignment="LEFT" text="0">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" offsetX="6" offsetY="4"/>
                </Label>

                <Label name="$(parent)BuffLabel" font="/esoui/common/fonts/univers67.otf|21|soft-shadow-thick" color="FFFFFF" verticalAlignment="TOP" horizontalAlignment="LEFT" text="0" hidden="true" >
                <Anchor point="TOPLEFT" relativeTo="$(parent)" offsetX="30" offsetY="30"/>
                </Label>

                <Label name="$(parent)NotifLabel" font="/esoui/common/fonts/univers67.otf|23|soft-shadow-thick" color="FFFFFF" verticalAlignment="TOP" horizontalAlignment="LEFT" text="" hidden="true" >
                <Anchor point="TOPLEFT" relativeTo="$(parent)" offsetX="30" offsetY="56"/>
                </Label>

                <Label name="$(parent)UptimeLabel" font="/esoui/common/fonts/univers67.otf|21|soft-shadow-thick" color="FFFFFF" verticalAlignment="TOP" horizontalAlignment="LEFT" text="100%" hidden="true" >
                <Anchor point="TOPLEFT" relativeTo="$(parent)" offsetX="30" offsetY="80"/>
                </Label>

                <Backdrop name="$(parent)BrutalityBarFrame" mouseEnabled="false" edgeTexture="EsoUI/Art/ChatWindow/chatOptions_bgEdge.dds" centerTexture="EsoUI/Art/ChatWindow/chat_BG_center.dds">
