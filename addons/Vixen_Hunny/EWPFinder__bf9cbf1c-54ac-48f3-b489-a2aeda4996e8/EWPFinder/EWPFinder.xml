                    <Anchor point="RIGHT" relativeTo="$(parent)SorceryBarFrame" relativePoint="RIGHT" offsetX="-6" offsetY="0"/>
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
