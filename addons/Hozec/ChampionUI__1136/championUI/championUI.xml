<GuiXml>
    <Controls>
        <TopLevelControl name="CHAMPIONUI" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="true" resizeHandleSize="0">
            <Dimensions x="180" y="120" />
            <Anchor point="TOPLEFT" offsetX="0" offsetY="0" relativeTo="GuiRoot" relativePoint="CENTER" />
            <OnInitialized>
				CHAMPIONUI_OnInitialized(self)
			</OnInitialized>
            <Controls>
                <Backdrop name="$(parent)BG" inherits="ZO_ThinBackdrop"  alpha="0">
                <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"  offsetX="0" offsetY="0"/>
                <Dimensions x="180" y="120" />
                <AnchorFill />
                </Backdrop>
				<!-- <Backdrop name="$(parent)Border" edgeColor="FF0000" layer="0" level="2" centerColor="00000000" alpha="1"  hidden="false">
					<Dimensions x="180" y="120" />
					<Anchor point="TOPLEFT"  relativeTo="$(parent)" relativePoint="TOPLEFT"/>
					<Edge edgeSize="6" />
				</Backdrop> -->

                <Label name="$(parent)DisplayRank" font="ZoFontWinH5" color="D6660C" wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="">
                    <AnchorFill />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
                </Label>
				<Label name="$(parent)DisplayXP" font="ZoFontGameSmall" wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="">
                    <AnchorFill />
                    <Anchor point="TOPLEFT" relativeTo="$(parent)DisplayRank" relativePoint="BOTTOMLEFT"   offsetX="0" offsetY="0"/>
                </Label>
				<Label name="$(parent)UnspentLabel" font="ZoFontGameSmall" color="FFFFFF" wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="Unspent/Spent CP">
                    <AnchorFill />
                    <Anchor point="TOPLEFT" offsetX="1" relativeTo="$(parent)DisplayXP" relativePoint="BOTTOMLEFT" />
                </Label>
                <Label name="$(parent)Warriortxt" font="ZoFontGameSmall" color="D6660C" wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="Warrior:">
                    <AnchorFill />
                    <Anchor point="TOPLEFT" offsetX="0" relativeTo="$(parent)UnspentLabel" relativePoint="BOTTOMLEFT" />
                </Label>
                 <Label name="$(parent)WarriorLabel" font="ZoFontGameSmall"  wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="">
                    <AnchorFill />
                    <Anchor point="TOPLEFT" offsetX="0" offsetY="0" relativeTo="$(parent)UnspentLabel" relativePoint="BOTTOMRIGHT" />
                </Label>
                <Label name="$(parent)Thieftxt" font="ZoFontGameSmall" color="0dab36" wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="Thief:">
                    <AnchorFill />
                    <Anchor point="TOPLEFT" offsetX="0" relativeTo="$(parent)Warriortxt" relativePoint="BOTTOMLEFT" />
                </Label>
                <Label name="$(parent)ThiefLabel" font="ZoFontGameSmall"  wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="">
                    <AnchorFill />
                    <Anchor point="TOPLEFT" offsetX="0" offsetY="0" relativeTo="$(parent)WarriorLabel" relativePoint="BOTTOMLEFT" />
                </Label>
				<Label name="$(parent)Magetxt" font="ZoFontGameSmall" color="1970c9" wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="Mage:">
                    <AnchorFill />
                    <Anchor point="TOPLEFT" offsetX="0" relativeTo="$(parent)Thieftxt" relativePoint="BOTTOMLEFT" />
                </Label>
                <Label name="$(parent)MageLabel" font="ZoFontGameSmall"  wrapMode="ELLIPSIS" verticalAlignment="CENTER" horizontalAlignment="LEFT" text="">
                    <AnchorFill />
                    <Anchor point="TOPLEFT" offsetX="0" offsetY="0" relativeTo="$(parent)ThiefLabel" relativePoint="BOTTOMLEFT" />
                </Label>
				<!-- <Label name="$(parent)Label" font="ZoFontWinH3."  color="dbd53d" wrapMode="ELLIPSIS" verticalAlignment="TOPLEFT" horizontalAlignment="LEFT" text="">
                    <AnchorFill />
                     <Anchor point="TOPLEFT"  relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
                    <Dimensions x="220" />
                </Label> -->
	
				
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>