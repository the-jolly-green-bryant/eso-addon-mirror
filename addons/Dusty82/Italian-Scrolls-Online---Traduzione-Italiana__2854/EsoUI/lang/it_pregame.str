[SI_TRIBUTEMECHANIC_PLAYERPERSPECTIVE11] = "Crea |cffffff<<X:1>>|r <<C:2>> <<1[carta/carte]>> e inserisci<<1[la/le]>> nel tuo <<z:3>> ."
[SI_TRIBUTEMECHANIC_PLAYERPERSPECTIVE12] = "Lancia - Guarda le successive <<2[card/|cffffff<<X:2>>|r carte]>> del tuo mazzo. <<1[Puoi spostare quella carta/Scegliere fino a |cffffff%d|r di quelle carte da spostare]>> nella tua pila di ricarica."
