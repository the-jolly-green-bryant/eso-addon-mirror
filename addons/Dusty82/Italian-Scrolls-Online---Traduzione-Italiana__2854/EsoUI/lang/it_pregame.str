[SI_DELETE_CHARACTER] = "Elimina <<X:1>>"
[SI_DELETE_CHARACTER_CONFIRMATION_BUTTON] = "Elimina"
[SI_DELETE_CHARACTER_CONFIRMATION_TEXT] = "ELIMINA"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_CONTINUE] = "Continua"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TEXT] = "Puoi cancellare ancora<<1>><<1[/personaggio/personaggi]>>.\n\n|cff9633Cancellare un personaggio con oggetti ottenuti o riscattati dal Negozio delle Corone causerà la perdita di tali oggetti dal tuo account.|r\n\nSe vuoi tenere questi oggetti visita la banca più vicina e depositali presso la banca.\n\nCollezionabili come Cavalcature, Pet, Costumi e aggiornamenti account non verranno persi.\n\nGli oggetti equipaggiati dal personaggio e l'inventario verranno distrutti."
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TITLE] = "Elimina personaggio"
[SI_DELETE_CHARACTER_DIALOG_TEXT] = "|cff0000Cancellare un personaggio con oggetti dal Negozio delle Corone o riscattati tramite codice nel tuo inventario causerà la perdita di tali oggetti dal tuo account.|r \n\nCollezionabili come Cavalcature, Pet, Costumi e Aggiornamenti Account non saranno persi. Gli oggetti equipaggiati dal personaggio e contenuto del suo inventario verranno distrutti. Se intendi conservare tali oggetti, visita la banca più vicina per depositarli.\n\nPuoi al momento cancellare |cFFFFFF<<4>>|r <<4[/personaggio/personaggi]>>. Cancellazioni aggiuntive saranno disponibili più avanti.\n\nSei sicuro di voler cancellare |cFFFFFF<<1>>|r? Per confermare, digita |cFFFFFF<<2>>|r qui sotto e clicca il tasto <<3>>."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TEXT] = "In questo momento non puoi eliminare nessun personaggio.\n\nLe eliminazioni saranno di nuovo disponibili a breve. Riprova più tardi."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TITLE] = "Impossibile eliminare il personaggio"
[SI_DELETE_CHARACTER_DISABLED_TOOLTIP] = "Per il momento non puoi eliminare un personaggio.\n\nLe cancellazioni diventano disponibili a breve. Si prega di riprovare più tardi."
[SI_DELETE_CHARACTER_ENABLED_TOOLTIP] = "Al momento puoi cancellare |cFFFFFF<<1>>|r <<1[/personaggio/personaggi]>>.\n\nPotrai cancellare un altro personaggio dopo un po' di tempo."
[SI_DELETE_CHARACTER_GAMEPAD_DELETING] = "Eliminazione"
