[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE0] = "|cff1919Setback|r - L'avversario guadagna |cffffff<<X:1>>|r <<t:2>>."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE10] = "|cff1919Setback|r - <<3>> Aggiorna - Ritorna fino a |cffffff<<X:1>>|r <<z:2>> <<1[carta/carte]>> dalla pila di ricarica del tuo avversario alla sua <<z:3>>."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE11] = "Crea |cffffff<<X:1>>|r <<C:2>> <<1[carta/carte]>> e piazza<<1[la/le]>>> nella  <<z:3>> del tuo avversario."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE12] = "Lancia - Guarda le successive <<2[card/|cffffff<<X:2>>|r carte]>> del mazzo di pesca dell'avversario. <<1[Puoi spostare quella carta/Scegliere fino a |cffffff%d|r di quelle carte da spostare]>> nella loro pila di ricarica."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE14] = "Confina - Metti |cffffff<<X:1>>|r <<1[carta/carte]>> dalle <<z:2>> del tuo avversario sotto questa carta finché questa carta non viene rimossa dal gioco."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE16] = "Ottieni |cffffff<<X:1>>|r <<1[carta/carte]>> dalla Taverna. Il tuo avversario guadagna <<1[una copia/una copia di ciascuno]>>."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE2] = "Butta Giù - Metti |cffffff<<X:1>>|r degli agenti attivi del tuo avversario nella sua pila di ricarica."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE3] = "L'avversario scarta |cffffff<<X:1>>|r <<1[carta/carte]>> dalla sua mano all'inizio del proprio turno."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE4] = "|cff1919Setback|r - L'avversario pesca |cffffff<<X:1>>|r <<1[carta/carte]>>."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE5] = "Break - L'Avversario Perde |cffffff<<X:1>>|r <<t:2>>."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE6] = "|cff1919Setback|r - Cura |cffffff<<X:1>>|r <<1[agente/agenti]>> controllati dal tuo avversario per |cffffff<<2>>|r salute."
[SI_TRIBUTEMECHANIC_OPPONENTPERSPECTIVE7] = "Distruggi fino a |cffffff<<X:1>>|r carte del tuo avversario che sono in gioco dalla partita."
