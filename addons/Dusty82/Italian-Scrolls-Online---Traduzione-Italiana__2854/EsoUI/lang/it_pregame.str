[SI_ACCESSIBILITY_OPTIONS_MOUSE_AIM_ASSIST_INTENSITY] = "ntensità della Mira Assistita del Mouse"
[SI_ACCESSIBILITY_OPTIONS_MOUSE_AIM_ASSIST_INTENSITY_TOOLTIP] = "Regola l'intensità della mira assistita per le abilità del raggio dell'Arcanist durante l'utilizzo di un mouse. L'impostazione a zero elimina la mira assistita."
