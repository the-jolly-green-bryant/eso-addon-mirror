[SI_ACCESSIBILITY_OPTIONS_ACCESSIBLE_QUICKWHEELS_TOOLTIP] = "Se abilitati, i Menù a Ruota possono essere attivati o disattivati e sono navigabili tramite tasti di scelta rapida."
[SI_ACCESSIBILITY_OPTIONS_ARCANIST] = "Mira Assistita dell'Arcanista"
[SI_ACCESSIBILITY_OPTIONS_GAMEPAD_AIM_ASSIST_INTENSITY] = "Intensità della Mira Assistita del Gamepad"
[SI_ACCESSIBILITY_OPTIONS_GAMEPAD_AIM_ASSIST_INTENSITY_TOOLTIP] = "Regola l'intensità della mira assistita per le abilità del raggio dell'Arcanista durante l'utilizzo di un gamepad. L'impostazione a zero elimina la mira assistita."
