[SI_GUILD_INFO_SCENE_TITLE] = "Informazioni sulla Gilda"
[SI_GUILD_INTRODUCTION] = "Le gilde sono un ottimo modo per collaborare con i viaggiatori che incontri mentre esplori il mondo di Tamriel! Questi grandi gruppi consentono ai giocatori di unirsi, lavorare per obiettivi comuni e sbloccare vantaggi extra come i Negozi della Gilda."
