[SI_ZONECOMPLETIONTYPE4] = "Santuari"
[SI_ZONECOMPLETIONTYPE5] = "Esplorazioni"
[SI_ZONECOMPLETIONTYPE6] = "Esplorazioni di Gruppo"
[SI_ZONECOMPLETIONTYPE7] = "Frammenti Celesti"
[SI_ZONECOMPLETIONTYPE8] = "Eventi del mondo"
[SI_ZONECOMPLETIONTYPE9] = "Boss del Mondo"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "|cffffffLe Storie delle Missioni della Zona|r sono l'arco narrativo principale della zona. Il completamento di queste missioni può premiarti con punti abilità, esperienza, oro e equipaggiamento."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "|cffffffLuoghi Suggestivi|r sono luoghi di interesse all'interno del mondo. La scoperta di tutti i Luoghi Suggestivi in una zona ti premierà con l'obiettivo Pioniere di quella zona."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "|cffffffI Libri della Biblioteca di Shalidor|r sono sparsi in tutto il mondo. Questi libri sono identificati dal loro caratteristico bagliore viola. La scoperta di questi libri migliorerà il tuo rango nella gilda dei maghi e farà avanzare la linea di abilità associata."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "|cffffffLe Pietre Mundus|r sono oggetti del mondo che garantiscono al giocatore un vantaggio sotto forma di effetto temporaneo. Questo effetto resterà fino a quando non verrà sostituito con un altro effetto delle Pietre Mundus."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "|cffffffI Dungeon Pubblici|r sono dungeon open world che si trovano in tutta Tamriel e nel resto del mondo. Sono progettati per gruppi quattro di giocatori. Il completamento delle diverse parti dei dungeon pubblici possono premiarti con un punto abilità, esperienza, oro ed equipaggiamento."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "|cffffffLe Postazioni dei Set|r sono luoghi all'interno del mondo in cui è possibile creare oggetti con dei bonus specifici per il set."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "|cffffffI Punti di interesse|r sono storie autonome che raccontano la tradizione, i personaggi e i luoghi all'interno di una zona. Questi possono premiarti con esperienza, oro e attrezzatura."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "|cffffffI Santuari|r consentono di viaggiare in maniera istantanea e gratuita tra i vari santuari scoperti e sbloccati. Puoi anche viaggiare direttamente in qualsiasi santuario sbloccato da qualsiasi punto del mondo al costo di piccola quantità di oro."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "|cffffffLe Esplorazioni|r sono dungeon che si affrontano da soli e si trovano in tutto il mondo. Le Esplorazioni ti ricompenseranno sempre con un frammento celeste e un boss che lascerà oggetti di un set d'equipaggiamento."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "|cffffffLe Esplorazioni di Gruppo|r sono dungeon che si trovano a Craglorn, sono pensati per un gruppo da quattro di giocatori.Le Esplorazioni di Gruppo ti ricompenseranno sempre con un frammento celeste e un boss che lascerà oggetti di un set d'equipaggiamento."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "|cffffffI Frammenti Celesti|r sono sparsi in tutto il mondo e possono essere identificati da un fascio luminoso di luce bianca che emanano.Raccogliendo tre Frammenti Celesti guadagnerai un punto abilità, che potrà essere utilizzato per sbloccare o trasformare nuove abilità."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "|cffffffGli Eventi del Mondo|r come le Ancore Oscure sono attività che si verificano nel mondo e che possono essere affrontate al meglio da un gruppo di avventurieri. Il completamento di un evento mondiale può farti guadagnare esperienza, oro e equipaggiamento di livello superiore."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION9] = "|cffffffI Boss del Mondo|r sono nemici difficili destinati ad essere affrontati da un gruppo di avventurieri. Sconfiggendo un boss del mondo puoi essere premiato con equipaggiamento di livello superiore."
[SI_ZONECOMPLETIONTYPE_PROGRESSDESCRIPTION10] = "Scoperti <<1>> Luoghi Suggestivi a <<2>>"
