[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY101] = "Sfruttamento e abuso sessuale infantile"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY102] = "Terrorismo o estremismo violento"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY103] = "Autolesionismo/Suicidio"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY104] = "Danno imminente a persone o proprietà"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY201] = "Discorsi d'odio"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY202] = "Disturbare"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY203] = "Spam"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY204] = "Chat Vocale Blasmefa"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY205] = "Nome Blasfemo/<<1>>"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY301] = "Truffa"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY302] = "Doxing/condivisione di informazioni personali"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY303] = "Trucchi/Sfruttamento di Bug"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY304] = "Molestie/bullismo"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "Usalo per segnalare qualsiasi problema di pericolo relativo ai bambini. Questo può portare ad una denuncia alla polizia."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = "Usatelo quando vedete una situazione che arriva ad un livello che può richiedere la notifica alle autorità federali preposte all'applicazione della legge."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "Usalo se stai osservando un comportamento che va notificato per far eseguire un controllo da parte della polizia."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "In caso di pericolo immediato, si prega di contattare i servizi di emergenza locali oltre a compilare questo rapporto."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "Usalo per segnalare discorsi o scritte offensive e minacciose che esprimono pregiudizi contro un gruppo particolare, specialmente sulla razza, nazionalità, religione o orientamento sessuale."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "Usalo per segnalare qualcuno che sta deliberatamente disturbando l'ambiente di gioco o l'esperienza della comunità."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "Usalo per segnalare un altro giocatore che invia lo stesso messaggio più e più volte nella chat."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = "Usalo per segnalare solo la chat Vocale."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = "Usalo per segnalare il nome del personaggio o <<1>> blasfemo o offensivo."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "I CSR valuteranno i log della chat di gioco per confermare i dettagli dello scambio e confrontarli con i log del gioco."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "Usa questa opzione per segnalare qualsiasi giocatore che pubblica informazioni sulla vita reale di un altro giocatore."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "Questo include, ma non è limitato a, l'uso di programmi di terze parti (bot), armi modificate, hack dei muri, glitch del terreno, trolling delle pergamene, ecc."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION304] = "Usa questa opzione quando i giocatori usano il testo o le meccaniche di gioco per eseguire ripetutamente comportamenti indesiderati dopo che gli è stato chiesto di fermarsi."
