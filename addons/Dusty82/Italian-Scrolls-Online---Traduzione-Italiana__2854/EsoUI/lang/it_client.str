[SI_GUILD_KIOSK_DISPLAY_CAPTION_WITH_OWNER] = "Commerciante della Gilda (<<1>>)"
[SI_GUILD_KIOSK_INITIAL_BID] = "Invia Offerta"
[SI_GUILD_KIOSK_MINIMUM_BID_HEADER] = "Offerta Minima:"
[SI_GUILD_KIOSK_NEW_BID_HEADER] = "Nuova Offerta:"
[SI_GUILD_KIOSK_PURCHASE] = "Assumere"
[SI_GUILD_KIOSK_PURCHASE_COST] = "Costo di Assunzione:"
[SI_GUILD_KIOSK_PURCHASE_DESCRIPTION] = "La tua gilda può assumere questo commerciante per un uso immediato. Una volta assunto, il negozio della tua gilda sarà reso disponibile al pubblico tramite questo commerciante per il prossimo |cffffff<<1>>|r.\n\n|cffffffNOTA:|r Può essere assunto un solo commerciante alla volta per ogni gilda."
