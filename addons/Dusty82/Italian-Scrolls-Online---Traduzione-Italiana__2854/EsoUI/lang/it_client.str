[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_ADDITIONAL_DETAILS] = "Informazioni Aggiuntive (Facoltativo)"
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_GROUP_FINDER_LISTING_DETAILS] = "Dettagli sulla Ricerca Gruppo"
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_GROUP_FINDER_LISTING_INSTRUCTIONS] = "Per aiutarci a risolvere il tuo problema, \"Segnala\" l'elenco incriminato dal menu Ricerca Gruppi per fornirci i dettagli e le informazioni dell'elenco."
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_GUILD_NAME] = "Nome Gilda"
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_NO_QUEST_HINT] = "Il Supporto Clienti non può fornire aiuto per terminare le missioni. Se hai bisogno di aiuto o di suggerimenti su come completare una missione, gli altri giocatori sul forum  |c2e86b8<<1>>|r sono una grande fonte di informazioni. In aggiunta, puoi consultare una delle tante guide su ESO della community."
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_PLAYER_NAME] = "Nome Giocatore"
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_SUBMIT_TICKET_CONFIRMATION] = "<<1>>"
[SI_CUSTOMER_SERVICE_ATTACH_SCREENSHOT] = "Allega Screenshot"
[SI_CUSTOMER_SERVICE_CATEGORY] = "Categoria"
[SI_CUSTOMER_SERVICE_CHARACTER_STUCK] = "Personaggio Incastrato"
[SI_CUSTOMER_SERVICE_DEFAULT_DESCRIPTION_TEXT_FEEDBACK] = "Includi i seguenti dettagli:\nCosa stavi facendo?\nCosa ti aspettavi che accadesse?\nChe cosa è realmente accaduto?"
[SI_CUSTOMER_SERVICE_DEFAULT_DESCRIPTION_TEXT_GENERIC] = "Per favore, aggiungi qualsiasi dettaglio ritieni importante."
[SI_CUSTOMER_SERVICE_DESCRIPTION] = "Descrizione"
[SI_CUSTOMER_SERVICE_ENTER_NAME] = "Inserisci Nome"
[SI_CUSTOMER_SERVICE_ESO_FORUMS_LINK_TEXT] = "Forum The Elder Scrolls Online"
[SI_CUSTOMER_SERVICE_ESO_HELP_LINK_TEXT] = "Supporto The Elder Scrolls Online"
[SI_CUSTOMER_SERVICE_FEEDBACK_IMPACT_DESCRIPTION] = "Usa il feedback quando vuoi segnalare un bug o fornire un feedback direttamente al team di sviluppo. Le richieste di aiuto NON riceveranno risposta se presentate attraverso il feedback. Per favore seleziona una categoria APPROPRIATA se hai bisogno di aiuto per qualcos'altro."
[SI_CUSTOMER_SERVICE_GET_ME_UNSTUCK] = "Liberami"
[SI_CUSTOMER_SERVICE_IMPACT] = "Impatto"
[SI_CUSTOMER_SERVICE_ITEM_ASSISTANCE] = "Assistenza oggetto"
[SI_CUSTOMER_SERVICE_ITEM_ASSISTANCE_NAME_INSTRUCTIONS] = "Per aiutarci a risolvere il problema, forniscici i dettagli e le informazioni sull'oggetto accedendo al tuo inventario e seleziona "Ottieni assistenza" dal menu delle opzioni dell'oggetto."
