[SI_INTERFACE_OPTIONS_ACTION_BAR_TOOLTIP] = "Controlla la visibilità della barra delle abilità. Quando è selezionata la visualizzazione automatica, la barra delle abilità apparirà solo in situazioni utili come il combattimento e il puntamento di un nemico."
[SI_INTERFACE_OPTIONS_ACT_SETTING_LABEL] = "Attiva Consigli Combattimento"
[SI_INTERFACE_OPTIONS_ACT_SETTING_LABEL_TOOLTIP] = "Controlla la visualizzazione di utili consigli di combattimento nella parte inferiore del heads up display. Quando viene scelto il display automatico, verrà mostrato solo quando necessario per imparare le meccaniche di base del combattimento."
[SI_INTERFACE_OPTIONS_AUTOMATIC_QUEST_TRACKING] = "Traccia Automatica delle Missioni"
[SI_INTERFACE_OPTIONS_AUTOMATIC_QUEST_TRACKING_TOOLTIP] = "Traccia automaticamente una missione quando la accetti."
[SI_INTERFACE_OPTIONS_BATTLE_LEVEL] = "Livello di Battaglia"
