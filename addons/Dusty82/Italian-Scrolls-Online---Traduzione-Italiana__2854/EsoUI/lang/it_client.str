[SI_GUILD_KEEP_ATTACK_END] = "Nessuna altra guardia è stata uccisa a <<1>>."
[SI_GUILD_KEEP_ATTACK_UPDATE] = "<<1>> <<1[la guardia è stata uccisa/le guardie sono state uccise]>>  a <<2>> da <<3>> <<3[giocatore/i]>>."
[SI_GUILD_KEEP_OWNERSHIP_HEADER] = "Guerra dell'Alleanza\nProprietà"
[SI_GUILD_KIOSK_BANKED_GOLD_HEADER] = "Saldo Banca della Gilda:"
[SI_GUILD_KIOSK_BIDDING_CLOSES_IN_HEADER] = "L'offerta scade tra:"
[SI_GUILD_KIOSK_BID_DESCRIPTION] = "La tua gilda potrebbe fare un'offerta per assumere questo commerciante per un uso futuro. Il negozio della gilda vincitrice sarà reso disponibile al pubblico tramite questo commerciante per un totale di |cffffff7 giorni|r. Il periodo di assunzione non inizia fino a quando non è stato determinato un vincitore alla fine dell'asta.\n\n|cffffffNOTA:|r Puoi fare offerte per un massimo di |cffffff<<1>>|r commercianti per gilda a settimana, comunque puoi vincerne solamente |cffffff1|r, in base alla tua offerta più alta. Se ci sono più offerte dello stesso importo, vince la prima. Tutte le altre offerte verranno rimborsate alla chiusura delle offerte."
[SI_GUILD_KIOSK_BID_ERROR_TRADING_HOUSE_LOCKED] = "Le gilde devono aver sbloccato i Negozi delle Gilde per poter fare offerte a un Commerciante della Gilda. Questa gilda non ha i  |cffffff<<1>>|r membri richiesti."
[SI_GUILD_KIOSK_BID_GUILD_CHOICE_HEADER] = "Offerta della Gilda:"
[SI_GUILD_KIOSK_BID_RATE_EXCEEDED] = "Tasso di offerta superato."
[SI_GUILD_KIOSK_BID_TITLE] = "Fai un'offerta al Commerciante della Gilda"
