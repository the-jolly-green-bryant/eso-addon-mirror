[SI_GOODBYE] = "Arrivederci."
[SI_GRAPHICSMODE0] = "Fedeltà"
[SI_GRAPHICSMODE1] = "Prestazioni"
[SI_GRAPHICSPRESETS0] = "Minima"
[SI_GRAPHICSPRESETS1] = "Bassa"
[SI_GRAPHICSPRESETS16] = "Massima"
[SI_GRAPHICSPRESETS2] = "Media"
[SI_GRAPHICSPRESETS3] = "Alta"
[SI_GRAPHICSPRESETS4] = "Ultra"
[SI_GRAPHICSPRESETS7] = "Personalizzata"
[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT] = "Limite FPS"
[SI_GRAPHICS_OPTIONS_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Imposta gli FPS massimi a cui il gioco è limitato quando l'opzione Limita FPS in background è attivata e il gioco è in esecuzione in background."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY] = "Grafica"
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP] = "Controlla la qualità del rendering."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_PS5] = "Fedeltà - Privilegia la risoluzione rispetto alla frequenza dei fotogrammi.\n\nPrestazioni - Privilegia la frequenza dei fotogrammi rispetto alla risoluzione."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSS] = "Fedeltà - Privilegia la risoluzione rispetto alla frequenza dei fotogrammi.\n\nPrestazioni—Privilegia la frequenza dei fotogrammi rispetto alla risoluzione."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSX] = "Fedeltà—Privilegia la risoluzione rispetto al frame rate.\n\nPrestazioni—Privilegia il frame rate rispetto alla risoluzione."
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT] = "Limita FPS Background"
[SI_GRAPHICS_OPTIONS_USE_BACKGROUND_FPS_LIMIT_TOOLTIP] = "Abilita un limite sui FPS quando il gioco è in esecuzione in background per conservare le risorse di CPU e GPU."
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY] = "Monitor attivo"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_FORMAT] = "Monitor <<1>>"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_TOOLTIP] = "Imposta il monitor."
[SI_GRAPHICS_OPTIONS_VIDEO_AMBIENT_OCCLUSION_TYPE] = "Occlusione ambientale"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING] = "Anti-Aliasing"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING_TOOLTIP] = "Ammorbidisce il bordo degli oggetti nel mondo. La disabilitazione di questa opzione può migliorare le prestazioni a discapito di contorni più grezzi negli oggetti."
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM] = "Bloom"
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM_TOOLTIP] = "Aumenta l'intensità delle sorgenti luminose. Disabilitare questa opzione può migliorare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_ABILITY] = "Capacità"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_DISPLAY] = "Visualizzazione"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_GRAPHICS] = "Grafica"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION] = "Character Resolution"
[SI_GRAPHICS_OPTIONS_VIDEO_CHARACTER_RESOLUTION_TOOLTIP] = "Determines the number of high resolution characters near the player and distance at which they appear."
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY] = "Erba"
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY_TOOLTIP] = "Determina la quantità di erba presente nel mondo. Impostazioni più alte aumenteranno la distanza dalla quale l'erba sarà visibile. Diminuendo questa impostazione potresti aumentare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE] = "Profondità di Campo"
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE_TOOLTIP] = "Determina l'aspetto della profondità di campo che simula l'effetto fotografico che fa apparire gli oggetti distanti fuori fuoco in base alla distanza in cui si trovano dagli oggetti in primo piano."
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE] = "Modalità Video"
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE_TOOLTIP] = "Imposta la modalità di visualizzazione del gioco principale."
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION] = "Distorsione"
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION_TOOLTIP] = "Crea un effetto di distorsione intorno a determinati oggetti. La disabilitazione di questa opzione può migliorare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE] = "Modalità DLSS"
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE_TOOLTIP] = "Controlla l'equilibrio tra qualità e miglioramento delle prestazioni quando NVIDIA DLSS è abilitato."
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE] = "Modalità FSR"
[SI_GRAPHICS_OPTIONS_VIDEO_FSR_MODE_TOOLTIP] = "Controlla il bilanciamento tra qualità e prestazioni quando è abilitata la funzione Fidelity Fx Super Resolution (FSR)."
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT] = "Regolazione Gamma"
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT_TOOLTIP] = "Regola la gamma generale (luminosità) del gioco senza influire sulle sue prestazioni. Cambia questa impostazione se il gioco appare troppo chiaro o troppo scuro."
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS] = "Raggi solari"
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS_TOOLTIP] = "Questa opzione visualizza i raggi solari in base all'angolo del sole rispetto alla telecamera. La disabilitazione di questa opzione può migliorare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED] = "HDR (Beta)"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_ENABLED_TOOLTIP] = "Enables HDR if the game is running on a HDR supported monitor with HDR enabled."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE] = "Modalità HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE_TOOLTIP] = "Imposta la modalità HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS] = "Luminosità di Picco HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_PEAK_BRIGHTNESS_TOOLTIP] = "Imposta la Luminosità di Picco HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS] = "Luminosità della scena HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_BRIGHTNESS_TOOLTIP] = "Imposta la luminosità della scena HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST] = "Contrasto della scena HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_SCENE_CONTRAST_TOOLTIP] = "Imposta il contrasto della scena HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS] = "Luminosità UI HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_BRIGHTNESS_TOOLTIP] = "Imposta la luminosità UI HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST] = "Contrasto UI HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_UI_CONTRAST_TOOLTIP] = "Imposta il contrasto UI HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_MAC_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Migliora la fedeltà delle ombre e dell'illuminazione tenendo conto degli oggetti che bloccano la luce. HBAO è più pesante di SSAO ma fornisce un risultato più realistico. Disabilitare questa impostazione può aiutare a migliorare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS] = "Sistema particellare massimo"
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_RESTRICTION] = "Questa impostazione diventerà effettiva dopo la disconnessione o lo spostamento in un'altra posizione."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_TOOLTIP] = "Determina il numero totale di particelle visualizzate nel mondo in una sola volta. La riduzione di questa impostazione riduce il numero di particelle sullo schermo, ma può migliorare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED] = "Eliminazione dell'Occlusione Software"
[SI_GRAPHICS_OPTIONS_VIDEO_OCCLUSION_CULLING_ENABLED_TOOLTIP] = "Controlla se l'eliminazione dell'occlusione è abilitata. L'eliminazione dell'occlusione utilizzerà una maggiore quantità di CPU per ridurre il carico di lavoro della GPU. Utilizzalo se il framerate è limitato dalla tua GPU."
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Distanza Rimozione delle Particelle"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Regola la distanza alla quale le particelle non essenziali non sono più visibili. L'aumento di questo numero mostrerà più particelle, ma potrebbe influire sulle prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Qualità del Riflesso Planare"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Determina la risoluzione e il dettaglio dei riflessi planari mostrati sulla superficie dell'acqua. I riflessi planari sono di alta qualità ma possono ridurre le prestazioni quando sono abilitati. L'acqua che non può usare i riflessi planari ricadrà nei riflessi dello spazio dello schermo."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Qualità Grafica"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Imposta la qualità generale della grafica di gioco, regolando tutte le opzioni avanzate di seguito."
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Rendering Multithread"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Abilita un thread separato per il processo di rendering, che può migliorare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Risoluzione"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT] = "<<1>>x<<2>>"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (Esteso)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Specifica la risoluzione con cui verrà visualizzato il gioco. Aumentando la risoluzione si ottiene un'immagine ad alta fedeltà ma diminuiranno le prestazioni. La risoluzione scelta dovrebbe rispettare le proporzioni del monitor."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Qualità Riflessi dello Spazio sullo Schermo"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Determina la qualità dei riflessi dello spazio dello schermo sulla superficie dell'acqua. Aumentando questa impostazione si migliora l'accuratezza del riflesso ma può diminuire le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Qualità delle Ombre"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Determina la qualità delle ombre visualizzate nel mondo. Le impostazioni più alte influenzano la distanza con cui vengono disegnate le ombre, la loro precisione e il numero di oggetti. Riducendo la qualità si possono migliorare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "Mostra Effetti Aggiuntivi degli Alleati"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Mostra tutte le abilità offensive permanenti degli alleati nei dungeon o nelle aree aperte. Disabilitare questa opzione può migliorare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "Qualità del Sottocampionamento"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Determina la risoluzione con cui il gioco mostra il mondo. L'interfaccia non è influenzata da questa impostazione. Ridurre la qualità può migliorare le prestazioni."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Qualità delle Texture"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Controlla la qualità delle texture utilizzate in tutto il mondo modificandone le dimensioni. Impostazioni più elevate mostrano maggiori dettagli degli oggetti, personaggi e dintorni, ma richiedono una maggiore quantità di memoria video per una visualizzazione fluida."
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "Distanza Visiva"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Regola la distanza alla quale alcuni oggetti di gioco non saranno più visibili. Aumentandolo si ottiene un ambiente più ricco e realistico ma prestazioni ridotte."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Sincronizzazione Verticale"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Elimina gli artefatti sincronizzando la velocità del display con la frequenza di aggiornamento del monitor."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Migliora la fedeltà delle ombre e dell'illuminazione tenendo conto degli oggetti che bloccano la luce. LSAO è più realistico e più costoso di HBAO, che è più realistico e più costoso di SSAO. Lo Spazio sullo Schermo GI migliora LSAO tenendo conto dei rimbalzi di luce aggiuntivi. Disabilitare questa impostazione può aiutare a migliorare le prestazioni."
