SAS(SI_ZONECOMPLETIONTYPE_DESCRIPTION1, "(.ﺔﺒﻌﻟ ﺕﺍﺩﺍﺪﻋﺇ ,ﺓﻮﻗ ,ﺓﻮﻗ ,ﺪﻳﺪﺟ ﻉﺭﺩ ﺕﺍﺩﺍﺪﻋﺇ ﺐﻫﺫ ﺐﻫﺫ ﺔﻄﻳﺮﺧ ﺔﻄﻳﺮﺧ ﺪﻳﺪﺟ ﻢﻳﺪﻗ .ﻯﻮﺘﺴﻣ ﺔﻤﻬﻣ ﺡﻼﺳ ﺔﺤﺻ ﺔﺒﻌﻟ ﻢﻳﺪﻗ ﺔﻤﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ |rﺔﻄﻳﺮﺧ ﺔﺒﻌﻟ ﻯﻮﺘﺴﻣ|cffffff)", 3)
SAS(SI_ZONECOMPLETIONTYPE_DESCRIPTION10, "(.ﺓﻮﻗ ﺐﻫﺫ ﺔﺒﻌﻟ’ﻯﻮﺘﺴﻣ ﺡﻼﺳ ﺐﻫﺫ ﺔﺤﺻ ﻯﻮﺘﺴﻣ ﻯﻮﺘﺴﻣ ﺕﺍﺩﺍﺪﻋﺇ ﻯﻮﺘﺴﻣ ﻢﻳﺪﻗ ﺔﻤﻬﻣ ﺔﻄﻳﺮﺧ ﺮﺤﺳ ﺓﺭﺎﻬﻣ .ﺓﺄﻓﺎﻜﻣ ﺔﻤﻬﻣ ﻉﺭﺩ ﺔﻄﻳﺮﺧ ﺔﻄﻳﺮﺧ ﻢﻳﺪﻗ ﺕﺍﺩﺍﺪﻋﺇ |rﻯﻮﺘﺴﻣ ﻢﻳﺪﻗ|cffffff)", 2)
SAS(SI_ZONECOMPLETIONTYPE_DESCRIPTION11, "(.ﻯﻮﺘﺴﻣ ﻉﺭﺩ ﺓﺄﻓﺎﻜﻣ ﺔﻤﻬﻣ ﺔﻄﻳﺮﺧ ﺕﺍﺩﺍﺪﻋﺇ ﺕﺍﺩﺍﺪﻋﺇ ﺓﺄﻓﺎﻜﻣ ﻉﺭﺩ ﻖﻳﺮﻓ ﺓﻮﻗ ﺔﺤﺻ ﺐﻫﺫ ﺪﻳﺪﺟ ﺓﺭﺎﻬﻣ .ﺐﻫﺫ ﺕﺍﺩﺍﺪﻋﺇ ﺓﺄﻓﺎﻜﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺔﺒﻌﻟ ﺓﺭﺎﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺐﻫﺫ ﺪﻳﺪﺟ .ﺓﺄﻓﺎﻜﻣ ﺔﻤﻬﻣ ﺡﻼﺳ ﻖﻳﺮﻓ ﺕﺍﺩﺍﺪﻋﺇ |rﺐﻫﺫ ﺔﺒﻌﻟ ﺔﺒﻌﻟ’ﺡﻼﺳ|cffffff)", 2)
SAS(SI_ZONECOMPLETIONTYPE_DESCRIPTION12, "(.ﺪﻳﺪﺟ ﺡﻼﺳ ﺪﻳﺪﺟ ﺪﻳﺪﺟ ﻯﻮﺘﺴﻣ ﺕﺍﺩﺍﺪﻋﺇ ﻖﻳﺮﻓ ﺡﻼﺳ ﺪﻳﺪﺟ ﺔﺤﺻ ﺓﺭﺎﻬﻣ ﻢﻳﺪﻗ .ﺓﺭﺎﻬﻣ ﺮﺤﺳ ﺓﺄﻓﺎﻜﻣ ﻯﻮﺘﺴﻣ ﺔﻄﻳﺮﺧ ﺔﺒﻌﻟ ﺔﻤﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺪﻳﺪﺟ ﻯﻮﺘﺴﻣ ﺓﺭﺎﻬﻣ ﺡﻼﺳ ﺓﺄﻓﺎﻜﻣ ﺔﻤﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺔﺒﻌﻟ ﺕﺍﺩﺍﺪﻋﺇ |rﺓﺄﻓﺎﻜﻣ ﺪﻳﺪﺟ|cffffff)", 2)
SAS(SI_ZONECOMPLETIONTYPE_DESCRIPTION13, "(.ﺔﺒﻌﻟ ﺕﺍﺩﺍﺪﻋﺇ ,ﺓﻮﻗ ,ﺓﻮﻗ ,ﺪﻳﺪﺟ ﻉﺭﺩ ﻯﻮﺘﺴﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺐﻫﺫ ﺐﻫﺫ ﺔﻄﻳﺮﺧ ﺕﺍﺩﺍﺪﻋﺇ ﺪﻳﺪﺟ ﺔﻄﻳﺮﺧ ﺔﺒﻌﻟ ﺪﻳﺪﺟ ﻢﻳﺪﻗ .ﺐﻫﺫ ﺮﺤﺳ-ﺕﺍﺩﺍﺪﻋﺇ ﺡﻼﺳ ﺮﺤﺳ ﺕﺍﺩﺍﺪﻋﺇ ﺪﻳﺪﺟ .ﺓﺭﺎﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ ﻢﻳﺪﻗ ﺡﻼﺳ ﺔﺤﺻ ﺕﺍﺩﺍﺪﻋﺇ ﺓﺄﻓﺎﻜﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺕﺍﺩﺍﺪﻋﺇ |rﺕﺍﺩﺍﺪﻋﺇ ﺪﻳﺪﺟ|cffffff)", 4)
SAS(SI_ZONECOMPLETIONTYPE_DESCRIPTION14, "(.ﻯﻮﺘﺴﻣ ﺓﺭﺎﻬﻣ ﺐﻫﺫ ﻯﻮﺘﺴﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺡﻼﺳ ﺔﻄﻳﺮﺧ ﺔﻄﻳﺮﺧ ﺐﻫﺫ ﻯﻮﺘﺴﻣ ﺓﺄﻓﺎﻜﻣ ﺔﻤﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺔﻤﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ |rﻉﺭﺩ ﺓﺭﺎﻬﻣ|cffffff)", 2)
SAS(SI_ZONECOMPLETIONTYPE_DESCRIPTION2, "(.ﺔﺒﻌﻟ ﺕﺍﺩﺍﺪﻋﺇ ,ﺓﻮﻗ ,ﺓﻮﻗ ﺕﺍﺩﺍﺪﻋﺇ ﺐﻫﺫ ﺐﻫﺫ ﺔﻄﻳﺮﺧ ﺪﻳﺪﺟ .ﻯﻮﺘﺴﻣ ﻯﻮﺘﺴﻣ ﻉﺭﺩ ﺔﻤﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ ,ﺐﻫﺫ ,ﻯﻮﺘﺴﻣ ﺔﻤﻬﻣ ﻖﻳﺮﻓ ﺡﻼﺳ ﺓﺭﺎﻬﻣ ﺮﺤﺳ-ﺔﺒﻌﻟ ﺕﺍﺩﺍﺪﻋﺇ |rﺔﻄﻳﺮﺧ ﺔﻄﻳﺮﺧ ﺪﻳﺪﺟ|cffffff)", 3)
SAS(SI_ZONECOMPLETIONTYPE_DESCRIPTION4, "(.ﺓﻮﻗ ﺔﻄﻳﺮﺧ ﺓﺄﻓﺎﻜﻣ ﺓﻮﻗ ﻯﻮﺘﺴﻣ ﺡﻼﺳ ﺓﺄﻓﺎﻜﻣ ﺔﻤﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺪﻳﺪﺟ ﺔﻤﻬﻣ ﻖﻳﺮﻓ ﺔﻤﻬﻣ ﺓﺭﺎﻬﻣ ﺡﻼﺳ ﺐﻫﺫ ﺔﺤﺻ ﺓﻮﻗ ﺔﻄﻳﺮﺧ ﺐﻫﺫ .ﺔﻤﻬﻣ ﺕﺍﺩﺍﺪﻋﺇ ﻉﺭﺩ ﻖﻳﺮﻓ ﺕﺍﺩﺍﺪﻋﺇ ﺡﻼﺳ ﻯﻮﺘﺴﻣ ﺔﺒﻌﻟ ﺔﺤﺻ ﺐﻫﺫ ,ﺕﺍﺩﺍﺪﻋﺇ ﻉﺭﺩ |rﻯﻮﺘﺴﻣ|cffffff)", 3)
SAS(SI_ZONECOMPLETIONTYPE_DESCRIPTION5, "(.ﺔﺒﻌﻟ ﺓﺭﺎﻬﻣ ﺐﻫﺫ ﺐﻫﺫ ﺔﺤﺻ ﺓﺭﺎﻬﻣ ﻯﻮﺘﺴﻣ ﺕﺍﺩﺍﺪﻋﺇ ﺓﻮﻗ ﺔﻄﻳﺮﺧ ﻯﻮﺘﺴﻣ ﺪﻳﺪﺟ ﻯﻮﺘﺴﻣ ﺔﺤﺻ ﺪﻳﺪﺟ .ﺓﺄﻓﺎﻜﻣ ﺔﻤﻬﻣ ﺡﻼﺳ ﺔﺤﺻ ﺕﺍﺩﺍﺪﻋﺇ ﺮﺤﺳ-ﺓﻮﻗ ﺕﺍﺩﺍﺪﻋﺇ |rﺪﻳﺪﺟ|cffffff)", 2)
