[SI_REDEEMCODERESULT10] = "ﺮﻴﻏ ﻭﺃ ﺢﻟﺎﺻ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﻞﺸﻓ\nThe ﻦﻋ ﺭﺩﺎﺻ ﺓﺄﻓﺎﻜﻣ ﺰﻣﺭ ﻝﺎﺧﺩﺇ ﻦﻣ ﺪﻛﺄﺘﻟﺍ ﻰﺟﺮﻳ .ﺡﺎﺘﻣ\nﻑﺮﻃ ﻦﻣ ﺎﻣﺪﻘﻣ ﻙﺰﻣﺭ ﻥﺎﻛ ﻥﺇ .Elder Scrolls® Online\nﻝﺍﺪﺒﺘﺳﺎﻟﺍ ﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﻪﺑ ﺎﻄﺒﺗﺮﻣ ﻭﺃ ﺚﻟﺎﺛ\n،ﺓﺪﻋﺎﺴﻤﻟﺍ ﻰﻟﺇ ﺔﺟﺎﺤﺑ ﻝﺍﺰﺗ ﺎﻟ ﺖﻨﻛ ﻥﺇ .ﻪﺑ ﺔﺻﺎﺨﻟﺍ\n.ﺀﺎﻠﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ"
[SI_REDEEMCODERESULT2] = "ﺓﺮﻴﺜﻛ ﺯﻮﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﺖﻟﻭﺎﺣ ﺪﻘﻟ\nﺭﺎﻈﺘﻧﺎﻟﺍ ﻰﺟﺮﻳ .ﺮﻴﺼﻗ ﺖﻗﻭ ﻝﺎﻠﺧ\n.ﺎﻘﺣﺎﻟ ﺔﻟﻭﺎﺤﻤﻟﺍﻭ"
[SI_REDEEMCODERESULT3] = "ﻲﻓ ﺰﻣﺮﻟﺍ ﻝﺍﺪﺒﺘﺳﺍ ﻡﺎﻤﺗﺇ ﺭﺬﻌﺗ\nﺔﻟﻭﺎﺤﻤﻟﺍ ﻰﺟﺮﻳ .ﻲﻟﺎﺤﻟﺍ ﺖﻗﻮﻟﺍ\n.ﺎﻘﺣﺎﻟ"
[SI_REDEEMCODERESULT4] = "ﻰﻠﻋ ﺡﺎﺘﻣ ﺮﻴﻏ ﺯﻮﻣﺮﻟﺍ ﻝﺍﺪﺒﺘﺳﺍ\n.ﺔﺼﻨﻤﻟﺍ ﻩﺬﻫ"
[SI_REDEEMCODERESULT5] = "ﻭﺃ ﺢﻟﺎﺻ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﻞﺸﻓ\nﺪﻛﺄﺘﻟﺍ ﻰﺟﺮﻳ .ﻚﺘﺼﻨﻣ ﻰﻠﻋ ﻞﻫﺆﻣ ﺮﻴﻏ ﻭﺃ ﻞﻌﻔﻟﺎﺑ ﺎﻟﺪﺒﺘﺴﻣ\n®The Elder Scrolls ﻦﻋ ﺭﺩﺎﺻ ﺓﺄﻓﺎﻜﻣ ﺰﻣﺭ ﻝﺎﺧﺩﺇ ﻦﻣ\nﺎﻄﺒﺗﺮﻣ ﻭﺃ ﺚﻟﺎﺛ ﻑﺮﻃ ﻦﻣ ﺎﻣﺪﻘﻣ ﻙﺰﻣﺭ ﻥﺎﻛ ﻥﺇ .Online\nﻥﺇ .ﻪﺑ ﺔﺻﺎﺨﻟﺍ ﻝﺍﺪﺒﺘﺳﺎﻟﺍ ﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﻪﺑ\nﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ ،ﺓﺪﻋﺎﺴﻤﻟﺍ ﻰﻟﺇ ﺔﺟﺎﺤﺑ ﻝﺍﺰﺗ ﺎﻟ ﺖﻨﻛ\n.ﺀﺎﻠﻤﻌﻟﺍ ﻢﻋﺩ"
[SI_REDEEMCODERESULT6] = "ﻰﻟﺇ ﻝﻮﺻﻮﻟﺍ ﺀﺎﻨﺛﺃ ﺔﻠﻜﺸﻣ ﺖﺛﺪﺣ\nﻭﺃ ﺎﻘﺣﺎﻟ ﺔﻟﻭﺎﺤﻤﻟﺍ ﻰﺟﺮﻳ .ﻚﺑﺎﺴﺣ\n.ﺀﺎﻠﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ"
[SI_REDEEMCODERESULT7] = "ﻚﺑﺎﺴﺣ ﻰﻠﻋ ﻞﻫﺆﻣ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﻞﺸﻓ\nﻙﺰﻣﺭ ﻥﺎﻛ ﻥﺇ .ESO ﻊﻗﻮﻣ ﻰﻠﻋ ﻝﺍﺪﺒﺘﺳﺎﻟﺍ ﻰﻟﺇ ﺝﺎﺘﺤﻳ ﻭﺃ\nﻰﺟﺮﻴﻓ ،ﺚﻟﺎﺛ ﻑﺮﻃ ﻦﻣ ﺎﻣﺪﻘﻣ ﻭﺃ ﺀﺍﺮﺷ ﺔﻴﻠﻤﻌﺑ ﺎﻄﺒﺗﺮﻣ\nﺎﻟ ﺖﻨﻛ ﻥﺇ .ﻙﺰﻣﺮﺑ ﺔﻘﻓﺮﻤﻟﺍ ﻝﺍﺪﺒﺘﺳﺎﻟﺍ ﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ\nﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ ،ﺓﺪﻋﺎﺴﻤﻟﺍ ﻰﻟﺇ ﺔﺟﺎﺤﺑ ﻝﺍﺰﺗ\n.ﺀﺎﻠﻤﻌﻟﺍ"
[SI_REDEEMCODERESULT8] = "ﻚﺘﺼﻨﻣ ﻰﻠﻋ ﻞﻫﺆﻣ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﻞﺸﻓ\nﻦﻣ ﺎﻣﺪﻘﻣ ﻙﺰﻣﺭ ﻥﺎﻛ ﻥﺇ .ﻂﺸﻧ ﺮﻴﻏ ﻭﺃ ﻞﻌﻔﻟﺎﺑ ﺎﻟﺪﺒﺘﺴﻣ ﻭﺃ\nﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﻪﺑ ﺎﻄﺒﺗﺮﻣ ﻭﺃ ﺚﻟﺎﺛ ﻑﺮﻃ\n.ﺀﺎﻠﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻭﺃ ﻙﺰﻣﺮﺑ ﺔﻘﻓﺮﻤﻟﺍ ﻝﺍﺪﺒﺘﺳﺎﻟﺍ"
