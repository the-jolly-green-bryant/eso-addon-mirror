[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "ﺀﺎﻠﻤﻌﻟﺍ ﺔﻣﺪﺧ ﻮﻠﺜﻤﻣ ﻊﺟﺍﺮﻴﺳ\nﺔﺒﻌﻠﻟﺍ ﻞﺧﺍﺩ ﺔﺷﺩﺭﺪﻟﺍ ﺕﺎﻠﺠﺳ\nﻲﺘﻟﺍ ﺔﻘﻔﺼﻟﺍ ﻞﻴﺻﺎﻔﺗ ﻦﻣ ﻖﻘﺤﺘﻠﻟ\nﺎﻬﺘﻧﺭﺎﻘﻣﻭ ﺎﻬﻨﻋ ﺚﻳﺪﺤﻟﺍ ﻯﺮﺟ\n.ﺔﺒﻌﻠﻟﺍ ﻲﻓ ﻝﻭﺍﺪﺘﻟﺍ ﺕﺎﻠﺠﺴﺑ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "ﻦﻋ ﻍﺎﻠﺑﺈﻠﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\nﺓﺎﻴﺤﻟﺍ ﺕﺎﻣﻮﻠﻌﻣ ﺮﺸﻨﻳ ﺐﻋﺎﻟ ﻱﺃ\n.ﺮﺧﺁ ﺐﻋﺎﻟ ﻱﺄﻟ ﺔﻴﻌﻗﺍﻮﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "ﺞﻣﺍﺮﺑ ﻡﺍﺪﺨﺘﺳﺍ ،ﺮﺼﺤﻟﺍ ﺎﻟ ﻝﺎﺜﻤﻟﺍ ﻞﻴﺒﺳ ﻰﻠﻋ ،ﺍﺬﻫ ﻞﻤﺸﻳ\n،ﺔﻗﺮﺘﺨﻤﻟﺍ ﺔﺤﻠﺳﺄﻟﺍﻭ ،(ﺕﺎﺗﻮﺒﻟﺍ) ﺚﻟﺎﺜﻟﺍ ﻑﺮﻄﻟﺍ\nﺯﺍﺰﻔﺘﺳﺎﻟﺍﻭ ،ﺲﻳﺭﺎﻀﺘﻟﺍ ﺕﺍﺮﻐﺛﻭ ،ﻥﺍﺭﺪﺠﻟﺍ ﺕﺎﻗﺍﺮﺘﺧﺍﻭ\n.ﻚﻟﺫ ﺮﻴﻏﻭ ،ﺕﺎﻃﻮﻄﺨﻤﻟﺎﺑ"
