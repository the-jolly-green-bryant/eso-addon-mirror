[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "ﻦﻋ ﻍﺎﻠﺑﺈﻠﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﺮﻄﺨﻠﻟ ﻝﺎﻔﻃﺄﻟﺍ ﺽﺮﻌﺗ ﺔﻟﺄﺴﻣ ﻱﺃ\nﻍﺎﻠﺑ ﻢﻳﺪﻘﺗ ﻰﻟﺇ ﺍﺬﻫ ﻱﺩﺆﻳ ﺪﻗ\n.ﺔﻃﺮﺸﻠﻟ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = "ﻯﺮﺗ ﺎﻣﺪﻨﻋ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\nﻲﻋﺪﺘﺴﻳ ﺪﻗ ﻯﻮﺘﺴﻣ ﻰﻟﺇ ﻞﺼﻳ ﺎﻔﻗﻮﻣ\nﻥﻮﻧﺎﻘﻟﺍ ﺫﺎﻔﻧﺇ ﺕﺎﻄﻠﺳ ﺭﺎﻄﺧﺇ\n.ﺔﻴﻟﺍﺭﺪﻴﻔﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "ﺖﻈﺣﺎﻟ ﺍﺫﺇ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\nﻰﻟﺇ ﻱﺩﺆﻳ ﺪﻗ ﻪﻧﺃ ﺪﻘﺘﻌﺗ ﺎﻛﻮﻠﺳ\nﺺﺤﻓ ﺀﺍﺮﺟﺈﻟ ﺔﻃﺮﺸﻟﺍ ﺭﺎﻄﺧﺇ\n.ﻥﺎﻨﺌﻤﻃﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "ﻰﺟﺮﻳ ،ﻱﺭﻮﻓ ﺮﻄﺧ ﺩﻮﺟﻭ ﻝﺎﺣ ﻲﻓ\nﺔﻴﻠﺤﻤﻟﺍ ﺉﺭﺍﻮﻄﻟﺍ ﺕﺎﻣﺪﺨﺑ ﻝﺎﺼﺗﺎﻟﺍ\n.ﻍﺎﻠﺒﻟﺍ ﺍﺬﻫ ﻢﻳﺪﻘﺗ ﻰﻟﺇ ﺔﻓﺎﺿﺈﻟﺎﺑ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "ﺔﺌﻴﺴﻣ ﺔﺑﺎﺘﻛ ﻭﺃ ﻡﺎﻠﻛ ﻦﻋ ﻍﺎﻠﺑﺈﻠﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\nﻰﻠﻋ ﺎﺻﻮﺼﺧ ،ﺔﻨﻴﻌﻣ ﺔﺌﻓ ﺪﺿ ﺰﻴﺤﺗ ﻦﻋ ﺮﺒﻌﺗ ﺔﻳﺪﻳﺪﻬﺗ ﻭﺃ\n.ﻲﺴﻨﺠﻟﺍ ﻪﺟﻮﺘﻟﺍ ﻭﺃ ﻦﻳﺪﻟﺍ ﻭﺃ ﺔﻴﺴﻨﺠﻟﺍ ﻭﺃ ﻕﺮﻌﻟﺍ ﺱﺎﺳﺃ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "ﻦﻋ ﻍﺎﻠﺑﺈﻠﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\nﺔﺒﻌﻠﻟﺍ ﺀﺍﻮﺟﺃ ﺮﻴﻜﻌﺗ ﺪﻤﻌﺘﻳ ﺺﺨﺷ\n.ﻊﻤﺘﺠﻤﻟﺍ ﺔﺑﺮﺠﺗ ﻭﺃ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "ﻍﺎﻠﺑﺈﻟﺍ ﺪﻨﻋ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\nﺎﻬﺴﻔﻧ ﺔﻟﺎﺳﺮﻟﺍ ﻞﺳﺮﻳ ﺮﺧﺁ ﺐﻋﺎﻟ ﻦﻋ\nﺔﺷﺩﺭﺪﻟﺍ ﻲﻓ ﺍﺭﺍﺮﻜﺗﻭ ﺍﺭﺍﺮﻣ\n.ﺔﻴﺼﻨﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = "ﻦﻋ ﻍﺎﻠﺑﺈﻠﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﻂﻘﻓ ﺔﻴﺗﻮﺼﻟﺍ ﺔﺷﺩﺭﺪﻟﺍ"
