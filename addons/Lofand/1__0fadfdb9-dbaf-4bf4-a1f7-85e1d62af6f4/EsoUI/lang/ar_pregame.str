[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "ﺔﻠﻘﺘﺴﻣ ﺺﺼﻗ |cffffffﻡﺎﻤﺘﻫﺎﻟﺍ ﻁﺎﻘﻧ|r\nﺔﻓﺮﻌﻤﻟﺍ ﻒﺸﻜﺘﺴﺗ ﺎﻬﺗﺍﺬﺑ\nﻞﺧﺍﺩ ﻊﻗﺍﻮﻤﻟﺍﻭ ﺕﺎﻴﺼﺨﺸﻟﺍﻭ\nﺎﺒﻫﺫﻭ ﺓﺮﺒﺧ ﻚﺤﻨﻤﺗ ﺪﻗ .ﺔﻘﻄﻨﻤﻟﺍ\n.ﺍﺩﺎﺘﻋﻭ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "ﺕﺍﺭﺍﺰﻣ ﻦﻴﺑ ﻲﻧﺎﺠﻤﻟﺍ ﻱﺭﻮﻔﻟﺍ ﺮﻔﺴﻟﺍ ﺢﻴﺘﺗ |cffffffﺮﻔﺴﻟﺍ ﺕﺍﺭﺍﺰﻣ|r\nﺓﺮﺷﺎﺒﻣ ﺮﻔﺴﻟﺍ ﺎﻀﻳﺃ ﻚﻨﻜﻤﻳ .ﺖﺤﺘﻓﻭ ﺖﻔﺸﺘﻛﺍ ﻲﺘﻟﺍ ﺮﻔﺴﻟﺍ\nﻞﺑﺎﻘﻣ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻥﺎﻜﻣ ﻱﺃ ﻦﻣ ﺡﻮﺘﻔﻣ ﺮﻔﺳ ﺭﺍﺰﻣ ﻱﺃ ﻰﻟﺇ\n.ﺐﻫﺬﻟﺍ ﻦﻣ ﺮﻴﺴﻳ ﺭﺪﻗ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "ﺎﻬﺿﻮﺧ ﻦﻜﻤﻳ ﺰﻴﻟﺎﻫﺩ |cffffffﺐﻳﺩﺍﺮﺴﻟﺍ|r\n.ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻲﻓ ﺓﺩﻮﺟﻮﻣ ﺍﺩﺮﻔﻨﻣ\nﺔﻴﻈﺷ ﻰﻠﻋ ﺎﻤﺋﺍﺩ ﺐﻳﺩﺍﺮﺴﻟﺍ ﻱﻮﺘﺤﺗ\nﺩﺎﺘﻋ ﻂﻘﺴﻳ ﻢﻴﻋﺯﻭ ﺓﺪﺣﺍﻭ ﺀﺎﻤﺳ\n.ﻊﻄﻘﻟﺍ ﻢﻘﻃﺃ"
