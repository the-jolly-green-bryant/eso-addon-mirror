[SI_CRAFT_ADVISOR_ALCHEMY_MISSING_OR_UNKNOWN_TOOLTIP] = ".ﺍﺬﻫ ﻊﻨﺼﻟ ﺔﻣﺯﺎﻠﻟﺍ ﺺﺋﺎﺼﺨﻟﺍ ﻒﺸﻜﺗ ﻢﻟ ﻭﺃ ﺩﺍﻮﻤﻟﺍ ﻚﺼﻘﻨﺗ\nﺎﻀﻳﺃ ﻚﻨﻜﻤﻳ .ﺓﺪﻳﺪﺟ ﺺﺋﺎﺼﺧ ﻒﺸﻜﻟ ﻚﻳﺪﻟ ﻲﺘﻟﺍ ﺩﺍﻮﻤﻟﺍ ﺏﺮﺟ\nﻭﺃ ﺕﺎﺑﺎﻘﻨﻟﺍ ﺮﺟﺎﺘﻣ ﺓﺭﺎﻳﺰﺑ ﺔﻴﻓﺎﺿﺇ ﺩﺍﻮﻣ ﻰﻠﻋ ﻝﻮﺼﺤﻟﺍ\n.ﻞﻴﻳﺮﻣﺎﺗ ﺀﺎﺟﺭﺃ ﻲﻓ ﻮﻤﻨﻳ ﻩﺪﺠﺗ ﺎﻣ ﻊﻤﺠﺑ"
[SI_CRAFT_ADVISOR_ALCHEMY_REQUIRES_THIRD_SLOT_TOOLTIP] = "ﺔﻨﻘﺘﻤﻟﺍ ﺔﻴﻓﺮﺤﻟﺍ ﺩﻮﻘﻌﻟﺍ ﺐﻠﻄﺘﺗ\nﺢﻴﺘﺗ ﻲﺘﻟﺍ ﺔﻴﺒﻠﺴﻟﺍ ﺓﺭﺪﻘﻟﺍ\n.ﺔﻴﺋﺎﻴﻤﻴﺧ ﺮﺻﺎﻨﻋ 3 ﻡﺍﺪﺨﺘﺳﺍ"
[SI_CRAFT_ADVISOR_ENCHANTING_MISSING_ITEMS_TOOLTIP] = "ﻚﻴﻠﻌﻓ ،ﻱﺮﺤﺳ ﺶﻘﻨﻟ ﺔﺑﻮﻠﻄﻣ ﺔﻴﻧﻭﺭ ﺭﺎﺠﺣﺃ ﻚﺼﻘﻨﺗ ﺖﻧﺎﻛ ﺍﺫﺇ\nﻢﻈﻌﻣ ﺀﺍﺮﺷ ﻚﻨﻜﻤﻳ .ﺔﻋﺎﻨﺼﻟﺍ ﺔﻟﻭﺎﺤﻣ ﻞﺒﻗ ﺎﻬﻴﻠﻋ ﻝﻮﺼﺤﻟﺍ\nﻚﻨﻜﻤﻳ ﺎﻤﻛ ،ﺕﺎﺑﺎﻘﻨﻟﺍ ﺮﺟﺎﺘﻣ ﻭﺃ ﺭﺎﺠﺘﻟﺍ ﻦﻣ ﺮﺻﺎﻨﻌﻟﺍ\n.ﻞﻴﻳﺮﻣﺎﺗ ﺀﺎﺤﻧﺃ ﻲﻓ ﺎﻬﻨﻋ ﺚﺤﺒﻟﺍ"
