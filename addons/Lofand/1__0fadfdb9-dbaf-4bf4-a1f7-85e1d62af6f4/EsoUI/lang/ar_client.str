[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_GROUP_FINDER_LISTING_INSTRUCTIONS] = "ﻰﺟﺮﻳ ،ﻚﺘﻠﻜﺸﻣ ﻞﺣ ﻲﻓ ﺎﻨﺗﺪﻋﺎﺴﻤﻟ\nﻦﻋ \"ﻍﺎﻠﺑﺈﻟﺍ\" ﺭﺎﻴﺧ ﻡﺍﺪﺨﺘﺳﺍ\nﺚﺣﺎﺑ ﺔﻤﺋﺎﻗ ﻦﻣ ﻒﻟﺎﺨﻤﻟﺍ ﻥﺎﻠﻋﺈﻟﺍ\nﻞﻴﺻﺎﻔﺘﺑ ﺎﻧﺪﻳﻭﺰﺘﻟ ﺕﺎﻋﻮﻤﺠﻤﻟﺍ\n.ﻪﺗﺎﻣﻮﻠﻌﻣﻭ ﻥﺎﻠﻋﺈﻟﺍ"
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_GUILD_NAME] = "ﺔﺑﺎﻘﻨﻟﺍ ﻢﺳﺍ"
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_HOUSE_TOUR_LISTING_DETAILS] = "ﻝﺰﻨﻤﻟﺍ ﺔﻟﻮﺟ ﻞﻴﺻﺎﻔﺗ"
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_HOUSE_TOUR_LISTING_INSTRUCTIONS] = "ﺭﺎﻴﺧ ﻡﺍﺪﺨﺘﺳﺍ ﻰﺟﺮﻳ ،ﻚﺘﻠﻜﺸﻣ ﻞﺣ ﻲﻓ ﺎﻨﺗﺪﻋﺎﺴﻤﻟ\nﺕﺎﻟﻮﺟ ﺔﻤﺋﺎﻗ ﻦﻣ ﻒﻟﺎﺨﻤﻟﺍ ﻥﺎﻠﻋﺈﻟﺍ ﻦﻋ \"ﻍﺎﻠﺑﺈﻟﺍ\"\nﻥﺎﻠﻋﺈﻟﺍ ﻞﻴﺻﺎﻔﺘﺑ ﺎﻧﺪﻳﻭﺰﺘﻟ ﻝﺰﻨﻤﻟﺍ ﻞﺧﺍﺩ ﻦﻣ ﻭﺃ ﻝﺯﺎﻨﻤﻟﺍ\n.ﻪﺗﺎﻣﻮﻠﻌﻣﻭ"
[SI_CUSTOMER_SERVICE_ASK_FOR_HELP_NO_QUEST_HINT] = ".ﻡﺎﻬﻤﻟﺍ ﻝﻮﺣ ﺕﺎﺤﻴﻤﻠﺗ ﻢﻳﺪﻘﺗ ﺀﺎﻠﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻴﻄﺘﺴﻳ ﺎﻟ\n،ﺎﻣ ﺔﻤﻬﻣ ﻝﺎﻤﻛﺈﻟ ﺢﺋﺎﺼﻧ ﻭﺃ ﺓﺪﻋﺎﺴﻣ ﻦﻋ ﺚﺤﺒﺗ ﺖﻨﻛ ﺍﺫﺇ\nﺭﺪﺼﻣ |c2e86b8<<1>>|r ﻰﻠﻋ ﺕﺎﻳﺪﺘﻨﻤﻟﺍ ﻲﻓ ﻦﻴﺒﻋﺎﻠﻟﺍ ﻙﺀﺎﻠﻣﺯ ﻥﺈﻓ\nﺕﺎﻋﻮﺳﻮﻣ ﻯﺪﺣﺇ ﻰﻟﺇ ﻉﻮﺟﺮﻟﺍ ﺎﻀﻳﺃ ﻚﻨﻜﻤﻳ .ﺕﺎﻣﻮﻠﻌﻤﻠﻟ ﻊﺋﺍﺭ\n.ESO ﻊﻤﺘﺠﻤﺑ ﺔﺻﺎﺨﻟﺍ ﺓﺪﻳﺪﻌﻟﺍ ﻲﻜﻳﻮﻟﺍ"
