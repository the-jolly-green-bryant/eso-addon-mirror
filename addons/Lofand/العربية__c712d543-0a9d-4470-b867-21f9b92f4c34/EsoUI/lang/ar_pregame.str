[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "Use this to report any endangerment issue related to children. This may lead to a police report being filed."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = ".ﻥﻮﻧﺎﻘﻟﺍ ﺫﺎﻔﻧﻹ ﺔﻳﺩﺎﺤﺗﻻﺍ ﺕﺎﻄﻠﺴﻟﺍ ﺭﺎﻄﺧﺇ ﺐﻠﻄﺘﻳ ﺪﻗ ﻱﺬﻟﺍ ﻯﻮﺘﺴﻤﻟﺍ ﻰﻟﺇ ﻊﻔﺗﺮﺗ ﺔﻟﺎﺣ ﻯﺮﺗ ﺎﻣﺪﻨﻋ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = ".ﺪﻴﺟ ﺺﺤﻔﺑ ﻡﺎﻴﻘﻠﻟ ﺔﻃﺮﺸﻟﺍ ﺭﺎﻌﺷﺇ ﻰﻟﺇ ﻱﺩﺆﻳ ﻥﺃ ﻦﻜﻤﻳ ﻪﻧﺃ ﺪﻘﺘﻌﺗ ﻱﺬﻟﺍ ﻙﻮﻠﺴﻟﺍ ﺐﻗﺍﺮﺗ ﺖﻨﻛ ﺍﺫﺇ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺇ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = ".ﺮﻳﺮﻘﺘﻟﺍ ﺍﺬﻫ ﻢﻳﺪﻘﺗ ﻰﻟﺇ ﺔﻓﺎﺿﻹﺎﺑ ﺔﻴﻠﺤﻤﻟﺍ ﺉﺭﺍﻮﻄﻟﺍ ﺕﺎﻣﺪﺨﺑ ﻝﺎﺼﺗﻻﺍ ﻰﺟﺮﻳ ،ﻱﺭﻮﻔﻟﺍ ﺮﻄﺨﻠﻟﻭ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "Use this to report abusive or threatening speech or writing that expresses prejudice against a particular group, especially on the basis of race, nationality, religion, or sexual orientation."
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = ".ﺔﻴﻌﻤﺘﺠﻤﻟﺍ ﺓﺮﺒﺨﻟﺍ ﻭﺃ ﺔﺒﻌﻠﻟﺍ ﺔﺌﻴﺑ ﺍﺪﻤﻋ ﻞﻄﻌﻳ ﺺﺨﺷ ﻦﻋ ﻍﻼﺑﻺﻟ ﺍﺬﻫ ﻡﺍﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "ﺖﺴﻜﻴﺗ ﻲﻓ ﺍﺭﺍﺮﻜﺗﻭ ﺍﺭﺍﺮﻣ ﺔﻟﺎﺳﺮﻟﺍ ﺲﻔﻧ ﻝﺎﺳﺭﻹ ﺮﺧﺁ ﺐﻋﻻ ﻍﻼﺑﺇ ﺪﻨﻋ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = "ﻂﻘﻓ ﺔﺷﺩﺭﺪﻟﺍ ﻦﻋ (ﺲﻳﻮﻓ) ﻍﻼﺑﻹ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺇ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = "ﻭﺃ ﺎﻣ ﺺﺨﺷ ﻢﺳﺍ ﻎﻴﻠﺒﺘﻟ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = ".ﺔﺒﻌﻠﻟﺍ ﻲﻓ ﺓﺭﺎﺠﺘﻟﺍ ﺕﻼﺠﺴﺑ ﺎﻬﻧﺭﺎﻘﺗﻭ ﺖﺸﻗﻮﻧ ﻲﺘﻟﺍ ﺓﺭﺎﺠﺘﻟﺍ ﻞﻴﺻﺎﻔﺗ ﺪﻴﻛﺄﺘﻟ ﺔﺒﻌﻠﻟﺍ ﻲﻓ ﺔﺷﺩﺭﺪﻟﺍ ﺕﻼﺠﺳ ﻲﻧﺪﻤﻟﺍ ﻊﻤﺘﺠﻤﻟﺍ ﺕﺎﻤﻈﻨﻣ ﻢﻴﻘﺘﺳﻭ"
