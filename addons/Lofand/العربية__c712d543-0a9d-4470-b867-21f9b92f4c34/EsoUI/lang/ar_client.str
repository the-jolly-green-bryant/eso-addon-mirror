[SI_LOGINAUTHERROR8004] = ".ﺕﺎﻣﻮﻠﻌﻤﻟﺍ ﻦﻣ ﺪﻳﺰﻤﻟ        ﻰﻟﺇ ﺐﻫﺫﺇ ﻙﻮﻠﺴﻟﺍ ﺪﻋﺍﻮﻗ ﺔﻧﻭﺪﻣ ﻙﺎﻬﺘﻧﺍ ﺐﺒﺴﺑ ﻚﺑﺎﺴﺣ ﺪﻴﻴﻘﺗ ﻢﺗ"
[SI_LOGINAUTHERROR8005] = ".ﺕﺎﻣﻮﻠﻌﻤﻟﺍ ﻦﻣ ﺪﻳﺰﻤﻟ        ﻰﻟﺇ ﺐﻫﺫﺇ ﺔﻣﺪﺨﻟﺍ ﻩﺬﻫ ﻰﻟﺇ ﻞﺼﺗ ﻻ ﺪﻗ ﻙﻮﻠﺴﻟﺍ ﺪﻋﺍﻮﻗ ﺔﻧﻭﺪﻣ ﻙﺎﻬﺘﻧﺍ ﺐﺒﺴﺑ ﻢﺋﺍﺩ ﻞﻜﺸﺑ ﻚﺑﺎﺴﺣ ﻞﻴﻄﻌﺗ ﻢﺗ ﺪﻘﻟ"
[SI_LOGINAUTHERROR8007] = "ﻲﻓ ﺀﻼﻤﻌﻟﺍ ﺔﻣﺪﺨﺑ ﻲﻠﺼﺗﺍ ،ﻲﻧﻭﺮﺘﻜﻟﺇ ﺪﻳﺮﺑ ﻲﻤﻠﺘﺴﺗ ﻢﻟ ﺍﺫﺇ ﻖﻘﺤﺘﻟﺍ ﺔﻴﻠﻤﻋ ﻝﺎﻤﻛﺇ ﺔﻴﻔﻴﻛ ﻢﻴﻠﻌﺘﻟ (ﻮﺴﻳﺇ) ﺏﺎﺴﺣ ﻖﻠﺨﻟ ﻪﺘﻣﺪﺨﺘﺳﺍ ﻱﺬﻟﺍ ﻲﻧﻭﺮﺘﻜﻟﻹﺍ ﺪﻳﺮﺒﻟﺍ ﻦﻣ ﻖﻘﺤﺗ .ﺐﻌﻠﻟﺍ ﺔﻠﺻﺍﻮﻣ ﻞﺟﺃ ﻦﻣ ﻚﺑﺎﺴﺣ ﻦﻣ ﻖﻘﺤﺘﻟﺍ ﺐﺠﻳ"
[SI_LOGINAUTHERROR8008] = "ﺔﺒﻌﻠﻟﺍ ﺏﺎﺴﺣ ﻰﻠﻋ ﺮﺜﻌﻳ ﻢﻟ"
[SI_LOGINAUTHERROR8009] = ".ﺕﺎﻣﻮﻠﻌﻤﻟﺍ ﻦﻣ ﺪﻳﺰﻤﻟ        ﻰﻟﺇ ﺐﻫﺫﺇ ﻙﻮﻠﺴﻟﺍ ﺪﻋﺍﻮﻗ ﺔﻧﻭﺪﻣ ﻙﺎﻬﺘﻧﺍ ﺐﺒﺴﺑ ﻚﺑﺎﺴﺣ ﺪﻴﻴﻘﺗ ﻢﺗ"
[SI_LOGINAUTHERROR8010] = ".ﺕﺎﻣﻮﻠﻌﻤﻟﺍ ﻦﻣ ﺪﻳﺰﻤﻟ        ﻰﻟﺇ ﺐﻫﺫﺇ ﺔﻣﺪﺨﻟﺍ ﻩﺬﻫ ﻰﻟﺇ ﻞﺼﺗ ﻻ ﺪﻗ ﻙﻮﻠﺴﻟﺍ ﺪﻋﺍﻮﻗ ﺔﻧﻭﺪﻣ ﻙﺎﻬﺘﻧﺍ ﺐﺒﺴﺑ ﻢﺋﺍﺩ ﻞﻜﺸﺑ ﻚﺑﺎﺴﺣ ﻞﻴﻄﻌﺗ ﻢﺗ ﺪﻘﻟ"
[SI_LOGINAUTHERROR8011] = "ﻲﻓ ﺀﻼﻤﻌﻟﺍ ﺔﻣﺪﺨﺑ ﻲﻠﺼﺗﺍ ،ﻲﻧﻭﺮﺘﻜﻟﺇ ﺪﻳﺮﺑ ﻲﻤﻠﺘﺴﺗ ﻢﻟ ﺍﺫﺇ ﻖﻘﺤﺘﻟﺍ ﺔﻴﻠﻤﻋ ﻝﺎﻤﻛﺇ ﺔﻴﻔﻴﻛ ﻢﻴﻠﻌﺘﻟ (ﻮﺴﻳﺇ) ﺏﺎﺴﺣ ﻖﻠﺨﻟ ﻪﺘﻣﺪﺨﺘﺳﺍ ﻱﺬﻟﺍ ﻲﻧﻭﺮﺘﻜﻟﻹﺍ ﺪﻳﺮﺒﻟﺍ ﻦﻣ ﻖﻘﺤﺗ .ﺐﻌﻠﻟﺍ ﺔﻠﺻﺍﻮﻣ ﻞﺟﺃ ﻦﻣ ﻚﺑﺎﺴﺣ ﻦﻣ ﻖﻘﺤﺘﻟﺍ ﺐﺠﻳ"
[SI_LOGINAUTHERROR8012] = "ﻲﻓ ﺀﻼﻤﻌﻟﺍ ﺔﻣﺪﺨﺑ ﻝﺎﺼﺗﻻﺍ ﻰﺟﺮﻳ ﻖﻴﺛﻮﺘﻟﺍ ﺪﻴﻗ ﺪﻗ ﻚﺑﺎﺴﺣ"
