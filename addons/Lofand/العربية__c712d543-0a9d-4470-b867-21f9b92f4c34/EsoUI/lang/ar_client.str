[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = " <<1>>   Zone Story Quests    <<2>>      ﺩﺎﺘﻋﻭ ﺐﻫﺫﻭ ﺓﺮﺒﺧﻭ ﺕﺍﺭﺎﻬﻣ ﻚﺤﻨﻤﻳ ﻥﺃ ﻦﻜﻤﻳ ﺕﻻﻭﺎﺤﻤﻟﺍ ﻩﺬﻫ ﻝﺎﻤﻛﺇ .ﺔﻘﻄﻨﻤﻠﻟ ﺔﻴﺴﻴﺋﺭ ﺔﺼﻗ ﻲﻫ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = ".ﺭﺪﻨﻴﻔﺛﺎﺑ ﻲﻓ ﺯﺎﺠﻧﻹﺍ ﺍﺬﻫ ﻖﻴﻘﺤﺗ ﻰﻟﺇ ﺎﻣ ﺔﻘﻄﻨﻣ ﻲﻓ ﻦﻴﺑﺮﻀﻤﻟﺍ ﻦﻴﻴﻠﺤﻤﻟﺍ ﻥﺎﻜﺴﻟﺍ ﻊﻴﻤﺟ ﻦﻋ ﻒﺸﻜﻟﺍ ﻱﺩﺆﻴﺳﻭ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻡﺎﻤﺘﻫﺍ ﻦﻛﺎﻣﺃ ﻲﻫ ﺔﻴﻠﺤﻤﻟﺍ ﺉﺭﺍﻮﻄﻟﺍ-"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = " <<1>>   Shalidor’s Library Books  <<2>>     ﺓﺭﺎﻬﻤﻟﺍ ﻂﺧ ﻊﻓﺮﻳﻭ (ﺪﻠﻴﻏ ﻲﻏﺎﻣ) ـﻟ ﻚﺘﺒﺗﺭ ﻦﺴﺤﻳ ﻑﻮﺳ ﺐﺘﻜﻟﺍ ﻩﺬﻫ ﻦﻋ ﻒﺸﻜﻟﺍ .ﺰﻴﻤﻤﻟﺍ ﻲﻧﺍﻮﺟﺭﻷﺍ ﺎﻬﺠﻫﻮﺘﺑ ﺐﺘﻜﻟﺍ ﻩﺬﻫ ﻑﺮﻌﺗﻭ .ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻊﻴﻤﺟ ﻲﻓ ﺓﺮﺜﻌﺒﻣ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "ﺔﻔﻠﺘﺨﻣ (ﻥﻮﺘﺳ ﺱﻭﺪﻧﻮﻣ) ﺓﺰﺋﺎﺠﺑ ﻝﺪﺒﺘﺴﻳ ﻰﺘﺣ ﻥﺎﻓﻮﻄﻟﺍ ﺍﺬﻫ ﺮﻤﺘﺴﻴﺳ ﺖﻗﺆﻣ ﻑﺯﺎﻋ ﻞﻜﺷ ﻲﻓ ﺓﺄﻓﺎﻜﻣ ﺢﻨﻤﺗ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﺀﺎﻴﺷﺃ ﻲﻫ"
