[SI_HOUSING_PATH_SETTINGS_CHANGE_COLLECTIBLE_TOOLTIP] = "(.ﺭﺎﺴﻤﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺴﻳ ﻱﺬﻟﺍ ﻦﺋﺎﻜﻟﺍ ﺩﺪﺤﻳ)"
[SI_HOUSING_PATH_SETTINGS_CONFORM_TO_GROUND_TEXT] = "(ﺽﺭﻷﺎﺑ ﻞﻴﺻﻮﺘﻟﺍ)"
[SI_HOUSING_PATH_SETTINGS_CONFORM_TO_GROUND_TOOLTIP] = "(.ﻚﻟﺫ ﻦﻜﻣﺃ ﺎﻤﻠﻛ ﺔﻴﺿﺭﺃ ﻭﺃ ﻲﺿﺭﺃ ﺢﻄﺳ ﺏﺮﻗﺃ ﻊﻣ ﻖﻓﺍﻮﺘﻴﻟ ﻦﺋﺎﻜﻟﺍ ﻙﺮﺤﺘﻴﺳ ،ﺓﺰﻴﻤﻟﺍ ﻩﺬﻫ ﻦﻴﻜﻤﺗ ﺪﻨﻋ)\n\n(.ﺽﺭﻷﺍ ﻕﻮﻓ ﻖﻴﻠﻌﺘﻟﺎﺑ ﻪﻟ ﺡﺎﻤﺴﻟﺍ ﻊﻣ ،ﻂﺒﻀﻟﺎﺑ ﻪﻧﻭﺩﺪﺤﺗ ﻱﺬﻟﺍ ﺭﺎﺴﻤﻟﺍ ﻦﺋﺎﻜﻟﺍ ﻊﺒﺘﻴﺳ ،ﺓﺰﻴﻤﻟﺍ ﻩﺬﻫ ﻞﻴﻄﻌﺗ ﺪﻨﻋ)"
[SI_HOUSING_PATH_SETTINGS_PATHING_STATE_TEXT] = "(ﺭﺎﺴﻤﻟﺍ ﺪﻳﺪﺤﺗ)"
[SI_HOUSING_PATH_SETTINGS_PATHING_STATE_TOOLTIP] = "(.ﺭﺎﺴﻤﻟﺍ ﻦﻣ ﻰﻟﻭﻷﺍ ﺓﺪﻘﻌﻟﺍ ﺪﻨﻋ ﺎﺘﺑﺎﺛ ﻰﻘﺒﻳ ﻡﺃ ﺭﺎﺴﻤﻟﺍ ﺍﺬﻫ ﻝﻮﻃ ﻰﻠﻋ ﻙﺮﺤﺘﻳ ﻦﺋﺎﻜﻟﺍ ﻥﺎﻛ ﺍﺫﺇ ﺎﻣ ﺩﺪﺤﻳ)"
[SI_HOUSING_PATH_SETTINGS_PATHING_TYPE_TEXT] = "(ﺭﺎﺴﻤﻟﺍ ﻉﻮﻧ)"
[SI_HOUSING_PATH_SETTINGS_PATHING_TYPE_TOOLTIP] = "(.ﺔﻳﺍﺪﺒﻟﺍ ﻰﻟﺇ ﺩﻮﻌﻳ ﻢﺛ ،ﻪﺘﻳﺎﻬﻧ ﻰﻟﺇ ﻞﺼﻳ ﻰﺘﺣ ﺭﺎﺴﻤﻟﺍ ﻝﻮﻃ ﻰﻠﻋ ﻦﺋﺎﻜﻟﺍ ﻙﺮﺤﺘﻳ ،«ﺞﻧﻮﺑ ﺞﻨﻴﺑ» ﺭﺎﻴﺘﺧﺍ ﺪﻨﻋ)\n\n(.ﺓﺮﺋﺍﺩ ﻚﻟﺬﺑ ﻞﻜﺸﺘﻟ ،ﻰﻟﻭﻷﺍ ﺓﺪﻘﻌﻟﺎﺑ ﻯﺮﺧﺃ ﺓﺮﻣ ﺭﺎﺴﻤﻟﺍ ﻲﻓ ﺓﺮﻴﺧﻷﺍ ﺓﺪﻘﻌﻟﺍ ﻂﺑﺭ ﻢﺘﻳ ،(ﺔﻘﻠﺣ) «Loop» ﺭﺎﻴﺧ ﺪﻳﺪﺤﺗ ﺪﻨﻋ)\n\n(.ﺭﺎﺴﻤﻟﺍ ﻲﻓ ﺔﻴﻘﺒﺘﻤﻟﺍ ﺪﻘﻌﻟﺍ ﻦﻴﺑ ﻦﻣ ﺎﻴﺋﺍﻮﺸﻋ ﻲﻟﺎﺘﻟﺍ ﻪﻌﻗﻮﻣ ﺭﺎﺘﺨﻳ ،ﺎﻣ ﺓﺪﻘﻋ ﻰﻟﺇ ﻦﺋﺎﻜﻟﺍ ﺎﻬﻴﻓ ﻞﺼﻳ ﺓﺮﻣ ﻞﻛ ﻲﻓ ،«ﻲﺋﺍﻮﺸﻋ» ﺭﺎﻴﺨﻟﺍ ﺪﻳﺪﺤﺗ ﺪﻨﻋ)"
