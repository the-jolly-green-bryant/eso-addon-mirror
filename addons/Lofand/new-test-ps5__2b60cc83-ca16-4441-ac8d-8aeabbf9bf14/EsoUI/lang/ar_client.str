[SI_RESPECTYPE0] = "(.ﺎﻬﻨﻴﻴﻌﺗ ﺓﺩﺎﻋﺇ ﻚﻴﻠﻋ ﻦﻴﻌﺘﻴﺳﻭ ؛ﻚﺑ ﺔﺻﺎﺨﻟﺍ ﺓﺭﺎﻬﻤﻟﺍ ﻁﺎﻘﻧ ﺩﺭ ﻢﺗ)"
[SI_RESPECTYPE1] = "(.ﺕﺍﺮﻴﻴﻐﺘﻠﻟ ﺔﻠﻣﺎﻜﻟﺍ ﺔﻤﺋﺎﻘﻟﺍ ﻰﻠﻋ ﻉﻼﻃﻼﻟ ﺚﻳﺪﺤﺘﻟﺍ ﺕﺎﻈﺣﻼﻣ ﺓﺀﺍﺮﻗ ﻰﺟﺮﻳ .ﻢﻜﺑ ﺔﺻﺎﺨﻟﺍ ﺺﺋﺎﺼﺨﻟﺍ ﻁﺎﻘﻧ ﻊﻴﻤﺟ ﺓﺩﺎﻋﺇ ﺖﻤﺗ ،ﻢﻜﻟ ﺎﻀﻳﻮﻌﺗﻭ .ﺚﻳﺪﺤﺘﻟﺍ ﺍﺬﻫ ﻲﻓ ﺺﺋﺎﺼﺨﻟﺍ ﺔﻧﺯﺍﻮﻣ ﺓﺩﺎﻋﺇ ﺖﻤﺗ)"
[SI_RESPECTYPE2] = "(.ﻚﻃﺎﻘﻧ ﻕﺎﻔﻧﻹ «Champion» ﺔﻤﺋﺎﻗ ﺓﺭﺎﻳﺰﺑ ﻞﻀﻔﺗ .ﺎﻬﻨﻴﻴﻌﺗ ﺓﺩﺎﻋﺇ ﻚﻴﻠﻋ ﻦﻴﻌﺘﻴﺳﻭ ؛ﻚﺑ ﺔﺻﺎﺨﻟﺍ «Champion» ﻁﺎﻘﻧ ﺩﺭ ﻢﺗ)"
[SI_RESPECTYPE3] = "(.ﻚﺗﺎﻧﺎﺧ ﺮﻴﻴﻐﺘﻟ «ﻝﺎﻄﺑﻷﺍ» ﺔﻤﺋﺎﻗ ﻰﻟﺇ ﻞﻘﺘﻧﺍ .ﺎﻬﻄﺒﺿ ﺓﺩﺎﻋﺇ ﻚﻴﻠﻋ ﻦﻴﻌﺘﻴﺳﻭ ؛ﻚﺑ ﺔﺻﺎﺨﻟﺍ ﻝﺎﻄﺑﻷﺍ ﺕﺎﻧﺎﺧ ﻞﻳﺪﻌﺗ ﻢﺗ)"
