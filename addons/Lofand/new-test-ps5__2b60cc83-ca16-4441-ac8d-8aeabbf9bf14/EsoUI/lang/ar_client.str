[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "(.ﺺﺨﺸﻟﺍ ﺔﻣﻼﺳ ﻦﻣ ﺪﻛﺄﺘﻠﻟ ﺺﺤﻓ ﺀﺍﺮﺟﻹ ﺔﻃﺮﺸﻟﺍ ﺭﺎﻄﺧﺇ ﻰﻟﺇ ﻱﺩﺆﻳ ﺪﻗ ﻪﻧﺃ ﺪﻘﺘﻌﺗ ﺎﻛﻮﻠﺳ ﺖﻈﺣﻻ ﺍﺫﺇ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ)"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "(.ﺮﻳﺮﻘﺘﻟﺍ ﺍﺬﻫ ﻢﻳﺪﻘﺗ ﻰﻟﺇ ﺔﻓﺎﺿﻹﺎﺑ ﺔﻴﻠﺤﻤﻟﺍ ﺉﺭﺍﻮﻄﻟﺍ ﺕﺎﻣﺪﺨﺑ ﻝﺎﺼﺗﻻﺍ ﻰﺟﺮﻳ ،ﺮﺷﺎﺒﻣ ﺮﻄﺧ ﺩﻮﺟﻭ ﺔﻟﺎﺣ ﻲﻓ)"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "(.ﻲﺴﻨﺠﻟﺍ ﻞﻴﻤﻟﺍ ﻭﺃ ﻦﻳﺪﻟﺍ ﻭﺃ ﺔﻴﺴﻨﺠﻟﺍ ﻭﺃ ﻕﺮﻌﻟﺍ ﺱﺎﺳﺃ ﻰﻠﻋ ﺎﻤﻴﺳ ﻻ ،ﺔﻨﻴﻌﻣ ﺔﻋﻮﻤﺠﻣ ﺪﺿ ﺰﻴﺤﺘﻟﺍ ﻦﻋ ﺮﺒﻌﺗ ﺔﻳﺪﻳﺪﻬﺗ ﻭﺃ ﺔﺌﻴﺴﻣ ﺔﺑﺎﺘﻛ ﻭﺃ ﻡﻼﻛ ﻱﺃ ﻦﻋ ﻍﻼﺑﻺﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ)"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "(.ﻊﻤﺘﺠﻤﻟﺍ ﺔﺑﺮﺠﺗ ﻭﺃ ﺔﺒﻌﻠﻟﺍ ﺔﺌﻴﺒﺑ ﻝﻼﺧﻹﺍ ﺪﻤﻌﺘﻳ ﺺﺨﺷ ﻱﺃ ﻦﻋ ﻍﻼﺑﻺﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ)"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "(.«ﺔﻴﺼﻨﻟﺍ ﺔﺷﺩﺭﺪﻟﺍ» ﻲﻓ ﺍﺭﺍﺮﻜﺗﻭ ﺍﺭﺍﺮﻣ ﺔﻟﺎﺳﺮﻟﺍ ﺲﻔﻧ ﻪﻟﺎﺳﺭﻹ ﺮﺧﺁ ﺐﻋﻻ ﻦﻋ ﻍﻼﺑﻹﺍ ﺪﻨﻋ ﺭﺎﻴﺨﻟﺍ ﻩﺬﻫ ﻡﺪﺨﺘﺳﺍ)"
