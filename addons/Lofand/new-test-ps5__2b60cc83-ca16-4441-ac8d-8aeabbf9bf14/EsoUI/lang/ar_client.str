[SI_ACTIVITYQUEUERESULT29] = "(.ﻲﻟﺎﺤﻟﺍ ﻚﻌﻗﻮﻣ ﻦﻣ «Tales of Tribute» ﺔﺒﻌﻠﻟ ﺭﺎﻈﺘﻧﻻﺍ ﺔﻤﺋﺎﻗ ﻰﻟﺇ ﻡﺎﻤﻀﻧﻻﺍ ﻚﻨﻜﻤﻳ ﻻ)"
