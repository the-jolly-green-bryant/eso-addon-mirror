[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "(.ﺕﺍﺪﻌﻣﻭ ﺐﻫﺫﻭ ﺓﺮﺒﺧﻭ ﺓﺭﺎﻬﻣ ﻁﺎﻘﻧ ﻡﺎﻬﻤﻟﺍ ﻩﺬﻫ ﻡﺎﻤﺗﺇ ﻚﺒﺴﻜﺗ ﻥﺃ ﻦﻜﻤﻳ .ﺔﻘﻄﻨﻤﻟﺍ ﻚﻠﺘﻟ ﺔﻴﺴﻴﺋﺮﻟﺍ ﺔﺼﻘﻟﺍ ﻲﻫ |rﺔﻘﻄﻨﻤﻟﺍ ﺔﺼﻗ ﻡﺎﻬﻣ|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "(.ﺔﻘﻄﻨﻤﻟﺍ ﻚﻠﺘﺑ ﺹﺎﺨﻟﺍ «ﺭﺪﻨﻳﺎﻔﺛﺎﺑ» ﺯﺎﺠﻧﺇ ﻰﻠﻋ ﻝﻮﺼﺤﻟﺍ ﻰﻟﺇ ﺎﻣ ﺔﻘﻄﻨﻣ ﻲﻓ «ﺓﺯﺭﺎﺒﻟﺍ ﻊﻗﺍﻮﻤﻟﺍ» ﻊﻴﻤﺟ ﻑﺎﺸﺘﻛﺍ ﻱﺩﺆﻴﺳ .ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻲﻓ ﺔﻴﻤﻫﺃ ﺕﺍﺫ ﻦﻛﺎﻣﺃ ﻲﻫ |r«ﺓﺯﺭﺎﺒﻟﺍ ﻊﻗﺍﻮﻤﻟﺍ»|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "(.ﺎﻬﺑ ﻂﺒﺗﺮﻤﻟﺍ ﺕﺍﺭﺎﻬﻤﻟﺍ ﻂﺧ ﺮﻳﻮﻄﺗﻭ ﺓﺮﺤﺴﻟﺍ ﺔﺑﺎﻘﻧ ﻲﻓ ﻚﺘﺒﺗﺭ ﻊﻓﺭ ﻰﻟﺇ ﺐﺘﻜﻟﺍ ﻩﺬﻫ ﻑﺎﺸﺘﻛﺍ ﻱﺩﺆﻴﺳ .ﺰﻴﻤﻤﻟﺍ ﻲﻧﺍﻮﺟﺭﻷﺍ ﺎﻬﺠﻫﻮﺗ ﻝﻼﺧ ﻦﻣ ﺐﺘﻜﻟﺍ ﻩﺬﻫ ﻰﻠﻋ ﻑﺮﻌﺘﻟﺍ ﻦﻜﻤﻳﻭ .ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻊﻴﻤﺟ ﻲﻓ ﺓﺮﺸﺘﻨﻣ |rﺭﻭﺪﻴﻟﺎﺷ ﺔﺒﺘﻜﻣ ﺐﺘﻛ|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "(.ﺱﻭﺪﻧﻮﻣ ﺭﺎﺠﺣﺃ ﻦﻣ ﻯﺮﺧﺃ ﺓﺰﻴﻤﺑ ﻪﻟﺍﺪﺒﺘﺳﺍ ﻢﺘﻳ ﻥﺃ ﻰﻟﺇ ﺎﻳﺭﺎﺳ ﺰﻳﺰﻌﺘﻟﺍ ﺍﺬﻫ ﺮﻤﺘﺴﻳ .ﺐﻋﻼﻟ ﺖﻗﺆﻣ ﺰﻳﺰﻌﺗ ﻞﻜﺷ ﻰﻠﻋ ﺓﺰﻴﻣ ﺢﻨﻤﺗ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﺓﺩﻮﺟﻮﻣ ﺮﺻﺎﻨﻋ ﻲﻫ |rﺱﻭﺪﻧﻮﻣ ﺭﺎﺠﺣﺃ|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "(.ﺕﺍﺪﻌﻣﻭ ،ﺎﺒﻫﺫﻭ ،ﺓﺮﺒﺧﻭ ،ﺓﺭﺎﻬﻣ ﺔﻄﻘﻧ ﺔﻣﺎﻌﻟﺍ ﺔﻨﺼﺤﻤﻟﺍ ﺝﺍﺮﺑﻷﺍ ﻦﻣ ﺔﻔﻠﺘﺨﻣ ﺀﺍﺰﺟﺃ ﻝﺎﻤﻛﺇ ﻚﺤﻨﻤﻳ ﻥﺃ ﻦﻜﻤﻳﻭ .ﻦﻴﺒﻋﻻ ﺔﻌﺑﺭﺃ ﻦﻣ ﺔﻧﻮﻜﻣ ﺕﺎﻋﻮﻤﺠﻤﻟ ﺝﺍﺮﺑﻷﺍ ﻩﺬﻫ ﺖﻤﻤﺻ ﺪﻗﻭ .ﺎﻬﺟﺭﺎﺧﻭ ﻞﻴﻳﺮﻣﺎﺗ ﺀﺎﺤﻧﺃ ﻊﻴﻤﺟ ﻲﻓ ﺮﺸﺘﻨﺗ ﺡﻮﺘﻔﻣ ﻢﻟﺎﻋ ﺕﺍﺫ ﺔﻨﺼﺤﻣ ﺝﺍﺮﺑﺃ ﻲﻫ |rﺔﻣﺎﻌﻟﺍ ﺔﻨﺼﺤﻤﻟﺍ ﺝﺍﺮﺑﻷﺍ|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "(.ﺮﺻﺎﻨﻌﻟﺍ ﺕﺎﻋﻮﻤﺠﻤﺑ ﺔﺻﺎﺧ ﺓﺩﺪﺤﻣ ﺎﻳﺍﺰﻤﺑ ﻊﺘﻤﺘﺗ ﺮﺻﺎﻨﻋ ﺔﻋﺎﻨﺻ ﺎﻬﻴﻓ ﻚﻨﻜﻤﻳ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻊﻗﺍﻮﻣ ﻲﻫ |rﺕﺎﻋﻮﻤﺠﻤﻟﺍ ﺕﺎﻄﺤﻣ|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "(.ﺕﺍﺪﻌﻣﻭ ﺎﺒﻫﺫﻭ ﺓﺮﺒﺧ ﻁﺎﻘﻧ ﺺﺼﻘﻟﺍ ﻩﺬﻫ ﻚﺤﻨﻤﺗ ﻥﺃ ﻦﻜﻤﻳﻭ .ﺎﻣ ﺔﻘﻄﻨﻣ ﻞﺧﺍﺩ ﻊﻗﺍﻮﻤﻟﺍﻭ ﺕﺎﻴﺼﺨﺸﻟﺍﻭ ﺙﺍﺮﺘﻟﺍ ﻒﺸﻜﺘﺴﺗ ﺔﻠﻘﺘﺴﻣ ﺺﺼﻗ ﻲﻫ |r«ﻡﺎﻤﺘﻫﻻﺍ ﻁﺎﻘﻧ»|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "(.ﺐﻫﺬﻟﺍ ﻦﻣ ﻂﻴﺴﺑ ﻎﻠﺒﻣ ﻞﺑﺎﻘﻣ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻥﺎﻜﻣ ﻱﺃ ﻦﻣ ﺡﻮﺘﻔﻣ ﺭﺍﺰﻣ ﻱﺃ ﻰﻟﺇ ﺓﺮﺷﺎﺒﻣ ﺮﻔﺴﻟﺍ ﻚﻨﻜﻤﻳ ﺎﻤﻛ .ﺎﻬﺤﺘﻓﻭ ﺎﻬﻓﺎﺸﺘﻛﺍ ﻢﺗ ﻲﺘﻟﺍ ﺕﺍﺭﺍﺰﻤﻟﺍ ﻦﻴﺑ ﻱﺭﻮﻔﻟﺍﻭ ﻲﻧﺎﺠﻤﻟﺍ ﺮﻔﺴﻟﺍ ﺢﻴﺘﺗ |rﺕﺍﺭﺍﺰﻤﻟﺍ|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "(.ﺮﺻﺎﻨﻌﻟﺍ ﺕﺎﻋﻮﻤﺠﻣ ﻦﻣ ﺕﺍﺪﻌﻣ ﺢﻨﻤﻳ ﺲﻴﺋﺭﻭ ﺓﺪﺣﺍﻭ ﺔﻳﻭﺎﻤﺳ ﺔﻴﻈﺷ ﻰﻠﻋ ﺎﻤﺋﺍﺩ ﻑﻮﻬﻜﻟﺍ ﻱﻮﺘﺤﺗﻭ .ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻊﻴﻤﺟ ﻲﻓ ﺮﺸﺘﻨﺗﻭ ﻙﺩﺮﻔﻤﺑ ﺎﻬﺿﻮﺧ ﻦﻜﻤﻳ ﺔﻴﺒﻗﺃ ﻲﻫ |r\"ﻑﻮﻬﻜﻟﺍ\"|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "(.ﺮﺻﺎﻨﻌﻟﺍ ﺕﺎﻋﻮﻤﺠﻣ ﻦﻣ ﺕﺍﺪﻌﻣ ﺢﻨﻤﻳ ﺲﻴﺋﺭﻭ ﺓﺪﺣﺍﻭ ﺔﻳﻭﺎﻤﺳ ﺔﻴﻈﺷ ﻰﻠﻋ ﺎﻤﺋﺍﺩ \"Group Delves\" ﻱﻮﺘﺤﺗﻭ .ﻦﻴﺒﻋﻻ ﺔﻌﺑﺭﺃ ﻦﻣ ﺔﻧﻮﻜﻣ ﺕﺎﻋﻮﻤﺠﻤﻟ ﺎﺼﻴﺼﺧ ﺔﻤﻤﺼﻣﻭ ،ﻥﺭﻮﻠﻏﺍﺮﻛ ﻲﻓ ﻊﻘﺗ ﺡﻮﺘﻔﻣ ﻢﻟﺎﻋ ﺕﺍﺫ ﺔﻴﺒﻗﺃ ﻲﻫ |cffffff\"Group Delves\"|r)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "(.ﺎﻬﻠﻜﺷ ﺮﻴﻴﻐﺗ ﻭﺃ ﺓﺪﻳﺪﺟ ﺕﺍﺭﺪﻗ ﺢﺘﻔﻟ ﺎﻬﻣﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ،ﺓﺭﺎﻬﻣ ﺔﻄﻘﻧ ﺀﺎﻤﺴﻟﺍ ﻦﻣ ﺎﻳﺎﻈﺷ ﺙﻼﺛ ﻑﺎﺸﺘﻛﺍ ﻚﺤﻨﻤﻳ .ﻪﻨﻣ ﺚﻌﺒﻨﺗ ﻱﺬﻟﺍ ﻊﻃﺎﺴﻟﺍ ﺾﻴﺑﻷﺍ ﺀﻮﻀﻟﺍ ﻉﺎﻌﺷ ﻝﻼﺧ ﻦﻣ ﺎﻬﻴﻠﻋ ﻑﺮﻌﺘﻟﺍ ﻦﻜﻤﻳﻭ ،ﻢﻟﺎﻌﻟﺍ ﺀﺎﺤﻧﺃ ﻊﻴﻤﺟ ﻲﻓ ﺓﺮﺸﺘﻨﻣ |rﺀﺎﻤﺴﻟﺍ ﺎﻳﺎﻈﺷ|cffffff)"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "(.ﻰﻠﻋﺃ ﺔﺌﻓ ﻦﻣ ﺕﺍﺪﻌﻣﻭ ﺐﻫﺫﻭ ﺓﺮﺒﺧ ﻁﺎﻘﻧ ﻲﻤﻟﺎﻋ ﺙﺪﺣ ﻝﺎﻤﻛﺇ ﻚﺤﻨﻤﻳ ﻥﺃ ﻦﻜﻤﻳ .ﻦﻳﺮﻣﺎﻐﻤﻟﺍ ﻦﻣ ﺔﻋﻮﻤﺠﻣ ﻞﺒﻗ ﻦﻣ ﺎﻬﺘﻬﺟﺍﻮﻣ ﻞﻀﻔﻳﻭ ،ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﺙﺪﺤﺗ ﺔﻄﺸﻧﺃ ﻲﻫ «ﺔﻤﻠﻈﻤﻟﺍ ﻲﺳﺍﺮﻤﻟﺍ» ﻞﺜﻣ |rﺔﻴﻤﻟﺎﻌﻟﺍ ﺙﺍﺪﺣﻷﺍ|cffffff)"
