[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TEXT] = "(.<<1[/character/characters]>> ﺪﻳﺰﻤﻟﺍ <<1>> ﻑﺬﺣ ﻚﻨﻜﻤﻳ)\n\n(|r.ﻚﺑﺎﺴﺣ ﻦﻣ ﺮﺻﺎﻨﻌﻟﺍ ﻚﻠﺗ ﻥﺍﺪﻘﻓ ﻰﻟﺇ ﺩﺍﺩﺮﺘﺳﻻﺍ ﺯﻮﻣﺭ ﺮﺒﻋ ﺎﻬﻴﻠﻋ ﻝﻮﺼﺤﻟﺍ ﻢﺗ ﻭﺃ «Crown Store» ﺮﺠﺘﻣ ﻦﻣ ﺮﺻﺎﻨﻋ ﻰﻠﻋ ﻱﻮﺘﺤﺗ ﺔﻴﺼﺨﺷ ﻑﺬﺣ ﻱﺩﺆﻴﺳ|cff9633)\n\n(.ﺎﻬﻨﻳﺰﺨﺘﻟ ﻲﻓﺮﺼﻣ ﻉﺮﻓ ﺏﺮﻗﺃ ﻰﻟﺇ ﻪﺟﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ ،ﺽﺍﺮﻏﻷﺍ ﻩﺬﻬﺑ ﻅﺎﻔﺘﺣﻻﺍ ﻲﻓ ﺐﻏﺮﺗ ﺖﻨﻛ ﺍﺫﺇ)\n\n(.ﺏﺎﺴﺤﻟﺍ ﺕﺎﻴﻗﺮﺗﻭ ﺀﺎﻳﺯﻷﺍﻭ ﺔﻔﻴﻟﻷﺍ ﺕﺎﻧﺍﻮﻴﺤﻟﺍﻭ ﻞﻘﻨﺘﻟﺍ ﻞﺋﺎﺳﻭ ﻞﺜﻣ ﺕﺎﻴﻨﺘﻘﻤﻟﺍ ﺪﻘﻔﺗ ﻦﻟ)\n\n(.ﺎﻬﻧﻭﺰﺨﻣ ﻲﻓ ﺓﺮﻓﻮﺘﻤﻟﺍﻭ ﺔﻴﺼﺨﺸﻟﺍ ﻰﻠﻋ ﺓﺰﻬﺠﻤﻟﺍ ﺔﻳﺩﺎﻌﻟﺍ ﺮﺻﺎﻨﻌﻟﺍ ﺮﻴﻣﺪﺗ ﻢﺘﻴﺳ)"
