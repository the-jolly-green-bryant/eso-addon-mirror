[SI_PROVIDE_OTP_INITIAL_DIALOG_TEXT] = "(.<<1>> ﻰﻠﻋ ﺮﻘﻨﻟﺍﻭ ﺰﻣﺮﻟﺍ ﻝﺎﺧﺩﺇ ﻰﺟﺮﻳ .ﺪﺟﻭ ﻥﺇ ،ﺏﺎﺴﺤﻟﺍ ﺍﺬﻬﺑ ﻂﺒﺗﺮﻤﻟﺍ ﻲﻧﻭﺮﺘﻜﻟﻹﺍ ﺪﻳﺮﺒﻟﺍ ﻥﺍﻮﻨﻋ ﻰﻟﺇ ﻝﻮﺧﺪﻟﺍ ﺰﻣﺭ ﻝﺎﺳﺭﺇ ﻢﺗ)\n\n(.ﺪﻳﺪﺟ ﻝﻮﺻﻭ ﺰﻣﺭ ﻝﺎﺳﺭﺇ ﺐﻠﻄﻟ |cffffff<<2>>|r ﻲﻓ ﻯﺮﺧﺃ ﺓﺮﻣ ﻝﻭﺎﺣ ﻢﺛ ،ﺭﻭﺮﻤﻟﺍ ﺔﻤﻠﻛﻭ ﻡﺪﺨﺘﺴﻤﻟﺍ ﻢﺳﺍ ﻦﻣ ﻖﻘﺤﺘﻟﺍ ﻰﺟﺮﻳ ،ﺔﻴﻧﻭﺮﺘﻜﻟﻹﺍ ﺔﻟﺎﺳﺮﻟﺍ ﻩﺬﻫ ﻰﻠﻋ ﺭﻮﺜﻌﻟﺍ ﻦﻣ ﻦﻜﻤﺘﺗ ﻢﻟ ﺍﺫﺇ)"
[SI_PROVIDE_OTP_INITIAL_DIALOG_TEXT_GAMEPAD] = "(.«ﻝﺎﺳﺭﺇ» ﻰﻠﻋ ﻂﻐﻀﻟﺍ ﻢﺛ ﺰﻣﺮﻟﺍ ﻝﺎﺧﺩﺇ ﻰﺟﺮﻳ .ﺪﺟﻭ ﻥﺇ ،ﺏﺎﺴﺤﻟﺍ ﺍﺬﻬﺑ ﻂﺒﺗﺮﻤﻟﺍ ﻲﻧﻭﺮﺘﻜﻟﻹﺍ ﺪﻳﺮﺒﻟﺍ ﻥﺍﻮﻨﻋ ﻰﻟﺇ ﻝﻮﺧﺪﻟﺍ ﺰﻣﺭ ﻝﺎﺳﺭﺇ ﻢﺗ)\n\n(.ﺪﻳﺪﺟ ﻝﻮﺻﻭ ﺰﻣﺭ ﻝﺎﺳﺭﺇ ﺐﻠﻄﻟ |cffffff<<1>>|r ﻝﻼﺧ ﻯﺮﺧﺃ ﺓﺮﻣ ﻝﻭﺎﺣ ﻢﺛ ،ﻚﺑ ﻦﻴﺻﺎﺨﻟﺍ ﺭﻭﺮﻤﻟﺍ ﺔﻤﻠﻛﻭ ﻡﺪﺨﺘﺴﻤﻟﺍ ﻢﺳﺍ ﻦﻣ ﻖﻘﺤﺘﻟﺍ ﻰﺟﺮﻳ ،ﺔﻴﻧﻭﺮﺘﻜﻟﻹﺍ ﺔﻟﺎﺳﺮﻟﺍ ﻩﺬﻫ ﻰﻠﻋ ﺭﻮﺜﻌﻟﺍ ﻦﻣ ﻦﻜﻤﺘﺗ ﻢﻟ ﺍﺫﺇ)"
[SI_PROVIDE_OTP_SUBSEQUENT_DIALOG_TEXT] = "(.ﻩﺎﻧﺩﺃ ﺺﻨﻟﺍ ﻞﻘﺣ ﻲﻓ ﻪﻟﺎﺧﺩﺇﻭ ﺢﻴﺤﺼﻟﺍ ﺰﻣﺮﻟﺍ ﻰﻠﻋ ﻝﻮﺼﺤﻠﻟ ﻲﻧﻭﺮﺘﻜﻟﻹﺍ ﻙﺪﻳﺮﺑ ﻦﻣ ﻖﻘﺤﺘﻟﺍ ﻰﺟﺮﻳ .ﻝﻮﺧﺪﻟﺍ ﺰﻣﺭ ﻝﺎﺧﺩﻹ ﺔﻘﺑﺎﺴﻟﺍ ﻚﺘﻟﻭﺎﺤﻣ ﺖﻠﺸﻓ ﺪﻘﻟ)\n\n(.ﺪﻳﺪﺟ ﺰﻣﺭ ﻝﺎﺳﺭﻹ |cffffff<<1>>|r ﻝﻼﺧ ﻯﺮﺧﺃ ﺓﺮﻣ ﻝﻭﺎﺣ ﻢﺛ ،ﺭﻭﺮﻤﻟﺍ ﺔﻤﻠﻛﻭ ﻡﺪﺨﺘﺴﻤﻟﺍ ﻢﺳﺍ ﻦﻣ ﻖﻘﺤﺘﻟﺍ ﻰﺟﺮﻳ ،ﺔﻴﻧﻭﺮﺘﻜﻟﻹﺍ ﺔﻟﺎﺳﺮﻟﺍ ﻩﺬﻫ ﻰﻠﻋ ﺭﻮﺜﻌﻟﺍ ﻦﻣ ﻦﻜﻤﺘﺗ ﻢﻟ ﺍﺫﺇ)"
