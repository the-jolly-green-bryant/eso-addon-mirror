[SI_RESPECTYPE1] = "(.ﺕﺍﺮﻴﻴﻐﺘﻠﻟ ﺔﻠﻣﺎﻜﻟﺍ ﺔﻤﺋﺎﻘﻟﺍ ﻰﻠﻋ ﻉﻼﻃﻼﻟ ﺚﻳﺪﺤﺘﻟﺍ ﺕﺎﻈﺣﻼﻣ ﺓﺀﺍﺮﻗ ﻰﺟﺮﻳ .ﻢﻜﺑ ﺔﺻﺎﺨﻟﺍ ﺺﺋﺎﺼﺨﻟﺍ ﻁﺎﻘﻧ ﻊﻴﻤﺟ ﺓﺩﺎﻋﺇ ﺖﻤﺗ ،ﻢﻜﻟ ﺎﻀﻳﻮﻌﺗﻭ .ﺚﻳﺪﺤﺘﻟﺍ ﺍﺬﻫ ﻲﻓ ﺺﺋﺎﺼﺨﻟﺍ ﺔﻧﺯﺍﻮﻣ ﺓﺩﺎﻋﺇ ﺖﻤﺗ)"
