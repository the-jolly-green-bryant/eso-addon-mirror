[SI_DELETE_CHARACTER_DIALOG_TEXT] = "( |r.ﻚﺑﺎﺴﺣ ﻦﻣ ﺮﺻﺎﻨﻌﻟﺍ ﻚﻠﺗ ﻥﺍﺪﻘﻓ ﻰﻟﺇ ﺩﺍﺩﺮﺘﺳﻻﺍ ﺯﻮﻣﺭ ﺮﺒﻋ ﺎﻬﻴﻠﻋ ﻝﻮﺼﺤﻟﺍ ﻢﺗ ﺮﺻﺎﻨﻋ ﻭﺃ «ﻥﻭﺍﺮﻛ» ﺮﺠﺘﻣ ﻦﻣ ﺮﺻﺎﻨﻋ ﻰﻠﻋ ﺎﻬﻧﻭﺰﺨﻣ ﻲﻓ ﻱﻮﺘﺤﺗ ﺔﻴﺼﺨﺷ ﻑﺬﺣ ﻱﺩﺆﻴﺳ|cff0000)\n\n(.ﺎﻬﻨﻳﺰﺨﺘﻟ ﻚﻨﺑ ﻊﺋﺎﺑ ﺏﺮﻗﺃ ﻰﻟﺇ ﻪﺟﻮﺘﻟﺍ ﻰﺟﺮﻳ ،ﺮﺻﺎﻨﻌﻟﺍ ﻩﺬﻬﺑ ﻅﺎﻔﺘﺣﻻﺍ ﻲﻓ ﺐﻏﺮﺗ ﺖﻨﻛ ﺍﺫﺇ .ﺎﻬﻧﻭﺰﺨﻣ ﻲﻓ ﺓﺩﻮﺟﻮﻤﻟﺍﻭ ﺔﻴﺼﺨﺸﻟﺍ ﻰﻠﻋ ﺓﺰﻬﺠﻤﻟﺍ ﺔﻳﺩﺎﻌﻟﺍ ﺮﺻﺎﻨﻌﻟﺍ ﻑﻼﺗﺇ ﻢﺘﻴﺳ ﺎﻤﻛ .ﺏﺎﺴﺤﻟﺍ ﺕﺎﻴﻗﺮﺗﻭ ﺀﺎﻳﺯﻷﺍﻭ ﺔﻔﻴﻟﻷﺍ ﺕﺎﻧﺍﻮﻴﺤﻟﺍﻭ ﺕﺎﺒﻛﺮﻤﻟﺍ ﻞﺜﻣ ﻊﻴﻤﺠﺘﻠﻟ ﺔﻠﺑﺎﻘﻟﺍ ﺮﺻﺎﻨﻌﻟﺍ ﺪﻘﻔﺗ ﻦﻟ)\n\n(.ﺖﻗﻮﻟﺍ ﺭﻭﺮﻣ ﻊﻣ ﺔﻴﻓﺎﺿﺇ ﻑﺬﺣ ﺕﺍﺭﺎﻴﺧ ﺮﻓﻮﺘﺘﺳﻭ  .|cFFFFFF<<4>>|r <<4[/character/characters]>> ﻑﺬﺣ ﺎﻴﻟﺎﺣ ﻚﻨﻜﻤﻳ)\n\n(.<<3>> ﺭﺰﻟﺍ ﻰﻠﻋ ﺮﻘﻧﺍﻭ ﻩﺎﻧﺩﺃ |cFFFFFF<<2>>|r ﺐﺘﻛﺍ ،ﺪﻴﻛﺄﺘﻠﻟ ؟|cFFFFFF<<1>>|r ﻑﺬﺣ ﺪﻳﺮﺗ ﻚﻧﺃ ﻦﻣ ﺪﻛﺄﺘﻣ ﺖﻧﺃ ﻞﻫ)"
