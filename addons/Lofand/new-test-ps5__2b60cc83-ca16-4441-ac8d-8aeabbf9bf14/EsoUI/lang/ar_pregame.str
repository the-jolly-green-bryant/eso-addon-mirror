[SI_FASTTRAVELKEEPRESULT12] = "(.ﻊﻳﺮﺴﻟﺍ ﻞﻘﻨﺘﻟﺍ ﺓﺰﻴﻣ ﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﻻ)"
[SI_FASTTRAVELKEEPRESULT14] = "(.ﺍﺪﺟ ﺔﻠﻴﻠﻗ ﺀﺎﻔﻠﺤﻟﺍ ﺓﺯﻮﺣ ﻲﻓ ﺔﻴﻗﻼﻄﻧﻻﺍ ﺔﻌﻠﻘﻟﺍ ﻲﻓ ﺓﺮﻓﻮﺘﻤﻟﺍ ﺩﺭﺍﻮﻤﻟﺍ ﻥﻷ «ﻊﻳﺮﺴﻟﺍ ﺮﻔﺴﻟﺍ» ﺓﺰﻴﻣ ﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﻻ)"
[SI_FASTTRAVELKEEPRESULT15] = "(.ﺀﺎﻋﺪﺘﺳﺍ ﺮﺠﺣ ﺪﺟﻮﺗ ﻻ)"
[SI_FASTTRAVELKEEPRESULT16] = "(.ﻪﻨﻣ ﺏﺮﻘﻟﺎﺑ ﻭﺃ ﻦﺼﺤﻟﺍ ﻞﺧﺍﺩ ﻦﻣ ﺀﺎﻋﺪﺘﺳﻻﺍ ﺮﺠﺣ ﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﻻ)"
[SI_FASTTRAVELKEEPRESULT2] = "(.ﺔﺑﻮﻠﻄﻤﻟﺍ ﺔﻬﺟﻮﻟﺍ ﻰﻟﺇ ﻊﻳﺮﺴﻟﺍ ﻞﻘﻨﺘﻠﻟ ﺢﻟﺎﺻ ﺭﺎﺴﻣ ﺪﺟﻮﻳ ﻻ ﻪﻧﻷ ﻊﻳﺮﺴﻟﺍ ﻞﻘﻨﺘﻟﺍ ﺓﺰﻴﻣ ﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﻻ)"
[SI_FASTTRAVELKEEPRESULT3] = "(.ﻚﻔﻟﺎﺤﺗ ﻦﻋ ﻒﻠﺘﺨﻳ ﺎﻬﻨﻣ ﺃﺪﺒﺗ ﻲﺘﻟﺍ ﺔﻌﻠﻘﻟﺍ ﻒﻟﺎﺤﺗ ﻥﻷ «ﻊﻳﺮﺴﻟﺍ ﺮﻔﺴﻟﺍ» ﺓﺰﻴﻣ ﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﻻ)"
[SI_FASTTRAVELKEEPRESULT4] = "(.ﺎﻴﻟﺎﺣ ﻡﻮﺠﻬﻠﻟ ﺽﺮﻌﺘﺗ ﺔﺒﻌﻠﻟﺍ ﺎﻬﻨﻣ ﺃﺪﺒﺗ ﻲﺘﻟﺍ ﺔﻌﻠﻘﻟﺍ ﻥﻷ «ﻊﻳﺮﺴﻟﺍ ﺮﻔﺴﻟﺍ» ﺓﺰﻴﻣ ﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﻻ)"
[SI_FASTTRAVELKEEPRESULT5] = "(.ﻚﻔﻟﺎﺤﺗ ﻦﻋ ﻒﻠﺘﺨﻳ ﺔﻬﺟﻮﻟﺍ ﻪﻴﻟﺇ ﻲﻤﺘﻨﺗ ﻱﺬﻟﺍ ﻒﻟﺎﺤﺘﻟﺍ ﻥﻷ «ﻊﻳﺮﺴﻟﺍ ﺮﻔﺴﻟﺍ» ﺓﺰﻴﻣ ﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﻻ)"
[SI_FASTTRAVELKEEPRESULT6] = "(.ﺎﻴﻟﺎﺣ ﻡﻮﺠﻬﻠﻟ ﺽﺮﻌﺘﻳ ﺔﻬﺟﻮﻛ ﻩﺪﻳﺪﺤﺗ ﻢﺗ ﻱﺬﻟﺍ ﻦﺼﺤﻟﺍ ﻥﻷ «ﻊﻳﺮﺴﻟﺍ ﺮﻔﺴﻟﺍ» ﺓﺰﻴﻣ ﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﻻ)"
[SI_FASTTRAVELKEEPRESULT7] = "(.ﻭﺪﻌﻟﺍ ﺓﺯﻮﺣ ﻲﻓ ﻞﻗﻷﺍ ﻰﻠﻋ ﺪﺣﺍﻭ ﺩﺭﻮﻣ ﻰﻠﻋ ﻱﻮﺘﺤﻳ ﻝﺍﺰﻳ ﻻ ﻪﻴﻟﺇ ﻝﻮﺻﻮﻟﺍ ﺪﻳﺮﺗ ﻱﺬﻟﺍ ﻦﺼﺤﻟﺍ ﻥﻷ «ﻊﻳﺮﺴﻟﺍ ﺮﻔﺴﻟﺍ» ﺓﺰﻴﻣ ﻡﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﻻ)"
