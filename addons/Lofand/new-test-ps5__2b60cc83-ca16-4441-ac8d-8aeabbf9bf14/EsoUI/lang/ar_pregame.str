[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "(.ﺔﺒﻌﻠﻟﺎﺑ ﺔﺻﺎﺨﻟﺍ ﺕﺎﻘﻔﺼﻟﺍ ﺕﻼﺠﺴﺑ ﺎﻬﺘﻧﺭﺎﻘﻣﻭ ﺎﻬﺘﺸﻗﺎﻨﻣ ﺖﻤﺗ ﻲﺘﻟﺍ ﺔﻘﻔﺼﻟﺍ ﻞﻴﺻﺎﻔﺗ ﻦﻣ ﺪﻛﺄﺘﻠﻟ ﺔﺒﻌﻠﻟﺍ ﻞﺧﺍﺩ ﺔﺷﺩﺭﺪﻟﺍ ﺕﻼﺠﺳ ﻢﻴﻴﻘﺘﺑ ﺀﻼﻤﻌﻟﺍ ﺔﻣﺪﺧ ﻮﻔﻇﻮﻣ ﻡﻮﻘﻴﺳ)"
