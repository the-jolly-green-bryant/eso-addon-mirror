[SI_REDEEMCODERESULT0] = "!ﺡﺎﺠﻨﺑ ﻙﺰﻣﺭ ﺩﺍﺩﺮﺘﺳﺍ ﻢﺗ"
[SI_REDEEMCODERESULT1] = ".ﻯﺮﺧﺃ ﺓﺮﻣ ﻝﻭﺎﺣﻭ ﻙﺰﻣﺭ ﻦﻣ ﻖﻘﺤﺗ .ﻞﺒﻗ ﻦﻣ ﺰﻣﺮﻟﺍ ﺍﺬﻫ ﺩﺍﺩﺮﺘﺳﺍ ﻢﺗ ﺎﻤﺑﺭ"
[SI_REDEEMCODERESULT10] = ".ﺡﺎﺘﻣ ﺮﻴﻏ ﻭﺃ ﺢﻟﺎﺻ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﺩﺍﺩﺮﺘﺳﺍ ﺭﺬﻌﺗ\nThe Elder ﻦﻣ ﻡﺪﻘﻣ ﺓﺄﻓﺎﻜﻣ ﺰﻣﺭ ﻝﺎﺧﺩﺇ ﻦﻣ ﺪﻛﺄﺘﻟﺍ ﻰﺟﺮﻳ\nScrolls® Online. ﻭﺃ ﺚﻟﺎﺛ ﻑﺮﻃ ﻦﻣ ﻚﻟ ﺎًﻣﺪﻘﻣ ﻙﺰﻣﺭ ﻥﺎﻛ ﺍﺫﺇ\nﺔﺻﺎﺨﻟﺍ ﺰﻣﺮﻟﺍ ﺩﺍﺩﺮﺘﺳﺍ ﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﻪﺑ ﺎًﻘﻠﻌﺘﻣ\nﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ ،ﺓﺪﻋﺎﺴﻤﻟﺍ ﻰﻟﺇ ﺔﺟﺎﺤﺑ ﻝﺍﺰﺗ ﻻ ﺖﻨﻛ ﺍﺫﺇ .ﻢﻬﺑ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ"
[SI_REDEEMCODERESULT2] = ".ﺮﻴﺼﻗ ﺖﻗﻭ ﻲﻓ ﺯﻮﻣﺮﻟﺍ ﻦﻣ ﺍًﺪﺟ ﺮﻴﺒﻛ ﺩﺪﻋ ﺩﺍﺩﺮﺘﺳﺍ ﺖﻟﻭﺎﺣ ﺪﻘﻟ\n.ﺎًﻘﺣﻻ ﻯﺮﺧﺃ ﺓﺮﻣ ﺔﻟﻭﺎﺤﻤﻟﺍﻭ ﺭﺎﻈﺘﻧﻻﺍ ﻰﺟﺮﻳ"
[SI_REDEEMCODERESULT3] = "ﺔﻟﻭﺎﺤﻤﻟﺍ ﻰﺟﺮﻳ .ﻲﻟﺎﺤﻟﺍ ﺖﻗﻮﻟﺍ ﻲﻓ ﺰﻣﺮﻟﺍ ﺩﺍﺩﺮﺘﺳﺍ ﻡﺎﻤﺗﺇ ﺭﺬﻌﺗ\n.ﺎًﻘﺣﻻ ﻯﺮﺧﺃ ﺓﺮﻣ"
[SI_REDEEMCODERESULT4] = ".ﺔﺼﻨﻤﻟﺍ ﻩﺬﻫ ﻰﻠﻋ ﺡﺎﺘﻣ ﺮﻴﻏ ﺯﻮﻣﺮﻟﺍ ﺩﺍﺩﺮﺘﺳﺍ"
[SI_REDEEMCODERESULT5] = "ﺍًﺩﺮﺘﺴﻣ ﻭﺃ ،ﺢﻟﺎﺻ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﺩﺍﺩﺮﺘﺳﺍ ﺭﺬﻌﺗ\nﺰﻣﺭ ﻝﺎﺧﺩﺇ ﻦﻣ ﺪﻛﺄﺘﻟﺍ ﻰﺟﺮﻳ .ﻚﺘﺼﻨﻣ ﻰﻠﻋ ﻞﻫﺆﻣ ﺮﻴﻏ ﻭﺃ ،ﻞﺒﻗ ﻦﻣ\nﻙﺰﻣﺭ ﻥﺎﻛ ﺍﺫﺇ .The Elder Scrolls® Online ﻦﻣ ﻡﺪﻘﻣ ﺓﺄﻓﺎﻜﻣ\nﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﻪﺑ ﺎًﻘﻠﻌﺘﻣ ﻭﺃ ﺚﻟﺎﺛ ﻑﺮﻃ ﻦﻣ ﻚﻟ ﺎًﻣﺪﻘﻣ\nﺔﺟﺎﺤﺑ ﻝﺍﺰﺗ ﻻ ﺖﻨﻛ ﺍﺫﺇ .ﻢﻬﺑ ﺔﺻﺎﺨﻟﺍ ﺰﻣﺮﻟﺍ ﺩﺍﺩﺮﺘﺳﺍ ﺕﺎﻤﻴﻠﻌﺗ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ ،ﺓﺪﻋﺎﺴﻤﻟﺍ ﻰﻟﺇ"
[SI_REDEEMCODERESULT6] = "ﻯﺮﺧﺃ ﺓﺮﻣ ﺔﻟﻭﺎﺤﻤﻟﺍ ﻰﺟﺮﻳ .ﻚﺑﺎﺴﺣ ﻰﻟﺇ ﻝﻮﺻﻮﻟﺍ ﻲﻓ ﺔﻠﻜﺸﻣ ﺖﺛﺪﺣ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻭﺃ ﺎًﻘﺣﻻ"
[SI_REDEEMCODERESULT7] = "ﻭﺃ ﻚﺑﺎﺴﺣ ﻰﻠﻋ ﻞﻫﺆﻣ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﺩﺍﺩﺮﺘﺳﺍ ﺭﺬﻌﺗ\nﻙﺰﻣﺭ ﻥﺎﻛ ﺍﺫﺇ .ﻲﻧﻭﺮﺘﻜﻟﻹﺍ ESO ﻊﻗﻮﻣ ﺮﺒﻋ ﻩﺩﺍﺩﺮﺘﺳﺍ ﻡﺰﻠﻳ\nﻰﺟﺮﻴﻓ ،ﺚﻟﺎﺛ ﻑﺮﻃ ﻦﻣ ﻚﻟ ﺎًﻣﺪﻘﻣ ﻭﺃ ﺀﺍﺮﺷ ﺔﻴﻠﻤﻌﺑ ﺎًﻘﻠﻌﺘﻣ\nﻻ ﺖﻨﻛ ﺍﺫﺇ .ﻙﺰﻣﺭ ﻊﻣ ﺔﻘﻓﺮﻤﻟﺍ ﺩﺍﺩﺮﺘﺳﻻﺍ ﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ ،ﺓﺪﻋﺎﺴﻤﻟﺍ ﻰﻟﺇ ﺔﺟﺎﺤﺑ ﻝﺍﺰﺗ"
[SI_REDEEMCODERESULT8] = "ﻭﺃ ،ﻚﺘﺼﻨﻣ ﻰﻠﻋ ﻞﻫﺆﻣ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﺩﺍﺩﺮﺘﺳﺍ ﺭﺬﻌﺗ\nﻦﻣ ﻚﻟ ﺎًﻣﺪﻘﻣ ﻙﺰﻣﺭ ﻥﺎﻛ ﺍﺫﺇ .ﻂﺸﻧ ﺮﻴﻏ ﻭﺃ ،ﻞﺒﻗ ﻦﻣ ﺍًﺩﺮﺘﺴﻣ\nﺩﺍﺩﺮﺘﺳﻻﺍ ﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﻪﺑ ﺎًﻘﻠﻌﺘﻣ ﻭﺃ ﺚﻟﺎﺛ ﻑﺮﻃ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻭﺃ ﻙﺰﻣﺭ ﻊﻣ ﺔﻘﻓﺮﻤﻟﺍ"
[SI_REDEEMCODERESULT9] = "ﺰﻣﺭ ﻝﺎﺧﺩﺇ ﻦﻣ ﺪﻛﺄﺘﻟﺍ ﻰﺟﺮﻳ .ﺰﻣﺮﻟﺍ ﺩﺍﺩﺮﺘﺳﺍ ﺔﺠﻟﺎﻌﻣ ﺖﻠﺸﻓ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻭﺃ ﺢﻟﺎﺻ"
