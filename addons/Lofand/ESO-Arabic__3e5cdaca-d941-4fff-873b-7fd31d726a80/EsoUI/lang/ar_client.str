[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "ﻝﺎﻤﻛﺇ .ﺔﻘﻄﻨﻤﻠﻟ ﻲﺴﻴﺋﺮﻟﺍ ﻲﺼﺼﻘﻟﺍ ﺱﻮﻘﻟﺍ ﻲﻫ |cffffffﺔﻘﻄﻨﻤﻟﺍ ﺔﺼﻗ ﻡﺎﻬﻣ|r\n.ﺍًﺩﺎﺘﻋﻭ ﺎًﺒﻫﺫﻭ ﺓﺮﺒﺧﻭ ﺓﺭﺎﻬﻣ ﻁﺎﻘﻧ ﻚﺤﻨﻤﻳ ﺪﻗ ﻡﺎﻬﻤﻟﺍ ﻩﺬﻫ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = ".ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻡﺎﻤﺘﻫﻼﻟ ﺓﺮﻴﺜﻣ ﻦﻛﺎﻣﺃ ﻲﻫ |cffffffﺓﺯﺭﺎﺒﻟﺍ ﻊﻗﺍﻮﻤﻟﺍ|r\nﺯﺎﺠﻧﺇ ﻚﺤﻨﻤﻳ ﺎﻣ ﺔﻘﻄﻨﻣ ﻲﻓ ﺓﺯﺭﺎﺒﻟﺍ ﻊﻗﺍﻮﻤﻟﺍ ﻊﻴﻤﺟ ﻑﺎﺸﺘﻛﺍ\n.ﺔﻘﻄﻨﻤﻟﺍ ﻚﻠﺘﺑ ﺹﺎﺨﻟﺍ ﺏﻭﺭﺪﻟﺍ ﻒﺸﻜﺘﺴﻣ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "ﻩﺬﻫ ﻑﺮﻌُﺗ .ﻢﻟﺎﻌﻟﺍ ﺀﺎﺟﺭﺃ ﻲﻓ ﺓﺮﺛﺎﻨﺘﻣ |cffffffﺭﻭﺪﻴﻟﺎﺷ ﺔﺒﺘﻜﻣ ﺐﺘﻛ|r\nﻊﻓﺮﻳ ﺐﺘﻜﻟﺍ ﻩﺬﻫ ﻑﺎﺸﺘﻛﺍ .ﺰﻴﻤﻤﻟﺍ ﻲﻧﺍﻮﺟﺭﻷﺍ ﺎﻬﺠﻫﻮﺘﺑ ﺐﺘﻜﻟﺍ\n.ﺎﻬﺑ ﻂﺒﺗﺮﻤﻟﺍ ﺕﺍﺭﺎﻬﻤﻟﺍ ﻂﺧ ﻡّﺪﻘﻳﻭ ﺓﺮﺤﺴﻟﺍ ﺔﺑﺎﻘﻧ ﻲﻓ ﻚﺘﺒﺗﺭ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "ﺰﻳﺰﻌﺗ ﺔﺌﻴﻫ ﻰﻠﻋ ﺔﻤﻌﻧ ﺢﻨﻤﺗ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻡﺎﺴﺟﺃ |cffffffﺱﻭﺪﻧﻮﻣ ﺭﺎﺠﺣﺃ|r\nﺮﺠﺣ ﺔﻤﻌﻨﺑ ﻝﺪﺒﺘﺴُﻳ ﻰﺘﺣ ﺰﻳﺰﻌﺘﻟﺍ ﺍﺬﻫ ﺮﻤﺘﺴﻳ .ﺐﻋﻼﻟ ﺖﻗﺆﻣ\n.ﺮﺧﺁ ﺱﻭﺪﻧﻮﻣ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "ﻲﻓ ﺓﺩﻮﺟﻮﻣ ﺡﻮﺘﻔﻤﻟﺍ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﺰﻴﻟﺎﻫﺩ |cffffffﺔﻣﺎﻌﻟﺍ ﺰﻴﻟﺎﻫﺪﻟﺍ|r\nﺔﻌﺑﺭﺃ ﻦﻣ ﺕﺎﻋﻮﻤﺠﻤﻟ ﺖﻤﻤُﺻ .ﺎﻫﺀﺍﺭﻭ ﺎﻣﻭ ﻞﻴﻳﺮﻣﺎﺗ ﺀﺎﺤﻧﺃ\nﻚﺤﻨﻤﻳ ﺪﻗ ﺔﻣﺎﻌﻟﺍ ﺰﻴﻟﺎﻫﺪﻟﺍ ﻦﻣ ﺔﻔﻠﺘﺨﻣ ﺀﺍﺰﺟﺃ ﻝﺎﻤﻛﺇ .ﻦﻴﺒﻋﻻ\n.ﺍًﺩﺎﺘﻋﻭ ﺎًﺒﻫﺫﻭ ﺓﺮﺒﺧﻭ ﺓﺭﺎﻬﻣ ﺔﻄﻘﻧ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "ﺕﺍﺫ ﻊﻄﻗ ﻊﻨﺻ ﺎﻬﻴﻓ ﻚﻨﻜﻤﻳ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻊﻗﺍﻮﻣ |cffffffﻊﻄﻘﻟﺍ ﻢﻘﻃﺃ ﺕﺎﻄﺤﻣ|r\n.ﺓﺩﺪﺤﻣ ﻢﻘﻃﺃ ﺕﺂﻓﺎﻜﻣ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "ﺔﻓﺮﻌﻤﻟﺍ ﻒﺸﻜﺘﺴﺗ ﺎﻬﺗﺍﺬﺑ ﺔﻠﻘﺘﺴﻣ ﺺﺼﻗ |cffffffﻡﺎﻤﺘﻫﻻﺍ ﻁﺎﻘﻧ|r\nﺎًﺒﻫﺫﻭ ﺓﺮﺒﺧ ﻚﺤﻨﻤﺗ ﺪﻗ .ﺔﻘﻄﻨﻤﻟﺍ ﻞﺧﺍﺩ ﻊﻗﺍﻮﻤﻟﺍﻭ ﺕﺎﻴﺼﺨﺸﻟﺍﻭ\n.ﺍًﺩﺎﺘﻋﻭ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "ﺮﻔﺴﻟﺍ ﺕﺍﺭﺍﺰﻣ ﻦﻴﺑ ﻲﻧﺎﺠﻤﻟﺍ ﻱﺭﻮﻔﻟﺍ ﺮﻔﺴﻟﺍ ﺢﻴﺘﺗ |cffffffﺮﻔﺴﻟﺍ ﺕﺍﺭﺍﺰﻣ|r\nﻱﺃ ﻰﻟﺇ ﺓﺮﺷﺎﺒﻣ ﺮﻔﺴﻟﺍ ﺎًﻀﻳﺃ ﻚﻨﻜﻤﻳ .ﺖﺤﺘُﻓﻭ ﺖﻔﺸُﺘﻛﺍ ﻲﺘﻟﺍ\nﻦﻣ ﺮﻴﺴﻳ ﺭﺪﻗ ﻞﺑﺎﻘﻣ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻥﺎﻜﻣ ﻱﺃ ﻦﻣ ﺡﻮﺘﻔﻣ ﺮﻔﺳ ﺭﺍﺰﻣ\n.ﺐﻫﺬﻟﺍ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "ﺀﺎﺤﻧﺃ ﻲﻓ ﺓﺩﻮﺟﻮﻣ ﺍًﺩﺮﻔﻨﻣ ﺎﻬﺿﻮﺧ ﻦﻜﻤﻳ ﺰﻴﻟﺎﻫﺩ |cffffffﺐﻳﺩﺍﺮﺴﻟﺍ|r\nﻢﻴﻋﺯﻭ ﺓﺪﺣﺍﻭ ﺀﺎﻤﺳ ﺔﻴﻈﺷ ﻰﻠﻋ ﺎًﻤﺋﺍﺩ ﺐﻳﺩﺍﺮﺴﻟﺍ ﻱﻮﺘﺤﺗ .ﻢﻟﺎﻌﻟﺍ\n.ﻊﻄﻘﻟﺍ ﻢﻘﻃﺃ ﺩﺎﺘﻋ ﻂﻘﺴُﻳ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "ﻲﻓ ﺓﺩﻮﺟﻮﻣ ﺡﻮﺘﻔﻤﻟﺍ ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﺰﻴﻟﺎﻫﺩ |cffffffﺔﻴﻋﺎﻤﺠﻟﺍ ﺐﻳﺩﺍﺮﺴﻟﺍ|r\nﻱﻮﺘﺤﺗ .ﻦﻴﺒﻋﻻ ﺔﻌﺑﺭﺃ ﻦﻣ ﺕﺎﻋﻮﻤﺠﻤﻟ ﺎًﺼﻴﺼﺧ ﺖﻤﻤُﺻ ،ﻥﺭﻮﻠﻏﺍﺮﻛ\nﻢﻴﻋﺯﻭ ﺓﺪﺣﺍﻭ ﺀﺎﻤﺳ ﺔﻴﻈﺷ ﻰﻠﻋ ﺎًﻤﺋﺍﺩ ﺔﻴﻋﺎﻤﺠﻟﺍ ﺐﻳﺩﺍﺮﺴﻟﺍ\n.ﻊﻄﻘﻟﺍ ﻢﻘﻃﺃ ﺩﺎﺘﻋ ﻂﻘﺴُﻳ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "ﺎﻫﺰﻴﻴﻤﺗ ﻦﻜﻤﻳﻭ ﻢﻟﺎﻌﻟﺍ ﺀﺎﺟﺭﺃ ﻲﻓ ﺓﺮﺛﺎﻨﺘﻣ |cffffffﺀﺎﻤﺴﻟﺍ ﺎﻳﺎﻈﺷ|r\nﺙﻼﺛ ﻑﺎﺸﺘﻛﺍ .ﺎﻬﻨﻣ ﺚﻌﺒﻨﻤﻟﺍ ﻊﻃﺎﺴﻟﺍ ﺾﻴﺑﻷﺍ ﺀﻮﻀﻟﺍ ﺩﻮﻤﻌﺑ\nﺕﺍﺭﺪﻗ ﺢﺘﻔﻟ ﺎﻬﻣﺍﺪﺨﺘﺳﺍ ﻚﻨﻜﻤﻳ ﺓﺭﺎﻬﻣ ﺔﻄﻘﻧ ﻚﺤﻨﻤﻳ ﺀﺎﻤﺳ ﺎﻳﺎﻈﺷ\n.ﺎﻫﺮﻳﻮﻄﺗ ﻭﺃ ﺓﺪﻳﺪﺟ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "ﻢﻟﺎﻌﻟﺍ ﻲﻓ ﻊﻘﺗ ﺔﻄﺸﻧﺃ ﺔﻤﻠﻈﻤﻟﺍ ﻲﺳﺍﺮﻤﻟﺍ ﻞﺜﻣ |cffffffﻢﻟﺎﻌﻟﺍ ﺙﺍﺪﺣﺃ|r\nﺙﺪﺣ ﻝﺎﻤﻛﺇ .ﻦﻳﺮﻣﺎﻐﻤﻟﺍ ﻦﻣ ﺔﻋﻮﻤﺠﻤﺑ ﺎﻬﻟ ﻱﺪﺼﺘﻟﺍ ﻞﻀﻓﻷﺍ ﻦﻣﻭ\n.ﻰﻠﻋﺃ ﺔﻘﺒﻃ ﻦﻣ ﺍًﺩﺎﺘﻋﻭ ﺎًﺒﻫﺫﻭ ﺓﺮﺒﺧ ﻚﺤﻨﻤﻳ ﺪﻗ ﻲﻤﻟﺎﻋ"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION9] = "ﻦﻣ ﺔﻋﻮﻤﺠﻤﺑ ﻢﻬﻟ ﻱﺪﺼﺘﻟﺍ ﺽﺮﺘﻔُﻳ ﺀﺍﺪﺷﺃ ﺀﺍﺪﻋﺃ |cffffffﻢﻟﺎﻌﻟﺍ ﺀﺎﻤﻋﺯ|r\nﺔﻘﺒﻃ ﻦﻣ ﺍًﺩﺎﺘﻋ ﻚﺤﻨﻤﺗ ﺪﻗ ﻢﻟﺎﻋ ﻢﻴﻋﺯ ﺔﻤﻳﺰﻫ .ﻦﻳﺮﻣﺎﻐﻤﻟﺍ\n.ﻰﻠﻋﺃ"
