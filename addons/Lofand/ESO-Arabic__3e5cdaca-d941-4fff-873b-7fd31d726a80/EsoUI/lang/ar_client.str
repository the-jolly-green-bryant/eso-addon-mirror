[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "ﺭﺎﻄﺧﺇ ﻰﻟﺇ ﻱﺩﺆﻳ ﺪﻗ ﻪﻧﺃ ﺪﻘﺘﻌﺗ ﺎًﻛﻮﻠﺳ ﺖﻈﺣﻻ ﺍﺫﺇ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﻥﺎﻨﺌﻤﻃﺍ ﺺﺤﻓ ﺀﺍﺮﺟﻹ ﺔﻃﺮﺸﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "ﺉﺭﺍﻮﻄﻟﺍ ﺕﺎﻣﺪﺨﺑ ﻝﺎﺼﺗﻻﺍ ﻰﺟﺮﻳ ،ﻱﺭﻮﻔﻟﺍ ﺮﻄﺨﻟﺍ ﺔﻟﺎﺣ ﻲﻓ\n.ﻍﻼﺒﻟﺍ ﺍﺬﻫ ﻢﻳﺪﻘﺗ ﻰﻟﺇ ﺔﻓﺎﺿﻹﺎﺑ ﺔﻴﻠﺤﻤﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "ﺔﻳﺪﻳﺪﻬﺗ ﻭﺃ ﺔﺌﻴﺴﻣ ﺔﺑﺎﺘﻛ ﻭﺃ ﻡﻼﻛ ﻦﻋ ﻍﻼﺑﻺﻟ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\nﻭﺃ ﻕﺮﻌﻟﺍ ﺱﺎﺳﺃ ﻰﻠﻋ ﺔﺻﺎﺧ ،ﺔﻨﻴﻌﻣ ﺔﺌﻓ ﺪﺿ ﻞﻣﺎﺤﺗ ﻦﻋ ﺮﺒﻌﺗ\n.ﻲﺴﻨﺠﻟﺍ ﻪﺟﻮﺘﻟﺍ ﻭﺃ ﻦﻳﺪﻟﺍ ﻭﺃ ﺔﻴﺴﻨﺠﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = ".ﻊﻤﺘﺠﻤﻟﺍ ﺔﺑﺮﺠﺗ ﻭﺃ ﺔﺒﻌﻠﻟﺍ ﺔﺌﻴﺒﺑ ﻝﻼﺧﻹﺍ ﺪﻤﻌﺘﻳ ﺺﺨﺷ ﻦﻋ ﻍﻼﺑﻺﻟ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "ﺎﻬﺴﻔﻧ ﺔﻟﺎﺳﺮﻟﺍ ﻞﺳﺮﻳ ﺮﺧﺁ ﺐﻋﻻ ﻦﻋ ﻍﻼﺑﻹﺍ ﺪﻨﻋ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﺔﻴﺼﻨﻟﺍ ﺔﺷﺩﺭﺪﻟﺍ ﻲﻓ ﺍًﺭﺍﺮﻜﺗﻭ ﺍًﺭﺍﺮﻣ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = ".ﻂﻘﻓ ﺔﻴﺗﻮﺼﻟﺍ ﺔﺷﺩﺭﺪﻟﺍ ﻦﻋ ﻍﻼﺑﻺﻟ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = ".ﺀﻲﺴﻣ ﻭﺃ ﺀﻱﺬﺑ <<1>> ﻭﺃ ﺔﻴﺼﺨﺷ ﻢﺳﺍ ﻦﻋ ﻍﻼﺑﻺﻟ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "ﺔﺒﻌﻠﻟﺍ ﻞﺧﺍﺩ ﺔﺷﺩﺭﺪﻟﺍ ﺕﻼﺠﺳ ﺀﻼﻤﻌﻟﺍ ﺔﻣﺪﺧ ﻮﻠﺜﻤﻣ ﻊﺟﺍﺮﻴﺳ\nﺕﻼﺠﺴﺑ ﺎﻬﺘﻧﺭﺎﻘﻣﻭ ﺎﻬﻴﻠﻋ ﻖﻔﺘﻤﻟﺍ ﺔﻘﻔﺼﻟﺍ ﻞﻴﺻﺎﻔﺗ ﻦﻣ ﻖﻘﺤﺘﻠﻟ\n.ﺔﺒﻌﻠﻟﺍ ﻲﻓ ﻝﻭﺍﺪﺘﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "ﺕﺎﻣﻮﻠﻌﻣ ﺮﺸﻨﻳ ﺐﻋﻻ ﻱﺃ ﻦﻋ ﻍﻼﺑﻺﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﺮﺧﺁ ﺐﻋﻻ ﻱﻷ ﺔﻴﻌﻗﺍﻮﻟﺍ ﺓﺎﻴﺤﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "ﻑﺮﻄﻟﺍ ﺞﻣﺍﺮﺑ ﻡﺍﺪﺨﺘﺳﺍ ،ﺮﺼﺤﻟﺍ ﻻ ﻝﺎﺜﻤﻟﺍ ﻞﻴﺒﺳ ﻰﻠﻋ ،ﺍﺬﻫ ﻞﻤﺸﻳ\n،ﻥﺍﺭﺪﺠﻟﺍ ﺕﺎﻗﺍﺮﺘﺧﺍﻭ ،ﺔﻗﺮﺘﺨﻤﻟﺍ ﺔﺤﻠﺳﻷﺍﻭ ،(ﺕﺎﺗﻮﺒﻟﺍ) ﺚﻟﺎﺜﻟﺍ\n.ﻚﻟﺫ ﺮﻴﻏﻭ ،ﺕﺎﻃﻮﻄﺨﻤﻟﺎﺑ ﺐﻋﻼﺘﻟﺍﻭ ،ﺲﻳﺭﺎﻀﺘﻟﺍ ﺕﺍﺮﻐﺛﻭ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION304] = "ﺕﺎﻴﻟﺁ ﻭﺃ ﺹﻮﺼﻨﻟﺍ ﻥﻮﺒﻋﻻ ﻡﺪﺨﺘﺴﻳ ﺎﻣﺪﻨﻋ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\nﻢﻬﺘﺒﻟﺎﻄﻣ ﺪﻌﺑ ﺎﻬﻴﻓ ﺏﻮﻏﺮﻣ ﺮﻴﻏ ﺕﺎﻴﻛﻮﻠﺳ ﺭﺍﺮﻜﺘﻟ ﺔﺒﻌﻠﻟﺍ\n.ﻒﻗﻮﺘﻟﺎﺑ"
