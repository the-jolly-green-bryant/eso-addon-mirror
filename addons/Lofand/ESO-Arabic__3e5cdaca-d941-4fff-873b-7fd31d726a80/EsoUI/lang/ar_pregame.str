[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TEXT] = ".ﺔﻴﻓﺎﺿﺇ <<1[/ﺔﻴﺼﺨﺷ/ﺕﺎﻴﺼﺨﺷ]>> <<1>> ﻑﺬﺣ ﻚﻨﻜﻤﻳ\n\n|cff9633ﻝﻮﺼﺤﻟﺍ ﻢﺗ ﺎًﻌﻄﻗ ﻭﺃ ﺝﺎﺘﻟﺍ ﺮﺠﺘﻣ ﻦﻣ ﺎًﻌﻄﻗ ﻞﻤﺤﺗ ﺔﻴﺼﺨﺷ ﻑﺬﺣ|r\n|cff9633ﻦﻣ ﻊﻄﻘﻟﺍ ﻚﻠﺗ ﻥﺍﺪﻘﻓ ﻰﻟﺇ ﻱﺩﺆﻴﺳ ﺩﺍﺩﺮﺘﺳﻻﺍ ﺯﻮﻣﺭ ﺮﺒﻋ ﺎﻬﻴﻠﻋ|r\n|cff9633.ﻚﺑﺎﺴﺣ|r\n\nﺏﺮﻗﺃ ﺓﺭﺎﻳﺯ ﻰﺟﺮﻴﻓ ،ﻊﻄﻘﻟﺍ ﻩﺬﻬﺑ ﻅﺎﻔﺘﺣﻻﺍ ﻲﻓ ﺐﻏﺮﺗ ﺖﻨﻛ ﺍﺫﺇ\n.ﺎﻬﻨﻳﺰﺨﺘﻟ ﻚﻨﺒﻟﺍ ﻲﻓ ﻊﺋﺎﺑ\n\nﺔﻔﻴﻟﻷﺍ ﺕﺎﻧﺍﻮﻴﺤﻟﺍﻭ ﺎﻳﺎﻄﻤﻟﺍ ﻞﺜﻣ ﺕﺎﻴﻨﺘﻘﻤﻟﺍ ﺪﻘﻔُﺗ ﻦﻟ\n.ﺏﺎﺴﺤﻟﺍ ﺕﺎﻴﻗﺮﺗﻭ ﺀﺎﻳﺯﻷﺍﻭ\n\nﺓﺩﻮﺟﻮﻤﻟﺍﻭ ﺔﻴﺼﺨﺸﻟﺍ ﻰﻠﻋ ﺓﺰﻬﺠﻤﻟﺍ ﺔﻳﺩﺎﻌﻟﺍ ﻊﻄﻘﻟﺍ ﺮﻴﻣﺪﺗ ﻢﺘﻴﺳ\n.ﺎﻬﺘﺒﻴﻘﺣ ﻲﻓ"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TITLE] = "ﺔﻴﺼﺨﺸﻟﺍ ﻑﺬﺣ"
[SI_DELETE_CHARACTER_DIALOG_TEXT] = "|cff0000ﺎًﻌﻄﻗ ﻭﺃ ﺝﺎﺘﻟﺍ ﺮﺠﺘﻣ ﻦﻣ ﺎًﻌﻄﻗ ﺎﻬﺘﺒﻴﻘﺣ ﻲﻓ ﻞﻤﺤﺗ ﺔﻴﺼﺨﺷ ﻑﺬﺣ|r\n|cff0000ﻚﻠﺗ ﻥﺍﺪﻘﻓ ﻰﻟﺇ ﻱﺩﺆﻴﺳ ﺩﺍﺩﺮﺘﺳﻻﺍ ﺯﻮﻣﺭ ﺮﺒﻋ ﺎﻬﻴﻠﻋ ﻝﻮﺼﺤﻟﺍ ﻢﺗ|r\n |cff0000.ﻚﺑﺎﺴﺣ ﻦﻣ ﻊﻄﻘﻟﺍ|r\n\nﺔﻔﻴﻟﻷﺍ ﺕﺎﻧﺍﻮﻴﺤﻟﺍﻭ ﺎﻳﺎﻄﻤﻟﺍ ﻞﺜﻣ ﺕﺎﻴﻨﺘﻘﻤﻟﺍ ﺪﻘﻔُﺗ ﻦﻟ\nﺔﻳﺩﺎﻌﻟﺍ ﻊﻄﻘﻟﺍ ﺮﻴﻣﺪﺗ ﻢﺘﻴﺳ ﺎﻤﻛ .ﺏﺎﺴﺤﻟﺍ ﺕﺎﻴﻗﺮﺗﻭ ﺀﺎﻳﺯﻷﺍﻭ\nﺐﻏﺮﺗ ﺖﻨﻛ ﺍﺫﺇ .ﺎﻬﺘﺒﻴﻘﺣ ﻲﻓ ﺓﺩﻮﺟﻮﻤﻟﺍﻭ ﺔﻴﺼﺨﺸﻟﺍ ﻰﻠﻋ ﺓﺰﻬﺠﻤﻟﺍ\nﻚﻨﺒﻟﺍ ﻲﻓ ﻊﺋﺎﺑ ﺏﺮﻗﺃ ﺓﺭﺎﻳﺯ ﻰﺟﺮﻴﻓ ،ﻊﻄﻘﻟﺍ ﻩﺬﻬﺑ ﻅﺎﻔﺘﺣﻻﺍ ﻲﻓ\n.ﺎﻬﻨﻳﺰﺨﺘﻟ\n\nﻑﺬﺣ ﺕﺎﻴﻠﻤﻋ ﺡﺎﺘﺘﺳﻭ  .<<4[/ﺔﻴﺼﺨﺷ/ﺕﺎﻴﺼﺨﺷ]>> |cFFFFFF<<4>>|r ﻑﺬﺣ ﺎًﻴﻟﺎﺣ ﻚﻨﻜﻤﻳ\n.ﺖﻗﻮﻟﺍ ﺭﻭﺮﻤﺑ ﺔﻴﻓﺎﺿﺇ\n\nﺐﺘﻛﺍ ،ﺪﻴﻛﺄﺘﻠﻟ ؟|cFFFFFF<<1>>|r ﻑﺬﺣ ﺪﻳﺮﺗ ﻚﻧﺃ ﻦﻣ ﺪﻛﺄﺘﻣ ﺖﻧﺃ ﻞﻫ\n.<<3>> ﺭﺯ ﻰﻠﻋ ﺮﻘﻧﺍﻭ ﻩﺎﻧﺩﺃ |cFFFFFF<<2>>|r"
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TEXT] = ".ﻲﻟﺎﺤﻟﺍ ﺖﻗﻮﻟﺍ ﻲﻓ ﺕﺎﻴﺼﺨﺷ ﻱﺃ ﻑﺬﺣ ﻚﻨﻜﻤﻳ ﻻ\n\n.ﺎًﻘﺣﻻ ﻯﺮﺧﺃ ﺓﺮﻣ ﺔﻟﻭﺎﺤﻤﻟﺍ ﻰﺟﺮﻳ  .ﺖﻗﻮﻟﺍ ﺭﻭﺮﻤﺑ ﺔﺣﺎﺘﻣ ﻑﺬﺤﻟﺍ ﺕﺎﻴﻠﻤﻋ ﺢﺒﺼﺗ"
