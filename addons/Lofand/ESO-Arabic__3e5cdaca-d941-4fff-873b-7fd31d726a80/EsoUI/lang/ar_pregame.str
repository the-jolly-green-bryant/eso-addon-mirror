[SI_REDEEMCODERESULT0] = "!ﺡﺎﺠﻨﺑ ﻙﺰﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ّﻢﺗ"
[SI_REDEEMCODERESULT1] = ".ﺍًﺩﺪﺠﻣ ﻝﻭﺎﺣﻭ ﻙﺰﻣﺭ ﻦﻣ ﻖﻘﺤﺗ .ﻞﻌﻔﻟﺎﺑ ًﻻﺪﺒﺘﺴﻣ ﺰﻣﺮﻟﺍ ﺍﺬﻫ ﻥﻮﻜﻳ ﺪﻗ"
[SI_REDEEMCODERESULT10] = ".ﺡﺎﺘﻣ ﺮﻴﻏ ﻭﺃ ﺢﻟﺎﺻ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﻞﺸﻓ\nThe Elder ﻦﻋ ﺭﺩﺎﺻ ﺓﺄﻓﺎﻜﻣ ﺰﻣﺭ ﻝﺎﺧﺩﺇ ﻦﻣ ﺪﻛﺄﺘﻟﺍ ﻰﺟﺮﻳ\nScrolls® Online. ﻭﺃ ﺚﻟﺎﺛ ﻑﺮﻃ ﻦﻣ ﺎًﻣَّﺪﻘﻣ ﻙﺰﻣﺭ ﻥﺎﻛ ﻥﺇ\nﻥﺇ .ﻪﺑ ﺔﺻﺎﺨﻟﺍ ﻝﺍﺪﺒﺘﺳﻻﺍ ﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﻪﺑ ﺎًﻄﺒﺗﺮﻣ\nﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ ،ﺓﺪﻋﺎﺴﻤﻟﺍ ﻰﻟﺇ ﺔﺟﺎﺤﺑ ﻝﺍﺰﺗ ﻻ ﺖﻨﻛ\n.ﺀﻼﻤﻌﻟﺍ"
[SI_REDEEMCODERESULT2] = "ﻰﺟﺮﻳ .ﺮﻴﺼﻗ ﺖﻗﻭ ﻝﻼﺧ ﺓﺮﻴﺜﻛ ﺯﻮﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﺖﻟﻭﺎﺣ ﺪﻘﻟ\n.ﺎًﻘﺣﻻ ﺔﻟﻭﺎﺤﻤﻟﺍﻭ ﺭﺎﻈﺘﻧﻻﺍ"
[SI_REDEEMCODERESULT3] = ".ﺎًﻘﺣﻻ ﺔﻟﻭﺎﺤﻤﻟﺍ ﻰﺟﺮﻳ .ﻲﻟﺎﺤﻟﺍ ﺖﻗﻮﻟﺍ ﻲﻓ ﺰﻣﺮﻟﺍ ﻝﺍﺪﺒﺘﺳﺍ ﻡﺎﻤﺗﺇ ﺭّﺬﻌﺗ"
[SI_REDEEMCODERESULT4] = ".ﺔﺼﻨﻤﻟﺍ ﻩﺬﻫ ﻰﻠﻋ ﺡﺎﺘﻣ ﺮﻴﻏ ﺯﻮﻣﺮﻟﺍ ﻝﺍﺪﺒﺘﺳﺍ"
[SI_REDEEMCODERESULT5] = "ًﻻﺪﺒﺘﺴﻣ ﻭﺃ ﺢﻟﺎﺻ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﻞﺸﻓ\nﺰﻣﺭ ﻝﺎﺧﺩﺇ ﻦﻣ ﺪﻛﺄﺘﻟﺍ ﻰﺟﺮﻳ .ﻚﺘﺼﻨﻣ ﻰﻠﻋ ﻞﻫﺆﻣ ﺮﻴﻏ ﻭﺃ ﻞﻌﻔﻟﺎﺑ\nﻙﺰﻣﺭ ﻥﺎﻛ ﻥﺇ .The Elder Scrolls® Online ﻦﻋ ﺭﺩﺎﺻ ﺓﺄﻓﺎﻜﻣ\nﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﻪﺑ ﺎًﻄﺒﺗﺮﻣ ﻭﺃ ﺚﻟﺎﺛ ﻑﺮﻃ ﻦﻣ ﺎًﻣَّﺪﻘﻣ\n،ﺓﺪﻋﺎﺴﻤﻟﺍ ﻰﻟﺇ ﺔﺟﺎﺤﺑ ﻝﺍﺰﺗ ﻻ ﺖﻨﻛ ﻥﺇ .ﻪﺑ ﺔﺻﺎﺨﻟﺍ ﻝﺍﺪﺒﺘﺳﻻﺍ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ"
[SI_REDEEMCODERESULT6] = "ﺎًﻘﺣﻻ ﺔﻟﻭﺎﺤﻤﻟﺍ ﻰﺟﺮﻳ .ﻚﺑﺎﺴﺣ ﻰﻟﺇ ﻝﻮﺻﻮﻟﺍ ﺀﺎﻨﺛﺃ ﺔﻠﻜﺸﻣ ﺖﺛﺪﺣ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻭﺃ"
[SI_REDEEMCODERESULT7] = "ﻭﺃ ﻚﺑﺎﺴﺣ ﻰﻠﻋ ﻞﻫﺆﻣ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﻞﺸﻓ\nﺎًﻄﺒﺗﺮﻣ ﻙﺰﻣﺭ ﻥﺎﻛ ﻥﺇ .ESO ﻊﻗﻮﻣ ﻰﻠﻋ ﻝﺍﺪﺒﺘﺳﻻﺍ ﻰﻟﺇ ﺝﺎﺘﺤﻳ\nﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﺚﻟﺎﺛ ﻑﺮﻃ ﻦﻣ ﺎًﻣَّﺪﻘﻣ ﻭﺃ ﺀﺍﺮﺷ ﺔﻴﻠﻤﻌﺑ\nﺔﺟﺎﺤﺑ ﻝﺍﺰﺗ ﻻ ﺖﻨﻛ ﻥﺇ .ﻙﺰﻣﺮﺑ ﺔﻘﻓﺮﻤﻟﺍ ﻝﺍﺪﺒﺘﺳﻻﺍ ﺕﺎﻤﻴﻠﻌﺗ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻰﺟﺮﻴﻓ ،ﺓﺪﻋﺎﺴﻤﻟﺍ ﻰﻟﺇ"
[SI_REDEEMCODERESULT8] = "ﻭﺃ ﻚﺘﺼﻨﻣ ﻰﻠﻋ ﻞﻫﺆﻣ ﺮﻴﻏ ﺰﻣﺮﻟﺍ ﻥﻮﻜﻳ ﺪﻗ .ﻙﺰﻣﺭ ﻝﺍﺪﺒﺘﺳﺍ ﻞﺸﻓ\nﻑﺮﻃ ﻦﻣ ﺎًﻣَّﺪﻘﻣ ﻙﺰﻣﺭ ﻥﺎﻛ ﻥﺇ .ﻂﺸﻧ ﺮﻴﻏ ﻭﺃ ﻞﻌﻔﻟﺎﺑ ًﻻﺪﺒﺘﺴﻣ\nﻝﺍﺪﺒﺘﺳﻻﺍ ﺕﺎﻤﻴﻠﻌﺗ ﻉﺎﺒﺗﺍ ﻰﺟﺮﻴﻓ ،ﻪﺑ ﺎًﻄﺒﺗﺮﻣ ﻭﺃ ﺚﻟﺎﺛ\n.ﺀﻼﻤﻌﻟﺍ ﻢﻋﺩ ﻊﻣ ﻞﺻﺍﻮﺘﻟﺍ ﻭﺃ ﻙﺰﻣﺮﺑ ﺔﻘﻓﺮﻤﻟﺍ"
