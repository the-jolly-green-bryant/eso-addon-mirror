[SI_GAMEPAD_ADDON_MENU_DISK_USAGE_FORMATTER] = "ﺖﻳﺎﺑﺎﻐﻴﻣ <<2>>/ﺖﻳﺎﺑﺎﻐﻴﻣ <<1>> :ﺹﺮﻘﻟﺍ ﻡﺍﺪﺨﺘﺳﺍ"
[SI_GAMEPAD_ADDON_MENU_MOD_BROWSER_TOOLTIP] = ".ﺎﻬﻨﻴﺴﺤﺗﻭ ﻚﺘﺑﺮﺠﺗ ﺀﺍﺮﺛﻹ ﻊﻤﺘﺠﻤﻟﺍ ﻱﺭﻮﻄﻣ ﻦﻣ ﺕﺎﻓﺎﺿﺇ ﻦﻋ ﺚﺤﺑﺍ\n\nﺀﻻﺆﻫﻭ ،ESO ﻊﻤﺘﺠﻣ ﺩﺍﺮﻓﺃ ﻊﻨﺻ ﻦﻣ ﺕﺎﻓﺎﺿﻹﺍ :ﺔﻈﺣﻼﻤﻟﺍ ﻰﺟﺮﻳ\n.ﺎﻬﺘﻧﺎﻴﺻﻭ ﻢﻬﺗﺎﻓﺎﺿﺇ ﻯﻮﺘﺤﻣ ﻦﻋ ﻥﻮﻟﻭﺆﺴﻣ ﻥﻭﺭﻮﻄﻤﻟﺍ"
[SI_GAMEPAD_ADDON_MENU_MOD_BROWSER_UNAVAILABLE_TOOLTIP] = ".ﺎًﻘﺣﻻ ﻯﺮﺧﺃ ﺓﺮﻣ ﻝﻭﺎﺣ .ﻞﻳﺰﻨﺘﻠﻟ ﺔﺣﺎﺘﻣ ﺮﻴﻏ ﺕﺎﻓﺎﺿﻹﺍ"
[SI_GAMEPAD_AUDIO_OPTIONS_SPATIAL_SOUND_TOOLTIP_PROSPERO] = ".ﻚﺘﺼﻨﻣ ﺕﺍﺩﺍﺪﻋﺇ ﻰﻠﻋ ًﺀﺎﻨﺑ ﻲﻧﺎﻜﻤﻟﺍ ﺕﻮﺼﻟﺍ ﺓﺎﻛﺎﺤﻣ ﻞﻌﻔﻳ\nﺓﺎﻴﺤﻟﺍ ﻲﻓ ﺕﻮﺼﻟﺍ ﻙﺍﺭﺩﺇ ﺔﻘﻳﺮﻃ ﻲﻧﺎﻜﻤﻟﺍ ﺕﻮﺼﻟﺍ ﻲﻛﺎﺤﻳ\nﺕﺍﺩﺍﺪﻋﺇ ﻲﻓ ﺩﺎﻌﺑﻷﺍ ﻲﺛﻼﺛ ﺕﻮﺼﻟﺍ ﻞﻴﻌﻔﺗ ﺐﻠﻄﺘﻳ .ﺔﻴﻌﻗﺍﻮﻟﺍ\nﻲﺛﻼﺛ ﺕﻮﺼﻟﺍ < ﺕﻮﺼﻟﺍ < ﺕﺍﺩﺍﺪﻋﻹﺍ ﻦﻤﺿ ﻚﻣﺎﻈﻧ ﻲﻓ ﺕﻮﺼﻟﺍ\n.ﺩﺎﻌﺑﻷﺍ"
[SI_GAMEPAD_AUDIO_OPTIONS_SPATIAL_SOUND_TOOLTIP_SCARLETT] = ".ﻚﺘﺼﻨﻣ ﺕﺍﺩﺍﺪﻋﺇ ﻰﻠﻋ ًﺀﺎﻨﺑ ﻲﻧﺎﻜﻤﻟﺍ ﺕﻮﺼﻟﺍ ﺓﺎﻛﺎﺤﻣ ﻞﻌﻔﻳ\nﺓﺎﻴﺤﻟﺍ ﻲﻓ ﺕﻮﺼﻟﺍ ﻙﺍﺭﺩﺇ ﺔﻘﻳﺮﻃ ﻲﻧﺎﻜﻤﻟﺍ ﺕﻮﺼﻟﺍ ﻲﻛﺎﺤﻳ\nﺕﺍﺩﺍﺪﻋﺇ ﻲﻓ ﺱﺃﺮﻟﺍ ﺔﻋﺎﻤﺳ ﻖﻴﺴﻨﺗ ﺮﻴﻴﻐﺗ ﺐﻠﻄﺘﻳ .ﺔﻴﻌﻗﺍﻮﻟﺍ\n< ﺕﺍﺩﺍﺪﻋﻹﺍ < ﻡﺎﻈﻨﻟﺍﻭ ﻲﺼﺨﺸﻟﺍ ﻒﻠﻤﻟﺍ ﻦﻤﺿ ﻚﻣﺎﻈﻧ ﻲﻓ ﺕﻮﺼﻟﺍ\n.ﺱﺃﺮﻟﺍ ﺔﻋﺎﻤﺳ ﺕﻮﺻ < ﺕﻮﺼﻟﺍ ﺝﺍﺮﺧﺇﻭ ﺕﻮﺼﻟﺍ ﻯﻮﺘﺴﻣ < ﻡﺎﻋ"
