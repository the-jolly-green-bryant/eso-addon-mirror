[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION101] = "ﻝﺎﻔﻃﻷﺍ ﺽّﺮﻌﺗ ﺔﻟﺄﺴﻣ ﻱﺃ ﻦﻋ ﻍﻼﺑﻺﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﺔﻃﺮﺸﻠﻟ ﻍﻼﺑ ﻢﻳﺪﻘﺗ ﻰﻟﺇ ﺍﺬﻫ ﻱﺩﺆﻳ ﺪﻗ .ﺮﻄﺨﻠﻟ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION102] = "ﺪﻗ ﻯﻮﺘﺴﻣ ﻰﻟﺇ ﻞﺼﻳ ﺎًﻔﻗﻮﻣ ﻯﺮﺗ ﺎﻣﺪﻨﻋ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﺔﻴﻟﺍﺭﺪﻴﻔﻟﺍ ﻥﻮﻧﺎﻘﻟﺍ ﺫﺎﻔﻧﺇ ﺕﺎﻄﻠﺳ ﺭﺎﻄﺧﺇ ﻲﻋﺪﺘﺴﻳ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION103] = "ﻱﺩﺆﻳ ﺪﻗ ﻪﻧﺃ ﺪﻘﺘﻌﺗ ﺎًﻛﻮﻠﺳ ﺖﻈﺣﻻ ﺍﺫﺇ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﻥﺎﻨﺌﻤﻃﺍ ﺺﺤﻓ ﺀﺍﺮﺟﻹ ﺔﻃﺮﺸﻟﺍ ﺭﺎﻄﺧﺇ ﻰﻟﺇ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION104] = "ﺉﺭﺍﻮﻄﻟﺍ ﺕﺎﻣﺪﺨﺑ ﻝﺎﺼﺗﻻﺍ ﻰﺟﺮﻳ ،ﻱﺭﻮﻓ ﺮﻄﺧ ﺩﻮﺟﻭ ﻝﺎﺣ ﻲﻓ\n.ﻍﻼﺒﻟﺍ ﺍﺬﻫ ﻢﻳﺪﻘﺗ ﻰﻟﺇ ﺔﻓﺎﺿﻹﺎﺑ ﺔﻴﻠﺤﻤﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION201] = "ﻭﺃ ﺔﺌﻴﺴﻣ ﺔﺑﺎﺘﻛ ﻭﺃ ﻡﻼﻛ ﻦﻋ ﻍﻼﺑﻺﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\nﺱﺎﺳﺃ ﻰﻠﻋ ﺎًﺻﻮﺼﺧ ،ﺔﻨﻴﻌﻣ ﺔﺌﻓ ﺪﺿ ﺰّﻴﺤﺗ ﻦﻋ ﺮّﺒﻌﺗ ﺔﻳﺪﻳﺪﻬﺗ\n.ﻲﺴﻨﺠﻟﺍ ﻪﺟﻮﺘﻟﺍ ﻭﺃ ﻦﻳﺪﻟﺍ ﻭﺃ ﺔﻴﺴﻨﺠﻟﺍ ﻭﺃ ﻕﺮﻌﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION202] = "ﺀﺍﻮﺟﺃ ﺮﻴﻜﻌﺗ ﺪﻤﻌﺘﻳ ﺺﺨﺷ ﻦﻋ ﻍﻼﺑﻺﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﻊﻤﺘﺠﻤﻟﺍ ﺔﺑﺮﺠﺗ ﻭﺃ ﺔﺒﻌﻠﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION203] = "ﺔﻟﺎﺳﺮﻟﺍ ﻞﺳﺮﻳ ﺮﺧﺁ ﺐﻋﻻ ﻦﻋ ﻍﻼﺑﻹﺍ ﺪﻨﻋ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﺔﻴﺼﻨﻟﺍ ﺔﺷﺩﺭﺪﻟﺍ ﻲﻓ ﺍًﺭﺍﺮﻜﺗﻭ ﺍًﺭﺍﺮﻣ ﺎﻬﺴﻔﻧ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION204] = ".ﻂﻘﻓ ﺔﻴﺗﻮﺼﻟﺍ ﺔﺷﺩﺭﺪﻟﺍ ﻦﻋ ﻍﻼﺑﻺﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION205] = "ﻥﻮﻜﻳ <<1>> ﻭﺃ ﺔﻴﺼﺨﺷ ﻢﺳﺍ ﻦﻋ ﻍﻼﺑﻺﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﺮﺧﺁ ﻞﻜﺷ ﻱﺄﺑ ﺎًﺌﻴﺴﻣ ﻭﺃ ﺎًﺌﻳﺬﺑ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION301] = "ﺔﺒﻌﻠﻟﺍ ﻞﺧﺍﺩ ﺔﺷﺩﺭﺪﻟﺍ ﺕﻼﺠﺳ ﺀﻼﻤﻌﻟﺍ ﺔﻣﺪﺧ ﻮﻠﺜﻤﻣ ﻊﺟﺍﺮﻴﺳ\nﺎﻬﺘﻧﺭﺎﻘﻣﻭ ﺎﻬﻨﻋ ﺚﻳﺪﺤﻟﺍ ﻯﺮﺟ ﻲﺘﻟﺍ ﺔﻘﻔﺼﻟﺍ ﻞﻴﺻﺎﻔﺗ ﻦﻣ ﻖﻘﺤﺘﻠﻟ\n.ﺔﺒﻌﻠﻟﺍ ﻲﻓ ﻝﻭﺍﺪﺘﻟﺍ ﺕﻼﺠﺴﺑ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION302] = "ﺕﺎﻣﻮﻠﻌﻣ ﺮﺸﻨﻳ ﺐﻋﻻ ﻱﺃ ﻦﻋ ﻍﻼﺑﻺﻟ ﺭﺎﻴﺨﻟﺍ ﺍﺬﻫ ﻡﺪﺨﺘﺳﺍ\n.ﺮﺧﺁ ﺐﻋﻻ ﻱﻷ ﺔﻴﻌﻗﺍﻮﻟﺍ ﺓﺎﻴﺤﻟﺍ"
[SI_CUSTOMERSERVICEASKFORHELPREPORTPLAYERSUBCATEGORY_DESCRIPTION303] = "ﻑﺮﻄﻟﺍ ﺞﻣﺍﺮﺑ ﻡﺍﺪﺨﺘﺳﺍ ،ﺮﺼﺤﻟﺍ ﻻ ﻝﺎﺜﻤﻟﺍ ﻞﻴﺒﺳ ﻰﻠﻋ ،ﺍﺬﻫ ﻞﻤﺸﻳ\n،ﻥﺍﺭﺪﺠﻟﺍ ﺕﺎﻗﺍﺮﺘﺧﺍﻭ ،ﺔﻗﺮﺘﺨﻤﻟﺍ ﺔﺤﻠﺳﻷﺍﻭ ،(ﺕﺎﺗﻮﺒﻟﺍ) ﺚﻟﺎﺜﻟﺍ\n.ﻚﻟﺫ ﺮﻴﻏﻭ ،ﺕﺎﻃﻮﻄﺨﻤﻟﺎﺑ ﺯﺍﺰﻔﺘﺳﻻﺍﻭ ،ﺲﻳﺭﺎﻀﺘﻟﺍ ﺕﺍﺮﻐﺛﻭ"
