[SI_ZONECOMPLETIONTYPE_DESCRIPTION1] = "‏.‏ﺕﺍﺪﻌﻣﻭ ‏ﺐﻫﺫﻭ ‏ﺓﺮﺒﺧﻭ ‏ﺓﺭﺎﻬﻣ ‏ﻁﺎﻘﻨﺑ ‏ﻚﺌﻓﺎﻜﻳ ‏ﻥﺃ ‏ﻦﻜﻤﻳ ‏ﻡﺎﻬﻤﻟﺍ ‏ﻩﺬﻫ ‏ﻝﺎﻤﻛﺇ .‏ﺔﻘﻄﻨﻤﻠﻟ ‏ﺔﻴﺴﻴﺋﺮﻟﺍ ‏ﺔﺼﻘﻟﺍ ‏ﻲﻫ |‏ﺔﻘﻄﻨﻤﻟﺍ ‏ﺔﺼﻗ ‏ﻡﺎﻬﻣ|"
[SI_ZONECOMPLETIONTYPE_DESCRIPTION10] = "‏|cffffffStriking Locales|r ‏ﺯﺎﺠﻧﺇ ‏ﺢﻨﻣ ‏ﻰﻟﺇ ‏ﺎﻣ ‏ﺔﻘﻄﻨﻣ ‏ﻲﻓ ‏ﺔﻠﻫﺬﻤﻟﺍ ‏ﻊﻗﺍﻮﻤﻟﺍ ‏ﻊﻴﻤﺟ ‏ﻑﺎﺸﺘﻛﺍ ‏ﻱﺩﺆﻴﺳ .‏ﻢﻟﺎﻌﻟﺍ ‏ﻞﺧﺍﺩ ‏ﺔﻴﻤﻫﺃ ‏ﺕﺍﺫ ‏ﻦﻛﺎﻣﺃ ‏ﻲﻫ Pathfinder ‏ﺔﻘﻄﻨﻤﻟﺍ ‏ﻚﻠﺘﻟ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION11] = "‏|‏cffffffﺎﻬﺑ ‏ﺔﻄﺒﺗﺮﻤﻟﺍ ‏ﻚﺗﺍﺭﺎﻬﻣ ‏ﻯﻮﺘﺴﻤﺑ ‏ﺀﺎﻘﺗﺭﻻﺍﻭ ‏ﺓﺮﺤﺴﻟﺍ ‏ﺔﺑﺎﻘﻧ ‏ﻲﻓ ‏ﻚﺘﺒﺗﺭ ‏ﻦﻴﺴﺤﺗ ‏ﻰﻟﺇ ‏ﺐﺘﻜﻟﺍ ‏ﻩﺬﻫ ‏ﻑﺎﺸﺘﻛﺍ ‏ﻱﺩﺆﻴﺳ .‏ﺰﻴﻤﻤﻟﺍ ‏ﻲﻧﺍﻮﺟﺭﻷﺍ ‏ﺎﻬﺠﻫﻮﺗ ‏ﻝﻼﺧ ‏ﻦﻣ ‏ﺐﺘﻜﻟﺍ ‏ﻩﺬﻫ ‏ﺰﻴﻴﻤﺗ ‏ﻦﻜﻤﻳ .‏ﻢﻟﺎﻌﻟﺍ ‏ﺀﺎﺤﻧﺃ ‏ﻊﻴﻤﺟ ‏ﻲﻓ ‏ﺓﺮﺛﺎﻨﺘﻣ |‏ﺭﻭﺪﻴﻟﺎﺷ ‏ﺔﺒﺘﻜﻣ ‏ﺐﺘﻛ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION12] = "‏|cffffffMundus Stones|r ‏ﺱﻭﺪﻧﻮﻣ ‏ﺮﺠﺣ ‏ﻦﻣ ‏ﻯﺮﺧﺃ ‏ﺓﺄﻓﺎﻜﻤﺑ ‏ﻪﻟﺍﺪﺒﺘﺳﺍ ‏ﻢﺘﻳ ‏ﻰﺘﺣ ‏ﺰﻳﺰﻌﺘﻟﺍ ‏ﺍﺬﻫ ‏ﺮﻤﺘﺴﻴﺳ .‏ﺖﻗﺆﻣ ‏ﺰﻳﺰﻌﺗ ‏ﻞﻜﺷ ‏ﻰﻠﻋ ‏ﺓﺄﻓﺎﻜﻣ ‏ﺐﻋﻼﻟﺍ ‏ﺢﻨﻤﺗ ‏ﻢﻟﺎﻌﻟﺍ ‏ﻲﻓ ‏ﺀﺎﻴﺷﺃ ‏ﻲﻫ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION13] = "‏|cffffffPublic Dungeons|r ‏ﺕﺍﺪﻌﻣﻭ ‏ﺎﺒﻫﺫﻭ ‏ﺓﺮﺒﺧﻭ ‏ﺓﺭﺎﻬﻣ ‏ﻁﺎﻘﻧ ‏ﺔﻣﺎﻌﻟﺍ ‏ﺕﺎﻧﺍﺰﻧﺰﻟﺍ ‏ﻦﻣ ‏ﺔﻔﻠﺘﺨﻣ ‏ﺀﺍﺰﺟﺃ ‏ﻝﺎﻤﻛﺇ ‏ﻚﺤﻨﻤﻳ ‏ﻥﺃ ‏ﻦﻜﻤﻳ .‏ﻦﻴﺒﻋﻼﻟﺍ ‏ﻦﻣ ‏ﺕﺎﻋﻮﻤﺠﻣ ‏ﻊﺑﺭﻷ ‏ﺔﻤﻤﺼﻣ ‏ﻲﻫﻭ .‏ﺎﻫﺀﺍﺭﻭ ‏ﺎﻣﻭ ‏ﻞﻳﺮﻣﺎﺗ ‏ﺀﺎﺤﻧﺃ ‏ﻊﻴﻤﺟ ‏ﻲﻓ ‏ﺓﺩﻮﺟﻮﻣ ‏ﺡﻮﺘﻔﻤﻟﺍ ‏ﻢﻟﺎﻌﻟﺍ ‏ﻲﻓ ‏ﺕﺎﻧﺍﺰﻧﺯ ‏ﻲﻫ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION14] = "‏|cffffffSet Stations|r ‏ﺓﺩﺪﺤﻣ ‏ﺮﺻﺎﻨﻋ ‏ﺔﻋﻮﻤﺠﻣ ‏ﺕﺂﻓﺎﻜﻤﺑ ‏ﺮﺻﺎﻨﻋ ‏ﻊﻨﺻ ‏ﻚﻨﻜﻤﻳ ‏ﺚﻴﺣ ‏ﻢﻟﺎﻌﻟﺍ ‏ﻲﻓ ‏ﻊﻗﺍﻮﻣ ‏ﻲﻫ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION2] = "‏|cffffffPoints of Interest|r ‏ﺕﺍﺪﻌﻣﻭ ‏ﺎﺒﻫﺫﻭ ‏ﺓﺮﺒﺧ ‏ﺺﺼﻘﻟﺍ ‏ﻩﺬﻫ ‏ﻚﺤﻨﻤﺗ ‏ﻥﺃ ‏ﻦﻜﻤﻳﻭ .‏ﺎﻬﻌﻗﺍﻮﻣﻭ ‏ﺎﻬﺗﺎﻴﺼﺨﺷﻭ ‏ﺔﻘﻄﻨﻤﻟﺍ ‏ﺦﻳﺭﺎﺗ ‏ﻒﺸﻜﺘﺴﺗ ‏ﺔﻠﻘﺘﺴﻣ ‏ﺺﺼﻗ ‏ﻲﻫ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION4] = "‏|cffffffWayshrines|r ‏ﺐﻫﺬﻟﺍ ‏ﻦﻣ ‏ﺮﻴﻐﺻ ‏ﻎﻠﺒﻣ ‏ﻞﺑﺎﻘﻣ ‏ﻢﻟﺎﻌﻟﺍ ‏ﻲﻓ ‏ﻥﺎﻜﻣ ‏ﻱﺃ ‏ﻦﻣ ‏ﺡﻮﺘﻔﻣ ‏ﺢﻳﺮﺿ ‏ﻱﺃ ‏ﻰﻟﺇ ‏ﺓﺮﺷﺎﺒﻣ ‏ﺮﻔﺴﻟﺍ ‏ﺎﻀﻳﺃ ‏ﻚﻨﻜﻤﻳ .‏ﺎﻬﺤﺘﻓﻭ ‏ﺎﻬﻓﺎﺸﺘﻛﺍ ‏ﻢﺗ ‏ﻲﺘﻟﺍ ‏ﺔﺣﺮﺿﻷﺍ ‏ﻦﻴﺑ ‏ﻲﻧﺎﺠﻤﻟﺍﻭ ‏ﻱﺭﻮﻔﻟﺍ ‏ﺮﻔﺴﻟﺎﺑ ‏ﺢﻤﺴﺗ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION5] = "‏|cffffffDelves|r ‏ﺮﺻﺎﻨﻌﻟﺍ ‏ﺔﻋﻮﻤﺠﻣ ‏ﺕﺍﺪﻌﻣ ‏ﻂﻘﺴﻳ ‏ﻢﻴﻋﺯﻭ ‏ﺓﺪﺣﺍﻭ ‏ﺔﻳﻭﺎﻤﺳ ‏ﺔﻴﻈﺷ ‏ﻰﻠﻋ ‏ﺎﻤﺋﺍﺩ ‏ﺕﺎﻧﺍﺰﻧﺰﻟﺍ ‏ﻱﻮﺘﺤﺗ .‏ﻢﻟﺎﻌﻟﺍ ‏ﺀﺎﺤﻧﺃ ‏ﻊﻴﻤﺟ ‏ﻲﻓ ‏ﺪﺟﻮﺗﻭ ‏ﻱﺩﺮﻓ ‏ﻞﻜﺸﺑ ‏ﺎﻫﺯﺎﻴﺘﺟﺍ ‏ﻦﻜﻤﻳ ‏ﺕﺎﻧﺍﺰﻧﺯ ‏ﻲﻫ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION6] = "‏|cffffffGroup Delves|r ‏ﺮﺻﺎﻨﻌﻟﺍ ‏ﺔﻋﻮﻤﺠﻣ ‏ﺕﺍﺪﻌﻣ ‏ﻂﻘﺴﻳ ‏ﻢﻴﻋﺯﻭ ‏ﺓﺪﺣﺍﻭ ‏ﺔﻳﻭﺎﻤﺳ ‏ﺔﻴﻈﺷ ‏ﻰﻠﻋ ‏ﺎﻤﺋﺍﺩ ‏ﺔﻋﻮﻤﺠﻤﻟﺍ ‏ﺕﺎﻧﺍﺰﻧﺯ ‏ﻱﻮﺘﺤﺗ .‏ﻦﻴﺒﻋﻻ ‏ﺔﻌﺑﺭﺃ ‏ﻦﻣ ‏ﺕﺎﻋﻮﻤﺠﻤﻟ ‏ﺎﺼﻴﺼﺧ ‏ﺔﻤﻤﺼﻣ ‏،ﻥﺭﻮﻠﻏﺍﺮﻛ ‏ﻲﻓ ‏ﺓﺩﻮﺟﻮﻣ ‏ﺡﻮﺘﻔﻣ ‏ﻢﻟﺎﻋ ‏ﺕﺎﻧﺍﺰﻧﺯ ‏ﻲﻫ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION7] = "‏|cffffffSkyshards|r ‏ﺎﻫﺮﻳﻮﻄﺗ ‏ﻭﺃ ‏ﺓﺪﻳﺪﺟ ‏ﺕﺍﺭﺪﻗ ‏ﺢﺘﻔﻟ ‏ﺎﻬﻣﺍﺪﺨﺘﺳﺍ ‏ﻦﻜﻤﻳ ‏ﻲﺘﻟﺍﻭ ‏،ﺓﺭﺎﻬﻣ ‏ﺔﻄﻘﻧ ‏ﺔﻳﻭﺎﻤﺳ ‏ﺎﻳﺎﻈﺷ ‏ﺙﻼﺛ ‏ﻑﺎﺸﺘﻛﺍ ‏ﻚﺤﻨﻤﻴﺳ .‏ﻪﻨﻣ ‏ﺚﻌﺒﻨﺗ ‏ﻱﺬﻟﺍ ‏ﻊﻃﺎﺴﻟﺍ ‏ﺾﻴﺑﻷﺍ ‏ﺀﻮﻀﻟﺍ ‏ﻉﺎﻌﺷ ‏ﻝﻼﺧ ‏ﻦﻣ ‏ﺎﻬﻴﻠﻋ ‏ﻑﺮﻌﺘﻟﺍ ‏ﻦﻜﻤﻳﻭ ‏ﻢﻟﺎﻌﻟﺍ ‏ﺀﺎﺤﻧﺃ ‏ﻊﻴﻤﺟ ‏ﻲﻓ ‏ﺓﺮﺛﺎﻨﺘﻣ."
[SI_ZONECOMPLETIONTYPE_DESCRIPTION8] = "‏|cffffffWorld Events|r ‏ﻰﻠﻋﺃ ‏ﻯﻮﺘﺴﻣ ‏ﻦﻣ ‏ﺕﺍﺪﻌﻣﻭ ‏ﺐﻫﺬﻟﺍﻭ ‏ﺓﺮﺒﺨﻟﺎﺑ ‏ﻚﺌﻓﺎﻜﻳ ‏ﻥﺃ ‏ﻦﻜﻤﻳ ‏ﻲﻤﻟﺎﻋ ‏ﺙﺪﺣ ‏ﻝﺎﻤﻛﺇ .‏ﻦﻳﺮﻣﺎﻐﻤﻟﺍ ‏ﻦﻣ ‏ﺔﻋﻮﻤﺠﻣ ‏ﺎﻬﺑ ‏ﻡﻮﻘﺗ ‏ﻥﺃ ‏ﻞﻀﻓﻷﺍ ‏ﻦﻣﻭ ‏،ﻢﻟﺎﻌﻟﺍ ‏ﻲﻓ ‏ﺙﺪﺤﺗ ‏ﺔﻄﺸﻧﺃ ‏ﻲﻫ ‏ﺔﻤﻠﻈﻤﻟﺍ ‏ﻲﺳﺍﺮﻤﻟﺍ ‏ﻞﺜﻣ."
