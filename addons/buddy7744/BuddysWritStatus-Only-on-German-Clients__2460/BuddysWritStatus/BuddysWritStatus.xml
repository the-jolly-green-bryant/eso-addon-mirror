<GuiXml>
	<Controls>
		<TopLevelControl name="BuddysWritStatusAddonIndicator" mouseEnabled="true" movable="true" clampedToScreen="true" resizeToFitDescendents="true" tier="LOW">
			<Dimensions x="400" y="200" />
			<Anchor point="RIGHT" />
			<OnMoveStop>
				BuddysWritStatusAddon.OnIndicatorMoveStop()
			</OnMoveStop>
			<Controls>
				<Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" centerColor="020202" alpha="0" edgeSize="2">
					<AnchorFill />
				</Backdrop>

				<Label name="$(parent)Label" width="400" height="200" font="ZoFontWinH1" inheritAlpha="true"  
				 rapMode="ELLIPSIS" verticalAlignment="TOP" horizontalAlignment="LEFT" text="">
					<Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
				</Label>	
				<Label name="$(parent)AlchemyLabel" text="" width="200" height="25" inheritAlpha="true"  
				 font="ZoFontWinH1" verticalAlignment="TOP" horizontalAlignment="LEFT" wrapMode="ELLIPSIS">
					<Anchor point="TOP" relativeTo="$(parent)Label" relativePoint="BOTTOM" />
				</Label>
				<Label name="$(parent)BlacksmithingLabel" text="" width="200" height="25" inheritAlpha="true" 
				 font="ZoFontWinH1" verticalAlignment="TOP" horizontalAlignment="CENTER">
					<Anchor point="TOP" relativeTo="$(parent)AlchemyLabel" relativePoint="BOTTOM" />
				</Label>
				<Label name="$(parent)JewelryLabel" text="" width="200" height="25" inheritAlpha="true" 
				 font="ZoFontWinH1" verticalAlignment="TOP" horizontalAlignment="CENTER">
					<Anchor point="TOP" relativeTo="$(parent)BlacksmithingLabel" relativePoint="BOTTOM" />
				</Label>
				<Label name="$(parent)TailoringLabel" text="" width="200" height="25" inheritAlpha="true"  
				 font="ZoFontWinH1" verticalAlignment="TOP" horizontalAlignment="CENTER">
					<Anchor point="TOP" relativeTo="$(parent)JewelryLabel" relativePoint="BOTTOM" />
				</Label>
				<Label name="$(parent)WoodworkingLabel" text="" width="200" height="25" inheritAlpha="true"  
				 font="ZoFontWinH1" verticalAlignment="TOP" horizontalAlignment="CENTER">
					<Anchor point="TOP" relativeTo="$(parent)TailoringLabel" relativePoint="BOTTOM" />
				</Label>
				<Label name="$(parent)ProvisioningLabel" text="" width="200" height="25" inheritAlpha="true"  
				 font="ZoFontWinH1" verticalAlignment="TOP" horizontalAlignment="CENTER">
					<Anchor point="TOP" relativeTo="$(parent)WoodworkingLabel" relativePoint="BOTTOM" />
				</Label>
				<Label name="$(parent)EnchantingLabel" text="" width="200" height="25" inheritAlpha="true"  
				 font="ZoFontWinH1" verticalAlignment="TOP" horizontalAlignment="CENTER">
					<Anchor point="TOP" relativeTo="$(parent)ProvisioningLabel" relativePoint="BOTTOM" />
				</Label>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>