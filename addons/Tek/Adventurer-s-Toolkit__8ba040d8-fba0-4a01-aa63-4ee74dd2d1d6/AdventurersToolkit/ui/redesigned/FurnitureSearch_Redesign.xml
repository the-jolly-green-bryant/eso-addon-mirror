<GuiXml>
    <Controls>
        <!-- Furniture Search UI - Redesigned -->
        <TopLevelControl name="ATK_FurnitureSearch_UI" hidden="true" mouseEnabled="true" movable="false">
            <Dimensions x="1600" y="900"/>
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER"/>
            <Controls>
                <!-- Main Window Background -->
                <Backdrop name="$(parent)BG" alpha="0.98">
                    <AnchorFill/>
                    <Edge edgeSize="4" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="AAFFAA"/>
                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0A0A0A"/>
                </Backdrop>

                <!-- Header Section -->
                <Control name="$(parent)Header">
                    <Dimensions x="1560" y="85"/>
                    <Anchor point="TOP" offsetY="5"/>
                    <Controls>
                        <Backdrop name="$(parent)Plate" alpha="0.9">
                            <AnchorFill/>
                            <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="AAFFAA"/>
                            <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="111111"/>
                        </Backdrop>
                        <Label name="$(parent)Title" font="ZoFontGamepadBold48" horizontalAlignment="CENTER" text="|cAAFFAAFURNITURE FINDER|r">
                            <Anchor point="TOP" offsetY="5"/>
                        </Label>
                        <Label name="$(parent)Subtitle" font="ZoFontGamepad22" horizontalAlignment="CENTER">
                            <Anchor point="BOTTOM" offsetY="-8"/>
                        </Label>
                    </Controls>
                </Control>

                <!-- Left Column: Search Results -->
                <Control name="$(parent)LeftCol">
                    <Dimensions x="800" y="700"/>
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="100"/>
                    <Controls>
                        <Control name="$(parent)ResultsCard">
                            <Dimensions x="780" y="690"/>
                            <Anchor point="TOPLEFT"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Texture name="$(parent)FocusGlow" hidden="true" textureFile="EsoUI/Art/Buttons/gamepad/gp_goldHighlight.dds" alpha="0.5">
                                    <AnchorFill/>
                                </Texture>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="760" y="45"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cAAFFAASEARCH RESULTS|r">
                                    <Anchor point="TOP" offsetY="18"/>
                                </Label>
                                <Label name="$(parent)SearchText" font="ZoFontGamepad22" horizontalAlignment="CENTER" color="00FFFF">
                                    <Anchor point="TOP" offsetY="55"/>
                                </Label>
                                <Control name="$(parent)List">
                                    <Dimensions x="760" y="580"/>
                                    <Anchor point="TOP" offsetY="85"/>
                                    <Controls>
                                        <Backdrop name="$(parent)SelectionFrame" hidden="true" alpha="0.8">
                                            <Dimensions x="750" y="38"/>
                                            <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="AAFFAA"/>
                                            <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="AAFFAA" alpha="0.15"/>
                                        </Backdrop>
                                        <Label name="$(parent)Row1" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="0"/></Label>
                                        <Label name="$(parent)Row2" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="40"/></Label>
                                        <Label name="$(parent)Row3" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="80"/></Label>
                                        <Label name="$(parent)Row4" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="120"/></Label>
                                        <Label name="$(parent)Row5" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="160"/></Label>
                                        <Label name="$(parent)Row6" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="200"/></Label>
                                        <Label name="$(parent)Row7" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="240"/></Label>
                                        <Label name="$(parent)Row8" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="280"/></Label>
                                        <Label name="$(parent)Row9" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="320"/></Label>
                                        <Label name="$(parent)Row10" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="360"/></Label>
                                        <Label name="$(parent)Row11" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="400"/></Label>
                                        <Label name="$(parent)Row12" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="440"/></Label>
                                        <Label name="$(parent)Row13" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="740" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="480"/></Label>
                                    </Controls>
                                </Control>
                                <Label name="$(parent)ResultCount" font="ZoFontGamepad22" horizontalAlignment="CENTER" color="888888">
                                    <Anchor point="BOTTOM" offsetY="-15"/>
                                </Label>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>

                <!-- Right Column: Item Details -->
                <Control name="$(parent)RightCol">
                    <Dimensions x="730" y="700"/>
                    <Anchor point="TOPRIGHT" offsetX="-20" offsetY="100"/>
                    <Controls>
                        <!-- Item Details Card -->
                        <Control name="$(parent)DetailsCard">
                            <Dimensions x="710" y="400"/>
                            <Anchor point="TOPLEFT"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="690" y="45"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFFFAASELECTED ITEM|r">
                                    <Anchor point="TOP" offsetY="18"/>
                                </Label>
                                <Texture name="$(parent)Icon">
                                    <Dimensions x="64" y="64"/>
                                    <Anchor point="TOP" offsetY="70"/>
                                </Texture>
                                <Label name="$(parent)ItemName" font="ZoFontGamepadBold27" horizontalAlignment="CENTER">
                                    <Dimensions x="680" y="35"/>
                                    <Anchor point="TOP" offsetY="145"/>
                                </Label>
                                <Label name="$(parent)Category" font="ZoFontGamepad22" horizontalAlignment="CENTER" color="888888">
                                    <Anchor point="TOP" offsetY="185"/>
                                </Label>
                                <Label name="$(parent)GoldValue" font="ZoFontGamepad27" horizontalAlignment="CENTER" color="FFD700">
                                    <Anchor point="TOP" offsetY="220"/>
                                </Label>
                                <Label name="$(parent)CrownValue" font="ZoFontGamepad27" horizontalAlignment="CENTER" color="00FFFF">
                                    <Anchor point="TOP" offsetY="255"/>
                                </Label>
                                <Label name="$(parent)Source" font="ZoFontGamepad22" horizontalAlignment="CENTER" color="AAAAAA">
                                    <Anchor point="TOP" offsetY="295"/>
                                </Label>
                                <Label name="$(parent)OwnedCount" font="ZoFontGamepad27" horizontalAlignment="CENTER">
                                    <Anchor point="TOP" offsetY="335"/>
                                </Label>
                            </Controls>
                        </Control>

                        <!-- Actions Card -->
                        <Control name="$(parent)ActionsCard">
                            <Dimensions x="710" y="280"/>
                            <Anchor point="TOPLEFT" offsetY="410"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="690" y="40"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFFFAACONTROLS|r">
                                    <Anchor point="TOP" offsetY="15"/>
                                </Label>
                                <Label name="$(parent)Action1" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[A]|r Search"><Dimensions x="320" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="65"/></Label>
                                <Label name="$(parent)Action2" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[X]|r Clear Search"><Dimensions x="320" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="100"/></Label>
                                <Label name="$(parent)Action3" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[Y]|r Add to Planner"><Dimensions x="320" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="135"/></Label>
                                <Label name="$(parent)Action4" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[LB]|r Planner"><Dimensions x="320" y="35"/><Anchor point="TOPLEFT" offsetX="370" offsetY="65"/></Label>
                                <Label name="$(parent)Action5" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[RB]|r Housing"><Dimensions x="320" y="35"/><Anchor point="TOPLEFT" offsetX="370" offsetY="100"/></Label>
                                <Label name="$(parent)Action6" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[B]|r Back"><Dimensions x="320" y="35"/><Anchor point="TOPLEFT" offsetX="370" offsetY="135"/></Label>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>

                <!-- Footer -->
                <Label name="$(parent)Footer" font="ZoFontGamepad18" horizontalAlignment="CENTER" color="888888">
                    <Dimensions x="1400" y="25"/>
                    <Anchor point="BOTTOM" offsetY="-15"/>
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
