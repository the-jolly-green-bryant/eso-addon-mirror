                                        <Label name="$(parent)Row6" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="250"/></Label>
                                        <Label name="$(parent)Row7" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="300"/></Label>
                                        <Label name="$(parent)Row8" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="350"/></Label>
                                        <Label name="$(parent)Row9" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="400"/></Label>
                                        <Label name="$(parent)Row10" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="450"/></Label>
                                        <Label name="$(parent)Row11" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="500"/></Label>
                                        <Label name="$(parent)Row12" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="550"/></Label>
                                        <Label name="$(parent)Row13" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="600"/></Label>
                                        <Label name="$(parent)Row14" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="650"/></Label>
                                    </Controls>
                                </Control>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
                <Control name="$(parent)RightCol">
                    <Dimensions x="780" y="700"/>
                    <Anchor point="TOPRIGHT" offsetX="-20" offsetY="100"/>
                    <Controls>
                        <Control name="$(parent)InfoCard">
                            <Dimensions x="760" y="350"/>
                            <Anchor point="TOPLEFT"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="740" y="40"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFFFAAFEATURE INFO|r">
                                    <Anchor point="TOP" offsetY="15"/>
