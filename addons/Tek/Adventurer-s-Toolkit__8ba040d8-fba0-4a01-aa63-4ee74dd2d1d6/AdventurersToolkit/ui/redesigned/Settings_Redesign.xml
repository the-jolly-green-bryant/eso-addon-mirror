                                <Label name="$(parent)FeatureName" font="ZoFontGamepadBold34" horizontalAlignment="CENTER" color="00FFFF">
                                    <Anchor point="TOP" offsetY="70"/>
                                </Label>
                                <Label name="$(parent)Description" font="ZoFontGamepad22" horizontalAlignment="CENTER" wrapMode="TRUNCATE">
                                    <Dimensions x="720" y="200"/>
                                    <Anchor point="TOP" offsetY="120"/>
                                </Label>
                            </Controls>
                        </Control>
                        <Control name="$(parent)ActionsCard">
                            <Dimensions x="760" y="330"/>
                            <Anchor point="TOPLEFT" offsetY="360"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="740" y="40"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFFFAACONTROLS|r">
                                    <Anchor point="TOP" offsetY="15"/>
                                </Label>
                                <Label name="$(parent)Action1" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[A]|r Toggle Feature"><Dimensions x="350" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="65"/></Label>
                                <Label name="$(parent)Action2" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[D-Pad]|r Navigate"><Dimensions x="350" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="100"/></Label>
                                <Label name="$(parent)Action3" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[B]|r Back"><Dimensions x="350" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="135"/></Label>
                                <Label name="$(parent)Action4" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888[Y]|r Reset All"><Dimensions x="350" y="35"/><Anchor point="TOPLEFT" offsetX="400" offsetY="65"/></Label>
                                <Label name="$(parent)Hint" font="ZoFontGamepad18" horizontalAlignment="CENTER" color="888888" text="Changes take effect immediately">
                                    <Anchor point="BOTTOM" offsetY="-20"/>
                                </Label>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
                <Label name="$(parent)Footer" font="ZoFontGamepad18" horizontalAlignment="CENTER" color="888888">
                    <Dimensions x="1400" y="25"/>
                    <Anchor point="BOTTOM" offsetY="-15"/>
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
