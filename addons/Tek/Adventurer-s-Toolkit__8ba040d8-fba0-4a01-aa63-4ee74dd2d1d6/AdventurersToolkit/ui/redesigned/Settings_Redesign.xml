<GuiXml>
    <Controls>
        <TopLevelControl name="ATK_Settings_UI" hidden="true" mouseEnabled="true" movable="false">
            <Dimensions x="1600" y="900"/>
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER"/>
            <Controls>
                <Backdrop name="$(parent)BG" alpha="0.98">
                    <AnchorFill/>
                    <Edge edgeSize="4" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="AAAAAA"/>
                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0A0A0A"/>
                </Backdrop>
                <Control name="$(parent)Header">
                    <Dimensions x="1560" y="85"/>
                    <Anchor point="TOP" offsetY="5"/>
                    <Controls>
                        <Backdrop name="$(parent)Plate" alpha="0.9">
                            <AnchorFill/>
                            <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="AAAAAA"/>
                            <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="111111"/>
                        </Backdrop>
                        <Label name="$(parent)Title" font="ZoFontGamepadBold48" horizontalAlignment="CENTER" text="|cAAAAAASETTINGS|r">
                            <Anchor point="TOP" offsetY="5"/>
                        </Label>
                        <Label name="$(parent)Subtitle" font="ZoFontGamepad22" horizontalAlignment="CENTER" text="|cFFFFFFAdventurer's Toolkit Configuration|r">
                            <Anchor point="BOTTOM" offsetY="-8"/>
                        </Label>
                    </Controls>
                </Control>
                <Control name="$(parent)LeftCol">
                    <Dimensions x="750" y="700"/>
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="100"/>
                    <Controls>
                        <Control name="$(parent)FeaturesCard">
                            <Dimensions x="730" y="690"/>
                            <Anchor point="TOPLEFT"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Texture name="$(parent)FocusGlow" hidden="true" textureFile="EsoUI/Art/Buttons/gamepad/gp_goldHighlight.dds" alpha="0.5">
                                    <AnchorFill/>
                                </Texture>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="710" y="45"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFFFAAFEATURE TOGGLES|r">
                                    <Anchor point="TOP" offsetY="18"/>
                                </Label>
                                <Control name="$(parent)List">
                                    <Dimensions x="710" y="610"/>
                                    <Anchor point="TOP" offsetY="65"/>
                                    <Controls>
                                        <Backdrop name="$(parent)SelectionFrame" hidden="true" alpha="0.8">
                                            <Dimensions x="700" y="45"/>
                                            <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="00FFFF"/>
                                            <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="00FFFF" alpha="0.15"/>
                                        </Backdrop>
                                        <Label name="$(parent)Row1" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="0"/></Label>
                                        <Label name="$(parent)Row2" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="690" y="45"/><Anchor point="TOPLEFT" offsetX="10" offsetY="50"/></Label>
