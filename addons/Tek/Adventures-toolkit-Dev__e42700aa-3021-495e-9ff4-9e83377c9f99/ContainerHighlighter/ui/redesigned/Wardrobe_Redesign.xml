                                        <Label name="$(parent)Label" font="ZoFontGamepad18" horizontalAlignment="CENTER" text="Main"><Anchor point="BOTTOM" offsetY="18"/></Label>
                                    </Controls>
                                </Control>
                                
                                <!-- Off Hand (Slot 12) -->
                                <Control name="$(parent)Slot12">
                                    <Dimensions x="65" y="65"/>
                                    <Anchor point="TOP" offsetX="-30" offsetY="490"/>
                                    <Controls>
                                        <Backdrop name="$(parent)Frame" alpha="0.8">
                                            <AnchorFill/>
                                            <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="555555"/>
                                            <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="1A1A1A"/>
