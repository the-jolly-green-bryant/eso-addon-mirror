                                    </Controls>
                                </Control>
                                
                                <!-- Shoulders (Slot 2) -->
                                <Control name="$(parent)Slot2">
                                    <Dimensions x="60" y="60"/>
                                    <Anchor point="TOP" offsetX="-90" offsetY="150"/>
