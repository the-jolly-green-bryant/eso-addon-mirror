                                            <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="555555"/>
                                            <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="1A1A1A"/>
                                        </Backdrop>
                                        <Texture name="$(parent)Icon"><Dimensions x="40" y="40"/><Anchor point="CENTER"/></Texture>
                                        <Texture name="$(parent)Status"><Dimensions x="16" y="16"/><Anchor point="BOTTOMRIGHT" offsetX="4" offsetY="4"/></Texture>
                                    </Controls>
                                </Control>
                                
                                <!-- Ring 1 (Slot 9) -->
                                <Control name="$(parent)Slot9">
                                    <Dimensions x="45" y="45"/>
