<GuiXml>
    <Controls>
        <!-- Housing Settings UI -->
        <TopLevelControl name="ATK_HousingSettings_UI" hidden="true" mouseEnabled="true" movable="false">
            <Dimensions x="1400" y="800"/>
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER"/>
            <Controls>
                <!-- Main Window Background -->
                <Backdrop name="$(parent)BG" alpha="0.98">
                    <AnchorFill/>
                    <Edge edgeSize="4" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="FF00FF"/>
                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0A0A0A"/>
                </Backdrop>

                <!-- Header Section -->
                <Control name="$(parent)Header">
                    <Dimensions x="1360" y="70"/>
                    <Anchor point="TOP" offsetY="5"/>
                    <Controls>
                        <Backdrop name="$(parent)Plate" alpha="0.9">
                            <AnchorFill/>
                            <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="FF00FF"/>
                            <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="111111"/>
                        </Backdrop>
                        <Label name="$(parent)Title" font="ZoFontGamepadBold48" horizontalAlignment="CENTER" text="|cFF00FFHOUSING SETTINGS|r">
                            <Dimensions x="1300" y="60"/>
                            <Anchor point="CENTER"/>
                        </Label>
                    </Controls>
                </Control>

                <!-- Left Column: Categories List -->
                <Control name="$(parent)LeftCol">
                    <Dimensions x="450" y="650"/>
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="85"/>
                    <Controls>
                        <Control name="$(parent)CategoriesCard">
                            <Dimensions x="430" y="640"/>
                            <Anchor point="TOPLEFT"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Texture name="$(parent)FocusGlow" hidden="true" textureFile="EsoUI/Art/Buttons/gamepad/gp_goldHighlight.dds" alpha="0.5">
                                    <AnchorFill/>
                                </Texture>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="410" y="45"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFF00FFCATEGORIES|r">
                                    <Anchor point="TOP" offsetY="18"/>
                                </Label>
                                <Control name="$(parent)List">
                                    <Dimensions x="410" y="550"/>
                                    <Anchor point="TOP" offsetY="65"/>
                                    <Controls>
                                        <Label name="$(parent)Cat1" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="0"/></Label>
                                        <Label name="$(parent)Cat2" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="35"/></Label>
