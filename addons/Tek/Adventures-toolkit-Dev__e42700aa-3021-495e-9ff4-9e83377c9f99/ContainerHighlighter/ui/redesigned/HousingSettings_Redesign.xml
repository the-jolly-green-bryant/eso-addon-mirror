                                        <Label name="$(parent)House12" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="418"/></Label>
                                        <Label name="$(parent)House13" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="456"/></Label>
                                        <Label name="$(parent)House14" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="494"/></Label>
                                    </Controls>
                                </Control>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>

                <!-- Right Column: Actions -->
                <Control name="$(parent)RightCol">
                    <Dimensions x="420" y="650"/>
                    <Anchor point="TOPRIGHT" offsetX="-20" offsetY="85"/>
                    <Controls>
                        <!-- Actions Card -->
                        <Control name="$(parent)ActionsCard">
                            <Dimensions x="400" y="300"/>
                            <Anchor point="TOPLEFT"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="380" y="45"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFFFFFACTIONS|r">
                                    <Anchor point="TOP" offsetY="18"/>
                                </Label>
                                <Label name="$(parent)Action1" font="ZoFontGamepad27" horizontalAlignment="LEFT" text="|cFFFFFF[A]|r Add Category">
                                    <Dimensions x="360" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="70"/>
                                </Label>
                                <Label name="$(parent)Action2" font="ZoFontGamepad27" horizontalAlignment="LEFT" text="|cFFFFFF[X]|r Rename Category">
                                    <Dimensions x="360" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="105"/>
                                </Label>
                                <Label name="$(parent)Action3" font="ZoFontGamepad27" horizontalAlignment="LEFT" text="|cFFFFFF[Y]|r Delete Category">
                                    <Dimensions x="360" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="140"/>
                                </Label>
                                <Label name="$(parent)Action4" font="ZoFontGamepad27" horizontalAlignment="LEFT" text="|cFFFFFF[RB]|r Assign Houses">
                                    <Dimensions x="360" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="175"/>
                                </Label>
                                <Label name="$(parent)Action5" font="ZoFontGamepad27" horizontalAlignment="LEFT" text="|cFFFFFF[B]|r Back">
                                    <Dimensions x="360" y="35"/><Anchor point="TOPLEFT" offsetX="20" offsetY="210"/>
                                </Label>
                            </Controls>
                        </Control>

                        <!-- Info Card -->
                        <Control name="$(parent)InfoCard">
                            <Dimensions x="400" y="320"/>
                            <Anchor point="TOPLEFT" offsetY="320"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
