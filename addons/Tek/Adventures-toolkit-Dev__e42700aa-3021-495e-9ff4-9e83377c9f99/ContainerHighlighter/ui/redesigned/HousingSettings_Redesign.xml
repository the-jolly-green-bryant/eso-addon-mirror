                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|c888888INFO|r">
                                    <Anchor point="TOP" offsetY="18"/>
                                </Label>
                                <Label name="$(parent)Info1" font="ZoFontGamepad22" horizontalAlignment="LEFT" wrapMode="ELLIPSIS">
                                    <Dimensions x="360" y="220"/><Anchor point="TOPLEFT" offsetX="20" offsetY="70"/>
                                </Label>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
