                                        <Label name="$(parent)Cat5" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="140"/></Label>
                                        <Label name="$(parent)Cat6" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="175"/></Label>
                                        <Label name="$(parent)Cat7" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="210"/></Label>
                                        <Label name="$(parent)Cat8" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="245"/></Label>
                                        <Label name="$(parent)Cat9" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="280"/></Label>
                                        <Label name="$(parent)Cat10" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="315"/></Label>
                                    </Controls>
                                </Control>
                                <Label name="$(parent)Instructions" font="ZoFontGamepad18" horizontalAlignment="CENTER" color="888888">
                                    <Dimensions x="410" y="60"/>
                                    <Anchor point="BOTTOM" offsetY="-10"/>
                                </Label>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>

                <!-- Center Column: Houses in Category -->
                <Control name="$(parent)CenterCol">
                    <Dimensions x="450" y="650"/>
                    <Anchor point="TOP" offsetY="85"/>
                    <Controls>
                        <Control name="$(parent)HousesCard">
                            <Dimensions x="430" y="640"/>
                            <Anchor point="TOPLEFT"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Texture name="$(parent)FocusGlow" hidden="true" textureFile="EsoUI/Art/Buttons/gamepad/gp_goldHighlight.dds" alpha="0.5">
                                    <AnchorFill/>
                                </Texture>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="410" y="45"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFFFAAHOUSES IN CATEGORY|r">
                                    <Anchor point="TOP" offsetY="18"/>
                                </Label>
                                <Control name="$(parent)List">
                                    <Dimensions x="410" y="560"/>
                                    <Anchor point="TOP" offsetY="65"/>
                                    <Controls>
                                        <Label name="$(parent)House1" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="0"/></Label>
