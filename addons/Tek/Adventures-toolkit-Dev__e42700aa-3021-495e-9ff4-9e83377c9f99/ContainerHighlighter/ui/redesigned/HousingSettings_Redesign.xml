                                        <Label name="$(parent)House7" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="228"/></Label>
                                        <Label name="$(parent)House8" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="266"/></Label>
                                        <Label name="$(parent)House9" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="390" y="38"/><Anchor point="TOPLEFT" offsetX="10" offsetY="304"/></Label>
