<GuiXml>
	<Controls>
		<Control name="ZBNSStatusRow" resizeToFitDescendents="true" hidden="false" virtual="true">
			<Controls>

				<Label name="$(parent)Value" font="$(BOLD_FONT)|$(KB_15)|soft-shadow-thick" horizontalAlignment="RIGHT" verticalAlignment="TOP">
					<Anchor point="TOPLEFT" />
					<Dimensions x="48" y="40" />
				</Label>
				<Label name="$(parent)Label" font="$(BOLD_FONT)|$(KB_15)|soft-shadow-thick" horizontalAlignment="LEFT" verticalAlignment="TOP">
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Value" offsetX="8" />
					<Dimensions x="150" y="40" />
				</Label>
					<Label name="$(parent)Stg" font="$(BOLD_FONT)|$(KB_15)|soft-shadow-thick" horizontalAlignment="LEFT" verticalAlignment="TOP" alpha="1">
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Label" offsetX="8" />
					<Dimensions x="200" y="40" />
				</Label>

			</Controls>
		</Control>
		
		<TopLevelControl name="ZBNSFrame" resizeToFitDescendents="true" clampedToScreen="true" hidden="false">
			<OnMoveStop>
				ZBNS.OnMoveStop()
			</OnMoveStop>
			<Controls>
				<!-- <Texture name="$(parent)Icon">
					<Anchor point="TOPLEFT" />
					<Dimensions x="48" y="48" />
				</Texture> -->
				<!-- <Control name="$(parent)Row1" inherits="ZBNSStatusRow">
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Icon" offsetX="4" />
				</Control> -->

				<Control name="$(parent)Row1" inherits="ZBNSStatusRow">
					<Anchor point="TOPLEFT" />
					<Dimensions x="48" y="48" />
				</Control>
				<Control name="$(parent)Row2" inherits="ZBNSStatusRow">
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$(parent)Row1" />
				</Control>
				<Control name="$(parent)Row3" inherits="ZBNSStatusRow">
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$(parent)Row2" />
				</Control>
				<Control name="$(parent)Row4" inherits="ZBNSStatusRow">
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$(parent)Row3" />
				</Control>
				<Control name="$(parent)Row5" inherits="ZBNSStatusRow">
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$(parent)Row4" />
				</Control>
				<Control name="$(parent)Row6" inherits="ZBNSStatusRow">
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$(parent)Row5" />
				</Control>
			</Controls>
		</TopLevelControl>


	</Controls>
</GuiXml>
