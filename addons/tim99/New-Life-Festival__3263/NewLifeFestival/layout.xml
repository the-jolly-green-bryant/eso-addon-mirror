<GuiXml> 
	<!-- New Font definition -->
	<Font name="TimFontNewYearM" font="$(BOLD_FONT)|16|soft-shadow-thin" />
	<Font name="TimFontNewYearT" font="$(MEDIUM_FONT)|14|soft-shadow-thin" />
	<Controls> 
		<!--Window-->
		<TopLevelControl name="TimNewYearUI" clampedToScreen="true" mouseEnabled="true" movable="true" > 
			<Dimensions x="220" y="300"/>
			<Anchor point="CENTER" relativeTo="GUI_ROOT" relativePoint="CENTER" offsetX="0" offsetY="0" />
			<OnMouseUp>
				Tim99_NewYearEventSaveAnchor()
			</OnMouseUp>
			<Controls> 
				<Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop" >
					<AnchorFill/>
				</Backdrop>
				<Label name="$(parent)Header" font="TimFontNewYearM" color="9966ff" text="NewLife-Festival!" verticalAlignment="CENTER" horizontalAlignment="CENTER" >
					<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="5" />
					<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="0" offsetY="5" />					
				</Label>
				<Texture name="$(parent)Divider" textureFile="EsoUI/Art/Miscellaneous/horizontalDivider.dds">
					<Dimensions y="4"/>
					<Anchor point="TOPLEFT" relativeTo="$(parent)Header" relativePoint="BOTTOMLEFT" offsetX="-30" offsetY="3" />
					<Anchor point="TOPRIGHT" relativeTo="$(parent)Header" relativePoint="BOTTOMRIGHT" offsetX="30" offsetY="3" />
				</Texture>
			</Controls>.
		</TopLevelControl>
	</Controls>
</GuiXml>

