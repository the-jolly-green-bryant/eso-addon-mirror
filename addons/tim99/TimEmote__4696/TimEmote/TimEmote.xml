<!--                v 1.4.3               -->
<GuiXml>
	<Controls>
		<Button name="TE_EmoteStyleButton" inherits="ZO_DefaultButton" virtual="true">
			<Controls>
				<Texture name="$(parent)Contrast"
					textureFile="/esoui/art/buttons/eso_buttonlarge_normal.dds"
					color="000000"
					alpha="0.40"
					drawLayer="DL_BACKGROUND">
					<AnchorFill/>
				</Texture>
			</Controls>
		</Button>

		<TopLevelControl name="TimEmoteWindow" mouseEnabled="true" movable="true" drawLevel="DL_BACKGROUND">
			<Dimensions x="200" y="120"/>
			<Anchor point="TOPLEFT"/>
			<Controls>
				<Control name="$(parent)Header" mouseEnabled="true" drawLayer="DL_BACKGROUND">
					<Dimensions x="200" y="34"/>
					<Anchor point="TOPLEFT" offsetX="-14" offsetY="-14"/>
					<OnMouseDown>
						if button == MOUSE_BUTTON_INDEX_LEFT then
							self:GetParent():StartMoving()
						end
					</OnMouseDown>
					<OnMouseUp>
						self:GetParent():StopMovingOrResizing()
						TimEmote.SaveAnchor()
					</OnMouseUp>
				</Control>
				<Label name="$(parent)Label" mouseEnabled="false" font="ZoFontGameLargeBoldShadow" color="CFDCBD" styleColor="0A0A0A" wrapmode="ELLIPSIS" verticalAlignment="CENTER" text="TimEmote">
					<Anchor point="TOPLEFT" offsetX="-10"/>
				</Label>
				
				<Control name="TE_EmotePanel" mouseEnabled="true">
					<Dimensions x="180" y="620"/>
					<Anchor relativeTo="$(parent)Label" point="TOPLEFT" offsetX="10" offsetY="50"/>
				</Control>
				<Button name="TE_ShowListButton" inherits="TE_EmoteStyleButton" text="list" font="$(BOLD_FONT)|$(KB_15)|soft-shadow-thick">
					<Anchor relativeTo="TE_EmotePanel" point="TOPLEFT" offsetX="0" offsetY="-25"/>
					<Dimensions x="180" y="20"/>
				</Button>
				<Button name="TE_EmoteRandomButton" inherits="ZO_DefaultButton" drawLayer="DL_CONTROLS">
					<Anchor relativeTo="TE_ShowListButton" point="BOTTOM" relativePoint="TOP" offsetX="0" offsetY="0"/>
					<Dimensions x="32" y="32"/>
					<Textures fill="$(parent)" normal="/esoui/art/icons/gift_box_003.dds" pressed="/esoui/art/icons/gift_box_001.dds" />
					<OnMouseEnter>
						ZO_Tooltips_ShowTextTooltip(self, TOP, "|cFF6A00Random|r")
					</OnMouseEnter>
					<OnMouseExit>
						ZO_Tooltips_HideTextTooltip()					
					</OnMouseExit>
					<OnClicked>
						TimEmote.Random(0)
					</OnClicked>
				</Button>
			</Controls>
		</TopLevelControl>

		<Button name="TE_EmoteButton" font="ZoFontGameSmall" inherits="TE_EmoteStyleButton" virtual="true" drawLevel="DL_BACKGROUND" text="Click_">
			<Dimensions x="180" y="28"/>
			<Anchor relativeTo="TE_EmotePanel" point="TOPLEFT" offsetX="0" offsetY="-5"/> 
		</Button>

		<Control name="TE_FavPanel" mouseEnabled="true" movable="false" virtual="true" drawLayer="DL_BACKGROUND" >
			<Dimensions x="180" y="660"/>
			<Anchor relativeTo="TimEmoteWindowLabel" point="TOPLEFT" offsetX="160" offsetY="0"/>
			<Controls>
				<Button name="$(parent)GroupButton" inherits="TE_EmoteStyleButton" text="group" drawLayer="DL_OVERLAY" font="$(BOLD_FONT)|$(KB_15)|soft-shadow-thick">
					<Dimensions x="180" y="20"/>
					<Anchor relativeTo="TE_FavPanel" point="TOPLEFT" offsetX="0" offsetY="25"/>
				</Button>
				<Button name="$(parent)RandomButton" inherits="ZO_DefaultButton" drawLayer="DL_CONTROLS">
					<Anchor relativeTo="$(parent)GroupButton" point="BOTTOM" relativePoint="TOP" offsetX="0" offsetY="0"/>
					<Dimensions x="32" y="32"/>
					<Textures fill="$(parent)" normal="/esoui/art/icons/gift_box_002.dds" pressed="/esoui/art/icons/gift_box_001.dds" />
				</Button>
				<Button name="$(parent)SettingsButton" inherits="ZO_DefaultButton" drawLayer="DL_CONTROLS">
					<Anchor relativeTo="$(parent)GroupButton" point="TOPRIGHT" offsetX="0" offsetY="-20"/>
					<Dimensions x="32" y="32"/>
					<Textures fill="$(parent)" normal="/esoui/art/chatwindow/chat_options_up.dds" pressed="/esoui/art/chatwindow/chat_options_down.dds" />
				</Button>
				<Control name="$(parent)FavList" mouseEnabled="true" drawLayer="DL_BACKGROUND">
					<Dimensions x="210" y="620"/>
					<Controls>
  <!--              <Backdrop name="$(parent)BG" inherits="ZO_ThinBackdrop" /> -->
					</Controls>
				</Control>
			</Controls>
		</Control>
		<Button name="TE_FavButton" font="ZoFontGameSmall" inherits="TE_EmoteStyleButton" virtual="true" drawLayer="DL_BACKGROUND" text="Click_">
			<Dimensions x="180" y="28"/>
			<Anchor relativeTo="TE_FavPanelFavList" point="TOPLEFT" offsetX="0" offsetY="-5"/>
			<MouseButton button="1" enabled="true"/>
		</Button>
		<Button name="TE_DownButton" inherits="ZO_DefaultButton" text="" virtual="true" drawLayer="DL_CONTROLS">
			<Dimensions x="25" y="25"/>
			<Anchor relativeTo="TE_FavPanelFavList" point="TOPLEFT" offsetX="170" offsetY="-6"/>
		</Button>
		<Button name="TE_UpButton" inherits="ZO_DefaultButton" text="" virtual="true" drawLayer="DL_CONTROLS">
			<Dimensions x="25" y="25"/>
			<Anchor relativeTo="TE_FavPanelFavList" point="TOPLEFT" offsetX="185" offsetY="-3"/>
		</Button>
		
	</Controls>
</GuiXml>