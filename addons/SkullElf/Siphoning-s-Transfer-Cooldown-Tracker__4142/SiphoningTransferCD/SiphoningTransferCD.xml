<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/DakJaniels/esoui_gui_xsd/main/esoui_gui_xml.xsd">
	<Controls>
		<TopLevelControl name="STCD_Control"
		                 movable="true"
		                 mouseEnabled="true"
		                 hidden="true">
			<Dimensions x="64"
			            y="64"/>
			<Anchor point="TOPLEFT"
			        offsetX="400"
			        offsetY="300"/>
			<Controls>
				<!-- Scalable wrapper that grows from center -->
				<Control name="$(parent)_Scaler">
					<AnchorFill/>
					<Controls>
						<Texture name="$(parent)_Icon"
						         layer="BACKGROUND"
						         level="0"
						         textureFile="/esoui/art/icons/passive_sorcerer_002.dds"
                                 textureFileReleaseOption="RELEASE_TEXTURE_AT_ZERO_REFERENCES">
							<Anchor point="CENTER"
							        relativePoint="CENTER"/>
							<Dimensions x="64"
							            y="64"/>
						</Texture>
						<Label name="$(parent)_TimerLabel"
						       font="ZoFontWinH2"
						       color="FF0000"
						       layer="OVERLAY"
						       level="1"
						       horizontalAlignment="CENTER"
						       verticalAlignment="CENTER">
							<AnchorFill/>
						</Label>
					</Controls>
				</Control>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>
