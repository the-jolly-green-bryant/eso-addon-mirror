<GuiXml>
    <Controls>

        <Control name="SimpleLongBuffs_BuffDebuffCenterOutStyle_Template" virtual="true">
            <Controls>
                <Control name="$(parent)Container1">
                    <Anchor point="BOTTOM" relativePoint="BOTTOM" offsetY="-7"/>
                </Control>

                <Control name="$(parent)Container2">
                    <Anchor point="BOTTOM" relativeTo="$(parent)Container1" relativePoint="TOP" offsetY="-25"/>
                </Control>
            </Controls>
        </Control>

        <Control name="SimpleLongBuffs_BuffDebuffIcon_Keyboard_Template" inherits="ZO_BuffDebuffIcon_Keyboard_Template" virtual="true">
            <Controls>
                <Label name="$(parent)Duration" font="$(GAMEPAD_MEDIUM_FONT)|25|soft-shadow-thick" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                    <Anchor point="CENTER" relativeTo="$(parent)Frame" relativePoint="CENTER" offsetY="-2" />
                </Label>
            </Controls>
        </Control>

        <Control name="SimpleLongBuffs_BuffDebuffIcon_Gamepad_Template" inherits="ZO_BuffDebuffIcon_Gamepad_Template" virtual="true">
            <Controls>
                <Label name="$(parent)Duration" font="$(GAMEPAD_MEDIUM_FONT)|32|soft-shadow-thick" horizontalAlignment="CENTER" verticalAlignment="CENTER">
                    <Anchor point="CENTER" relativeTo="$(parent)Frame" relativePoint="CENTER" offsetY="-5" />
                </Label>
            </Controls>
        </Control>

        <TopLevelControl name="SimpleLongBuffs" clampedToScreen="true">
            <Dimensions x="30" y="666" />
            <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="-30"/>

            <OnInitialized>
                SimpleLongBuffs_Initialize(self)
            </OnInitialized>
        </TopLevelControl>
    </Controls>
</GuiXml>