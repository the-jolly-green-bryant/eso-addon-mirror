<GuiXml>

	<Controls>

		<TopLevelControl name="MiniBarsWindow" mouseEnabled="true" movable="true" clampedToScreen="true">
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="-10"/>
			<Dimensions y="160" x="60"/>
			<OnMouseEnter>WINDOW_MANAGER:SetMouseCursor(12)</OnMouseEnter>
      		<OnMouseExit>WINDOW_MANAGER:SetMouseCursor(0)</OnMouseExit>
			<OnMoveStop>MiniBars.OnBarMoveDone()</OnMoveStop>

			<Controls>

				<!-- Health -->
				
				<Backdrop name="$(parent)BackdropHealth" edgeColor="1a1a1a" centerColor="1a1a1a" alpha="0.8" layer="0" level="0">
					<Dimensions x="160" y="20" />
					<Anchor point="TOPLEFT"  relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
					<Edge edgeSize="1" />
				</Backdrop>
		 
				<StatusBar name="$(parent)StatusBarHealth" color="933f3f" alpha="1" layer="0" level="1">
					<Dimensions x="160" y="20" />
					<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0" />
					<Limits min="0" max="100" />
				</StatusBar>
				
				<StatusBar name="$(parent)StatusBarShield" color="933f3f" alpha="0.3" layer="0" level="2">
					<Dimensions x="160" y="20" />
					<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
					<Limits min="0" max="100" />
				</StatusBar>
				
				<!-- Magicka -->
				
				<Backdrop name="$(parent)BackdropMagicka" edgeColor="1a1a1a" centerColor="1a1a1a" alpha="0.8" layer="0" level="0">
					<Dimensions x="160" y="20" />
					<Anchor point="TOPLEFT"  relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="20"/>
					<Edge edgeSize="1" />
				</Backdrop>
				
				<StatusBar name="$(parent)StatusBarMagicka" color="933f3f" alpha="1" layer="0" level="1">
					<Dimensions x="160" y="20" />
					<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="20"/>
					<Limits min="0" max="100" />
				</StatusBar>
				
				<!-- Stamina -->
				<Backdrop name="$(parent)BackdropStamina" edgeColor="1a1a1a" centerColor="1a1a1a" alpha="0.8" layer="0" level="0">
					<Dimensions x="160" y="20" />
					<Anchor point="TOPLEFT"  relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="40"/>
					<Edge edgeSize="1" />
				</Backdrop>
				
				<StatusBar name="$(parent)StatusBarStamina" color="933f3f" alpha="1" layer="0" level="1">
					<Dimensions x="160" y="20" />
					<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="40"/>
					<Limits min="0" max="100" />
				</StatusBar>
				
			</Controls>

		</TopLevelControl>

	</Controls>
	
</GuiXml>