<GuiXml>
  <Controls>
    <TopLevelControl name="BTIndicator" mouseEnabled="true" movable="true" clampedToScreen="true" hidden="true">
    
      <Dimensions x="32" y="32" />
      <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="-20" />

      <OnMoveStop>
          BT.OnIndicatorMoveStop()
      </OnMoveStop>
 
      <Controls>
        <Texture name="$(parent)Icon" textureFile="/esoui/art/icons/ability_arcanist_002.dds" tier="HIGH">
					<Dimensions x="32" y="32"/>
					<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
				</Texture>

				<Label name="$(parent)Timer" font="ZoFontAnnounceMedium" text="5" tier="HIGH" hidden="true">
					<Anchor point="CENTER" relativeTo="$(parent)Icon" relativePoint="CENTER" />
				</Label>

        <Backdrop name="$(parent)Backdrop" centerColor="000000" alpha="1" hidden="true">
          <Dimensions x="0" y="32"/>
          <Anchor point="LEFT" relativeTo="$(parent)Icon" relativePoint="RIGHT" offsetX="-1" />
        </Backdrop>
      </Controls>

    </TopLevelControl>
  </Controls>
</GuiXml>