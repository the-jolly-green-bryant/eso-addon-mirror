<GuiXml> 
   <Controls>
		<TopLevelControl name="WerewolfTimerIconWindow" clampedToScreen="true" allowBringToTop="false" mouseEnabled="true" movable="true" hidden="true" layer="0" level="0">
			<Dimensions x="100" y="300"/>
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0"/>
			<OnMoveStop>
				WerewolfTimerIcon.SaveLoc(self)
			</OnMoveStop>
			<Controls>
				<Backdrop name="$(parent)_Backdrop" edgeColor="000000" centerColor="000000" alpha="0.4"  hidden="false" layer="0" level="1">
					<Dimensions x="100" y="300"/>
					<Anchor point="TOPLEFT"  relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
					<Edge edgeSize="2"/>
				</Backdrop>
				<Button name="$(parent)_LockUIButton" font="ZoFontWinH5" color="ffffff" text="Lock UI" hidden="false" layer="0" level="2">
					<Dimensions x="60" y="20"/>
					<Anchor point="BOTTOMLEFT"  relativeTo="$(parent)_Backdrop" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
					<Textures normal="esoui/art/buttons/eso_Buttonlarge_normal.dds"
						pressed="esoui/art/buttons/eso_Buttonlarge_mousedown.dds"
						mouseOver="esoui/art/buttons/eso_Buttonlarge_mouseover.dds"/>
					<OnClicked>
						WerewolfTimerIcon.ClickLockUIButton(self)
					</OnClicked>
				</Button>
				<Button name="$(parent)_UltimateBlockButton" hidden="false" mouseEnabled="true" layer="0" level="2">
					<Dimensions x="20" y="20"/>
					<Anchor point="TOPLEFT"  relativeTo="$(parent)_Backdrop" relativePoint="TOPLEFT" offsetX="0" offsetY="5"/>
					<Textures normal="esoui/art/miscellaneous/unlocked_up.dds"
						pressed="esoui/art/miscellaneous/locked_up.dds"
						mouseOver="esoui/art/miscellaneous/unlocked_up.dds"/>
					<OnClicked>
						WerewolfTimerIcon.ClickUltimateBlockButton(self)
					</OnClicked>
				</Button>
				<Texture name="$(parent)_Icon" textureFile="/esoui/art/progression/progression_indexicon_world_up.dds" hidden="0" color="FFFFFF" alpha="1" layer="0" level="2">
					<Dimensions x="94" y="94"/>
					<Anchor point="TOPLEFT" relativeTo="$(parent)_Backdrop" relativePoint="TOPLEFT" offsetX="5" offsetY="30"/>
				</Texture>
				<Label name="$(parent)_Timer" font="ZoFontWinH1" color="ffffff" text="0" verticalAlignment="CENTER" horizontalAlignment="CENTER"  alpha="1" layer="0" level="3">			
					<Dimensions x="0" y="0"/>
					<Anchor point="CENTER"  relativeTo="$(parent)_Icon" relativePoint="CENTER" offsetX="0" offsetY="0"/>
				</Label>
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>