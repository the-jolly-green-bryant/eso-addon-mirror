<GuiXml> 
   <Controls>
		<TopLevelControl name="WerewolfTimerBarWindow" clampedToScreen="true" allowBringToTop="false" mouseEnabled="true" movable="true" hidden="true" layer="0" level="0">	
			<Dimensions x="500" y="100"/>
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0"/>
			<OnMoveStop>
				WerewolfTimerBar.SaveLoc(self)
			</OnMoveStop>
			<Controls>
				<Backdrop name="$(parent)_Backdrop" edgeColor="000000" centerColor="000000" alpha="0.4"  hidden="false" layer="0" level="0">
					<Dimensions x="305" y="50"/>
					<Anchor point="TOPLEFT"  relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="1"/>
					<Edge edgeSize="2"/>
				</Backdrop>
				<Button name="$(parent)_LockUIButton" font="ZoFontWinH5" color="ffffff" text="Lock UI" hidden="false" layer="0" level="2">
					<Dimensions x="60" y="20"/>
					<Anchor point="BOTTOMLEFT"  relativeTo="$(parent)_Backdrop" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
					<Textures normal="esoui/art/buttons/eso_buttonlarge_normal.dds"
						pressed="esoui/art/buttons/eso_buttonlarge_mousedown.dds"
						mouseOver="esoui/art/buttons/eso_buttonlarge_mouseover.dds"/>
					<OnClicked>
						WerewolfTimerBar.ClickLockUIButton(self)
					</OnClicked>
				</Button>
				<Button name="$(parent)_UltimateBlockButton" hidden="false" mouseEnabled="true" layer="0" level="2">
					<Dimensions x="20" y="20"/>
					<Anchor point="TOPLEFT"  relativeTo="$(parent)_Backdrop" relativePoint="TOPLEFT" offsetX="5" offsetY="5"/>
					<Textures normal="esoui/art/miscellaneous/unlocked_up.dds"
						pressed="esoui/art/miscellaneous/locked_up.dds"
						mouseOver="esoui/art/miscellaneous/unlocked_up.dds"/>
					<OnClicked>
						WerewolfTimerBar.ClickUltimateBlockButton(self)
					</OnClicked>
				</Button>
				<Label name="$(parent)_Label" font="ZoFontWinH1" color="ffffff" text="Werewolf Form" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="1" layer="0" level="2">			
					<Dimensions x="0" y="0"/>
					<Anchor point="TOPLEFT"  relativeTo="$(parent)_UltimateBlockButton" relativePoint="TOPRIGHT" offsetX="5" offsetY="-3"/>
				</Label>
				<StatusBar name="$(parent)_StatusBar" color="8A2BE2" alpha="1" hidden="false" layer="0" level="2">
					<Dimensions x="300" y="20"/>
					<Anchor point="TOPLEFT" relativeTo="$(parent)_UltimateBlockButton" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="5"/>
					<Limits min="100" max="300"/>
				</StatusBar>	 
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>