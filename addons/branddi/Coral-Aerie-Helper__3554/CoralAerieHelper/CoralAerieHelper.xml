<GuiXml>
	<Controls>
		<TopLevelControl name="CoralAerieHelperFrame" mouseEnabled="false" movable="false" hidden="false" clampedToScreen="true" >
			<Dimensions x="1000" y="50" />
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" />
			
			<OnMoveStop>
				CoralAerieHelper.savePos()
			</OnMoveStop>

			<Controls>
				<Label name="$(parent)Time" text="0.0" color="00FF00" inheritAlpha="true" font="$(CHAT_FONT)|$(KB_48)|soft-shadow-thick" verticalAlignment="TOP" horizontalAlignment="RIGHT" >
					<AnchorFill />
				</Label>
				<Label name="$(parent)Name1" text="Next Link" color="00FF00" inheritAlpha="true" font="$(CHAT_FONT)|$(KB_48)|soft-shadow-thick" verticalAlignment="TOP" horizontalAlignment="RIGHT" >
					<AnchorFill />
					<Dimensions x="1000" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="$(parent)Time" />
				</Label>
				<Label name="$(parent)Name2" text="" color="00FF00" inheritAlpha="true" font="$(CHAT_FONT)|$(KB_48)|soft-shadow-thick" verticalAlignment="TOP" horizontalAlignment="RIGHT" >
					<AnchorFill />
					<Dimensions x="1000" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="$(parent)Name1" />
				</Label>


			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>
