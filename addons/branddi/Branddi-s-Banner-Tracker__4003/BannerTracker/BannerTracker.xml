<GuiXml>
    <Controls>
        <TopLevelControl name="BannerTracker_UI" clampedToScreen="true" hidden="true" mouseEnabled="false" movable="false">
            <Anchor point="TOPLEFT" offsetX="300" offsetY="300" />
            <Controls>

                <Texture name="$(parent)_Icon" textureFile="esoui/art/icons/ability_grimoire_support.dds">
                    <AnchorFill />
                </Texture>
                <Backdrop name="$(parent)_Backdrop" centerColor="cc640000" edgeColor="808080">
                    <AnchorFill />
                    <Edge edgeSize="3" />
                </Backdrop>

            </Controls>
            <Dimensions x="64" y="64" />
            <OnMoveStop>
                 BannerTracker.OnMoveStop()
            </OnMoveStop>
        </TopLevelControl>
    </Controls>
</GuiXml>