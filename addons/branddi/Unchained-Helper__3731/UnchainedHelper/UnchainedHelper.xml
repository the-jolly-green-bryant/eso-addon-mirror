<GuiXml>
	<Controls>
		<TopLevelControl name="UnchainedHelperFrame" mouseEnabled="false" movable="false" hidden="false" clampedToScreen="true" >
			<Dimensions x="1000" y="50" />
			<Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" />
			
			<OnMoveStop>
				UnchainedHelper.savePos()
			</OnMoveStop>

			<Controls>
				<Label name="$(parent)Purge" text="Purge x" color="00FF00" inheritAlpha="true" font="$(CHAT_FONT)|$(KB_48)|soft-shadow-thick" verticalAlignment="TOP" horizontalAlignment="RIGHT" >
					<AnchorFill />
				</Label>

			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>
