<GuiXml>
    <Controls>
        <!-- Loot Log UI - Redesigned -->
        <TopLevelControl name="ATK_LootLog_UI" hidden="true" mouseEnabled="true" movable="false">
            <Dimensions x="1600" y="900"/>
            <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER"/>
            <Controls>
                <!-- Main Window Background -->
                <Backdrop name="$(parent)BG" alpha="0.98">
                    <AnchorFill/>
                    <Edge edgeSize="4" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="00AAFF"/>
                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0A0A0A"/>
                </Backdrop>

                <!-- Header Section -->
                <Control name="$(parent)Header">
                    <Dimensions x="1560" y="85"/>
                    <Anchor point="TOP" offsetY="5"/>
                    <Controls>
                        <Backdrop name="$(parent)Plate" alpha="0.9">
                            <AnchorFill/>
                            <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="00AAFF"/>
                            <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="111111"/>
                        </Backdrop>
                        <Label name="$(parent)Title" font="ZoFontGamepadBold48" horizontalAlignment="CENTER" text="|c00AAFFLOOT LOG|r">
                            <Anchor point="TOP" offsetY="5"/>
                        </Label>
                        <Label name="$(parent)Subtitle" font="ZoFontGamepad22" horizontalAlignment="CENTER">
                            <Anchor point="BOTTOM" offsetY="-8"/>
                        </Label>
                    </Controls>
                </Control>

                <!-- Left Column: Loot List -->
                <Control name="$(parent)LeftCol">
                    <Dimensions x="750" y="700"/>
                    <Anchor point="TOPLEFT" offsetX="20" offsetY="100"/>
                    <Controls>
                        <Control name="$(parent)LootCard">
                            <Dimensions x="730" y="690"/>
                            <Anchor point="TOPLEFT"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Texture name="$(parent)FocusGlow" hidden="true" textureFile="EsoUI/Art/Buttons/gamepad/gp_goldHighlight.dds" alpha="0.5">
                                    <AnchorFill/>
                                </Texture>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="710" y="45"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|c00AAFF RECENT LOOT|r">
                                    <Anchor point="TOP" offsetY="18"/>
                                </Label>
                                <Label name="$(parent)ColumnHeaders" font="ZoFontGamepad22" horizontalAlignment="LEFT" text="|c888888  Time         Item                                    Value      Source|r">
                                    <Dimensions x="700" y="25"/>
                                    <Anchor point="TOPLEFT" offsetX="15" offsetY="60"/>
                                </Label>
                                <Control name="$(parent)List">
                                    <Dimensions x="710" y="580"/>
                                    <Anchor point="TOP" offsetY="90"/>
                                    <Controls>
                                        <Backdrop name="$(parent)SelectionFrame" hidden="true" alpha="0.8">
                                            <Dimensions x="700" y="35"/>
                                            <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds" edgeColor="00AAFF"/>
                                            <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="00AAFF" alpha="0.15"/>
                                        </Backdrop>
                                        <Label name="$(parent)Row1" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="0"/></Label>
                                        <Label name="$(parent)Row2" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="35"/></Label>
                                        <Label name="$(parent)Row3" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="70"/></Label>
                                        <Label name="$(parent)Row4" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="105"/></Label>
                                        <Label name="$(parent)Row5" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="140"/></Label>
                                        <Label name="$(parent)Row6" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="175"/></Label>
                                        <Label name="$(parent)Row7" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="210"/></Label>
                                        <Label name="$(parent)Row8" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="245"/></Label>
                                        <Label name="$(parent)Row9" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="280"/></Label>
                                        <Label name="$(parent)Row10" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="315"/></Label>
                                        <Label name="$(parent)Row11" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="350"/></Label>
                                        <Label name="$(parent)Row12" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="385"/></Label>
                                        <Label name="$(parent)Row13" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="420"/></Label>
                                        <Label name="$(parent)Row14" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="455"/></Label>
                                        <Label name="$(parent)Row15" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="700" y="35"/><Anchor point="TOPLEFT" offsetX="10" offsetY="490"/></Label>
                                    </Controls>
                                </Control>
                                <Label name="$(parent)PageInfo" font="ZoFontGamepad22" horizontalAlignment="CENTER" color="888888">
                                    <Anchor point="BOTTOM" offsetY="-15"/>
                                </Label>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>

                <!-- Right Column: Stats & Summary -->
                <Control name="$(parent)RightCol">
                    <Dimensions x="780" y="700"/>
                    <Anchor point="TOPRIGHT" offsetX="-20" offsetY="100"/>
                    <Controls>
                        <!-- Session Stats Card -->
                        <Control name="$(parent)SessionCard">
                            <Dimensions x="760" y="200"/>
                            <Anchor point="TOPLEFT"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="740" y="40"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFFFAASESSION SUMMARY|r">
                                    <Anchor point="TOP" offsetY="15"/>
                                </Label>
                                <Label name="$(parent)TotalItems" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="350" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="60"/></Label>
                                <Label name="$(parent)TotalValue" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="350" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="95"/></Label>
                                <Label name="$(parent)GoldLooted" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="350" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="130"/></Label>
                                <Label name="$(parent)Duration" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="350" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="165"/></Label>
                                <Label name="$(parent)GoldPerHour" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="350" y="30"/><Anchor point="TOPLEFT" offsetX="400" offsetY="60"/></Label>
                                <Label name="$(parent)ItemsPerHour" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="350" y="30"/><Anchor point="TOPLEFT" offsetX="400" offsetY="95"/></Label>
                                <Label name="$(parent)BestItem" font="ZoFontGamepad27" horizontalAlignment="LEFT"><Dimensions x="350" y="30"/><Anchor point="TOPLEFT" offsetX="400" offsetY="130"/></Label>
                            </Controls>
                        </Control>

                        <!-- Filter Card -->
                        <Control name="$(parent)FilterCard">
                            <Dimensions x="760" y="130"/>
                            <Anchor point="TOPLEFT" offsetY="210"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="740" y="40"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFFFAAFILTER|r">
                                    <Anchor point="TOP" offsetY="15"/>
                                </Label>
                                <Label name="$(parent)CurrentFilter" font="ZoFontGamepadBold27" horizontalAlignment="CENTER">
                                    <Anchor point="TOP" offsetY="70"/>
                                </Label>
                            </Controls>
                        </Control>

                        <!-- Top Items Card -->
                        <Control name="$(parent)TopItemsCard">
                            <Dimensions x="760" y="350"/>
                            <Anchor point="TOPLEFT" offsetY="350"/>
                            <Controls>
                                <Backdrop name="$(parent)BG" alpha="0.95">
                                    <AnchorFill/>
                                    <Edge edgeSize="2" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="0D0D0D"/>
                                </Backdrop>
                                <Backdrop name="$(parent)HeaderPlate" alpha="0.9">
                                    <Dimensions x="740" y="40"/>
                                    <Anchor point="TOP" offsetY="10"/>
                                    <Edge edgeSize="1" edgeFile="EsoUI/Art/Tooltips/UI-Border.dds"/>
                                    <Center file="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="151515"/>
                                </Backdrop>
                                <Label name="$(parent)Header" font="ZoFontGamepadBold27" horizontalAlignment="CENTER" text="|cFFD700TOP VALUABLE ITEMS|r">
                                    <Anchor point="TOP" offsetY="15"/>
                                </Label>
                                <Label name="$(parent)Item1" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="720" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="60"/></Label>
                                <Label name="$(parent)Item2" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="720" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="95"/></Label>
                                <Label name="$(parent)Item3" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="720" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="130"/></Label>
                                <Label name="$(parent)Item4" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="720" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="165"/></Label>
                                <Label name="$(parent)Item5" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="720" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="200"/></Label>
                                <Label name="$(parent)Item6" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="720" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="235"/></Label>
                                <Label name="$(parent)Item7" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="720" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="270"/></Label>
                                <Label name="$(parent)Item8" font="ZoFontGamepad22" horizontalAlignment="LEFT"><Dimensions x="720" y="30"/><Anchor point="TOPLEFT" offsetX="20" offsetY="305"/></Label>
                            </Controls>
                        </Control>
                    </Controls>
                </Control>

                <!-- Footer -->
                <Label name="$(parent)Footer" font="ZoFontGamepad18" horizontalAlignment="CENTER" color="888888">
                    <Dimensions x="1400" y="25"/>
                    <Anchor point="BOTTOM" offsetY="-15"/>
                </Label>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
