<GuiXml>
	<Controls>
		<!-- TRACKER -->
		<TopLevelControl name="ECB_TRACKER" mouseEnabled="true" movable="true" hidden="true" clampedToScreen="true" layer="0" level="0" tier="0">
			<Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0"/>
			<OnMoveStop>ECB:SaveWindowLocation()</OnMoveStop>
			
			<Controls>
				<Control name="$(parent)_HEADER">
					<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
					<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="0" offsetY="0"/>
					
					<Controls>
						<Button name="$(parent)_MORE" mouseEnabled="true">
							<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-5" offsetY="0"/>
							<OnMouseUp>ECB:ToggleBookWindow()</OnMouseUp>
							<Dimensions x="30" y="30"/>
							<Textures normal="/esoui/art/housing/keyboard/furniture_tabicon_settings_up.dds" pressed="/esoui/art/housing/keyboard/furniture_tabicon_settings_down.dds"
								mouseOver="/esoui/art/housing/keyboard/furniture_tabicon_settings_over.dds"/>
						</Button>
						<Label name="$(parent)_TITLE" font="ZoFontWinH5" color="c5c29e" text="ERA's Collection Book" horizontalAlignment="CENTER" verticalAlignment="CENTER" wrapMode="ELLIPSIS">
							<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
						</Label>
						
						<Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop">
							<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
							<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetX="0" offsetY="0"/>
						</Backdrop>
					</Controls>
				</Control>
				
				<Control name="$(parent)_CONTENT" resizeToFitDescendents="false">
					<Anchor point="TOPLEFT" relativeTo="$(parent)_HEADER" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="0"/>
					
					<Controls>
						<Control name="$(parent)_BODY_" inherits="ZO_ScrollContainer">
							<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="10" offsetY="5"/>
							<OnInitialized>
								ZO_Scroll_Initialize(self)
							</OnInitialized>
							
							<Controls>
								<!-- HATS -->
								<Label name="$(parent)HATS" mouseEnabled="true" font="ZoFontWinH5" color="c5c29e" text="CATEGORY" horizontalAlignment="LEFT" verticalAlignment="TOP" wrapMode="ELLIPSIS">
									<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
									<OnMouseUp>ECB:OpenCloseCategory("HATS")</OnMouseUp>
								</Label>
								<Control name="$(parent)HATS_LIST" mouseEnabled="true" resizeToFitDescendents="true">
									<Anchor point="TOPLEFT" relativeTo="$(parent)HATS" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="0"/>
								</Control>
								
