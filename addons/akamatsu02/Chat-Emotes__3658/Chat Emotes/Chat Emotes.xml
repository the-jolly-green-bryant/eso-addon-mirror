						end);
						self:SetHandler("OnMouseExit", function() 
							ZO_Tooltips_HideTextTooltip() 
						end)
					</OnInitialized>
				</Button>
				<Button name="$(parent)Icon4" inherits="ZO_ButtonBehaviorClickSound">
					<Dimensions x="64" y="64" />
