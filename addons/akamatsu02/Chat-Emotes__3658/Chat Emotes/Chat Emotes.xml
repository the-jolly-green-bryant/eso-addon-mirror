							ZO_Tooltips_HideTextTooltip() 
						end)
					</OnInitialized>
				</Button>
				<Button name="$(parent)Icon6" inherits="ZO_ButtonBehaviorClickSound">
					<Dimensions x="64" y="64" />
					<Anchor point="TOPLEFT" relativeTo="$(parent)Icon5" relativePoint="TOPRIGHT" offsetX="10" />
					<Textures normal="" />
					<OnClicked>
						local obj = self:GetParent().data.icon6
						if obj == nil then return end
						APCE.AddEmojiInChat(obj.name)
					</OnClicked>
					<OnInitialized>
						self:SetHandler("OnMouseEnter", function() 
							local obj = self:GetParent().data.icon6
							if obj == nil then return end
							ZO_Tooltips_ShowTextTooltip(self, RIGHT, ":"..obj.name..":") 
						end);
						self:SetHandler("OnMouseExit", function() 
							ZO_Tooltips_HideTextTooltip() 
						end)
					</OnInitialized>
				</Button>
            </Controls>
        </Button>
    </Controls>
</GuiXml>