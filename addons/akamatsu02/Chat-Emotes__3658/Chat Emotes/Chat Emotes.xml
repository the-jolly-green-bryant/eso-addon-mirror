						end);
						self:SetHandler("OnMouseExit", function() 
							ZO_Tooltips_HideTextTooltip() 
						end)
					</OnInitialized>
				</Button>
				<Button name="$(parent)Icon5" inherits="ZO_ButtonBehaviorClickSound">
					<Dimensions x="64" y="64" />
					<Anchor point="TOPLEFT" relativeTo="$(parent)Icon4" relativePoint="TOPRIGHT" offsetX="10" />
