									<OnClicked>
										local marker = MARK.UI.Edit.Marker
										if marker == nil then return end
										marker:setData(tonumber(RightMarkerViewInput1:GetText()) or 0, tonumber(RightMarkerViewInput2:GetText()) or 0, tonumber(RightMarkerViewInput3:GetText()) or 0, MARK.UI.SelectedTexture, tonumber(RightMarkerViewInput4:GetText()) or 0)
										marker:save()
										MARK.AdjustRightMenuVisibility(false)
									</OnClicked>
								</Button>
							</Controls>
						</Control>
					</Controls>
				</Control>
            </Controls>
