<GuiXml>
    <Controls>
		<TopLevelControl name="MarkerTLC" layer="0">
		</TopLevelControl>
		
		<TopLevelControl name="MarkerUI" hidden="true" tier="MEDIUM" clampedToScreen="true" movable="true" mouseEnabled="true">
            <Dimensions x="600" y="450" />
            <Anchor point="LEFT" />
			<OnMouseUp>MARK.OnUIMove()</OnMouseUp>
			<OnInitialized>
				self:SetResizeHandleSize(5)
				self:SetDimensionConstraints(600, 450, 1200, 900)
				self:SetHandler("OnMoveStop", function(...) MARK.OnUIMove() end)
				self:SetHandler("OnResizeStop", function(...) MARK.OnUIMove() end)
			</OnInitialized>
            <Controls>
				<Label name="$(parent)_Title" inherits="ZO_WindowTitle" text="">
					<OnInitialized>
						self:SetText(MARK.name)
					</OnInitialized>
				</Label>
                <Backdrop name="$(parent)_BG" inherits="ZO_DefaultBackdrop" />
                <Button name="$(parent)_Close" inherits="ZO_CloseButton">
                    <Anchor point="TOPRIGHT" offsetY="3" />
                    <OnClicked>
						for _, osiIcon in pairs(OSI.GetPositionIcons()) do
						OSI.DiscardPositionIcon(osiIcon)
						end
						MarkerUI:SetHidden(true)
						if MARK.loadedProfile == nil then return end
						local id = MARK.loadedProfile.data.id
						local name = MARK.loadedProfile.data.name
						MARK.unloadProfile(false)
						MARK.loadProfile(id)
					</OnClicked>
                </Button>
				<Button name="$(parent)Donate" inherits="ZO_ButtonBehaviorClickSound">
					<Dimensions x="30" y="30" />
					<Anchor point="BOTTOMRIGHT" />
					<Textures normal="esoui/art/bank/bank_purchasedown.dds" />
					<OnClicked>
						MARK.toDonate()
					</OnClicked>
					<OnInitialized>
						self:SetHandler("OnMouseEnter", function()
						ZO_Tooltips_ShowTextTooltip(self, RIGHT, MARK.donateTitle)
						end);
						self:SetHandler("OnMouseExit", function()
						ZO_Tooltips_HideTextTooltip()
						end)
					</OnInitialized>
				</Button>
				<Button name="$(parent)Reload" inherits="ZO_ButtonBehaviorClickSound">
					<Dimensions x="20" y="20" />
					<Anchor point="TOPLEFT" />
					<Textures normal="esoui/art/menubar/gamepad/gp_playermenu_icon_submitfeedback.dds" />
					<OnClicked>
						MARK.ClearAndReload()
					</OnClicked>
					<OnInitialized>
						self:SetHandler("OnMouseEnter", function()
						ZO_Tooltips_ShowTextTooltip(self, RIGHT, "Reload all placed icons - use this if icons are buggy")
						end);
						self:SetHandler("OnMouseExit", function()
						ZO_Tooltips_HideTextTooltip()
						end)
					</OnInitialized>
				</Button>

				<Control name="$(parent)Body">
					<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetY="35" offsetX="5"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" offsetY="-5" offsetX="-5"/>
					<Controls>
						<Control name="$(parent)Left">
							<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT"/>
							<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOM" offsetX="-5"/>
							<Controls>
								<Button name="$(parent)Switch" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" x="200" />
									<Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP"/>
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="Profiles (1/2)" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										MARK.LeftMenuChangeView()
									</OnClicked>
									<OnInitialized>
										self:SetHandler("OnMouseEnter", function()
										local text = ""
										if MARK.UI.ShownMenu == 1 then
										text = "Change to Marker-List"
										else
										text = "Change to Profile-List"
										end
										ZO_Tooltips_ShowTextTooltip(self, RIGHT, text)
										end);
										self:SetHandler("OnMouseExit", function()
										ZO_Tooltips_HideTextTooltip()
										end)
									</OnInitialized>
								</Button>
								<Button name="$(parent)DistanceSettingOff" inherits="ZO_ButtonBehaviorClickSound" hidden="true">
									<Dimensions x="32" y="32" />
									<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" />
									<Textures normal="esoui\art\campaign\overview_indexicon_scoring_disabled.dds" />
									<OnClicked>
										MARK.LeftMenuFilter()
									</OnClicked>
									<OnInitialized>
										self:SetHandler("OnMouseEnter", function()
										ZO_Tooltips_ShowTextTooltip(self, RIGHT, "Enable filter 'visible markers only'")
										end);
										self:SetHandler("OnMouseExit", function()
										ZO_Tooltips_HideTextTooltip()
										end)
									</OnInitialized>
								</Button>
								<Button name="$(parent)DistanceSettingOn" inherits="ZO_ButtonBehaviorClickSound" hidden="true">
									<Dimensions x="32" y="32" />
									<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" />
									<Textures normal="esoui\art\campaign\overview_indexicon_scoring_up.dds" />
									<OnClicked>
										MARK.LeftMenuFilter()
									</OnClicked>
									<OnInitialized>
										self:SetHandler("OnMouseEnter", function()
										ZO_Tooltips_ShowTextTooltip(self, RIGHT, "Disable filter 'visible markers only'")
										end);
										self:SetHandler("OnMouseExit", function()
										ZO_Tooltips_HideTextTooltip()
										end)
									</OnInitialized>
								</Button>
								<Control name="MarkerList" inherits="ZO_ScrollList">
									<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetY="40"/>
									<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)" relativePoint="BOTTOMRIGHT" />
								</Control>
							</Controls>
						</Control>
						<Control name="RightProfileView" hidden="false">
							<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT"/>
							<Anchor point="BOTTOMLEFT" relativeTo="$(parent)" relativePoint="BOTTOM"/>
							<Controls>
								<Button name="$(parent)New" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" x="200" />
									<Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP"/>
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="New Profile" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										MARK.AdjustRightMenuVisibility(false)
										local profile = MARK.newProfile()
										if profile == nil then return end
										MARK.ItemClickEdit(profile.id)
									</OnClicked>
									<OnInitialized>
										self:SetHandler("OnMouseEnter", function()
										ZO_Tooltips_ShowTextTooltip(self, RIGHT, "Create a new profile for this zone")
										end);
										self:SetHandler("OnMouseExit", function()
										ZO_Tooltips_HideTextTooltip()
										end)
									</OnInitialized>
								</Button>

								<Label name="$(parent)Label1" text="Name:" font="ZoFontWinH3" color="ffffff" wrapMode="TRUNCATE">
									<Dimensions y="32" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetY="40"/>
									<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetY="40"/>
								</Label>
								<Backdrop name="$(parent)Backdrop1" inherits="ZO_MultiLineEditBackdrop_Keyboard">
									<Dimensions y="32" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Label1" relativePoint="BOTTOMLEFT" />
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Label1" relativePoint="BOTTOMRIGHT" />
								</Backdrop>
								<EditBox name="$(parent)Input1" textType="TEXT" inherits="ZO_DefaultEditForBackdrop ZO_EditDefaultText">
									<Dimensions y="32" />
									<Anchor point="LEFT" relativeTo="$(parent)Backdrop1" relativePoint="LEFT" />
									<Anchor point="RIGHT" relativeTo="$(parent)Backdrop1" relativePoint="RIGHT" />
									<OnEscape>self:LoseFocus()</OnEscape>
									<OnEnter>self:LoseFocus();RightProfileViewInput2:TakeFocus()</OnEnter>
									<OnTab>self:LoseFocus();RightProfileViewInput2:TakeFocus()</OnTab>
								</EditBox>

								<Label name="$(parent)Label2" text="Configs:" font="ZoFontWinH3" color="ffffff" wrapMode="TRUNCATE">
									<Dimensions y="32" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Backdrop1" relativePoint="BOTTOMLEFT" offsetY="5"/>
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Backdrop1" relativePoint="BOTTOMRIGHT" offsetY="5"/>
								</Label>

								<Button name="$(parent)Import" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Label2" relativePoint="BOTTOMLEFT"/>
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Label2" relativePoint="BOTTOMRIGHT"/>
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="Import" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										MARK.import()
									</OnClicked>
								</Button>

								<Button name="$(parent)Export" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Import" relativePoint="BOTTOMLEFT"/>
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Import" relativePoint="BOTTOMRIGHT"/>
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="Export" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										MARK.export()
									</OnClicked>
								</Button>

								<Label name="$(parent)Label3" text="Functions:" font="ZoFontWinH3" color="ffffff" wrapMode="TRUNCATE">
									<Dimensions y="32" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Export" relativePoint="BOTTOMLEFT" offsetY="5"/>
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Export" relativePoint="BOTTOMRIGHT" offsetY="5"/>
								</Label>

								<Button name="$(parent)OnLoad" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Label3" relativePoint="BOTTOMLEFT"/>
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Label3" relativePoint="BOTTOMRIGHT"/>
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="OnLoad" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										MARK.codeWindow(true, true)
									</OnClicked>
								</Button>

								<Button name="$(parent)OnUnload" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)OnLoad" relativePoint="BOTTOMLEFT"/>
									<Anchor point="TOPRIGHT" relativeTo="$(parent)OnLoad" relativePoint="BOTTOMRIGHT"/>
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="OnUnload" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										MARK.codeWindow(true, false)
									</OnClicked>
								</Button>

								<Button name="$(parent)Save" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" x="200" />
									<Anchor point="BOTTOM" relativeTo="$(parent)" relativePoint="BOTTOM"/>
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="Save" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										local profile = MARK.UI.Edit.Profile
										if profile == nil then return end
										if RightProfileViewInput1:GetText() ~= "" then profile:setName(RightProfileViewInput1:GetText()) end
										profile:save()
										MARK.AdjustRightMenuVisibility(false)
									</OnClicked>
								</Button>
							</Controls>
						</Control>
						<Control name="RightMarkerView" hidden="true">
							<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT"/>
							<Anchor point="BOTTOMLEFT" relativeTo="$(parent)" relativePoint="BOTTOM"/>
							<Controls>
								<Button name="$(parent)New" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" x="100" />
									<Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" offsetX="-55" />
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="New" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										MARK.AdjustRightMenuVisibility(false)
										MARK.triggerMarkerPlace()
									</OnClicked>
									<OnInitialized>
										self:SetHandler("OnMouseEnter", function()
										ZO_Tooltips_ShowTextTooltip(self, RIGHT, "Create a new Marker on your position")
										end);
										self:SetHandler("OnMouseExit", function()
										ZO_Tooltips_HideTextTooltip()
										end)
									</OnInitialized>
								</Button>
								<Button name="$(parent)Placement" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" x="100" />
									<Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" offsetX="55" />
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="Place" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										MARK.AdjustRightMenuVisibility(false)
										MARK.PlaceIcon3DKeybind()
									</OnClicked>
									<OnInitialized>
										self:SetHandler("OnMouseEnter", function()
										ZO_Tooltips_ShowTextTooltip(self, RIGHT, "Create a new Marker and place it where you're looking at")
										end);
										self:SetHandler("OnMouseExit", function()
										ZO_Tooltips_HideTextTooltip()
										end)
									</OnInitialized>
								</Button>
								
								<Label name="$(parent)Label1" text="X:" font="ZoFontWinH3" color="ffffff" wrapMode="TRUNCATE">
									<Dimensions y="32" x="100" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetY="40"/>
								</Label>
								<Backdrop name="$(parent)Backdrop1" inherits="ZO_MultiLineEditBackdrop_Keyboard">
									<Dimensions y="32" />
									<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetY="40"/>
									<Anchor point="BOTTOMLEFT" relativeTo="$(parent)Label1" relativePoint="BOTTOMRIGHT" />
								</Backdrop>
								<EditBox name="$(parent)Input1" textType="NUMBER" inherits="ZO_DefaultEditForBackdrop ZO_EditDefaultText">
									<Dimensions y="32" />
									<Anchor point="LEFT" relativeTo="$(parent)Backdrop1" relativePoint="LEFT" />
									<Anchor point="RIGHT" relativeTo="$(parent)Backdrop1" relativePoint="RIGHT" />
									<OnEscape>self:LoseFocus()</OnEscape>
									<OnEnter>self:LoseFocus();RightMarkerViewInput2:TakeFocus()</OnEnter>
									<OnTab>self:LoseFocus();RightMarkerViewInput2:TakeFocus()</OnTab>
								</EditBox>

								<Label name="$(parent)Label2" text="Y:" font="ZoFontWinH3" color="ffffff" wrapMode="TRUNCATE">
									<Dimensions y="32" x="100" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Label1" relativePoint="BOTTOMLEFT" offsetY="5"/>
								</Label>
								<Backdrop name="$(parent)Backdrop2" inherits="ZO_MultiLineEditBackdrop_Keyboard">
									<Dimensions y="32"  />
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Backdrop1" relativePoint="BOTTOMRIGHT" offsetY="5"/>
									<Anchor point="BOTTOMLEFT" relativeTo="$(parent)Label2" relativePoint="BOTTOMRIGHT" />
								</Backdrop>
								<EditBox name="$(parent)Input2" textType="NUMBER" inherits="ZO_DefaultEditForBackdrop ZO_EditDefaultText">
									<Dimensions y="32" />
									<Anchor point="LEFT" relativeTo="$(parent)Backdrop2" relativePoint="LEFT" />
									<Anchor point="RIGHT" relativeTo="$(parent)Backdrop2" relativePoint="RIGHT" />
									<OnEscape>self:LoseFocus()</OnEscape>
									<OnEnter>self:LoseFocus();RightMarkerViewInput3:TakeFocus()</OnEnter>
									<OnTab>self:LoseFocus();RightMarkerViewInput3:TakeFocus()</OnTab>
								</EditBox>

								<Label name="$(parent)Label3" text="Z:" font="ZoFontWinH3" color="ffffff" wrapMode="TRUNCATE">
									<Dimensions y="32" x="100" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Label2" relativePoint="BOTTOMLEFT" offsetY="5"/>
								</Label>
								<Backdrop name="$(parent)Backdrop3" inherits="ZO_MultiLineEditBackdrop_Keyboard">
									<Dimensions y="32" />
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Backdrop2" relativePoint="BOTTOMRIGHT" offsetY="5"/>
									<Anchor point="BOTTOMLEFT" relativeTo="$(parent)Label3" relativePoint="BOTTOMRIGHT" />
								</Backdrop>
								<EditBox name="$(parent)Input3" textType="NUMBER" inherits="ZO_DefaultEditForBackdrop ZO_EditDefaultText">
									<Dimensions y="32" />
									<Anchor point="LEFT" relativeTo="$(parent)Backdrop3" relativePoint="LEFT" />
									<Anchor point="RIGHT" relativeTo="$(parent)Backdrop3" relativePoint="RIGHT" />
									<OnEscape>self:LoseFocus()</OnEscape>
									<OnEnter>self:LoseFocus();RightMarkerViewInput4:TakeFocus()</OnEnter>
									<OnTab>self:LoseFocus();RightMarkerViewInput4:TakeFocus()</OnTab>
								</EditBox>

								<Label name="$(parent)Label4" text="Size:" font="ZoFontWinH3" color="ffffff" wrapMode="TRUNCATE">
									<Dimensions y="32" x="100" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Label3" relativePoint="BOTTOMLEFT" offsetY="5"/>
								</Label>
								<Backdrop name="$(parent)Backdrop4" inherits="ZO_MultiLineEditBackdrop_Keyboard">
									<Dimensions y="32" x="300" />
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Backdrop3" relativePoint="BOTTOMRIGHT" offsetY="5"/>
									<Anchor point="BOTTOMLEFT" relativeTo="$(parent)Label4" relativePoint="BOTTOMRIGHT" />
								</Backdrop>
								<EditBox name="$(parent)Input4" textType="NUMBER" inherits="ZO_DefaultEditForBackdrop ZO_EditDefaultText">
									<Dimensions y="32" />
									<Anchor point="LEFT" relativeTo="$(parent)Backdrop4" relativePoint="LEFT" />
									<Anchor point="RIGHT" relativeTo="$(parent)Backdrop4" relativePoint="RIGHT" />
									<OnEscape>self:LoseFocus()</OnEscape>
									<OnEnter>self:LoseFocus()</OnEnter>
									<OnTab>self:LoseFocus()</OnTab>
								</EditBox>

								<Label name="$(parent)Label5" text="Texture:" font="ZoFontWinH3" color="ffffff" wrapMode="TRUNCATE">
									<Dimensions y="32" x="100" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Label4" relativePoint="BOTTOMLEFT" offsetY="5"/>
								</Label>
								
								<Label name="$(parent)Label6" text="Function:" font="ZoFontWinH3" color="ffffff" wrapMode="TRUNCATE">
									<Dimensions y="32" x="100" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Label5" relativePoint="BOTTOMLEFT" offsetY="85"/>
								</Label>
								<Button name="$(parent)Function" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" />
									<Anchor point="TOPRIGHT" relativeTo="$(parent)Backdrop4" relativePoint="BOTTOMRIGHT" offsetY="115"/>
									<Anchor point="BOTTOMLEFT" relativeTo="$(parent)Label6" relativePoint="BOTTOMRIGHT"/>
									<Controls>
										<Backdrop name="$(parent)_BG" inherits="ZO_SliderBackdrop" />
										<Label name="$(parent)Label" text="Set Requirement" font="ZoFontWinH3" color="ffffff">
											<Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
										</Label>
									</Controls>
									<OnClicked>
										MARK.codeWindow()
									</OnClicked>
								</Button>
								
								<Backdrop name="$(parent)Backdrop5" inherits="ZO_MultiLineEditBackdrop_Keyboard">
									<Dimensions y="100" x="100" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Label5" relativePoint="TOPRIGHT" />
								</Backdrop>
								<Button name="$(parent)TextureEdit" inherits="ZO_ButtonBehaviorClickSound">
									<Anchor point="TOPLEFT" relativeTo="$(parent)Backdrop5" relativePoint="TOPLEFT"/>
									<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Backdrop5" relativePoint="BOTTOMRIGHT"/>
									<Textures normal="esoui\art\compass\compass_bg_flagspawn_neutral.dds" />
									<OnClicked>
										LibEmoteSelector:ClearAnchors()
										LibEmoteSelector:SetAnchor(TOPLEFT, GuiRoot, TOPLEFT, RightMarkerViewTextureEdit:GetLeft(), RightMarkerViewTextureEdit:GetBottom())
										LibEmote.StartEmoteSelection(function(emote)
											self:SetNormalTexture(emote:getTexture())
											MARK.TriggerHistorySet()
											MARK.UI.SelectedTexture = emote.emoteIndex
											MARK.saveData()
										end, MARK.getEmotePackFiler(), "", false)
									</OnClicked>
									<OnInitialized>
										self:SetHandler("OnMouseEnter", function()
										ZO_Tooltips_ShowTextTooltip(self, RIGHT, "Click to change texture")
										end);
										self:SetHandler("OnMouseExit", function()
										ZO_Tooltips_HideTextTooltip()
										end)
									</OnInitialized>
								</Button>
								<Backdrop name="$(parent)Backdrop6" inherits="ZO_MultiLineEditBackdrop_Keyboard" alpha="0.1">
									<Dimensions y="50" x="50" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)TextureEdit" relativePoint="TOPRIGHT" />
								</Backdrop>
								<Backdrop name="$(parent)Backdrop7" inherits="ZO_MultiLineEditBackdrop_Keyboard" alpha="0.1">
									<Dimensions y="50" x="50" />
									<Anchor point="TOPLEFT" relativeTo="$(parent)Backdrop6" relativePoint="TOPRIGHT" />
								</Backdrop>
								<Button name="$(parent)TextureHistory1" inherits="ZO_ButtonBehaviorClickSound" alpha="0.3">
									<Anchor point="TOPLEFT" relativeTo="$(parent)Backdrop6" relativePoint="TOPLEFT"/>
									<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Backdrop6" relativePoint="BOTTOMRIGHT"/>
									<Textures normal="" />
									<OnClicked>
										MARK.LoadHistory(1)
									</OnClicked>
									<OnInitialized>
										self:SetHandler("OnMouseEnter", function()
										ZO_Tooltips_ShowTextTooltip(self, RIGHT, "Click to change to this texture")
										end);
										self:SetHandler("OnMouseExit", function()
										ZO_Tooltips_HideTextTooltip()
										end)
									</OnInitialized>
								</Button>
								<Button name="$(parent)TextureHistory2" inherits="ZO_ButtonBehaviorClickSound" alpha="0.3">
									<Anchor point="TOPLEFT" relativeTo="$(parent)Backdrop7" relativePoint="TOPLEFT"/>
									<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Backdrop7" relativePoint="BOTTOMRIGHT"/>
									<Textures normal="" />
									<OnClicked>
										MARK.LoadHistory(2)
									</OnClicked>
									<OnInitialized>
										self:SetHandler("OnMouseEnter", function()
										ZO_Tooltips_ShowTextTooltip(self, RIGHT, "Click to change to this texture")
										end);
										self:SetHandler("OnMouseExit", function()
										ZO_Tooltips_HideTextTooltip()
										end)
									</OnInitialized>
								</Button>
								<Button name="$(parent)Save" inherits="ZO_ButtonBehaviorClickSound">
									<Dimensions y="32" x="200" />
									<Anchor point="BOTTOM" relativeTo="$(parent)" relativePoint="BOTTOM"/>
									<Controls>
