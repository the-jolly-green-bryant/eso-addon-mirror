<GuiXml>
	<Animations>
		<AnimationTimeline name="HarvensXPNotifyAnimation">
			<Animations>
				<AlphaAnimation duration="3000" startAlpha="1" endAlpha="0">
					<EasingFunction>
						return ZO_EaseInQuadratic(progress)
					</EasingFunction>
				</AlphaAnimation>
				<TranslateAnimation duration="3000" deltaY="-300">
<!--					<EasingFunction>
						return ZO_EaseInQuadratic(progress)
					</EasingFunction>-->
				</TranslateAnimation>
			</Animations>
		</AnimationTimeline>

		<AnimationTimeline name="HarvensXPStatusWindowAnimation">
			<Animations>
				<AlphaAnimation duration="1000" startAlpha="1" endAlpha="0">
				</AlphaAnimation>
			</Animations>
		</AnimationTimeline> 
	</Animations>

	<Controls>
		<TopLevelControl name="HarvensXPNotify" virtual="true" resizeToFitDescendents="true" hidden="true">
			<Controls>
				<Label name="$(parent)Text" font="ZoFontWinH2" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" verticalAlignment="CENTER" horizontalAlignment="TOP" wrapMode="ELLIPSIS">
					<AnchorFill/>
				</Label>
			</Controls>
		</TopLevelControl>

		<TopLevelControl name="HarvensXPStatusWindow" movable="true" resizeToFitDescendents="true" mouseEnabled="true" hidden="true" clampedToScreen="true" layer="BACKGROUND" tier="LOW">
			<Anchor point="RIGHT"/>
			<ResizeToFitPadding width="30" height="20" />
			<Controls>
				<Backdrop name="$(parent)Bg" inherits="ZO_DefaultBackdrop" excludeFromResizeToFitExtents="true">
					<AnchorFill />
				</Backdrop>
		                <Button name="$(parent)Close" inherits="ZO_CloseButton" excludeFromResizeToFitExtents="true">
					<Anchor point="TOPRIGHT" offsetX="-4" offsetY="4"/>
				</Button>
				<Label name="$(parent)Title" text="XP Gained" font="ZoFontWinH2" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED">
					<Anchor point="TOP" offsetY="6"/>
				</Label>
				<Texture name="$(parent)Divider" textureFile="EsoUI/Art/Miscellaneous/horizontalDivider.dds" excludeFromResizeToFitExtents="true">
					<Dimensions y="4"/>
					<Anchor point="TOPLEFT" relativeTo="$(parent)Bg" relativePoint="TOPLEFT" offsetY="34"/>
					<Anchor point="TOPRIGHT" relativeTo="$(parent)Bg" relativePoint="TOPRIGHT" offsetY="34"/>
				</Texture>
		                <Button name="$(parent)Reset" text="Reset" inherits="ZO_DefaultButton">
				</Button>
<!--				<Label name="$(parent)AutoClose" text="Closing in %d" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" font="ZoFontGame">
				</Label>-->
			</Controls>
		</TopLevelControl>

		<Label name="HarvensXPStatusWindowText" virtual="true" font="ZoFontWinH3" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_SELECTED" verticalAlignment="CENTER" horizontalAlignment="TOP" wrapMode="ELLIPSIS">
		</Label>
	</Controls>
</GuiXml>