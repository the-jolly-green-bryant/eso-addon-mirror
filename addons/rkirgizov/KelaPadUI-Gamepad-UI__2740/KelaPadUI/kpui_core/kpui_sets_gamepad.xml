<GuiXml>
   
	<Controls>
        <TopLevelControl name="Kela_Sets" inherits="ZO_Gamepad_ParametricList_Screen">
            <OnInitialized>
                Kela_Sets_OnInitialize(self)
            </OnInitialized>
        </TopLevelControl>

        <Control name="KelaSourceDropdownTemplate" inherits="ZO_Gamepad_Dropdown_Item_Indented" virtual="true"/>
        <Control name="KelaObtainableDropdownTemplate" inherits="ZO_Gamepad_Dropdown_Item_Indented" virtual="true"/>
        <Control name="KelaBonusDropdownTemplate" inherits="ZO_Gamepad_Dropdown_Item_Indented" virtual="true"/>
        <Control name="KelaBoundDropdownTemplate" inherits="ZO_Gamepad_Dropdown_Item_Indented" virtual="true"/>
        <Control name="KelaZoneDropdownTemplate" inherits="ZO_Gamepad_Dropdown_Item_Indented" virtual="true"/>
        <Control name="KelaDLCDropdownTemplate" inherits="ZO_Gamepad_Dropdown_Item_Indented" virtual="true"/>

		<Control name="Kela_GamepadItemSubEntryTemplate" inherits="ZO_GamepadSubMenuEntryTemplate" virtual="true">
            <Controls>
                <Cooldown name="$(parent)Cooldown" inherits="ZO_GamepadMenuEntryCooldownTemplate" tier="MEDIUM" hidden="true"/>
                <Texture name="$(parent)StatusIndicator" inherits="ZO_GamepadMenuEntryStatusIndicationTemplate" hidden="true"/>
            </Controls>
        </Control>

    </Controls>
</GuiXml>