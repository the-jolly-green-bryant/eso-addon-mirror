<GuiXml>
  <Controls>
    <TopLevelControl name="EMR_Mundus_Notification" mouseEnabled="true" movable="false" clampedToScreen="true" hidden="true">
      <Anchor point="CENTER" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0" />
      <Dimensions x="600" y="50" />
      <OnMoveStop>
          EMR.OnIndicatorMoveStop()
      </OnMoveStop>

      <Controls>
        <Backdrop name="$(parent)_Background" edgeColor="000000" layer="0" level="0" centerColor="FF0000" alpha="0.7"  hidden="false">
            <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER"/>
            <Dimensions x="600" y="50" />
            <Edge  edgeSize="2" />
        </Backdrop>
        <Label name="$(parent)_Label"  font="ZoFontCallout2" inheritAlpha="true"
              color="FF0000" verticalAlignment="CENTER" horizontalAlignment="CENTER" text="Mundus Stone">
          <Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
        </Label>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
