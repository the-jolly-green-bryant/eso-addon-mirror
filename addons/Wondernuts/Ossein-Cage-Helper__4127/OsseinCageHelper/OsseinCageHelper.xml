<GuiXml>
  <Controls>
    <TopLevelControl name="OCHMessage1" mouseEnabled="true" movable="true" clampedToScreen="true">
      <Dimensions x="800" y="200" />
      <Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="-150" />
      <OnMoveStop>OCH.OnOCHMessage1Move()</OnMoveStop>

      <Controls>
        <Label name="$(parent)Label" width="800" height="200" font="EsoUI/Common/Fonts/univers67.otf|72|soft-shadow-thick" inheritAlpha="true" color="FF6600"
            wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="CENTER" text="MESSAGE ONE">
          <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
        </Label>
      </Controls>
    </TopLevelControl>

    <TopLevelControl name="OCHMessage2" mouseEnabled="true" movable="true" clampedToScreen="true">
      <Dimensions x="800" y="200" />
      <Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="50" />
      <OnMoveStop>OCH.OnOCHMessage2Move()</OnMoveStop>
      
      <Controls>
        <Label name="$(parent)Label" width="800" height="200" font="EsoUI/Common/Fonts/univers67.otf|72|soft-shadow-thick" inheritAlpha="true" color="FF5733"
            wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="CENTER" text="MESSAGE TWO" alpha="0.85">
          <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
        </Label>
      </Controls>
    </TopLevelControl>

    <TopLevelControl name="OCHMessage3" mouseEnabled="true" movable="true" clampedToScreen="true">
      <Dimensions x="800" y="200" />
      <Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="150" />
      <OnMoveStop>OCH.OnOCHMessage3Move()</OnMoveStop>
      
      <Controls>
        <Label name="$(parent)Label" width="800" height="200" font="EsoUI/Common/Fonts/univers67.otf|72|soft-shadow-thick" inheritAlpha="true" color="FF00FF"
            wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="CENTER" text="MESSAGE THREE" alpha="0.85">
          <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" />
        </Label>
      </Controls>
    </TopLevelControl>

    <TopLevelControl name="OCHStatus" mouseEnabled="true" movable="true" clampedToScreen="true">
      <Dimensions x="500" y="200" />
      <Anchor point="BOTTOM" relativeTo="GuiRoot" relativePoint="CENTER" offsetY="-150" offsetX="600" />
      <OnMoveStop>OCH.OnOCHStatusMove()</OnMoveStop>
      <Controls>
      <Label name="$(parent)LabelAddonName" font="EsoUI/Common/Fonts/univers67.otf|16|soft-shadow-thick" color="FFFFFF" text="Ossein Cage Helper" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="-30"/>
      </Label>
      
      <Texture name="$(parent)Divider" textureFile="/esoui/art/miscellaneous/horizontaldivider.dds">
          <Dimensions x="270" y="4"/>
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="-20" offsetX="-210"/>
      </Texture>
      
      <Label name="$(parent)LabelTop" font="ZoFontWinH1" color="FFFFFF" text="TOP MESSAGE" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="-60" offsetX="0"/>
      </Label>

      <!-- Boss 2: Jynorah -->
      <Label name="$(parent)LabelJynorah1" font="ZoFontWinH1" color="CCCC66" text="Titanic Clash:" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="0"/>
      </Label>
      <Label name="$(parent)LabelJynorah1Value" font="ZoFontWinH1" color="FFD666" text="30s" verticalAlignment="CENTER" horizontalAlignment="LEFT" alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="0" offsetX="200"/>
      </Label>

      <Label name="$(parent)LabelJynorah2" font="ZoFontWinH1" color="CCCC66" text="Bosses:" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="40"/>
      </Label>
      <Label name="$(parent)LabelJynorah2Value" font="ZoFontWinH1" color="ff8500" text="|c66CCFF100.0%|r / |cFF6600100.0%|r" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="40" offsetX="200"/>
      </Label>

      <Label name="$(parent)LabelJynorah3" font="ZoFontWinH1" color="CCCC66" text="Titans:" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="80"/>
      </Label>
      <Label name="$(parent)LabelJynorah3Value" font="ZoFontWinH1" color="ff8500" text="|c66CCBB100.0%|r / |cDD6600100.0%|r" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="80" offsetX="200"/>
      </Label>

      <Label name="$(parent)LabelCausticCarrion" font="ZoFontWinH1" color="7df2ff" text="Carrion Stacks:" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="120"/>
      </Label>
      <Label name="$(parent)LabelCausticCarrionValue" font="ZoFontWinH1" color="ff8500" text="" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0.85">
          <Dimensions x="600" y="50" />
          <Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER" offsetY="120" offsetX="200"/>
      </Label>

      </Controls>
    </TopLevelControl>

    <TopLevelControl name="OCHScreenBorder" tier="HIGH" alpha="0.5" hidden="true">
      <AnchorFill />
      <Controls>
        <Backdrop name="$(parent)Overlay" edgeColor="CC00CC">
          <AnchorFill />
          <Center file="EsoUI/Art/HUD/UITelvarOverlayCenter.dds" />
          <Edge file="EsoUI/Art/HUD/UITelvarOverlayEdge.dds" edgeFileWidth="2048" edgeFileHeight="256" />
          <Insets left="256" top="256" right="-256" bottom="-256" />
        </Backdrop>
      </Controls>
    </TopLevelControl>
  </Controls>
</GuiXml>
