<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <Category name="Le Guide de L'Antiquaire">
            <!-- Raccourcis existants -->
            <Action name="LGA_TOGGLE_WINDOW">
                <Down>Le_Guide_de_L_Antiquaire.ToggleWindow()</Down>
            </Action>
            <Action name="LGA_USE_EYE">
                <Down>Le_Guide_de_L_Antiquaire.UseEye()</Down>
            </Action>
            
            <!-- Nouveaux raccourcis demandés -->
            <Action name="LGA_TOGGLE_MINIMIZE">
                <Down>Le_Guide_de_L_Antiquaire.ToggleMinimize()</Down>
            </Action>
            
            <Action name="LGA_CLOSE_ALL_POPUPS">
                <Down>Le_Guide_de_L_Antiquaire.CloseAllPopups()</Down>
            </Action>
            
            <Action name="LGA_TOGGLE_ALARM_ACTIVE">
                <Down>Le_Guide_de_L_Antiquaire.ToggleAlarmActive()</Down>
            </Action>
            
            <Action name="LGA_REFRESH_ALARM">
                <Down>Le_Guide_de_L_Antiquaire.RefreshAlarm()</Down>
            </Action>
            
            <Action name="LGA_TOGGLE_ALARM_WINDOW">
                <Down>Le_Guide_de_L_Antiquaire.ToggleAlarmWindow()</Down>
            </Action>
        </Category>
    </Layer>
</Bindings>
