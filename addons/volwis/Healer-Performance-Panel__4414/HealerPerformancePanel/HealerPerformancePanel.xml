; HealerPerformancePanel.xml  (v0.2.15)  mk.dds centered 256x256, list starts below
<GuiXml>
  <Controls>
    <TopLevelControl name="HPP_Window" movable="true" mouseEnabled="true" clampedToScreen="true" hidden="false">
      <Dimensions x="980" y="300" />
      <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" offsetX="120" offsetY="120" />
      <Controls>
        <Backdrop name="$(parent)Bg" inherits="ZO_DefaultBackdrop"><AnchorFill /></Backdrop>
        <Label name="$(parent)Title" font="ZoFontGame" text="HPP"><Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="5" offsetY="5" /></Label>
        <Label name="$(parent)Sub" font="ZoFontGame" text=""><Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetX="0" offsetY="2" /></Label>

        <!-- mk.dds is in the same addon folder -->
        <Texture name="$(parent)HeaderImage" hidden="false" drawLayer="OVERLAY" drawLevel="1" textureFile="mk.dds">
          <Anchor point="TOP" relativeTo="$(parent)" relativePoint="TOP" offsetX="0" offsetY="0" />
          <Dimensions x="256" y="256" />
        </Texture>

        <Control name="$(parent)List">
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="0" offsetY="256" />
          <Dimensions x="980" y="300" />
        </Control>
      </Controls>
    </TopLevelControl>

    <Control name="HPP_RowTemplate" virtual="true" mouseEnabled="false">
      <Dimensions x="480" y="40" />
      <Controls>
        <Backdrop name="$(parent)RowBg" inherits="ZO_DefaultBackdrop"><AnchorFill /></Backdrop>

        <StatusBar name="$(parent)HpBar">
          <AnchorFill />
        </StatusBar>

        <Label name="$(parent)Level" font="ZoFontWinH4" text="32" horizontalAlignment="LEFT" verticalAlignment="CENTER">
          <Anchor point="LEFT" relativeTo="$(parent)" relativePoint="LEFT" offsetX="10" offsetY="0" />
          <Dimensions x="52" y="34" />
        </Label>

        <Texture name="$(parent)LeaderIcon" hidden="true" drawLayer="OVERLAY" drawLevel="10">
          <Dimensions x="26" y="26" />
          <Anchor point="RIGHT" relativeTo="$(parent)RoleIcon" relativePoint="LEFT" offsetX="-10" offsetY="0" />
        </Texture>

        <Texture name="$(parent)RoleIcon" hidden="false" drawLayer="OVERLAY" drawLevel="5">
          <Anchor point="LEFT" relativeTo="$(parent)Level" relativePoint="RIGHT" offsetX="32" offsetY="0" />
          <Dimensions x="26" y="26" />
        </Texture>

        <Label name="$(parent)Name" font="ZoFontWinH4" text="@player" horizontalAlignment="LEFT" verticalAlignment="CENTER">
          <Anchor point="LEFT" relativeTo="$(parent)Level" relativePoint="RIGHT" offsetX="32" offsetY="0" />
          <Dimensions x="220" y="34" />
        </Label>

        <Label name="$(parent)HpText" font="ZoFontWinH4" text="100%" horizontalAlignment="RIGHT" verticalAlignment="CENTER">
          <Anchor point="RIGHT" relativeTo="$(parent)" relativePoint="RIGHT" offsetX="-10" offsetY="0" />
          <Dimensions x="170" y="34" />
        </Label>

        <Texture name="$(parent)Debuff3" hidden="true">
          <Dimensions x="18" y="18" />
          <Anchor point="RIGHT" relativeTo="$(parent)HpText" relativePoint="LEFT" offsetX="-6" offsetY="0" />
        </Texture>
        <Texture name="$(parent)Debuff2" hidden="true">
          <Dimensions x="18" y="18" />
          <Anchor point="RIGHT" relativeTo="$(parent)Debuff3" relativePoint="LEFT" offsetX="-3" offsetY="0" />
        </Texture>
        <Texture name="$(parent)Debuff1" hidden="true">
          <Dimensions x="18" y="18" />
          <Anchor point="RIGHT" relativeTo="$(parent)Debuff2" relativePoint="LEFT" offsetX="-3" offsetY="0" />
        </Texture>
      </Controls>
    </Control>
  </Controls>
</GuiXml>
