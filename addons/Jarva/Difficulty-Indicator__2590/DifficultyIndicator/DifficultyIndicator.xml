<GuiXml>
    <Controls>
        <TopLevelControl name="DifficultyIndicatorUI">
            <Controls>
                <Backdrop name="$(parent)LabelBG" alpha="0" centerColor="40FF0000" edgeColor="60FF0000" clampedToScreen="true" movable="true" mouseEnabled="true">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="CENTER" offsetX="0" offsetY="0"/>
                    <Dimensions x="64" y="64"/>
                    <Edge edgeSize="1"/>
                    <OnMouseEnter>WINDOW_MANAGER:SetMouseCursor(12);self:SetAlpha(0.7)</OnMouseEnter>
                    <OnMouseExit>WINDOW_MANAGER:SetMouseCursor(0);self:SetAlpha(0)</OnMouseExit>
                    <OnMoveStop>DifficultyIndicator.SavePosition()</OnMoveStop>
                </Backdrop>

                <Texture hidden="true" alpha="0.5" name="$(parent)Icon" tier="HIGH">
                  <Anchor point="CENTER" relativeTo="$(parent)LabelBG" relativePoint="CENTER" />
                  <Dimensions x="64" y="64" />
                </Texture>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
