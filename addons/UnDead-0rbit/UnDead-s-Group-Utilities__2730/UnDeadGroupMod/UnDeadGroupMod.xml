				<Button name="$(parent)ButtonReady" inherits="ZO_ButtonBehaviorClickSound">
					<Dimensions x="25" y="25" />
					<Anchor point="LEFT" relativeTo="$(parent)LabelReady" relativePoint="Right" offsetX="25" offsetY="-1" />
					<Textures normal="esoui/art/buttons/plus_up.dds" pressed="esoui/art/buttons/plus_down.dds" mouseOver="esoui/art/buttons/plus_over.dds" disabled="esoui/art/buttons/plus_down.dds"/>
					<OnClicked>
						UnDeadGroupMod.ReadyCheck()
					</OnClicked>
					<OnMouseEnter>
						ZO_Tooltips_ShowTextTooltip(self, LEFT, "Initiate")
					</OnMouseEnter>
					<OnMouseExit>
