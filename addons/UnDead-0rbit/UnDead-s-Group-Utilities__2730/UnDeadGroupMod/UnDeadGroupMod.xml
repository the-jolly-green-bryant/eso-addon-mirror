				<Label name="$(parent)LabelReady" font="myfont" color="ffffff" text="Initiate Ready Check">
					<Dimensions x="160" y="26" />
					<Anchor point="TopLeft" relativeTo="$(parent)Label4" relativePoint="BottomLeft" />
