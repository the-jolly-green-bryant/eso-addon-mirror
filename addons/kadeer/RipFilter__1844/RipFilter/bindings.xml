<Bindings>
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="RipFilter">
			<Action name="RF_SHOWHIDE_RECAP">
				<Up>RipFilter:SetHiddenRecap(not RF_RECAP:IsHidden())</Up>
			</Action>
			<Action name="RF_KILLING_BLOW">
				<Up>RipFilter:PostList("Killing Blows")</Up>
			</Action>
			<Action name="RF_RESURRECTIONS">
				<Up>RipFilter:PostList("Resurrections")</Up>
			</Action>
			<Action name="RF_DEATHS">
				<Up>RipFilter:PostList("Deaths")</Up>
			</Action>
			<Action name="RF_WIPES">
				<Up>RipFilter:PostSingle("Wipes")</Up>
			</Action>

			<Action name="RF_RESET_KILLING_BLOW">
				<Up>RipFilter:Reset("Killing Blows")</Up>
			</Action>
			<Action name="RF_RESET_RESURRECTIONS">
				<Up>RipFilter:Reset("Resurrections")</Up>
			</Action>
			<Action name="RF_RESET_DEATHS">
				<Up>RipFilter:Reset("Deaths")</Up>
			</Action>
			<Action name="RF_RESET_ALL">
				<Up>RipFilter:Reset("RipFilter has Reset")</Up>
			</Action>
		</Category>
	</Layer>
</Bindings>