					<Dimensions x="15" y="28" />
					<Textures normal="esoui/art/miscellaneous/list_sortheader_icon_neutral.dds" mouseOver="esoui/art/miscellaneous/list_sortheader_icon_over.dds"/>
					<OnClicked>HealCounter.sortAbilityUsed()</OnClicked>
				</Button>
				<Button name="$(parent)SortAbilityAvgColumn" tier="MEDIUM" level="3">
					<Anchor point="TOPLEFT" offsetX="245" offsetY="360" relativeTo="$(parent)Frame" relativePoint="TOPLEFT"/>
					<Dimensions x="15" y="28" />
					<Textures normal="esoui/art/miscellaneous/list_sortheader_icon_neutral.dds" mouseOver="esoui/art/miscellaneous/list_sortheader_icon_over.dds"/>
					<OnClicked>HealCounter.sortAbilityAvg()</OnClicked>
				</Button>
				<Button name="$(parent)SortAbilityMinColumn" tier="MEDIUM" level="3">
					<Anchor point="TOPLEFT" offsetX="315" offsetY="360" relativeTo="$(parent)Frame" relativePoint="TOPLEFT"/>
					<Dimensions x="15" y="28" />
					<Textures normal="esoui/art/miscellaneous/list_sortheader_icon_neutral.dds" mouseOver="esoui/art/miscellaneous/list_sortheader_icon_over.dds"/>
					<OnClicked>HealCounter.sortAbilityMin()</OnClicked>
				</Button>
				<Button name="$(parent)SortAbilityMaxColumn" tier="MEDIUM" level="3">
					<Anchor point="TOPLEFT" offsetX="410" offsetY="360" relativeTo="$(parent)Frame" relativePoint="TOPLEFT"/>
					<Dimensions x="15" y="28" />
					<Textures normal="esoui/art/miscellaneous/list_sortheader_icon_neutral.dds" mouseOver="esoui/art/miscellaneous/list_sortheader_icon_over.dds"/>
					<OnClicked>HealCounter.sortAbilityMax()</OnClicked>
				</Button>
				<Button name="$(parent)SortAbilityCritColumn" tier="MEDIUM" level="3">
					<Anchor point="TOPLEFT" offsetX="495" offsetY="360" relativeTo="$(parent)Frame" relativePoint="TOPLEFT"/>
					<Dimensions x="15" y="28" />
					<Textures normal="esoui/art/miscellaneous/list_sortheader_icon_neutral.dds" mouseOver="esoui/art/miscellaneous/list_sortheader_icon_over.dds"/>
					<OnClicked>HealCounter.sortAbilityCrit()</OnClicked>
				</Button>
				<Scroll name="$(parent)AbilitiesTable" hidden="false">
					<AnchorFill />
				</Scroll>
			</Controls>
		</TopLevelControl>
		<Control name="HealCounterTableLine" virtual="true">
			<Controls>
				<Texture name="$(parent)_Texture" textureFile="/esoui/art/ava/ava_siegeupgrade_bg.dds" layer="BACKGROUND" hidden="false" virtual="false" alpha="1.0">
					<AnchorFill/>
				</Texture>
			</Controls>
		</Control>
	</Controls>
</GuiXml>