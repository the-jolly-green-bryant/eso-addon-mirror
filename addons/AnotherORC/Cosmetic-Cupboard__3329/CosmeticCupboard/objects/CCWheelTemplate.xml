<GuiXml>
  <Controls>

    <!-- Collection Item -->
    <Control name="CC_WheelItem" mouseEnabled="true" virtual="true">

      <OnInitialized>
        CC_WheelItem_OnInitialized(self)
      </OnInitialized>

      <Controls>

        <Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop"/>

        <Texture name="$(parent)Highlight" textureFile="esoui\art\restyle\keyboard\outfitslot_selectedbackground.dds">
          <Dimensions x="63" y="63" />
          <Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" offsetX="-1" offsetY="-1" />
        </Texture>

        <Texture name="$(parent)Image" mouseEnabled="true">
          <Anchor point="CENTER" relativeTo="$(parent)" relativePoint="CENTER" />
        </Texture>

        <Texture name="$(parent)Check" textureFile="esoui/art/cadwell/check.dds" color="00FF00" hidden="true">
          <Dimensions x="15" y="15" />
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOPLEFT" offsetX="-5" offsetY="-4" />
        </Texture>

        <Texture name="$(parent)Star" textureFile="esoui/art/tutorial/ava_rankicon_general.dds" color="FEFF9A">
          <Dimensions x="20" y="20" />
          <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="6" offsetY="-7" />
        </Texture>
      </Controls>
    </Control>

    <Control name="CC_AssignableUtilityWheel" virtual="true">
        <Dimensions x="300" y="300" />

        <OnInitialized>
            CC_WheelTemplate_OnInitialized(self)
        </OnInitialized>

         <Controls>
            <!-- 
            <Texture name="$(parent)Background" textureFile="EsoUI/Art/Quickslots/quickslot_mapping_bg.dds">
                <Dimensions x="512" y="512" />
                <Anchor point="CENTER" />
            </Texture>
            -->
        </Controls>
    </Control>
  </Controls>
</GuiXml>
