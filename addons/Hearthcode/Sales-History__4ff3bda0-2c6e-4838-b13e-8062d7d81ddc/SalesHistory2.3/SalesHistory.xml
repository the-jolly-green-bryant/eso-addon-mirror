        <!-- Status / empty label -->
        <Label name="$(parent)StatusLabel" font="ZoFontGamepad27" color="AAAAAA" text="" wrapMode="ELLIPSIS" horizontalAlignment="CENTER">
          <Dimensions x="668" y="30" />
          <Anchor point="BOTTOM" offsetY="-12" />
        </Label>

        <!-- Spinner overlay shown while scanning (simplified for safety) -->
        <Control name="$(parent)SpinnerOverlay" hidden="true">
          <AnchorFill />
          <Controls>
            <Backdrop name="$(parent)Bg">
              <AnchorFill />
            </Backdrop>
            <Texture name="$(parent)Spinner"
              textureFile="/esoui/art/miscellaneous/loading_spinner_512.dds"
              hidden="false">
              <Dimensions x="64" y="64" />
              <Anchor point="CENTER" offsetY="-16" />
            </Texture>
            <Label name="$(parent)Label" font="ZoFontGamepad34" color="FFFFFF"
              text="Scanning sales..." horizontalAlignment="CENTER">
              <Anchor point="CENTER" offsetY="36" />
            </Label>
          </Controls>
        </Control>

      </Controls>
    </TopLevelControl>

    <!-- Row Template (hidden, cloned at runtime) -->
    <Control name="SalesHistoryRowTemplate" hidden="true">
      <Dimensions x="668" y="36" />
      <Controls>
        <Texture name="$(parent)Icon">
          <Dimensions x="32" y="32" />
          <Anchor point="LEFT" offsetX="0" offsetY="0" />
        </Texture>
        <Label name="$(parent)ItemName" font="ZoFontGamepad27" color="FFFFFF" wrapMode="ELLIPSIS">
          <Dimensions x="340" y="32" />
          <Anchor point="LEFT" offsetX="38" offsetY="0" />
        </Label>
        <Label name="$(parent)Price" font="ZoFontGamepad27" color="FFD700">
          <Dimensions x="110" y="32" />
          <Anchor point="LEFT" offsetX="390" offsetY="0" />
        </Label>
        <Label name="$(parent)Date" font="ZoFontGamepad27" color="AAAAAA">
          <Dimensions x="120" y="32" />
          <Anchor point="LEFT" offsetX="510" offsetY="0" />
        </Label>
