<GuiXml>
  <Controls>

    <!-- Main Sales History Window -->
    <TopLevelControl name="SalesHistoryWindow" hidden="true" movable="true" clampedToScreen="true">
      <Dimensions x="700" y="500" />
      <Anchor point="CENTER" />

      <Controls>
        <!-- Background -->
        <Backdrop name="$(parent)Bg" inherits="ZO_DefaultBackdrop">
          <AnchorFill />
        </Backdrop>

        <!-- Title Bar -->
        <Label name="$(parent)Title" font="ZoFontGamepad42" color="FFFFFF" text="Guild Sales History">
          <Anchor point="TOPLEFT" offsetX="16" offsetY="12" />
        </Label>

        <!-- Close Button (safe: no template inheritance) -->
        <Button name="$(parent)CloseBtn" text="SI_DIALOG_CLOSE">
          <Dimensions x="100" y="36" />
          <Anchor point="TOPRIGHT" offsetX="-8" offsetY="8" />
        </Button>

        <!-- Divider -->
        <Texture name="$(parent)Divider" textureFile="/esoui/art/miscellaneous/horizontalrule.dds">
          <Dimensions x="668" y="4" />
          <Anchor point="TOPLEFT" offsetX="16" offsetY="50" />
        </Texture>

        <!-- Column Headers -->
        <Label name="$(parent)HeaderItem" font="ZoFontGamepad34" color="FFFF00" text="Item Name">
          <Dimensions x="420" y="30" />
          <Anchor point="TOPLEFT" offsetX="16" offsetY="56" />
        </Label>
        <Label name="$(parent)HeaderGold" font="ZoFontGamepad34" color="FFFF00" text="Gold" horizontalAlignment="RIGHT">
          <Dimensions x="100" y="30" />
          <Anchor point="TOPLEFT" offsetX="440" offsetY="56" />
        </Label>
        <Label name="$(parent)HeaderDate" font="ZoFontGamepad34" color="FFFF00" text="Date">
          <Dimensions x="120" y="30" />
          <Anchor point="TOPLEFT" offsetX="550" offsetY="56" />
        </Label>

        <!-- Hardcoded 12 sale item rows with 3 columns each -->
        <!-- Row 1 -->
        <Label name="$(parent)Item1Name" font="ZoFontGamepad27" color="FFFFFF" text="" wrapMode="ELLIPSIS">
          <Dimensions x="420" y="30" />
          <Anchor point="TOPLEFT" offsetX="16" offsetY="90" />
        </Label>
        <Label name="$(parent)Item1Gold" font="ZoFontGamepad27" color="FFD700" text="" horizontalAlignment="RIGHT">
          <Dimensions x="100" y="30" />
          <Anchor point="TOPLEFT" offsetX="440" offsetY="90" />
        </Label>
        <Label name="$(parent)Item1Date" font="ZoFontGamepad27" color="AAAAAA" text="">
          <Dimensions x="120" y="30" />
          <Anchor point="TOPLEFT" offsetX="550" offsetY="90" />
        </Label>

