<GuiXml>
	<Controls>
		<Control name="BlockBarControlTemplate" virtual="true">
		
			<Controls>
				
				<Label name="$(parent)Label" text="0" horizontalAlignment="LEFT" verticalAlignment="CENTER" font="ZoFontGameBold" color="FFFFFFFF">
					
					<Anchor point="TOPLEFT" relativeTo="$(parent)Bg" offsetX="4"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Bg"/>

				</Label>
		
			</Controls>				
			
		</Control>
		
	
		<TopLevelControl name="BLOCKCOUNTER_TLW" clampedToScreen="true" hidden="true" resizeToFitDescendents="true">
			<!-- <Dimensions x="1" y="1" /> -->
			<Anchor point="CENTER" offsetY="200"/>
			<Controls>
				<Backdrop name="$(parent)Bg" inherits="ZO_DefaultBackdrop">
					
					<AnchorFill/>
					
				</Backdrop>
				
				<Control name="$(parent)Blocks" resizeToFitDescendents="true">
					
					<Anchor point="LEFT" offsetX="0" offsetY="0" />
					<!-- <Dimensions x="1" y="1"/> -->
				
					<Controls>
						
						<Control name="$(parent)StaminaBlocks" inherits="BlockBarControlTemplate">
						
							<Anchor point="TOPLEFT"/>
							<Dimensions x="158" y="38"/>
							
						</Control>
						
						<Control name="$(parent)MagickaBlocks" inherits="BlockBarControlTemplate">
						
							<Anchor point="BOTTOMLEFT"/>
							<Dimensions x="158" y="38"/>							
						
						</Control>						
						
					</Controls>					
					
				</Control>
				
			</Controls>
		</TopLevelControl>
	</Controls>
</GuiXml>