<!-- 
================================================================================
 Hello Tamriel Travel Tools - Keybindings
 
 This file defines all keyboard shortcuts that can be bound in the Controls menu.
 Players can assign keys to these actions through the ESO Controls settings.
 
 Each <Action> creates a bindable command that calls the specified Lua function.
 
 Last Updated: 2025-08-23
 By: House-of-Rahl
================================================================================
-->
<Bindings>
    <Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
        <!-- Main addon category in the Controls menu -->
        <Category name="Hello Tamriel - |c00FF00Travel Tools|r">

            <!-- 
            ====== HOME AND SMART TELEPORT ACTIONS ======
            These actions provide quick access to home teleport and free wayshrine travel
            -->
            <Action name="HTTT_JUMP_HOME_INSIDE">
                <Down>HTTT.Teleport.JumpToPrimaryHome(false)</Down>
            </Action>

            <Action name="HTTT_JUMP_HOME_OUTSIDE">
                <Down>HTTT.Teleport.JumpToPrimaryHome(true)</Down>
            </Action>

            <Action name="HTTT_JUMP_WAYSHRINE">
                <Down>HTTT.Teleport.FreeTeleportToPriorityWayshrine()</Down>
            </Action>

            <!-- 
            ====== FAVORITE FRIEND HOUSES ======
            Keybinds for quick access to the 10 friend house favorite slots
