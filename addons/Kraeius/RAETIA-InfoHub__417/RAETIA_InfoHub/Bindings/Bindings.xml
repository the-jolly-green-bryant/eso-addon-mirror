<Bindings>
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="RAETIA InfoHub">			
			<Action name="RAEIH_OPEN_SETTINGS">
				<Down>SLASH_COMMANDS["/raeih"]()</Down>
			</Action>
			<Action name="RAEIH_TOGGLE_CHAMBERLAIN">
				<Down>RAEIH.ToggleChamberlain()</Down>
			</Action>
			<Action name="RAEIH_TOGGLE_HELMET">
				<Down>RAEIH.ToggleHelmet()</Down>
			</Action>
			<Action name="RAEIH_RELOAD_UI">
				<Down>SLASH_COMMANDS["/reloadui"]()</Down>
			</Action>
		</Category>
	</Layer>
</Bindings>