<GuiXml>
    <Controls>
        <Control name="VestigeMirrorItemCallout" virtual="true" mouseEnabled="true">
            <Dimensions x="384" y="130"/>
            <Controls>
                <Texture name="$(parent)Readability" textureFile="EsoUI/Art/Miscellaneous/listItem_backdrop.dds" color="000000" alpha="0.90" layer="BACKGROUND">
                    <Dimensions x="300" y="150"/>
                    <Anchor point="TOPLEFT" offsetX="76" offsetY="6"/>
                </Texture>

                <Texture name="$(parent)IconFrame" textureFile="EsoUI/Art/SiegeBar/siegeSlot_empty.dds" layer="OVERLAY">
                    <Dimensions x="60" y="60"/>
                    <Anchor point="TOPLEFT" offsetY="6"/>
                </Texture>

                <Texture name="$(parent)Icon" layer="OVERLAY">
                    <Dimensions x="40" y="40"/>
                    <Anchor point="CENTER" relativeTo="$(parent)IconFrame"/>
                </Texture>

                <Label name="$(parent)Slot" font="$(BOLD_FONT)|13|soft-shadow-thick" color="7FE7E0FF" maxLineCount="1">
                    <Dimensions x="270" y="16"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Readability" offsetX="10" offsetY="6"/>
                </Label>

                <Label name="$(parent)Name" font="$(BOLD_FONT)|18|soft-shadow-thick" color="F4EBD6FF" maxLineCount="1">
                    <Dimensions x="270" y="21"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Slot" relativePoint="BOTTOMLEFT" offsetY="-1"/>
                </Label>

                <Label name="$(parent)Meta" font="$(BOLD_FONT)|12|soft-shadow-thick" color="B7A6FFFF" maxLineCount="1">
                    <Dimensions x="270" y="15"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Name" relativePoint="BOTTOMLEFT" offsetY="-1"/>
                </Label>

                <Backdrop name="$(parent)Dye1" centerColor="141414FF" edgeColor="000000FF" edgeSize="1" layer="OVERLAY">
                    <Dimensions x="11" y="11"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Meta" relativePoint="BOTTOMLEFT" offsetY="4"/>
                </Backdrop>
                <Label name="$(parent)DyeName1" font="$(BOLD_FONT)|11|soft-shadow-thick" color="E7E1CEFF" maxLineCount="1">
                    <Dimensions x="248" y="13"/>
                    <Anchor point="LEFT" relativeTo="$(parent)Dye1" relativePoint="RIGHT" offsetX="5"/>
                </Label>

                <Backdrop name="$(parent)Dye2" centerColor="141414FF" edgeColor="000000FF" edgeSize="1" layer="OVERLAY">
                    <Dimensions x="11" y="11"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Dye1" relativePoint="BOTTOMLEFT" offsetY="3"/>
                </Backdrop>
                <Label name="$(parent)DyeName2" font="$(BOLD_FONT)|11|soft-shadow-thick" color="E7E1CEFF" maxLineCount="1">
                    <Dimensions x="248" y="13"/>
                    <Anchor point="LEFT" relativeTo="$(parent)Dye2" relativePoint="RIGHT" offsetX="5"/>
                </Label>

                <Backdrop name="$(parent)Dye3" centerColor="141414FF" edgeColor="000000FF" edgeSize="1" layer="OVERLAY">
                    <Dimensions x="11" y="11"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Dye2" relativePoint="BOTTOMLEFT" offsetY="3"/>
                </Backdrop>
                <Label name="$(parent)DyeName3" font="$(BOLD_FONT)|11|soft-shadow-thick" color="E7E1CEFF" maxLineCount="1">
                    <Dimensions x="248" y="13"/>
                    <Anchor point="LEFT" relativeTo="$(parent)Dye3" relativePoint="RIGHT" offsetX="5"/>
                </Label>
            </Controls>
        </Control>

        <Control name="VestigeMirrorMementoRow" virtual="true" mouseEnabled="true">
            <Dimensions x="258" y="46"/>
            <Controls>
                <Backdrop name="$(parent)Backdrop" centerColor="090A0CCC" edgeColor="00000000" edgeSize="1" layer="BACKGROUND">
                    <AnchorFill/>
                </Backdrop>

                <Backdrop name="$(parent)Highlight" hidden="true" centerColor="B9A87835" edgeColor="B9A87899" edgeSize="1" layer="OVERLAY">
                    <AnchorFill/>
                </Backdrop>

                <Backdrop name="$(parent)IconFrame" centerColor="020304FF" edgeColor="6E6658AA" edgeSize="1" layer="OVERLAY">
                    <Dimensions x="36" y="36"/>
                    <Anchor point="LEFT" offsetX="6"/>
                </Backdrop>

                <Texture name="$(parent)Icon" layer="OVERLAY">
                    <Dimensions x="30" y="30"/>
                    <Anchor point="CENTER" relativeTo="$(parent)IconFrame"/>
                </Texture>

                <Label name="$(parent)Name" font="$(BOLD_FONT)|14|soft-shadow-thick" color="E8E2D5FF" verticalAlignment="CENTER" maxLineCount="1" wrapMode="ELLIPSIS">
                    <Dimensions x="204" y="40"/>
                    <Anchor point="LEFT" relativeTo="$(parent)IconFrame" relativePoint="RIGHT" offsetX="9"/>
                </Label>

                <Texture name="$(parent)Divider" textureFile="EsoUI/Art/Miscellaneous/horizontalDivider.dds" color="81745F" alpha="0.18" layer="OVERLAY">
                    <Dimensions x="248" y="2"/>
                    <Anchor point="BOTTOM"/>
                </Texture>
            </Controls>
        </Control>

        <TopLevelControl name="VestigeMirrorWindow" hidden="true" mouseEnabled="false" keyboardEnabled="true">
            <AnchorFill/>
            <OnInitialized>
                VestigeMirror_OnInitialized(self)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)TextureLayer" mouseEnabled="false" layer="BACKGROUND" level="0">
                    <AnchorFill/>
                    <Controls>
                        <Texture name="VestigeMirrorWindowTexture" hidden="true" mouseEnabled="false" layer="BACKGROUND" level="0">
                            <Dimensions x="1024" y="1024"/>
                            <Anchor point="CENTER"/>
                        </Texture>
                    </Controls>
                </Control>

                <Label name="$(parent)Title" font="$(BOLD_FONT)|28|soft-shadow-thick" color="F6F0DEFF" text="Vestige Mirror">
                    <Anchor point="TOPLEFT" offsetX="58" offsetY="44"/>
                </Label>

                <Label name="$(parent)Subtitle" font="$(BOLD_FONT)|15|soft-shadow-thick" color="CFC6A6FF">
                    <Dimensions x="360" y="28"/>
                    <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetY="3"/>
                </Label>

                <Button name="$(parent)Close" inherits="ZO_CloseButton" mouseEnabled="true">
                    <Anchor point="TOPRIGHT" offsetX="-34" offsetY="36"/>
                    <OnClicked>
                        VestigeMirror:Hide()
                    </OnClicked>
                </Button>

                <Control name="$(parent)HeadCallouts">
                    <Dimensions x="384" y="130"/>
                    <Anchor point="CENTER" offsetX="-410" offsetY="-298"/>
                </Control>

                <Control name="$(parent)LeftCallouts">
                    <Dimensions x="384" y="360"/>
                    <Anchor point="CENTER" offsetX="-570" offsetY="-40"/>
                </Control>

                <Control name="$(parent)RightCallouts">
                    <Dimensions x="384" y="360"/>
                    <Anchor point="CENTER" offsetX="570" offsetY="-40"/>
                </Control>

                <Control name="$(parent)BottomCallouts">
                    <Dimensions x="1140" y="102"/>
                    <Anchor point="CENTER" offsetY="338"/>
                </Control>

                <Control name="$(parent)Collectibles">
                    <Dimensions x="620" y="320"/>
                    <Anchor point="CENTER" offsetX="470" offsetY="-415"/>
                    <Controls>
                        <Control name="$(parent)Rows">
                            <AnchorFill/>
                        </Control>
                    </Controls>
                </Control>

            </Controls>
        </TopLevelControl>

        <TopLevelControl name="VestigeMirrorTextureMoveLayer" hidden="true" mouseEnabled="true" layer="OVERLAY" tier="MEDIUM">
            <AnchorFill/>
        </TopLevelControl>

        <TopLevelControl name="VestigeMirrorTextureBar" hidden="true" mouseEnabled="true" layer="OVERLAY" tier="HIGH">
            <Dimensions x="1445" y="26"/>
            <Anchor point="BOTTOM" offsetY="-2"/>
            <Controls>
                <Control name="$(parent)TextureNext" mouseEnabled="true">
                    <Dimensions x="250" y="24"/>
                    <Anchor point="LEFT" offsetX="10"/>
                    <Controls>
                        <Label name="$(parent)Label" font="$(BOLD_FONT)|16|soft-shadow-thick" color="F6F0DEFF" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Texture: None">
                            <AnchorFill/>
                        </Label>
                    </Controls>
                </Control>

                <Control name="$(parent)TexturePrevious" mouseEnabled="true">
                    <Dimensions x="150" y="24"/>
                    <Anchor point="LEFT" relativeTo="$(parent)TextureNext" relativePoint="RIGHT" offsetX="12"/>
                    <Controls>
                        <Label name="$(parent)Label" font="$(BOLD_FONT)|16|soft-shadow-thick" color="F6F0DEFF" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Previous Texture">
                            <AnchorFill/>
                        </Label>
                    </Controls>
                </Control>

                <Control name="$(parent)ScaleDown" mouseEnabled="true">
                    <Dimensions x="120" y="24"/>
                    <Anchor point="LEFT" relativeTo="$(parent)TexturePrevious" relativePoint="RIGHT" offsetX="12"/>
                    <Controls>
                        <Label name="$(parent)Label" font="$(BOLD_FONT)|16|soft-shadow-thick" color="F6F0DEFF" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Scale -">
                            <AnchorFill/>
                        </Label>
                    </Controls>
                </Control>

                <Control name="$(parent)ScaleUp" mouseEnabled="true">
                    <Dimensions x="120" y="24"/>
                    <Anchor point="LEFT" relativeTo="$(parent)ScaleDown" relativePoint="RIGHT" offsetX="12"/>
                    <Controls>
                        <Label name="$(parent)Label" font="$(BOLD_FONT)|16|soft-shadow-thick" color="F6F0DEFF" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Scale +">
                            <AnchorFill/>
                        </Label>
                    </Controls>
                </Control>

                <Control name="$(parent)MoveTexture" mouseEnabled="true">
                    <Dimensions x="150" y="24"/>
                    <Anchor point="LEFT" relativeTo="$(parent)ScaleUp" relativePoint="RIGHT" offsetX="12"/>
                    <Controls>
                        <Label name="$(parent)Label" font="$(BOLD_FONT)|16|soft-shadow-thick" color="F6F0DEFF" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Move Texture">
                            <AnchorFill/>
                        </Label>
                    </Controls>
                </Control>

                <Control name="$(parent)ToggleCollectibles" mouseEnabled="true">
                    <Dimensions x="170" y="24"/>
                    <Anchor point="LEFT" relativeTo="$(parent)MoveTexture" relativePoint="RIGHT" offsetX="12"/>
                    <Controls>
                        <Label name="$(parent)Label" font="$(BOLD_FONT)|16|soft-shadow-thick" color="F6F0DEFF" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Hide Collectibles">
                            <AnchorFill/>
                        </Label>
                    </Controls>
                </Control>

                <Control name="$(parent)Mementos" mouseEnabled="true">
                    <Dimensions x="180" y="24"/>
                    <Anchor point="LEFT" relativeTo="$(parent)ToggleCollectibles" relativePoint="RIGHT" offsetX="12"/>
                    <Controls>
                        <Label name="$(parent)Label" font="$(BOLD_FONT)|16|soft-shadow-thick" color="F6F0DEFF" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Play Memento">
                            <AnchorFill/>
                        </Label>
                    </Controls>
                </Control>

                <Control name="$(parent)FramePreset" mouseEnabled="true">
                    <Dimensions x="210" y="24"/>
                    <Anchor point="LEFT" relativeTo="$(parent)Mementos" relativePoint="RIGHT" offsetX="12"/>
                    <Controls>
                        <Label name="$(parent)Label" font="$(BOLD_FONT)|16|soft-shadow-thick" color="F6F0DEFF" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="Frame: Full Body">
                            <AnchorFill/>
                        </Label>
                    </Controls>
                </Control>
            </Controls>
        </TopLevelControl>

        <TopLevelControl name="VestigeMirrorMementoPicker" hidden="true" mouseEnabled="true" layer="OVERLAY" tier="HIGH" level="100">
            <Dimensions x="300" y="430"/>
            <Anchor point="BOTTOMRIGHT" offsetX="-28" offsetY="-36"/>
            <Controls>
                <Texture name="$(parent)SolidBackground1" textureFile="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="000000" alpha="1" layer="BACKGROUND" level="0">
                    <AnchorFill/>
                </Texture>

                <Texture name="$(parent)SolidBackground2" textureFile="EsoUI/Art/Tooltips/UI-TooltipCenter.dds" color="000000" alpha="1" layer="BACKGROUND" level="1">
                    <AnchorFill/>
                </Texture>

                <Backdrop name="$(parent)Backdrop" centerColor="030405FF" edgeColor="80745FCC" edgeSize="1" layer="BACKGROUND" level="2">
                    <AnchorFill/>
                </Backdrop>

                <Label name="$(parent)Title" font="$(BOLD_FONT)|16|soft-shadow-thick" color="F4EBD6FF" text="Mementos" modifyTextType="UPPERCASE">
                    <Anchor point="TOPLEFT" offsetX="15" offsetY="12"/>
                </Label>

                <Label name="$(parent)Count" font="$(BOLD_FONT)|13|soft-shadow-thick" color="AFA793FF" horizontalAlignment="RIGHT">
                    <Dimensions x="46" y="20"/>
                    <Anchor point="TOPRIGHT" offsetX="-15" offsetY="13"/>
                </Label>

                <Texture name="$(parent)HeaderDivider" textureFile="EsoUI/Art/Miscellaneous/horizontalDivider.dds" color="B3A27F" alpha="0.55">
                    <Dimensions x="270" y="4"/>
                    <Anchor point="TOP" offsetY="39"/>
                </Texture>

                <Control name="$(parent)List" inherits="ZO_ScrollList" mouseEnabled="true">
                    <Dimensions x="274" y="378"/>
                    <Anchor point="TOPLEFT" offsetX="13" offsetY="44"/>
                </Control>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
