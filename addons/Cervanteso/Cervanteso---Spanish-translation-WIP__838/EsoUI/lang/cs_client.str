[SI_GUILD_INFO_SCENE_TITLE] = "Información del clan"
[SI_GUILD_INTRODUCTION] = "¡Los clanes son una gran forma de agruparte con otros viajeros con los que te encuentres explorando Tamriel! Estos amplios y permanentes grupos permiten a los jugadores asociarse, trabajar juntos hacia un objetivo común y desbloquear ventajas adicionales como las tiendas de clan."
[SI_GUILD_INVITED_PLAYER_LOCATION] = "Invitación pendiente"
[SI_GUILD_INVITE_ACTION] = "Añadir miembro"
[SI_GUILD_INVITE_BLACKISTED_ALERT] = "<<1>> está vetado de <<2>>."
