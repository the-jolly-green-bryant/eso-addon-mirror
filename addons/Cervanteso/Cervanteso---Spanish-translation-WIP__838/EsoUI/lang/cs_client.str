[SI_GUILD_KIOSK_BANKED_GOLD_HEADER] = "Balance del banco del clan:"
[SI_GUILD_KIOSK_BIDDING_CLOSES_IN_HEADER] = "La puja cierra en:"
[SI_GUILD_KIOSK_BID_DESCRIPTION] = "Tu clan puede pujar para contratar este vendedor y así poder usarlo en el futuro. La tienda del clan ganadora estará disponible aquí durante un total de |cffffff7 días|r. El periodo de alquiler no comenzará hasta que se determine el ganador al cierre de la subasta.\n\n|cffffffNOTA:|r Puedes pujar en hastæ |cffffff<<1>>|r tiendas por clan a la semana, pero sólo podrás ganar una según sea tu puja más alta. Si hay múltiples pujas victoriosas por la misma cantidad, la última ganará. Todas las otras pujas serán reembolaadas."
[SI_GUILD_KIOSK_BID_ERROR_TRADING_HOUSE_LOCKED] = "Los clanes tienen que haber desbloqueado la tienda del clan para poder pujar por un vendedor. Este clan no tiene los |cffffff<<1>>|r miembros necesarios."
