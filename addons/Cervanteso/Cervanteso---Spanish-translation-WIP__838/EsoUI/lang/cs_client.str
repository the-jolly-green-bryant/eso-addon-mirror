[SI_GUILD_KIOSK_PURCHASE_COST] = "Coste de alquiler"
[SI_GUILD_KIOSK_PURCHASE_DESCRIPTION] = "Tu clan puede alquilar este vendedor para su uso inmediato. Una vez alquilado, tu tienda del clan estará disponible en este vendedor para el público general durante |cffffff<<1>>|r.\n\n|cffffffNOTA:|r Sólo se puede tener alquilado al mismo tiempo un vendedor por clan."
