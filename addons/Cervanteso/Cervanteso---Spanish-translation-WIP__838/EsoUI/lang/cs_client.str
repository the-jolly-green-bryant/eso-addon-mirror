[SI_INTERFACE_OPTIONS_ACT_SETTING_LABEL_TOOLTIP] = "Controla la presentación de consejos útiles de combate en la parte inferior de la pantalla. Si escoges la presentación automática, se mostrará sólo cuando sea necesario para aprender las mecánicas básicas del combate."
