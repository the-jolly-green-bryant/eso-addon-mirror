[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_PS5] = "Fidelidad: Prioriza la resolución sobre la frecuencia de cuadros.\n\nRendimiento: Prioriza la frecuencia de cuadros sobre la resolución."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSS] = "Fidelidad: Prioriza la resolución y las funcionalidades gráficas sobre la frecuencia de cuadros.\n\nRendimiento: Prioriza la frecuencia de cuadros sobre la resolución y las funcionalidades gráficas."
