[SI_DELETE_CHARACTER] = "Borrar <<1>>"
[SI_DELETE_CHARACTER_CONFIRMATION_BUTTON] = "Borrar"
[SI_DELETE_CHARACTER_CONFIRMATION_TEXT] = "BORRAR"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_CONTINUE] = "Continuar"
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TEXT] = "Puedes borrar <<1>> <<1[/personaje/personajes]>> más.\n\n|cff9633Borrar un personaje con objetos comprados en la Tienda de Coronas o adquiridos mediante códigos promocionales provocará que dichos objetos desaparezcan de la cuenta.|r\n\nSi quieres conservar todos estos objetos, visita el banco más cercano para depositarlos. \n\nLos objetos de colecciones como monturas, mascotas, indumentarias y mejoras de cuenta no se perderán.\n\nTambién se destruirán los objetos con los que esté equipado y aquellos que guarde en su inventario."
[SI_DELETE_CHARACTER_DIALOG_GAMEPAD_TITLE] = "Eliminar personaje"
[SI_DELETE_CHARACTER_DIALOG_TEXT] = "|cff0000Borrar un personaje con objetos comprados en la Tienda de Coronas o adquiridos mediante códigos promocionales provocará que dichos objetos desaparezcan de la cuenta.|r \n\nLos objetos de colecciones como monturas, mascotas, indumentarias y mejoras de cuenta no se perderán. También se destruirán los objetos con los que esté equipado y aquellos que guarde en su inventario. Si quieres conservar todos estos objetos, visita el banco más cercano para depositarlos. \n\nPuedes borrar |cFFFFFF<<4>>|r <<4[/personaje/personajes]>>. Podrás borrar más pasado un tiempo.\n\n¿Seguro que quieres eliminar æ |cFFFFFF<<1>>|r? Para confirmar, escribe |cFFFFFF<<2>>|r debajo y pulsa el botón <<3>>."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TEXT] = "No puedes borrar ningún personaje ahora mismo.\n\nLa eliminación volverá a estar disponible dentro de un tiempo. Vuelve a intentarlo más tarde."
[SI_DELETE_CHARACTER_DISABLED_GAMEPAD_TITLE] = "El personaje no puede eliminarse"
[SI_DELETE_CHARACTER_DISABLED_TOOLTIP] = "No puedes borrar ningún personaje ahora mismo.\n\nLa eliminación volverá a estar disponible dentro de un tiempo. Vuelve a intentarlo más tarde."
[SI_DELETE_CHARACTER_ENABLED_TOOLTIP] = "Puedes borrar |cFFFFFF<<1>>|r <<1[/personaje/personajes]>>.\n\nPodrás borrar más con el tiempo."
[SI_DELETE_CHARACTER_GAMEPAD_DELETING] = "Borrando"
[SI_DELETE_CHARACTER_GAMEPAD_DELETING_CHARACTER] = "Borrando personaje…"
