[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY] = "Gráficos"
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP] = "Controla la calidad de renderizado."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_PS5] = "Fidelidad: Prioriza la resolución sobre la frecuencia de cuadros.\n\nRendimiento: Prioriza la frecuencia de cuadros sobre la resolución."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSS] = "Fidelidad: Prioriza la resolución y las funcionalidades gráficas sobre la frecuencia de cuadros.\n\nRendimiento: Prioriza la frecuencia de cuadros sobre la resolución y las funcionalidades gráficas."
[SI_GRAPHICS_OPTIONS_CONSOLE_ENHANCED_RENDER_QUALITY_TOOLTIP_XBSX] = "Fidelidad: Prioriza la resolución sobre la frecuencia de cuadros.\n\nRendimiento: Prioriza la frecuencia de cuadros sobre la resolución."
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY] = "Monitor activo"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_FORMAT] = "Monitor <<1>>"
[SI_GRAPHICS_OPTIONS_VIDEO_ACTIVE_DISPLAY_TOOLTIP] = "Define el dispositivo en el cual lanzar el juego."
[SI_GRAPHICS_OPTIONS_VIDEO_AMBIENT_OCCLUSION_TYPE] = "Oclusión ambiental"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING] = "Suavizado de líneas"
[SI_GRAPHICS_OPTIONS_VIDEO_ANTI_ALIASING_TOOLTIP] = "Suaviza los bordes de los objetos del mundo. Su desactivación mejorará el rendimiento a costa de mostrar bordes menos lisos en los objetos."
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM] = "Resplandor"
[SI_GRAPHICS_OPTIONS_VIDEO_BLOOM_TOOLTIP] = "Aumenta la intensidad del brillo que rodea las fuentes de luz. Su desactivación mejorará el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_ABILITY] = "Habilidad"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_DISPLAY] = "Vídeo"
[SI_GRAPHICS_OPTIONS_VIDEO_CATEGORY_GRAPHICS] = "Gráficos"
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY] = "Hierba"
[SI_GRAPHICS_OPTIONS_VIDEO_CLUTTER_2D_QUALITY_TOOLTIP] = "Determina la cantidad de hierba y otros elementos del suelo en el mundo. Los ajustes más altos aumentan la distancia a la que se visualiza la hierba. Disminuir esta configuración puede aumentar el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE] = "Profundidad de campo"
[SI_GRAPHICS_OPTIONS_VIDEO_DEPTH_OF_FIELD_MODE_TOOLTIP] = "Determina la apariencia de la profundidad de campo, simulando el efecto fotográfico de hacer que los objetos distantes se vean borrosos, en función de su distancia a los objetos en primer plano."
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE] = "Modo de vídeo"
[SI_GRAPHICS_OPTIONS_VIDEO_DISPLAY_MODE_TOOLTIP] = "Fija el modo de vídeo del juego."
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION] = "Distorsión"
[SI_GRAPHICS_OPTIONS_VIDEO_DISTORTION_TOOLTIP] = "Hace que ciertos objetos del mundo provoquen efectos de distorsión a su alrededor. Su desactivación mejorará el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE] = "DLSS Mode"
[SI_GRAPHICS_OPTIONS_VIDEO_DLSS_MODE_TOOLTIP] = "Controls the balance between quality and performance improvement when NVIDIA DLSS is enabled."
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT] = "Ajuste del brillo"
[SI_GRAPHICS_OPTIONS_VIDEO_GAMMA_ADJUSTMENT_TOOLTIP] = "Ajusta el brillo total del juego sin ningún impacto en el rendimiento. Cambia este parámetro si el juego parece demasiado claro o demasiado oscuro."
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS] = "Rayos de luz"
[SI_GRAPHICS_OPTIONS_VIDEO_GOD_RAYS_TOOLTIP] = "Hace que el sol muestre rayos de luz dependiendo de su ángulo respecto a la cámara. Su desactivación mejorará el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_BRIGHTNESS] = "Brillo HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_BRIGHTNESS_TOOLTIP] = "Ajusta brillo de HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE] = "Modo HDR"
[SI_GRAPHICS_OPTIONS_VIDEO_HDR_MODE_TOOLTIP] = "Define el modo HDR."
[SI_GRAPHICS_OPTIONS_VIDEO_MAC_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Mejora la fidelidad de las sobras y la iluminación tomando en cuenta los objetos que bloquean la luz. HBAO consume más recursos que SSAO, pero otorga un resultado más realista. Desactivar esta opción puede mejorar el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS] = "Sistemas de partículas"
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_RESTRICTION] = "Esta opción sólo tendrá efecto cuando te desconectes o cambies de ubicación."
[SI_GRAPHICS_OPTIONS_VIDEO_MAXIMUM_PARTICLE_SYSTEMS_TOOLTIP] = "Determina el número total de sistemas de partículas que se muestran simultáneamente en un momento dado. Disminuir este número reducirá el número de partículas mostradas, pero puede mejorar el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE] = "Supresión de partículas"
[SI_GRAPHICS_OPTIONS_VIDEO_PARTICLE_SUPPRESSION_DISTANCE_TOOLTIP] = "Ajusta la distancia a la cual las partículas intrascendentes ya no son visibles. Aumentarla mostrará un mayor número de este tipo de partículas a costa del rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY] = "Calidad de reflejos planos"
[SI_GRAPHICS_OPTIONS_VIDEO_PLANAR_WATER_REFLECTION_QUALITY_TOOLTIP] = "Determina la resolución y el detalle de los reflejos planos que se muestran en la superficie del agua. Los reflejos planos son de alta calidad, pero pueden reducir el rendimiento cuando están habilitados. El agua que no puede utilizar reflejos planos utilizará reflejos de espacio de pantalla."
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS] = "Calidad gráfica"
[SI_GRAPHICS_OPTIONS_VIDEO_PRESETS_TOOLTIP] = "Fija la calidad general de los gráficos del juego, ajustando todas las opciones avanzadas situadas debajo."
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD] = "Renderizado multihilo"
[SI_GRAPHICS_OPTIONS_VIDEO_RENDER_THREAD_TOOLTIP] = "Activa un hilo separado para el proceso de renderización, lo cual puede mejorar el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION] = "Resolución"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT] = "<<1>>x<<2>>"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_FORMAT_WIDE] = "<<1>>x<<2>> (ancho)"
[SI_GRAPHICS_OPTIONS_VIDEO_RESOLUTION_TOOLTIP] = "Especifica la resolución general a la que se ejecuta el juego. Aumentar la resolución proporcionará una mayor fidelidad de imagen a costa de un menor rendimiento. La resolución seleccionada debería coincidir con la de tu monitor."
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY] = "Calidad de reflejos en pantalla"
[SI_GRAPHICS_OPTIONS_VIDEO_SCREENSPACE_WATER_REFLECTION_QUALITY_TOOLTIP] = "Determina la calidad de los reflejos del espacio de la pantalla que se muestran en la superficie del agua. El aumento de este parámetro mejora la precisión de la reflexión, pero puede disminuir el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS] = "Calidad de las sombras"
[SI_GRAPHICS_OPTIONS_VIDEO_SHADOWS_TOOLTIP] = "Determina la calidad de las sombras en el mundo. Unos ajustes altos incrementan la distancia de dibujado de las sombras, su nitidez y el número de objetos que las proyectan. Reducir la calidad puede mejorar el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS] = "Mostrar efectos adicionales aliados"
[SI_GRAPHICS_OPTIONS_VIDEO_SHOW_ADDITIONAL_ALLY_EFFECTS_TOOLTIP] = "Muestra todas las habilidades ofensivas aliadas persistentes cuando se encuentran en zonas de mazmorras y zonas abiertas. Deshabilitar esto puede aumentar el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING] = "Calidad de muestreo"
[SI_GRAPHICS_OPTIONS_VIDEO_SUB_SAMPLING_TOOLTIP] = "Determina la resolución a la que se dibujará el juego en el mundo. La interfaz no se ve afectada por esta opción. Reducirla puede aumentar el rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES] = "Calidad de las texturas"
[SI_GRAPHICS_OPTIONS_VIDEO_TEXTURE_RES_TOOLTIP] = "Controla la calidad de las texturas usadas en el mundo cambiando su tamaño. Unos ajustes altos darán más detalle a los objetos, a los modelos de los personajes y al ambiente, pero requieren más memoria de vídeo para funcionar con fluidez."
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE] = "Distancia de visión"
[SI_GRAPHICS_OPTIONS_VIDEO_VIEW_DISTANCE_TOOLTIP] = "Ajusta la distancia a la que ciertos objetos en el mundo dejarán de ser visibles. Aumentarla proporcionará un ambiente más rico y realista a costa del rendimiento."
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC] = "Sincronización vertical"
[SI_GRAPHICS_OPTIONS_VIDEO_VSYNC_TOOLTIP] = "Ayuda a eliminar cortes al sincronizar la frecuencia de imagen con la frecuencia de refresco de tu monitor."
[SI_GRAPHICS_OPTIONS_VIDEO_WINDOWS_AMBIENT_OCCLUSION_TYPE_TOOLTIP] = "Mejora la fidelidad de las sombras y la iluminación tomando en cuenta los objetos que bloquean la luz. LSAO es más realista y consume más recursos que HBAO, el cual es más realista y consume más recursos que SSAO. SSGI mejora sobre LSAO tomando en cuenta la refracción de la luz adicional. Desactivar esta opción puede mejorar el rendimiento."
