<GuiXml>
	<Controls>
		<Label name="ItemBrowserRowLabel" font="ZoFontGame" wrapMode="ELLIPSIS" horizontalAlignment="LEFT" verticalAlignment="CENTER" virtual="true" />
		<Label name="ItemBrowserSearchLabel" font="ZoFontGameLargeBold" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" virtual="true" />
		<Control name="RarityDropdown" inherits="ZO_ComboBox" virtual="true">
			<Dimensions x="200" />
			<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetY="5" />
		</Control>
		<Label name="SpecificItemButton" font="ZoFontGameBold" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" wrapMode="ELLIPSIS" verticalAlignment="CENTER" mouseEnabled="true" virtual="true">
			<OnMouseEnter>
				SetJunker.highlightSpecificButton(self)
			</OnMouseEnter>
			<OnMouseExit>
				SetJunker.unHighlightSpecificButton(self)
			</OnMouseExit>
			<OnMouseDown>
				SetJunker.toggleJunkSpecificItem(self)
			</OnMouseDown>
		</Label>
		<Control name="ItemBrowserRow" mouseEnabled="true" virtual="true">
			<Dimensions y="30" />
			<OnMouseEnter>
				ItemBrowserRow_OnMouseEnter(self)
			</OnMouseEnter>
			<OnMouseExit>
				ItemBrowserRow_OnMouseExit(self)
			</OnMouseExit>
			<OnMouseUp>
				ItemBrowserRow_OnMouseUp(self)
			</OnMouseUp>
			<Controls>
				<Texture name="$(parent)BG" inherits="ZO_ThinListBgStrip" />
				<Label name="$(parent)Junk" inherits="ItemBrowserRowLabel" mouseEnabled="true">
					<Anchor point="LEFT" />
					<Dimensions x="40" y="30" />
					<OnMouseDown>
						SetJunker.toggleJunkSet(self)
					</OnMouseDown>
					<OnMouseEnter>
						SetJunker.highlightSpecificButton(self)
					</OnMouseEnter>
					<OnMouseExit>
						SetJunker.unHighlightSpecificButton(self)
						SetJunker.unHighlightTheRow(self)
					</OnMouseExit>
				</Label>
				<Label name="$(parent)Name" inherits="ItemBrowserRowLabel">
					<Anchor point="LEFT"  relativePoint="RIGHT" relativeTo="$(parent)Junk" />
					<Dimensions x="300" y="30" />
				</Label>
				<Label name="$(parent)Type" inherits="ItemBrowserRowLabel">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Name" />
					<Dimensions x="120" y="30" />
				</Label>
				<Label name="$(parent)Source" inherits="ItemBrowserRowLabel">
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Type" />
					<Anchor point="RIGHT" relativePoint="RIGHT" relativeTo="$(parent)" offsetX="-16" />
					<Dimensions y="30" />
				</Label>
			</Controls>
		</Control>

		<TopLevelControl name="ItemBrowserFrame" inherits="ZO_RightPanelFootPrint" hidden="true">
			<Controls>
				<Control name="$(parent)FilterDrop" inherits="ZO_ComboBox">
					<Dimensions x="200" />
					<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" offsetX="-38" offsetY="14" />
				</Control>

				<Backdrop name="$(parent)Search" tier="HIGH" inherits="ZO_SingleLineEditBackdrop_Keyboard">
					<Anchor point="RIGHT" relativeTo="$(parent)FilterDrop" relativePoint="LEFT" offsetX="-12" offsetY="-1" />
					<Dimensions x="250" />
					<Controls>
						<EditBox name="$(parent)Box" inherits="ZO_DefaultEditForBackdrop ZO_EditDefaultText" />
					</Controls>
				</Backdrop>

				<Control name="$(parent)SearchDrop" resizeToFitDescendents="true" mouseEnabled="true">
					<Anchor point="RIGHT" relativePoint="LEFT" relativeTo="$(parent)Search" />
					<OnInitialized>
						ZO_ComboBox:New(self)
					</OnInitialized>
					<OnMouseUp>
						if (button == MOUSE_BUTTON_INDEX_LEFT and upInside) then
							ZO_ComboBox_DropdownClicked(self)
						end
					</OnMouseUp>
					<Controls>
						<Label name="$(parent)Anchor" inherits="ItemBrowserSearchLabel">
							<Anchor point="RIGHT" />
						</Label>
						<Label name="$(parent)ColonText" text=":" inherits="ItemBrowserSearchLabel">
							<Anchor point="RIGHT" relativeTo="$(parent)Anchor" relativePoint="LEFT" offsetX="-8" />
						</Label>
						<Label name="$(parent)SelectedItemText" inherits="ItemBrowserSearchLabel">
							<Anchor point="RIGHT" relativeTo="$(parent)ColonText" relativePoint="LEFT" offsetX="-1" />
						</Label>
						<Button name="$(parent)OpenDropdown" inherits="ZO_DropdownButton">
							<Dimensions x="16" y="16" />
							<Anchor point="RIGHT" relativeTo="$(parent)SelectedItemText" relativePoint="LEFT" offsetX="-3" />
							<OnClicked>
								ZO_ComboBox_DropdownClicked(self:GetParent())
							</OnClicked>
						</Button>
					</Controls>
				</Control>

				<Control name="$(parent)Headers">
					<Anchor point="TOPLEFT" offsetX="30" offsetY="51" />
					<Anchor point="TOPRIGHT" offsetY="51" />
					<Dimensions y="32" />
					<Controls>
						<Control name="$(parent)JKS" inherits="ZO_SortHeader">
							<OnInitialized>
								ZO_SortHeader_Initialize(self, GetString(SI_ITEMBROWSER_HEADER_JUNK), "junk", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
							</OnInitialized>
							<Anchor point="TOPLEFT" />
							<Dimensions x="40" y="32" />
						</Control>
						<Control name="$(parent)Name" inherits="ZO_SortHeader">
							<OnInitialized>
								ZO_SortHeader_Initialize(self, GetString(SI_ITEMBROWSER_HEADER_NAME), "name", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
							</OnInitialized>
							<Anchor point="TOPLEFT"  relativePoint="TOPRIGHT" relativeTo="$(parent)JKS" />
							<Dimensions x="300" y="32" />
						</Control>
						<Control name="$(parent)Type" inherits="ZO_SortHeader">
							<OnInitialized>
								ZO_SortHeader_Initialize(self, GetString(SI_ITEMBROWSER_HEADER_TYPE), "itemType", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Name" />
							<Dimensions x="120" y="32" />
						</Control>
						<Control name="$(parent)Source" inherits="ZO_SortHeader">
							<OnInitialized>
								ZO_SortHeader_Initialize(self, GetString(SI_ITEMBROWSER_HEADER_SOURCE), "source", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT, "ZoFontGameLargeBold")
							</OnInitialized>
							<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" relativeTo="$(parent)Type" />
							<Dimensions y="32" />
						</Control>
					</Controls>
				</Control>

				<Control name="$(parent)List" inherits="ZO_ScrollList">
					<Anchor point="TOPLEFT" relativeTo="$(parent)Headers" relativePoint="BOTTOMLEFT" offsetY="3" />
					<Anchor point="BOTTOMRIGHT" offsetX="-35" offsetY="-32" />
				</Control>

				<Label name="$(parent)Counter" font="ZoFontGameSmall" horizontalAlignment="RIGHT" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_DISABLED">
					<Anchor point="TOPRIGHT" relativeTo="$(parent)List" relativePoint="BOTTOMRIGHT" offsetY="6" />
				</Label>
			</Controls>
		</TopLevelControl>
		<TopLevelControl name="ItemBrowserTooltipTopLevel" inherits="TooltipTopLevel">
			<Controls>
				<Tooltip name="ItemBrowserTooltip" inherits="ZO_ItemIconTooltip" />
			</Controls>
		</TopLevelControl>
		<!--	TODO: Translate those below	-->
		<TopLevelControl name="SetDetailedOptions" inherits="ZO_LeftPanelBG" hidden="true">
			<Controls>
				<Control name="$(parent)Main">
					<Anchor point="TOPLEFT" relativeTo="$(parent)" />
					<Controls>
						<Label name="$(parent)Title" font="ZoFontWindowTitle" wrapMode="ELLIPSIS" verticalAlignment="CENTER" text="DETAILED OPTIONS">
							<Anchor point="TOPLEFT" offsetX="20" />
						</Label>
						<Texture name="$(parent)DividerMain" inherits="ZO_DialogDivider">
							<Anchor relativePoint="BOTTOMLEFT" point="CENTER" relativeTo="$(parent)Title" offsetX="260" offsetY="5" />
							<Dimensions x="750" />
						</Texture>
					</Controls>
				</Control>
				<Control name="$(parent)JunkDuplicates">
					<Anchor point="TOPLEFT" relativeTo="$(parent)Main" relativePoint="BOTTOMLEFT" offsetY="40" />
					<Dimensions y="100" />
					<Controls>
						<Label name="$(parent)Enable" font="ZoFontGameMedium" wrapMode="ELLIPSIS" verticalAlignment="CENTER" text="Junk duplicate items (with trait priority):">
							<Anchor point="TOPLEFT" relativeTo="$(parent)" offsetY="10" offsetX="20" />
						</Label>
						<Label name="$(parent)JunkDuplicatesButton" font="ZoFontGameBold" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" wrapMode="ELLIPSIS" verticalAlignment="CENTER" mouseEnabled="true" text="OFF">
							<Anchor point="TOPLEFT" relativeTo="$(parent)Enable" relativePoint="TOPRIGHT" offsetX="20" />
							<OnMouseEnter>
								SetJunker.highlightSpecificButton(self)
							</OnMouseEnter>
							<OnMouseExit>
								SetJunker.unHighlightSpecificButton(self)
							</OnMouseExit>
							<OnMouseDown>
								SetJunker.toggleJunkDuplicates()
							</OnMouseDown>
						</Label>
						<Control name="$(parent)Traits">
							<Anchor point="TOPLEFT" relativeTo="$(parent)" offsetX="20" offsetY="40" />
							<Dimensions x="520" />
