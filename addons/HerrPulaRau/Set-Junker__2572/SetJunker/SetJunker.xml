							<Anchor relativePoint="BOTTOMLEFT" point="CENTER" relativeTo="$(parent)" offsetX="260" />
							<Dimensions x="750" />
						</Texture>
					</Controls>
				</Control>
				<Control name="$(parent)Keep">
					<Anchor point="TOPLEFT" relativeTo="$(parent)JunkDuplicates" relativePoint="BOTTOMLEFT" />
					<Dimensions y="200" />
					<Controls>
