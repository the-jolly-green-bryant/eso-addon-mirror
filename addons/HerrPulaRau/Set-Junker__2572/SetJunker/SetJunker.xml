								<Label name="SetJunkerJunkIntricatesButton" font="ZoFontGameBold" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL" wrapMode="ELLIPSIS" verticalAlignment="CENTER" mouseEnabled="true" text="OFF">
									<Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOPRIGHT" offsetX="-173" offsetY="8" />
									<OnMouseEnter>
										SetJunker.highlightSpecificButton(self)
									</OnMouseEnter>
									<OnMouseExit>
										SetJunker.unHighlightSpecificButton(self)
									</OnMouseExit>
									<OnMouseDown>
											SetJunker.toggleJunkIntricates()
									</OnMouseDown>
								</Label>
							</Controls>
						</Control>
						<Texture name="$(parent)DividerKeep" inherits="ZO_DialogDivider">
							<Anchor relativePoint="BOTTOMLEFT" point="CENTER" relativeTo="$(parent)" offsetX="260" />
							<Dimensions x="750" />
						</Texture>
					</Controls>
				</Control>
				<Control name="$(parent)DetailedSetOptions" hidden="true">
					<Anchor point="TOPLEFT" relativeTo="$(parent)Keep" relativePoint="BOTTOMLEFT" offsetY="20" />

					<Controls>
						<Label name="$(parent)DetailedSetOptions" font="ZoFontWindowSubtitle" wrapMode="ELLIPSIS" verticalAlignment="CENTER" text=" ">
