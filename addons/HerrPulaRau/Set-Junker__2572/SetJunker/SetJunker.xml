							</Controls>
						</Control>
						<Control name="$(parent)NeverJunkIntricates">
							<Anchor point="TOPLEFT" relativeTo="$(parent)NeverJunkGlyphs" relativePoint="BOTTOMLEFT" offsetY="40" />
							<Dimensions x="520" />
							<Controls>
								<Label font="ZoFontGameSmall" wrapMode="ELLIPSIS" verticalAlignment="CENTER" text="Never junk intricate items:">
									<Anchor point="TOPLEFT" relativeTo="$(parent)" offsetY="10" />
