									<Anchor point="TOPLEFT" relativeTo="$(parent)L2.1" relativePoint="BOTTOMLEFT" offsetY="15" />
								</Label>
								<Label name="$(parent)L3.1B" inherits="SpecificItemButton" text="ON">
