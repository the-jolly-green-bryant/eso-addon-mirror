<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://sir.insidi.at/or/schema/esoui.xsd">
  <Controls>

    <TopLevelControl name="LRSALeft">
      <Dimensions x="64" y="64" />
      <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="TOPLEFT" offsetX="600"
        offsetY="300" />

      <Controls>
        <Label name="$(parent)Label"   font="ZoFontEdit" inheritAlpha="true"
          color="FFFFFF"
          wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="LEFT">
          <Anchor point="TOPLEFT" relativeTo="$(parent)" relativePoint="TOP" />
        </Label>
      </Controls>
    </TopLevelControl>

    <TopLevelControl name="LRSARight">
      <Dimensions x="64" y="64" />
      <Anchor point="TOPRIGHT" relativeTo="GuiRoot" relativePoint="TOPRIGHT" offsetX="-600"
        offsetY="300" />

      <Controls>
        <Label name="$(parent)Label"   font="ZoFontEdit" inheritAlpha="true"
          color="FFFFFF"
          wrapMode="TRUNCATE" verticalAlignment="TOP" horizontalAlignment="RIGHT">
          <Anchor point="TOPRIGHT" relativeTo="$(parent)" relativePoint="TOP" />
        </Label>
      </Controls>
    </TopLevelControl>

  </Controls>
</GuiXml>