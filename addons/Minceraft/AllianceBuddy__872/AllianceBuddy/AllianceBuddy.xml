<GuiXml> 
   <Controls>
   <TopLevelControl name="AllianceBuddyUI" clampedToScreen="true" mouseEnabled="true" movable="true" hidden="false">	
      <Dimensions x="400" y="100" />
      <Anchor point="TOPLEFT" relativeTo="GuiRoot" relativePoint="CENTER" offsetX="0" offsetY="0"/>

	  <OnMoveStop>
	  AllianceBuddy.SaveLocation()
	  </OnMoveStop>

      <Controls>
		<Backdrop name="$(parent)Backdrop" edgeColor="00000000" layer="0" level="0" centerColor="6495ED" alpha="0"  offsetX="-25" offsetY="0" hidden="false">
			<Dimensions x="400" y="100" />
			<Anchor point="CENTER"  relativeTo="$(parent)" relativePoint="CENTER"/>
			<Edge edgeSize="0" />
		</Backdrop>
 
				<StatusBar name = "$(parent)StatusBar" textureFile="esoui\art\miscellaneous\progressbar_genericfill.dds" mouseEnabled= "false" movable="false" layer = "1" level = "3" color = "" >
					<Dimensions x="304" y="28" />
					<Anchor point="CENTER" relativeTo="$(parent)" offsetX="0" offsetY="6"/>
					<LeadingEdge textureFile = "esoui\art\miscellaneous\progressbar_genericfill_leadingedge.dds" level = "2" width="6" height="28" />
					<Limits min="0" max="100" />
				</StatusBar>
			
				<Texture name= "$(parent)FrameBG2" mouseEnabled= "false"  layer ="1" level="7" movable="false" alpha = "1" color = "" textureFile="esoui/art/miscellaneous/progressbar_frame.dds">
					<Dimensions x="496" y="32"/>
					<Anchor point= "TOPLEFT" relativeTo= "$(parent)StatusBar" offsetX= "0" offsetY ="-1"/>
				</Texture>
				<Texture name= "$(parent)FrameBG" mouseEnabled= "false"  layer ="0" level="5" movable="false" alpha = "1" color = "" textureFile="esoui/art/miscellaneous/progressbar_frame_bg.dds">
					<Dimensions x="496" y="32"/>
					<Anchor point= "TOPLEFT" relativeTo= "$(parent)FrameBG2" offsetX= "0" offsetY ="0"/>
				</Texture>

         <Backdrop name="$(parent)Border" edgeColor="FF0000" layer="0" level="2" centerColor="00000000" alpha="0" hidden="false" >
            <Dimensions x="300" y="50" />
            <Anchor point="TOPLEFT"  relativeTo="$(parent)" relativePoint="TOPLEFT"/>
            <Edge edgeSize="6" />
         </Backdrop>

				<Texture name= "$(parent)AllianceFlag" movable="false"  color="" mouseEnabled = "true" hidden = "false" layer ="0" level="3" alpha="1" textureFile= "" verticalAlignment="CENTER">
					<Dimensions x="64" y="64"/>
					<Anchor point= "CENTER" relativeTo= "$(parent)StatusBar" relativePoint="LEFT" offsetX= "-65" offsetY ="-10"/>
					<!-- <OnInitialized>
                  GetAllianceFlag()  
                 </OnInitialized> -->
				</Texture>
            <Label name="$(parent)AllianceRankDisplay" font="$(BOLD_FONT)|20|soft-shadow-thin"  alpha="1"  color="" wrapMode="ELLIPSIS" horizontalAlignment="LEFT" verticalAlignment="CENTER" text="Rank/Title Goes Here">
					<Anchor  point= "LEFT"  relativeTo = "$(parent)StatusBar" relativePoint = "TOPLEFT" offsetX="2" offsetY="-11"/>
				</Label>
				<Texture name= "$(parent)RankIconDisplay"   hidden = "false" color ="FFFFFF" layer ="0" level="4" alpha="1" movable="false" mouseEnabled = "false" textureFile="" >
					<Dimensions x="40" y="40"/>
					<Anchor point= "CENTER" relativeTo= "$(parent)AllianceFlag" relativePoint="RIGHTCENTER" offsetX= "44" offsetY ="-13"/>
				</Texture>
<!-- 				<Texture name= "$(parent)nextRankIconDisplay"   hidden = "false" color ="FFFFFF" layer ="0" level="4" alpha="1" movable="false" mouseEnabled = "false" textureFile="" >
					<Dimensions x="40" y="40"/>
					<Anchor point= "CENTER" relativeTo= "$(parent)RankIconDisplay" relativePoint="RIGHT" offsetX= "315" offsetY ="0"/>
				</Texture> -->
				<Label name="$(parent)AllianceLevelDisplay"  font="$(BOLD_FONT)|30|soft-shadow-thick"    color="FFFFFF" alpha="1" wrapMode="ELLIPSIS" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="0">
					<Dimensions x="30" y="30"/>
					<Anchor  point= "CENTER"  relativeTo = "$(parent)AllianceFlag" relativePoint = "RIGHTCENTER" offsetX="44" offsetY="15"/>
				</Label>
				<!-- <Label name="$(parent)AllianceLevelDisplayBG"  font="$(BOLD_FONT)|33|soft-shadow-thin"   layer="0" color="19070B" alpha="1" wrapMode="ELLIPSIS" horizontalAlignment="CENTER" verticalAlignment="CENTER" text="49">
					<Dimensions x="30" y="30"/>
					<Anchor  point= "CENTER"  relativeTo = "$(parent)AllianceFlag" relativePoint = "RIGHTCENTER" offsetX="44" offsetY="15"/>
				</Label> -->
				<Label name="$(parent)AlliancePointsDisplay" font="$(BOLD_FONT)|16|soft-shadow-thin"  alpha="1" level="4" color="" wrapMode="ELLIPSIS" horizontalAlignment="LEFT" verticalAlignment="CENTER" text="000/000">
					<Anchor  point= "LEFT"  relativeTo = "$(parent)StatusBar" relativePoint = "LEFT" offsetX="2" offsetY="13"/>
				</Label>
				<StatusBar name = "$(parent)GOStatusBar" textureFile="esoui\art\miscellaneous\progressbar_genericfill.dds" mouseEnabled= "false" movable="false" hidden = "true" layer = "1" level = "3" color = "" alpha = "0.25" >
					<Dimensions x="304" y="28" />
					<Anchor point="CENTER" relativeTo="$(parent)StatusBar" offsetX="0" offsetY="0"/>
					<LeadingEdge textureFile = "esoui\art\miscellaneous\progressbar_genericfill_leadingedge.dds" level = "1" width="6" height="28" />
					<Limits min="0" max="100" />
				</StatusBar>
				<StatusBar name = "$(parent)StatusBarGloss" textureFile="esoui\art\miscellaneous\progressbar_genericfill_gloss.dds" mouseEnabled= "false" movable="false" layer = "1" level = "4" color = "" alpha = "1" >
					<Dimensions x="301" y="28" />
					<Anchor point="CENTER" relativeTo="$(parent)StatusBar" offsetX="0" offsetY="-1"/>
					<LeadingEdge textureFile = "esoui\art\miscellaneous\progressbar_genericfill_leadingedge_gloss.dds" level = "1" width="6" height="28" />
					<Limits min="0" max="100" />
				</StatusBar>
				<Texture name= "$(parent)LowPop" mouseEnabled= "false"  layer ="3" level="5" movable="false" alpha = "0" color = "FFFFFF" textureFile="/esoui/art/ava/overview_icon_underdog_population.dds">
					<Dimensions x="26" y="26"/>
					<Anchor point= "RIGHT" relativeTo= "$(parent)AlliancePointsDisplay" offsetX= "25" offsetY ="-2"/>
				</Texture>
<!-- 				<Texture name= "$(parent)LowScore" mouseEnabled= "false"  layer ="3" level="5" movable="false" alpha = "0" color = "FFFFFF" textureFile="/esoui/art/ava/overview_icon_underdog_score.dds">
					<Dimensions x="32" y="32"/>
					<Anchor point= "TOPLEFT" relativeTo= "$(parent)StatusBar" offsetX= "20" offsetY ="-30"/>
				</Texture> -->

         <Label name="$(parent)Label" font="ZoFontWinH1" color="ffffff" text="Status Bar" verticalAlignment="CENTER" horizontalAlignment="LEFT"  alpha="0">			
            <Dimensions x="350" y="50" />
            <Anchor point="BOTTOMLEFT"  relativeTo="$(parent)StatusBar" relativePoint="TOPLEFT" offsetX="0" offsetY="0"/>
         </Label>
      </Controls>
   </TopLevelControl>
   </Controls>
</GuiXml>