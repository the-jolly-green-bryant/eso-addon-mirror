<GuiXml>
    <Controls>
		<TopLevelControl name="NotesWindow" movable="true" mouseEnabled="true" hidden="true">
			<Anchor point="LEFT" relativeTo="GuiRoot" offsetX="500" offsetY="0"/>
			<Dimensions x="500" y="650"/>
			
            <OnInitialized>
                NotesWindow_OnInitialised(self)
			</OnInitialized>
				
				<Controls>
				
					<Backdrop name="$(parent)BG" inherits="ZO_DefaultBackdrop">
						<AnchorFill/>
					</Backdrop>
					
					<Label name="$(parent)Title" font="ZoFontWindowTitle" text="NOTES">
						<Anchor point="TOPLEFT" offsetX="9" offsetY="7"/>
					</Label>
				
					<Button name="$(parent)CloseButton" inherits="ZO_CloseButton">
						<Anchor point="TOPRIGHT" offsetX="-7" offsetY="5"/>
						<Dimensions x="18" y="20"/>
                        <OnClicked>
                            NotesWindowCloseButton_OnClicked(self)
						</OnClicked>
                    </Button>

                    <Label name="$(parent)Body1ChannelLabel" font="ZoFontWinH4" text="Channel for Note 1:" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Title" relativePoint="BOTTOMLEFT" offsetY="12"/>
                    </Label>
                    <Control name="$(parent)Body1Channel" inherits="ZO_ComboBox">
                            <Anchor point="LEFT" relativeTo="$(parent)Body1ChannelLabel" relativePoint="BOTTOMLEFT" offsetX="150" offsetY="-10"/>
                            <Dimensions x="180" y="28"/>
                    </Control>

                    <Backdrop name="$(parent)Body1" inherits="ZO_EditBackdrop">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Body1ChannelLabel" relativePoint="BOTTOMLEFT" offsetY="8"/>
                        <Dimensions y="75" x="480"/>
                        <Controls>
                            <EditBox name="$(parent)Field" inherits="ZO_DefaultEditMultiLineForBackdrop" font="ZoFontGameBold">
                                <OnTextChanged>
                                    NotesWindowBody1_OnTextChanged(self)
                                </OnTextChanged>
                            </EditBox>
                        </Controls>
                    </Backdrop>

                    <Label name="$(parent)Body2ChannelLabel" font="ZoFontWinH4" text="Channel for Note 2:" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Body1" relativePoint="BOTTOMLEFT" offsetY="12"/>
                    </Label>
                    <Control name="$(parent)Body2Channel" inherits="ZO_ComboBox">
                            <Anchor point="LEFT" relativeTo="$(parent)Body2ChannelLabel" relativePoint="BOTTOMLEFT" offsetX="150" offsetY="-10"/>
                            <Dimensions x="180" y="28"/>
                    </Control>

                    <Backdrop name="$(parent)Body2" inherits="ZO_EditBackdrop">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Body2ChannelLabel" relativePoint="BOTTOMLEFT" offsetY="8"/>
                        <Dimensions y="75" x="480"/>
                        <Controls>
                            <EditBox name="$(parent)Field" inherits="ZO_DefaultEditMultiLineForBackdrop" font="ZoFontGameBold">
                                <OnTextChanged>
                                    NotesWindowBody2_OnTextChanged(self)
                                </OnTextChanged>
                            </EditBox>
                        </Controls>
                    </Backdrop>

                    <Label name="$(parent)Body3ChannelLabel" font="ZoFontWinH4" text="Channel for Note 3:" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Body2" relativePoint="BOTTOMLEFT" offsetY="12"/>
                    </Label>
                    <Control name="$(parent)Body3Channel" inherits="ZO_ComboBox">
                            <Anchor point="LEFT" relativeTo="$(parent)Body3ChannelLabel" relativePoint="BOTTOMLEFT" offsetX="150" offsetY="-10"/>
                            <Dimensions x="180" y="28"/>
                    </Control>

                    <Backdrop name="$(parent)Body3" inherits="ZO_EditBackdrop">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Body3ChannelLabel" relativePoint="BOTTOMLEFT" offsetY="8"/>
                        <Dimensions y="75" x="480"/>
                        <Controls>
                            <EditBox name="$(parent)Field" inherits="ZO_DefaultEditMultiLineForBackdrop" font="ZoFontGameBold">
                                <OnTextChanged>
                                    NotesWindowBody3_OnTextChanged(self)
                                </OnTextChanged>
                            </EditBox>
                        </Controls>
                    </Backdrop>

                    <Label name="$(parent)Body4ChannelLabel" font="ZoFontWinH4" text="Channel for Note 4:" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Body3" relativePoint="BOTTOMLEFT" offsetY="12"/>
                    </Label>
                    <Control name="$(parent)Body4Channel" inherits="ZO_ComboBox">
                            <Anchor point="LEFT" relativeTo="$(parent)Body4ChannelLabel" relativePoint="BOTTOMLEFT" offsetX="150" offsetY="-10"/>
                            <Dimensions x="180" y="28"/>
                    </Control>

                    <Backdrop name="$(parent)Body4" inherits="ZO_EditBackdrop">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Body4ChannelLabel" relativePoint="BOTTOMLEFT" offsetY="8"/>
                        <Dimensions y="75" x="480"/>
                        <Controls>
                            <EditBox name="$(parent)Field" inherits="ZO_DefaultEditMultiLineForBackdrop" font="ZoFontGameBold">
                                <OnTextChanged>
                                    NotesWindowBody4_OnTextChanged(self)
                                </OnTextChanged>
                            </EditBox>
                        </Controls>
                    </Backdrop>

                    <Label name="$(parent)Body5ChannelLabel" font="ZoFontWinH4" text="Channel for Note 5:" color="INTERFACE_COLOR_TYPE_TEXT_COLORS:INTERFACE_TEXT_COLOR_NORMAL">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Body4" relativePoint="BOTTOMLEFT" offsetY="12"/>
                    </Label>
                    <Control name="$(parent)Body5Channel" inherits="ZO_ComboBox">
                            <Anchor point="LEFT" relativeTo="$(parent)Body5ChannelLabel" relativePoint="BOTTOMLEFT" offsetX="150" offsetY="-10"/>
                            <Dimensions x="180" y="28"/>
                    </Control>

                    <Backdrop name="$(parent)Body5" inherits="ZO_EditBackdrop">
                        <Anchor point="TOPLEFT" relativeTo="$(parent)Body5ChannelLabel" relativePoint="BOTTOMLEFT" offsetY="8"/>
                        <Dimensions y="75" x="480"/>
                        <Controls>

                            <EditBox name="$(parent)Field" inherits="ZO_DefaultEditMultiLineForBackdrop" font="ZoFontGameBold">
                                <OnTextChanged>
                                    NotesWindowBody5_OnTextChanged(self)
                                </OnTextChanged>
                            </EditBox>
                        </Controls>
                    </Backdrop>
				</Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>
