<GuiXml>
	<Controls>
		<TopLevelControl name="GGNBook2ClipboardControl" mouseEnabled="true" hidden="true" font="GGNBook2Clipboard\fonts\univers55.otf|20">
			<Dimensions x="500" y="800" />
			<Anchor point="Right" />
			
			
			
			<Controls>
				<Backdrop name="$(parent)Output" inherits="ZO_EditBackdrop">
					<Anchor point="TOPLEFT" offsetX="20" offsetY="20" />
					<Anchor point="BOTTOMRIGHT" offsetX="-20" offsetY="-20" />
					<Controls>
						<EditBox name="$(parent)Box" inherits="ZO_DefaultEditForBackdrop ZO_EditDefaultText" editEnabled="true" multiLine="true"/>
					</Controls>
				</Backdrop>
			</Controls>
		</TopLevelControl>	
	</Controls>
</GuiXml>